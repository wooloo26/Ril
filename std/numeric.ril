-- Standard Numeric module: integer conversions and proved integer helpers.

-- Converts an arbitrary-precision `int` to IEEE-754 binary64 `f64` (saturating to `±inf` on overflow).
pub fn to_f64(n: int) -> f64

-- Truncates finite `x` toward zero into `Some(int)`, returning `None` for `NaN` or `±inf`.
pub fn to_int_trunc(x: f64) -> new ?int

-- Converts finite integer-valued `x` into `Some(int)`, returning `None` when `x` is
-- non-finite or has a nonzero fractional part.
pub fn to_int_exact(x: f64) -> new ?int {
    if let Some(n) = to_int_trunc(x) {
        if to_f64(n) == x {
            Some(n)
        } else {
            None
        }
    } else {
        None
    }
}

-- Returns the non-negative absolute value of `x`.
pub fn abs(x: int) -> Nat {
    if x < 0 {
        -x
    } else {
        x
    }
}

-- Returns the smaller of `a` and `b`.
pub fn min(a: int, b: int) -> AtMost<a> |> AtMost<b> {
    if a < b {
        a
    } else {
        b
    }
}

-- Returns the larger of `a` and `b`.
pub fn max(a: int, b: int) -> AtLeast<a> |> AtLeast<b> {
    if a > b {
        a
    } else {
        b
    }
}

-- Restricts `x` to the inclusive range `[lo, hi]`.
pub fn clamp(x: int, lo: int, hi: AtLeast<lo>) -> Between<lo, hi> {
    if x < lo {
        lo
    } else if x > hi {
        hi
    } else {
        x
    }
}
