-- Standard Math module: pure self-hosted `f64` constants and helpers.

-- Ratio of a circle's circumference to its diameter (π).
pub meta let PI: f64 = 3.141592653589793

-- Base of natural logarithms (e).
pub meta let EULER: f64 = 2.718281828459045

-- Returns the absolute value of `x`.
pub fn abs(x: f64) -> f64 {
    if x < 0.0 {
        -x
    } else {
        x
    }
}

-- Returns the smaller of `a` and `b`.
pub fn min(a: f64, b: f64) -> f64 {
    if a < b {
        a
    } else {
        b
    }
}

-- Returns the larger of `a` and `b`.
pub fn max(a: f64, b: f64) -> f64 {
    if a > b {
        a
    } else {
        b
    }
}

-- Restricts `value` to the inclusive range `[low, high]`.
pub fn clamp(value: f64, low: f64, high: f64) -> f64 {
    if value < low {
        low
    } else if value > high {
        high
    } else {
        value
    }
}
