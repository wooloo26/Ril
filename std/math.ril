-- Standard Math module: pure self-hosted numeric constants and helpers.

-- Ratio of a circle's circumference to its diameter (π).
pub meta let PI: f64 = 3.141592653589793

-- Base of natural logarithms (e).
pub meta let EULER: f64 = 2.718281828459045

-- Returns the absolute value of `x`.
pub fn abs<T: int | f64>(x: T) -> T {
    meta match <T> {
        <int> -> if x < 0 {
            return -x
        } else {
            return x
        }
        <f64> -> if x < 0.0 {
            return -x
        } else {
            return x
        }
    }
}

-- Returns the smaller of `a` and `b`.
pub fn min<T: int | f64>(a: T, b: T) -> T {
    if a < b {
        a
    } else {
        b
    }
}

-- Returns the larger of `a` and `b`.
pub fn max<T: int | f64>(a: T, b: T) -> T {
    if a > b {
        a
    } else {
        b
    }
}

-- Restricts `value` to the inclusive range `[low, high]`.
pub fn clamp<T: int | f64>(value: T, low: T, high: T) -> T {
    if value < low {
        low
    } else if value > high {
        high
    } else {
        value
    }
}
