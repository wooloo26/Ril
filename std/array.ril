-- Standard Array module: compiler primitives plus self-hosted Ril combinators.

pub fn push<T>(mut xs: [via]T, via item: T) &mut -> ()
pub fn pop<T>(mut xs: [via]T) &mut -> new ?T
pub fn pop_front<T>(mut xs: [via]T) &mut -> new ?T
pub fn insert<T>(mut xs: [via]T, index: int, via item: T) &mut -> ()
pub fn remove<T>(mut xs: [via]T, index: int) &mut -> new ?T

pub fn clear<T>(mut xs: [via]T) &mut -> () {
    for 0..len(ref xs) as _ {
        let _ = pop(mut xs)
    }
}

pub fn sort<T: int | f64 | str | bytes>(mut xs: []T) &mut -> () {
    var i = 1
    while i < len(ref xs) {
        let key = xs[i]
        var j = i - 1
        while j >= 0 && (xs[j] > key || (key == key && !(xs[j] == xs[j]))) {
            xs[j + 1] = xs[j]
            j -= 1
        }
        xs[j + 1] = key
        i += 1
    }
}

pub fn at<T>(xs: []T, index: int) &return(xs) -> new ?T {
    xs?[index]
}

pub fn contains<T>(xs: []T, target: T) -> bool {
    for xs as x {
        if x == target {
            return true
        }
    }
    false
}

pub fn map<T, U>(xs: []T, f: fn(T) @ -> U) -> new []U {
    let mut out: []U = []
    for xs as x {
        push(mut out, f(x))
    }
    new out
}

pub fn filter<T>(xs: []T, pred: fn(T) @ -> bool) &return(xs) -> new []T {
    let mut out: []T = []
    for xs as x {
        if pred(x) {
            push(mut out, x)
        }
    }
    new out
}
