-- Standard Array module: compiler primitives plus self-hosted Ril combinators.

pub fn push<T>(mut xs: []T, via item: T) &mut -> ()
pub fn pop<T>(mut xs: []T) &mut -> new ?T
pub fn insert<T>(mut xs: []T, index: int, via item: T) &mut -> ()
pub fn remove<T>(mut xs: []T, index: int) &mut -> new ?T
pub fn sort<T>(mut xs: []T) &mut -> ()
pub fn clear<T>(mut xs: []T) &mut -> ()
pub fn len<T>(via xs: []T) -> int

pub fn at<T>(xs: []T, index: int) &return(xs) -> new ?T {
    if index < 0 || index >= len(xs) {
        None
    } else {
        Some(xs[index])
    }
}

pub fn contains<T>(xs: []T, target: T) -> bool {
    var i = 0
    while i < len(xs) {
        if xs[i] == target {
            return true
        }
        i += 1
    }
    false
}

pub fn map<T, U>(xs: []T, f: fn(T) -> U) -> new []U {
    let mut out: []U = []
    var i = 0
    while i < len(xs) {
        Array::push(mut out, f(xs[i]))
        i += 1
    }
    new out
}

pub fn filter<T>(xs: []T, pred: fn(T) -> bool) &return(xs) -> new []T {
    let mut out: []T = []
    var i = 0
    while i < len(xs) {
        if pred(xs[i]) {
            Array::push(mut out, xs[i])
        }
        i += 1
    }
    new out
}
