-- Standard Array module: compiler primitives plus self-hosted Ril combinators.

-- Appends `item` to the end of `xs` in place.
pub fn push<T>(mut xs: [via]T, via item: T) -> ()

-- Removes and returns the last element of `xs`, or `None` if empty.
-- Supports destructive extraction from arrays holding must-consume values.
pub fn pop<T>(mut xs: [via]T) -> new ?T

-- Removes and returns the first element of `xs`, or `None` if empty.
-- Supports destructive extraction from arrays holding must-consume values.
pub fn pop_front<T>(mut xs: [via]T) -> new ?T

-- Swaps the elements at `i` and `j` in `xs` in place.
pub fn swap<T>(mut xs: [via]T, i: InBounds<xs>, j: InBounds<xs>) -> ()

-- Inserts `item` at `index` in `xs`, shifting subsequent elements right.
pub fn insert<T>(mut xs: [via]T, index: Between<0, len(xs)>, via item: T) -> ()

-- Removes and returns the element at `index` in `xs`, shifting subsequent elements left.
-- Supports destructive extraction from arrays holding must-consume values.
pub fn remove<T>(mut xs: [via]T, index: InBounds<xs>) -> T

-- Returns the first element of `xs`, or `None` if empty.
pub fn first<T>(via xs: []T) &return(xs) -> new ?T {
    xs?[0]
}

-- Returns the last element of `xs`, or `None` if empty.
pub fn last<T>(via xs: []T) &return(xs) -> new ?T {
    let n = len(xs)
    if n == 0 {
        None
    } else {
        Some(xs[n - 1])
    }
}

-- Returns a new array containing `count` copies of `value`.
pub fn repeat<T>(value: T, count: Nat) &return(value) -> new []T |> Len<count> {
    let mut out: []T = []
    for 0..count as _ {
        push(mut out, value)
    }
    out
}

-- Removes every element from `xs` in place.
pub fn clear<T>(mut xs: [via]T) -> () {
    for 0..len(ref xs) as _ {
        let _ = pop(mut xs)
    }
}

-- Sorts `xs` in ascending order in place (stable insertion sort; `f64` `NaN` sorts last).
pub fn sort<T: int | f64 | str | bytes>(mut xs: []T) -> () {
    let n = len(ref xs)
    for 1..n as i {
        var j = i
        while j > 0 {
            let prev = xs[j - 1]
            let curr = xs[j]
            if prev > curr || (curr == curr && !(prev == prev)) {
                swap(mut xs, j - 1, j)
                j -= 1
            } else {
                break
            }
        }
    }
}

-- Reports whether `xs` contains an element equal to `target`.
pub fn contains<T>(via xs: [via]T, via target: T) -> bool {
    for via xs as x {
        if x == target {
            return true
        }
    }
    false
}

-- Returns a new array formed by applying `f` to each element of `xs` in order.
pub fn map<T, U>(xs: []T, via f: fn(T) @& -> U) @ -> new []U |> SameLen<xs> {
    let mut out: []U = []
    for xs as x {
        push(mut out, f(x))
    }
    out
}

-- Returns a new array containing only the elements of `xs` for which `pred` returns `true`.
pub fn filter<T>(via xs: []T, via pred: fn(T) @& -> bool) @ &return(xs) -> new []T {
    let mut out: []T = []
    for xs as x {
        if pred(x) {
            push(mut out, x)
        }
    }
    out
}

-- Reduces `xs` from left to right starting at `init`.
pub fn fold<T, Acc>(via xs: []T, init: Acc, via f: fn(Acc, T) @& -> Acc) @ -> Acc {
    var acc = init
    for xs as x {
        acc = f(acc, x)
    }
    acc
}

-- Reports whether `pred` returns `true` for at least one element of `xs`.
pub fn any<T>(via xs: []T, via pred: fn(T) @& -> bool) @ -> bool {
    for xs as x {
        if pred(x) {
            return true
        }
    }
    false
}

-- Reports whether `pred` returns `true` for every element of `xs`.
pub fn all<T>(via xs: []T, via pred: fn(T) @& -> bool) @ -> bool {
    for xs as x {
        if !pred(x) {
            return false
        }
    }
    true
}

-- Returns the first element of `xs` for which `pred` returns `true`, or `None`.
pub fn find<T>(via xs: []T, via pred: fn(T) @& -> bool) @ &return(xs) -> new ?T {
    for xs as x {
        if pred(x) {
            return Some(x)
        }
    }
    None
}
