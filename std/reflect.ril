-- Standard Reflect module: compile-time attribute and default introspection primitives.

pub type FieldMode {
    Let
    Var
    Mut
    SharedMut
    Ref
    VarMut
    VarSharedMut
    VarRef
}

pub meta fn type_name<T>(tv: Type<T>) -> str
pub meta fn fields<T>(tv: Type<T>) -> [](FieldMode, FieldKey<T>)
pub meta fn variants<T>(tv: Type<T>) -> []str
pub meta fn attrs<T, A>(target: Type<T>) -> []A
pub meta fn field_attrs<T, A>(target: Type<T>, meta key: str |> KeyOf<T>) -> []A
pub meta fn variant_attrs<T, A>(target: Type<T>, meta variant: str) -> []A
pub meta fn has_default<T>(target: Type<T>, meta key: str |> KeyOf<T>) -> bool
