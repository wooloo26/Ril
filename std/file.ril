-- Standard File module: host file I/O primitives.

-- Reads the entire UTF-8 contents of the file at `path` (`@io`), returning `Err(reason)` on failure.
--
-- ```ril,no_run
-- use ril/file
-- fn load() @io -> new !<str, str> {
--     let content = File::read("config.toml")?
--     Ok(content)
-- }
-- ```
pub fn read(path: str) @io -> new !<str, str>

-- Writes UTF-8 `content` to the file at `path`, creating or truncating it (`@io`),
-- returning `Err(reason)` on failure.
--
-- ```ril,no_run
-- use ril/file
-- fn save() @io -> new !<(), str> {
--     File::write("out.txt", "hello")?
--     Ok()
-- }
-- ```
pub fn write(path: str, content: str) @io -> new !<(), str>
