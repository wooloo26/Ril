-- Standard String module: minimal UTF-8/scalar primitives plus self-hosted Ril helpers.

use ril/array

-- Dual-phase canonical debug formatter rendering any Ril value (including cycles) as `str`.
--
-- ```ril
-- let s = String::inspect(.{ id: 1, tags: ["a", "b"] })
-- ```
pub fn inspect<T>(via value: T) -> str

-- Returns the Unicode scalar code point (`int`) at 0-based scalar `index` of `text`.
pub fn scalar_at(text: str, index: InBounds<text>) -> Between<0, 0x10FFFF>

-- Returns all Unicode scalar code points of `text` as a new `[]int`.
pub fn scalars(text: str) -> new []int |> SameLen<text>

-- Builds a `str` from an array of Unicode scalar code points, returning `None` if any
-- entry is not a valid Unicode scalar value (`0..=0x10FFFF` excluding surrogates).
pub fn from_scalars(via values: []int) -> new ?str |> SameLen<values>

-- Encodes `text` into its UTF-8 `bytes` representation.
pub fn encode_utf8(text: str) -> bytes

-- Decodes UTF-8 `data` into `Some(str)`, returning `None` if `data` is not valid UTF-8.
pub fn decode_utf8(data: bytes) -> new ?str

-- Concatenates `parts` into a single `str` separated by `separator`.
pub fn join(via parts: []str, separator: str) -> str {
    var out = ""
    var first = true
    for parts as part {
        if !first {
            out = "{out}{separator}"
        }
        first = false
        out = "{out}{part}"
    }
    out
}

-- Splits `text` on every non-overlapping occurrence of `separator`.
pub fn split(text: str, separator: str) -> new []str |> NonEmpty {
    let mut out: []str = []
    let n = len(text)
    let m = len(separator)
    if m == 0 {
        Array::push(mut out, "")
        for 0..n as i {
            Array::push(mut out, text[i..i + 1])
        }
        Array::push(mut out, "")
        return out
    }
    var start = 0
    var i = 0
    while i + m <= n {
        if text[i..i + m] == separator {
            Array::push(mut out, text[start..i])
            i += m
            start = i
        } else {
            i += 1
        }
    }
    Array::push(mut out, text[start..n])
    out
}

-- Reports whether `text` begins with `prefix`.
pub fn starts_with(text: str, prefix: str) -> bool {
    let n = len(prefix)
    if n > len(text) {
        return false
    }
    text[..n] == prefix
}

-- Reports whether `text` ends with `suffix`.
pub fn ends_with(text: str, suffix: str) -> bool {
    let n = len(suffix)
    let m = len(text)
    if n > m {
        return false
    }
    text[m - n..] == suffix
}
