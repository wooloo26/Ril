-- Standard Io module: synchronous standard-output primitive plus println helper.

-- Writes `text` directly to standard output without a trailing newline (`@io`).
pub fn print(text: str) @io -> ()

-- Writes `text` followed by a newline (`\n`) to standard output (`@io`).
pub fn println(text: str) @io -> () {
    print("{text}\n")
}
