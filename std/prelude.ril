-- Standard Prelude module: implicit ambient scope for every Ril compilation unit.

pub use ril/array
pub use ril/bytes
pub use ril/io::(print, println)
pub use ril/map
pub use ril/numeric
pub use ril/reflect
pub use ril/reflect::FieldMode
pub use ril/set
pub use ril/set::Set
pub use ril/string

pub type Option<T> {
    Some(T)
    None
}

pub use Option::(Some, None)

pub type Result<T, E> {
    Ok(T)
    Err(E)
}

pub use Result::(Ok, Err)

pub opaque type PanicInfo(str)

pub type PanicError {
    Panicked(PanicInfo)
}

pub use PanicError::Panicked

pub opaque type Draft<T>

meta fn compile_error_code(code: str, message: str) -> never
pub meta fn compile_error(message: str) -> never

pub type LenTarget = \T -> match <T> {
    <str> | <bytes> | <Set<_>> -> <T>
    <[let M]_> -> <T>
    <[_: let M _]> -> <T>
    _ -> compile_error_code("E0301", "len requires text, bytes, or a collection")
}

pub type Tuple = \T -> match <T> {
    <(..)> -> <T>
    _ -> compile_error_code("E0301", "type does not satisfy Tuple")
}

pub type Unwrap = \W -> match <W> {
    <Draft<let Inner>> -> <Draft<Unwrap<Inner>>>
    _ -> <UnwrapNominal<W>>
}

pub type NominalWrapper = \W -> match <W> {
    <Draft<let Inner>> -> {
        let _ = <NominalWrapper<Inner>>
        <W>
    }
    _ -> {
        let _ = <UnwrapNominal<W>>
        <W>
    }
}

pub type FieldKey = \T -> match <T> {
    <.{ ..}> -> <str>
    <(..)> -> <int>
    _ -> match <TryUnwrapNominal<T>> {
        <.{ ..}> -> <str>
        <(..)> -> <int>
        _ -> compile_error_code("E0358", "FieldKey requires a record or tuple type")
    }
}

pub type SharedObject = \T -> match <T> {
    <bool> | <int> | <f64> | <str> | <bytes> | <()> | <never> -> compile_error_code("E0301", "type does not satisfy SharedObject")
    <FieldMode> | <Draft<_>> | <Type> | <Type<_>> -> compile_error_code("E0301", "type does not satisfy SharedObject")
    <[let M]_> | <[_: let M _]> | <.{ ..}> | <(..)> -> <T>
    _ -> match <SharedObjectKernel<T>> {
        <never> -> compile_error_code("E0301", "type does not satisfy SharedObject")
        <let Ok> -> <Ok>
    }
}

pub fn len<T |> LenTarget>(via item: T) -> int
pub fn inner<W |> NominalWrapper>(via wrapper: W) -> infer Unwrap<W>
pub fn clone<T |> SharedObject>(via value: T) -> new T
pub fn derive<T |> SharedObject>(base: T, via update: fn(mut Draft<T>) @& -> ()) -> T
pub fn abort<T>(new k: T) -> ()
pub fn absorb_panic<T>(via action: fn() @& -> infer T) -> infer !<T, PanicError>
pub fn panic_message(info: PanicInfo) -> str
pub meta fn type_name<T>(tv: Type<T>) -> str
pub meta fn fields<T>(tv: Type<T>) -> [](FieldMode, FieldKey<T>)
pub meta fn variants<T>(tv: Type<T>) -> []str
pub fn panic(message: str) -> never
pub fn assert(condition: bool, message: str = "assertion failed") -> () {
    if !condition {
        panic(message)
    }
}
