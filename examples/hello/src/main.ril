-- Multi-module Ril example showcasing stdlib combinators, algebraic `ctl` effects, and `defer`.

use pkg/math
use ril/io

eff Emit {
    ctl emit(value: int) -> ()
}

fn emit_squares(nums: []int) @Emit -> () {
    for nums as n {
        Emit::emit(Math::square(n))
    }
}

fn main() @io -> () {
    let nums = [2, 3, 4, 5]
    let squares = Array::map(nums, \x -> Math::square(x))
    assert(squares?[2] == Some(16))
    assert(Math::safe_ratio(42, 6) == Some(7))
    assert(Math::safe_ratio(42, 0) == None)

    let raw = String::encode_utf8("hello-ril")
    assert(String::decode_utf8(raw) == Some("hello-ril"))

    var cleaned = false
    let done: []int = {
        let mut collected: []int = []
        with {
            ctl Emit::emit = \v, k -> {
                Array::push(mut collected, v)
                k()
            }
            defer {
                cleaned = true
            }
            emit_squares(nums)
        }
        collected
    }
    assert(cleaned)
    assert(done?[3] == Some(25))
    Io::println("hello-ok")
}
