use ril/_storage as Storage
use ril/_unicode_data as Data
use ril/num
use ril/string_builder
pub type DecodeError = { offset: int }
pub type ScalarError = { value: u32 }
fn valid(value: u32) -> bool { value <= 0x10ffffu32 && (value < 0xd800u32 || value > 0xdfffu32) }
fn widen(value: u8) -> u32 { Num::convert<u8, u32>(value) ?? \_error -> panic("byte widening") }
pub fn from_scalar(value: u32) -> Result<str, ScalarError> {
    if !valid(value) { Err(.{ value: value }) } else { Ok(Storage::string_from_scalars([value])) }
}
pub fn decode_utf8(data: bytes) -> Result<str, DecodeError> {
    let mut values: []u32 = []
    var index = 0
    while index < len(data) {
        let first = data[index]
        let count = if first < 128u8 { 1 } else if first >= 194u8 && first < 224u8 { 2 }
            else if first >= 224u8 && first < 240u8 { 3 } else if first >= 240u8 && first <= 244u8 { 4 }
            else { return Err(.{ offset: index }) }
        if count > len(data) - index { return Err(.{ offset: index }) }
        var value = widen(if count == 1 { first } else if count == 2 { first & 31u8 }
            else if count == 3 { first & 15u8 } else { first & 7u8 })
        for 1..count as offset {
            let continuation_byte = data[index + offset]
            if continuation_byte < 128u8 || continuation_byte >= 192u8 { return Err(.{ offset: index }) }
            value = (value << 6u32) | widen(continuation_byte & 63u8)
        }
        if !valid(value) || (count == 2 && value < 128u32) || (count == 3 && value < 2048u32)
            || (count == 4 && value < 65536u32) { return Err(.{ offset: index }) }
        values !> Array::push(value)
        index += count
    }
    Ok(Storage::string_from_scalars(values))
}
fn properties(value: u32) -> u8 {
    if !valid(value) { return 0u8 }
    let index = (Num::convert<u32, int>(value >> 8u32) ?? \_error -> panic("scalar page")) * 2
    let low = Num::convert<u8, int>(Data::INDICES[index]) ?? \_error -> panic("page byte")
    let high = Num::convert<u8, int>(Data::INDICES[index + 1]) ?? \_error -> panic("page byte")
    let offset = Num::convert<u32, int>(value & 255u32) ?? \_error -> panic("page offset")
    Data::PAGES[(low + high * 256) * 256 + offset]
}
pub fn is_white_space(value: u32) -> bool { (properties(value) & 1u8) != 0u8 }
pub fn is_alphabetic(value: u32) -> bool { (properties(value) & 2u8) != 0u8 }
pub fn is_decimal_digit(value: u32) -> bool { (properties(value) & 4u8) != 0u8 }
pub fn is_xid_start(value: u32) -> bool { (properties(value) & 8u8) != 0u8 }
pub fn is_xid_continue(value: u32) -> bool { (properties(value) & 16u8) != 0u8 }
fn mapped(value: u32, table: [](u32, str)) -> str {
    var lower = 0
    var upper = len(table)
    while lower < upper {
        let middle = lower + (upper - lower) / 2
        if table[middle].0 < value { lower = middle + 1 } else { upper = middle }
    }
    if lower < len(table) && table[lower].0 == value { table[lower].1 }
    else { from_scalar(value) ?? \_error -> panic("string contains a nonscalar") }
}
pub fn uppercase(text: str) -> str {
    let mut output = StringBuilder::new()
    for String::scalars(text) as value { StringBuilder::append(mut output, mapped(value, Data::UPPER)) }
    StringBuilder::to_string(output)
}
pub fn lowercase(text: str) -> str {
    let values = String::scalars(text)
    let mut after: []bool = []
    for values as _value { after !> Array::push(false) }
    var following = false
    var index = len(values)
    while index > 0 {
        index -= 1
        after[index] = following
        let bits = properties(values[index])
        if (bits & 32u8) != 0u8 { following = true } else if (bits & 64u8) == 0u8 { following = false }
    }
    var before = false
    let mut output = StringBuilder::new()
    for 0..len(values) as at {
        let value = values[at]
        let mapped_value = if value == 0x3a3u32 && before && !after[at] { "ς" } else { mapped(value, Data::LOWER) }
        StringBuilder::append(mut output, mapped_value)
        let bits = properties(value)
        if (bits & 32u8) != 0u8 { before = true } else if (bits & 64u8) == 0u8 { before = false }
    }
    StringBuilder::to_string(output)
}
