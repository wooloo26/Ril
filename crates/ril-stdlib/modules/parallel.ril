use ril/_storage as Storage

type Fault = Storage::BranchFault

fn workers(count: int) -> int { if count == 0 { 1 } else { count } }
fn map_jobs<T, U>(items: []T, transform: fn(T) -> U) -> [](fn() -> U) {
    let mut jobs: [](fn() -> U) = []
    for 0..len(items) as index { Array::push(mut jobs, \ -> transform(items[index])) }
    jobs
}
fn ordered<T>(outcomes: []Result<T, Fault>) -> []T {
    let mut values: []T = []
    var failure: ?Fault = None
    for outcomes as outcome {
        match outcome {
            Ok(value) -> Array::push(mut values, value),
            Err(error) -> { if failure is None { failure = Some(error) } },
        }
    }
    match failure { Some(error) -> Storage::branch_rethrow(error), None -> values }
}
fn independent<T>(outcomes: []Result<T, Fault>) -> []T {
    let mut values: []T = []
    var failure: ?Fault = None
    var rank = 0
    for outcomes as outcome {
        match outcome {
            Ok(value) -> Array::push(mut values, value),
            Err(error) -> {
                let incoming = Storage::branch_rank(error)
                if incoming > rank { failure = Some(error); rank = incoming }
            },
        }
    }
    match failure { Some(error) -> Storage::branch_rethrow(error), None -> values }
}
fn flatten<T>(outcomes: []Result<Result<T, Fault>, Fault>) -> []Result<T, Fault> {
    let mut values: []Result<T, Fault> = []
    for outcomes as outcome {
        match outcome { Ok(value) -> Array::push(mut values, value), Err(error) -> Array::push(mut values, Err(error)) }
    }
    values
}
fn attempt<T>(action: fn() -> T, index: ?int) -> Result<T, Fault> {
    let outcomes = Storage::parallel_run([action], 1)
    match outcomes[0] {
        Ok(value) -> Ok(value),
        Err(error) -> Err(Storage::branch_with_index(error, index)),
    }
}

pub fn map<T, U>(items: []T, transform: fn(T) -> U) -> []U {
    map_bounded(items, workers(len(items)), transform)
}
pub fn map_bounded<T, U>(items: []T, max_concurrency: int, transform: fn(T) -> U) -> []U {
    assert(max_concurrency > 0, "nonpositive bound")
    ordered(Storage::parallel_run(map_jobs(items, transform), max_concurrency))
}
pub fn find<T>(items: []T, predicate: fn(T) -> bool) -> ?T {
    let outcomes = Storage::parallel_run(map_jobs(items, predicate), workers(len(items)))
    var answer: ?T = None
    var failure: ?Fault = None
    var decided = false
    for 0..len(outcomes) as index {
        match outcomes[index] {
            Ok(selected) -> {
                if !decided && selected { answer = Some(items[index]); decided = true }
            },
            Err(error) -> { if !decided { failure = Some(error); decided = true } },
        }
    }
    match failure { Some(error) -> Storage::branch_rethrow(error), None -> answer }
}
pub fn first<T>(items: []T, predicate: fn(T) -> bool) -> ?T { find(items, predicate) }
pub fn any<T>(items: []T, predicate: fn(T) -> bool) -> bool { find(items, predicate) is Some(_) }

fn fold_group<T, A>(items: []T, start: int, end: int, init: fn() -> A, local: fn(A, T) -> A) -> Result<A, Fault> {
    var accumulator = attempt(init, None)?
    for start..end as index {
        accumulator = attempt(\ -> local(accumulator, items[index]), Some(index))?
    }
    Ok(accumulator)
}
pub fn fold<T, A>(items: []T, init_acc: fn() -> A,
    fold_local: fn(A, T) -> A, merge_acc: fn(A, A) -> A) -> A {
    let groups = if len(items) == 0 { 1 } else { len(items) / 64 + if len(items) % 64 == 0 { 0 } else { 1 } }
    let mut jobs: [](fn() -> Result<A, Fault>) = []
    for 0..groups as group {
        let start = group * 64
        let end = if len(items) - start < 64 { len(items) } else { start + 64 }
        Array::push(mut jobs, \ -> fold_group(items, start, end, init_acc, fold_local))
    }
    var values = ordered(flatten(Storage::parallel_run(jobs, workers(groups))))
    while len(values) > 1 {
        let count = len(values)
        let mut merges: [](fn() -> Result<A, Fault>) = []
        for 0..count / 2 as pair {
            Array::push(mut merges, \ -> attempt(\ -> merge_acc(values[pair * 2], values[pair * 2 + 1]), None))
        }
        let mut merged = ordered(flatten(Storage::parallel_run(merges, workers(count / 2))))
        if count % 2 == 1 { Array::push(mut merged, values[count - 1]) }
        values = merged
    }
    values[0]
}

type PairAnswer<A, B> { Left(A), Right(B) }
pub fn join<A, B>(left: fn() -> A, right: fn() -> B) -> (A, B) {
    let jobs: [](fn() -> PairAnswer<A, B>) = [\ -> PairAnswer::Left(left()), \ -> PairAnswer::Right(right())]
    let values = independent(Storage::parallel_run(jobs, 2))
    let first = match values[0] { PairAnswer::Left(value) -> value, PairAnswer::Right(_) -> panic("left branch result") }
    let second = match values[1] { PairAnswer::Right(value) -> value, PairAnswer::Left(_) -> panic("right branch result") }
    (first, second)
}
type TripleAnswer<A, B, C> { First(A), Second(B), Third(C) }
pub fn join3<A, B, C>(first: fn() -> A, second: fn() -> B, third: fn() -> C) -> (A, B, C) {
    let jobs: [](fn() -> TripleAnswer<A, B, C>) = [
        \ -> TripleAnswer::First(first()), \ -> TripleAnswer::Second(second()), \ -> TripleAnswer::Third(third()),
    ]
    let values = independent(Storage::parallel_run(jobs, 3))
    let a = match values[0] { TripleAnswer::First(value) -> value, _ -> panic("first branch result") }
    let b = match values[1] { TripleAnswer::Second(value) -> value, _ -> panic("second branch result") }
    let c = match values[2] { TripleAnswer::Third(value) -> value, _ -> panic("third branch result") }
    (a, b, c)
}
pub fn for_each<T>(mut items: []T, action: fn(mut T) -> ()) &mut {
    let mut jobs: [](fn() -> ()) = []
    for 0..len(items) as index {
        let mut item = items[index]
        Array::push(mut jobs, \ -> action(mut item))
    }
    let _ = independent(Storage::parallel_run(jobs, workers(len(items))))
}
