pub type Deque<T>
type DequeState<T> = { mut front: []T, mut back: []T }

pub fn new<T>() -> Deque<T> { Deque<T>.{ front: [], back: [] } }

pub fn len<T>(queue: Deque<T>) -> int { Prelude::len(queue.front) + Prelude::len(queue.back) }

pub fn push_front<T>(mut queue: Deque<T>, value: T) &mut {
    let _ = len(queue) + 1
    Array::push(mut queue.front, value)
}

pub fn push_back<T>(mut queue: Deque<T>, value: T) &mut {
    let _ = len(queue) + 1
    Array::push(mut queue.back, value)
}

pub fn pop_front<T>(mut queue: Deque<T>) -> ?T &mut {
    if Prelude::len(queue.front) == 0 && Prelude::len(queue.back) > 0 {
        let count = Prelude::len(queue.back)
        let middle = count / 2 + count % 2
        let mut front: []T = []
        let mut back: []T = []
        var index = middle
        while index > 0 { index -= 1; Array::push(mut front, queue.back[index]) }
        for middle..count as index { Array::push(mut back, queue.back[index]) }
        queue.front = front; queue.back = back
    }
    Array::pop(mut queue.front)
}

pub fn pop_back<T>(mut queue: Deque<T>) -> ?T &mut {
    if Prelude::len(queue.back) == 0 && Prelude::len(queue.front) > 0 {
        let count = Prelude::len(queue.front)
        let middle = count / 2 + count % 2
        let mut front: []T = []
        let mut back: []T = []
        var index = middle
        while index > 0 { index -= 1; Array::push(mut back, queue.front[index]) }
        for middle..count as index { Array::push(mut front, queue.front[index]) }
        queue.front = front; queue.back = back
    }
    Array::pop(mut queue.back)
}

pub fn values<T>(queue: Deque<T>) -> []T {
    let mut output: []T = []
    var index = Prelude::len(queue.front)
    while index > 0 { index -= 1; Array::push(mut output, queue.front[index]) }
    for queue.back as value { Array::push(mut output, value) }
    output
}
