pub fn from<T>(items: []T) -> Set<T> { of(items) }
pub fn of<T>(items: []T) -> Set<T> {
    let mut output = Storage::set_new<T>()
    for items as item { let _ = output !> Set::insert(item) }
    output
}
pub fn union<T>(left: Set<T>, right: Set<T>) -> Set<T> {
    let mut output = of(Set::values(left))
    for Set::values(right) as item { let _ = output !> Set::insert(item) }
    output
}
pub fn intersect<T>(left: Set<T>, right: Set<T>) -> Set<T> {
    let mut output = Storage::set_new<T>()
    for Set::values(left) as item {
        if Set::contains(right, item) { let _ = output !> Set::insert(item) }
    }
    output
}
pub fn diff<T>(left: Set<T>, right: Set<T>) -> Set<T> {
    let mut output = Storage::set_new<T>()
    for Set::values(left) as item {
        if !Set::contains(right, item) { let _ = output !> Set::insert(item) }
    }
    output
}
use ril/_storage as Storage


pub fn contains<T>(items: Set<T>, value: T) -> bool

pub fn insert<T>(mut items: Set<T>, value: T) -> bool &mut

pub fn remove<T>(mut items: Set<T>, value: T) -> bool &mut

pub fn values<T>(items: Set<T>) -> []T {
    let mut output: []T = []
    for items as item { Array::push(mut output, item) }
    output
}
