use ril/os
use ril/path
use ril/io
use ril/file
use ril/num
pub type Instant
pub type NativeString
pub type Path
pub type Identity
pub type ReadGuard

pub fn set_new<T>() -> Set<T>
pub fn environment_free<F>(value: F) -> F
pub fn instant_parts(instant: Instant) -> (bigint, bigint)
pub fn string_from_scalars(values: []u32) -> str
pub fn string_scalars(text: str) -> []u32
pub fn string_utf8(text: str) -> bytes
pub fn bytes_from_array(values: []u8) -> bytes
pub fn bytes_to_array(data: bytes) -> []u8
pub fn f32_bits(value: f32) -> u32
pub fn f32_from_bits(value: u32) -> f32
pub fn f64_bits(value: f64) -> u64
pub fn f64_from_bits(value: u64) -> f64
pub fn sqrt_f32(value: f32) -> f32
pub fn sqrt_f64(value: f64) -> f64
pub fn platform_windows() -> bool
pub fn native_from_units(values: []u16, windows: bool) -> NativeString
pub fn native_units(value: NativeString) -> []u16
pub fn native_windows(value: NativeString) -> bool
pub fn path_from_native(value: NativeString) -> Path
pub fn path_native(value: Path) -> NativeString
pub fn file_read_dir(path: Path::Path) -> Result<[](Os::NativeString, File::FileKind), Io::IoError> @Fiber
pub fn fresh_identity() -> Identity
pub fn reference_identity<T>(value: T) -> Identity
pub fn callable_identity<F>(value: F) -> Identity
pub fn guard_read(position: Identity)
pub fn guard_seek(position: Identity)
pub fn read_guard<R>(buffer: Io::ReadBuffer, reader: R,
    operation: fn(mut R, int) -> Result<Io::ReadChunk, Io::IoError> &mut,
    position: ?Identity, cached: bool) -> ReadGuard
pub fn read_reservation(guard: ReadGuard, pending: bool)
pub fn numeric_convert<T, U>(value: T) -> Result<U, Num::NumError>
pub fn environment_all() -> [](Os::NativeString, Os::NativeString) @Fiber
