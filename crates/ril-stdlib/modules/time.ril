pub type Duration(i64)

pub type Timestamp = { seconds: i64, nanos: u32 }

pub type Instant = Storage::Instant

pub type TimeError { OutOfRange, DifferentClock }

pub fn duration_nanos(value: i64) -> Duration { Duration(value) }

pub fn add(value: Timestamp, duration: Duration) -> Result<Timestamp, TimeError> {
    if value.nanos >= 1000000000u32 { return Err(TimeError::OutOfRange) }
    let seconds = Num::convert<i64, bigint>(value.seconds) ?? \_error -> panic("integer widening")
    let nanos = Num::convert<u32, bigint>(value.nanos) ?? \_error -> panic("integer widening")
    let delta = Num::convert<i64, bigint>(inner(duration)) ?? \_error -> panic("integer widening")
    let total = seconds * 1000000000bigint + nanos + delta
    var next_seconds = total / 1000000000bigint
    var next_nanos = total % 1000000000bigint
    if next_nanos < 0bigint { next_seconds -= 1bigint; next_nanos += 1000000000bigint }
    let converted_seconds = Num::convert<bigint, i64>(next_seconds) ?? \_error -> return Err(TimeError::OutOfRange)
    let converted_nanos = Num::convert<bigint, u32>(next_nanos) ?? \_error -> return Err(TimeError::OutOfRange)
    Ok(.{ seconds: converted_seconds, nanos: converted_nanos })
}

pub fn elapsed(start: Instant, end: Instant) -> Result<Duration, TimeError> {
    let first = Storage::instant_parts(start)
    let second = Storage::instant_parts(end)
    if first.0 != second.0 { return Err(TimeError::DifferentClock) }
    let difference = second.1 - first.1
    if difference < 0bigint { return Err(TimeError::OutOfRange) }
    let nanos = Num::convert<bigint, i64>(difference) ?? \_error -> return Err(TimeError::OutOfRange)
    Ok(Duration(nanos))
}

pub fn monotonic() -> Instant @Fiber

pub fn sleep(duration: Duration) -> () @Fiber

pub fn timestamp(seconds: i64, nanos: u32) -> Result<Timestamp, TimeError> {
    if nanos >= 1000000000u32 { Err(TimeError::OutOfRange) }
    else { Ok(.{ seconds: seconds, nanos: nanos }) }
}
use ril/_storage as Storage
