}
pub fn format_i32(value: i32, radix: int = 10) -> Result<str, NumError> {
    format_bigint(convert<i32, bigint>(value) ?? \_error -> panic("integer widening"), radix)
}

pub fn parse_i64(text: str, radix: int = 10) -> Result<i64, NumError> {
