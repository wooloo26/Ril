use ril/unicode
use ril/_storage as Storage
pub type NumError { InvalidSyntax, OutOfRange, InvalidRadix }
fn digit(value: u32) -> ?int {
    if value >= 48u32 && value <= 57u32 { Some(convert<u32, int>(value - 48u32) ?? \_error -> panic("digit range")) }
    else if value >= 65u32 && value <= 90u32 { Some(convert<u32, int>(value - 55u32) ?? \_error -> panic("digit range")) }
    else if value >= 97u32 && value <= 122u32 { Some(convert<u32, int>(value - 87u32) ?? \_error -> panic("digit range")) }
    else { None }
}
pub fn parse_bigint(text: str, radix: int = 10) -> Result<bigint, NumError> {
    if radix < 2 || radix > 36 { return Err(NumError::InvalidRadix) }
    let scalars = String::scalars(text)
    if len(scalars) == 0 { return Err(NumError::InvalidSyntax) }
    let negative = scalars[0] == 45u32
    let start = if negative || scalars[0] == 43u32 { 1 } else { 0 }
    if start == len(scalars) { return Err(NumError::InvalidSyntax) }
    let base = convert<int, bigint>(radix) ?? \_error -> panic("radix range")
    var value = 0bigint
    for start..len(scalars) as index {
        let number = digit(scalars[index]) ?? return Err(NumError::InvalidSyntax)
        if number >= radix { return Err(NumError::InvalidSyntax) }
        let part = convert<int, bigint>(number) ?? \_error -> panic("digit range")
        value = value * base + part
    }
    Ok(if negative { -value } else { value })
}
pub fn parse_int(text: str, radix: int = 10) -> Result<int, NumError> { convert<bigint, int>(parse_bigint(text, radix)?) }
pub fn format_bigint(value: bigint, radix: int = 10) -> Result<str, NumError> {
    if radix < 2 || radix > 36 { return Err(NumError::InvalidRadix) }
    let base = convert<int, bigint>(radix) ?? \_error -> panic("radix range")
    var magnitude = if value < 0bigint { -value } else { value }
    let mut digits: []str = []
    loop {
        let remainder = convert<bigint, u32>(magnitude % base) ?? \_error -> panic("digit range")
        let scalar = if remainder < 10u32 { 48u32 + remainder } else { 87u32 + remainder }
        digits !> Array::push(Unicode::from_scalar(scalar) ?? \_error -> panic("ASCII digit"))
        magnitude = magnitude / base
        if magnitude == 0bigint { last }
    }
    let text = String::join(Array::reverse(digits), "")
    Ok(if value < 0bigint { String::concat("-", text) } else { text })
}
pub fn format_int(value: int, radix: int = 10) -> Result<str, NumError> {
    format_bigint(convert<int, bigint>(value) ?? \_error -> panic("integer widening"), radix)
}
pub fn parse_f64(text: str) -> Result<f64, NumError> {
    let word = convert<bigint, u64>(parse_decimal(text, layout(true))?)?
    Ok(Storage::f64_from_bits(word))
}
pub fn format_f64(value: f64) -> str {
    format_decimal(convert<u64, bigint>(Storage::f64_bits(value)) ?? \_error -> panic("float bits"), layout(true))
}
pub fn parse_f32(text: str) -> Result<f32, NumError> {
    let word = convert<bigint, u32>(parse_decimal(text, layout(false))?)?
    Ok(Storage::f32_from_bits(word))
}
pub fn format_f32(value: f32) -> str {
    format_decimal(convert<u32, bigint>(Storage::f32_bits(value)) ?? \_error -> panic("float bits"), layout(false))
}
pub fn convert<T, U>(value: T) -> Result<U, NumError> { Storage::numeric_convert<T, U>(value) }

type FloatLayout = { fraction: int, bias: int, width: int, digits: int, decimal_limit: int }
fn layout(wide: bool) -> FloatLayout {
    if wide { .{ fraction: 52, bias: 1023, width: 64, digits: 17, decimal_limit: 309 } }
    else { .{ fraction: 23, bias: 127, width: 32, digits: 9, decimal_limit: 39 } }
}
fn integer(value: int) -> bigint { convert<int, bigint>(value) ?? \_error -> panic("integer widening") }
fn power(base: bigint, exponent: int) -> bigint {
    assert(exponent >= 0, "negative integer exponent")
    var factor = base
    var remaining = exponent
    var output = 1bigint
    while remaining > 0 {
        if remaining % 2 == 1 { output = output * factor }
        remaining = remaining / 2
        if remaining > 0 { factor = factor * factor }
    }
    output
}
fn rounded_ratio(numerator: bigint, denominator: bigint) -> bigint {
    let quotient = numerator / denominator
    let twice = (numerator % denominator) * 2bigint
    if twice > denominator || (twice == denominator && quotient % 2bigint != 0bigint) { quotient + 1bigint }
    else { quotient }
}
fn rational_word(numerator: bigint, denominator: bigint, format: FloatLayout) -> Result<bigint, NumError> {
    if numerator == 0bigint { return Ok(0bigint) }
    var exponent = 0
    var normalized = numerator
    var divisor = denominator
    while normalized < divisor { normalized = normalized * 2bigint; exponent -= 1 }
    while normalized >= divisor * 2bigint { divisor = divisor * 2bigint; exponent += 1 }
    if exponent > format.bias { return Err(NumError::OutOfRange) }
    if exponent < 1 - format.bias { exponent = 1 - format.bias }
    let shift = format.fraction - exponent
    var significand = if shift >= 0 { rounded_ratio(numerator * power(2bigint, shift), denominator) }
        else { rounded_ratio(numerator, denominator * power(2bigint, -shift)) }
    let hidden = power(2bigint, format.fraction)
    if significand >= hidden * 2bigint { significand = significand / 2bigint; exponent += 1 }
    if exponent > format.bias { return Err(NumError::OutOfRange) }
    if significand < hidden { Ok(significand) }
    else { Ok(integer(exponent + format.bias) * hidden + significand - hidden) }
}
fn decimal_digit(value: u32) -> bool { value >= 48u32 && value <= 57u32 }
fn parse_decimal(text: str, format: FloatLayout) -> Result<bigint, NumError> {
    let hidden = power(2bigint, format.fraction)
    let infinity = integer(format.bias * 2 + 1) * hidden
    if text == "nan" { return Ok(infinity + hidden / 2bigint) }
    if text == "inf" || text == "+inf" { return Ok(infinity) }
    let sign_bit = power(2bigint, format.width - 1)
    if text == "-inf" { return Ok(sign_bit + infinity) }
    let chars = String::scalars(text)
    if len(chars) == 0 { return Err(NumError::InvalidSyntax) }
    let negative = chars[0] == 45u32
    var index = if negative || chars[0] == 43u32 { 1 } else { 0 }
    var coefficient = 0bigint
    var significant = 0
    let before = index
    while index < len(chars) && decimal_digit(chars[index]) {
        coefficient = coefficient * 10bigint + convert<u32, bigint>(chars[index] - 48u32)?
        if coefficient != 0bigint { significant += 1 }
        index += 1
    }
    let has_integer = index > before
    var fractional = 0
    if index < len(chars) && chars[index] == 46u32 {
        index += 1
        let after = index
        while index < len(chars) && decimal_digit(chars[index]) {
            coefficient = coefficient * 10bigint + convert<u32, bigint>(chars[index] - 48u32)?
            if coefficient != 0bigint { significant += 1 }
            index += 1
        }
        fractional = index - after
        if fractional == 0 { return Err(NumError::InvalidSyntax) }
    } else if !has_integer { return Err(NumError::InvalidSyntax) }
    var exponent = 0bigint
    if index < len(chars) && (chars[index] == 101u32 || chars[index] == 69u32) {
        index += 1
        let minus = index < len(chars) && chars[index] == 45u32
        if index < len(chars) && (chars[index] == 43u32 || minus) { index += 1 }
        let start = index
        while index < len(chars) && decimal_digit(chars[index]) {
            exponent = exponent * 10bigint + convert<u32, bigint>(chars[index] - 48u32)?
            index += 1
        }
        if index == start { return Err(NumError::InvalidSyntax) }
        if minus { exponent = -exponent }
    }
    if index != len(chars) { return Err(NumError::InvalidSyntax) }
    let sign = if negative { sign_bit } else { 0bigint }
    if coefficient == 0bigint { return Ok(sign) }
    let scale = exponent - integer(fractional)
    let adjusted = scale + integer(significant - 1)
    if adjusted > integer(format.decimal_limit) { return Err(NumError::OutOfRange) }
    if adjusted < integer(if format.width == 64 { -325 } else { -47 }) { return Ok(sign) }
    let places = convert<bigint, int>(if scale < 0bigint { -scale } else { scale })?
    let magnitude = if scale >= 0bigint { rational_word(coefficient * power(10bigint, places), 1bigint, format)? }
        else { rational_word(coefficient, power(10bigint, places), format)? }
    Ok(sign + magnitude)
}
fn decimal_text(coefficient: bigint, scale: int) -> str {
    var digits = coefficient
    var unit = scale
    while digits % 10bigint == 0bigint { digits = digits / 10bigint; unit += 1 }
    let text = format_bigint(digits) ?? \_error -> panic("decimal digits")
    let exponent = len(text) + unit - 1
    if exponent < -6 || exponent > 20 {
        let mantissa = if len(text) == 1 { text } else { String::concat(String::concat(text[0..1], "."), text[1..len(text)]) }
        String::concat(String::concat(mantissa, "e"), format_int(exponent) ?? \_error -> panic("decimal exponent"))
    } else {
        let point = exponent + 1
        if point <= 0 { String::concat(String::concat("0.", zeroes(-point)), text) }
        else if point >= len(text) { String::concat(String::concat(text, zeroes(point - len(text))), ".0") }
        else { String::concat(String::concat(text[0..point], "."), text[point..len(text)]) }
    }
}
fn zeroes(count: int) -> str {
    let mut parts: []str = []
    for 0..count as _index { parts !> Array::push("0") }
    String::join(parts, "")
}
fn format_decimal(word: bigint, format: FloatLayout) -> str {
    let sign_bit = power(2bigint, format.width - 1)
    let negative = word >= sign_bit
    let magnitude = word % sign_bit
    let hidden = power(2bigint, format.fraction)
    let encoded_exponent = convert<bigint, int>(magnitude / hidden) ?? \_error -> panic("float exponent")
    let fraction = magnitude % hidden
    if encoded_exponent == format.bias * 2 + 1 {
        return if fraction != 0bigint { "nan" } else if negative { "-inf" } else { "inf" }
    }
    if magnitude == 0bigint { return if negative { "-0.0" } else { "0.0" } }
    let significand = if encoded_exponent == 0 { fraction } else { hidden + fraction }
    let binary_exponent = (if encoded_exponent == 0 { 1 } else { encoded_exponent }) - format.bias - format.fraction
    let numerator = if binary_exponent >= 0 { significand * power(2bigint, binary_exponent) } else { significand }
    let denominator = if binary_exponent < 0 { power(2bigint, -binary_exponent) } else { 1bigint }
    var normalized = numerator
    var divisor = denominator
    var decimal_exponent = 0
    while normalized < divisor { normalized = normalized * 10bigint; decimal_exponent -= 1 }
    while normalized >= divisor * 10bigint { divisor = divisor * 10bigint; decimal_exponent += 1 }
    for 1..format.digits + 1 as count {
        let scale = decimal_exponent - count + 1
        let unit_numerator = if scale >= 0 { power(10bigint, scale) } else { 1bigint }
        let unit_denominator = if scale < 0 { power(10bigint, -scale) } else { 1bigint }
        let floor = (numerator * unit_denominator) / (denominator * unit_numerator)
        var selected: ?bigint = None
        var distance = 0bigint
        for [floor, floor + 1bigint] as candidate {
            if candidate > 0bigint {
                let rounded = rational_word(candidate * unit_numerator, unit_denominator, format)
                let same = match rounded { Ok(value) -> value == magnitude, Err(_) -> false }
                if same {
                    let delta = candidate * unit_numerator * denominator - numerator * unit_denominator
                    let absolute = if delta < 0bigint { -delta } else { delta }
                    if selected is None || absolute < distance || (absolute == distance && candidate % 2bigint == 0bigint) {
                        selected = Some(candidate); distance = absolute
                    }
                }
            }
        }
        match selected {
            Some(candidate) -> {
                let text = decimal_text(candidate, scale)
                return if negative { String::concat("-", text) } else { text }
            },
            None -> {},
        }
    }
    panic("binary float has no shortest decimal")
}

pub fn parse_i8(text: str, radix: int = 10) -> Result<i8, NumError> {
    convert<bigint, i8>(parse_bigint(text, radix)?)
}
pub fn format_i8(value: i8, radix: int = 10) -> Result<str, NumError> {
    format_bigint(convert<i8, bigint>(value) ?? \_error -> panic("integer widening"), radix)
}

pub fn parse_i16(text: str, radix: int = 10) -> Result<i16, NumError> {
    convert<bigint, i16>(parse_bigint(text, radix)?)
}
pub fn format_i16(value: i16, radix: int = 10) -> Result<str, NumError> {
    format_bigint(convert<i16, bigint>(value) ?? \_error -> panic("integer widening"), radix)
}

pub fn parse_i32(text: str, radix: int = 10) -> Result<i32, NumError> {
