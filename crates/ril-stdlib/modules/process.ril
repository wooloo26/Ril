use ril/io
use ril/os
use ril/path

pub fn command(program: Path::Path, args: []Os::NativeString) -> Process::Command {
    .{ program: program, args: args, cwd: None, env: None,
       input: Process::Input::Inherit, stdout: Process::OutputMode::Inherit,
       stderr: Process::OutputMode::Inherit }
}

pub fn with_child<T>(command: Process::Command,
    action: fn(mut Process::Child) -> Result<T, Process::ProcessError>) -> Result<T, Process::ProcessError> @Fiber {
    let scoped mut child = Process::spawn(command)?
    let outcome = action(mut child)
    let terminated = Process::terminate(mut child)
    match terminated {
        Ok() -> outcome,
        Err(cleanup_error) -> match outcome { Err(error) -> Err(error), Ok(_) -> Err(cleanup_error) },
    }
}

pub fn success(status: Process::ExitStatus) -> bool {
    match status { Process::ExitStatus::Exited(code) -> code == 0u32, Process::ExitStatus::Signaled(_) -> false }
}

pub type Input { Inherit, Null, Data(bytes) }

pub type OutputMode { Inherit, Null, Capture }

pub type ExitStatus { Exited(u32), Signaled(int) }

pub type Output = { status: ExitStatus, stdout: bytes, stderr: bytes }

pub type ProcessError {
    InvalidCommand(str), StartFailed(Io::IoError), WaitFailed(Io::IoError),
    CaptureLimit, TransferFailed(Io::IoError),
}

pub type Child

pub fn run(command: Command, capture_limit: int = 16777216) -> Result<Output, ProcessError> @Fiber

pub fn spawn(command: Command) -> Result<Child, ProcessError> @Fiber

pub fn wait(mut child: Child) -> Result<ExitStatus, ProcessError> @Fiber &mut

pub fn terminate(mut child: Child) -> Result<(), ProcessError> @Fiber &mut

pub type Command = {
    program: Path::Path,
    args: []Os::NativeString,
    cwd: ?Path::Path,
    env: ?[](Os::NativeString, Os::NativeString),
    input: Input,
    stdout: OutputMode,
    stderr: OutputMode,
}
