use ril/_storage as Storage
use ril/bytes

pub fn read_all<R>(mut reader: R, ops: Io::ReadOps<R>) -> Result<bytes, Io::IoError> &mut {
    let mut output: []u8 = []
    loop {
        let chunk = ops.read(mut reader, 8192)?
        assert(len(chunk.data) <= 8192 && (len(chunk.data) > 0 || chunk.end), "invalid read chunk")
        for Bytes::to_array(chunk.data) as value { output !> Array::push(value) }
        if chunk.end { last Ok(Bytes::from_array(output)) }
    }
}

pub fn write_all<W>(mut writer: W, data: bytes, ops: Io::WriteOps<W>) -> Result<(), Io::IoError> &mut {
    var offset = 0
    var validate_empty = len(data) == 0
    while validate_empty || offset < len(data) {
        let progress = ops.write(mut writer, data[offset..len(data)])
        assert(progress.written >= 0 && progress.written <= len(data) - offset, "invalid write progress")
        offset += progress.written
        validate_empty = false
        match progress.error { Some(error) -> return Err(error), None -> {} }
        assert(offset == len(data) || progress.written > 0, "write made no progress")
    }
    Ok()
}

pub fn write_stdout(text: str) -> Result<(), Io::IoError> @Fiber {
    let data = String::utf8(text)
    var offset = 0
    var validate_empty = len(data) == 0
    while validate_empty || offset < len(data) {
        let progress = Io::stdout_write(data[offset..len(data)])
        assert(progress.written >= 0 && progress.written <= len(data) - offset, "invalid write progress")
        offset += progress.written
        validate_empty = false
        match progress.error { Some(error) -> return Err(error), None -> {} }
        assert(offset == len(data) || progress.written > 0, "write made no progress")
    }
    Ok()
}

pub fn write_stderr(text: str) -> Result<(), Io::IoError> @Fiber {
    let data = String::utf8(text)
    var offset = 0
    var validate_empty = len(data) == 0
    while validate_empty || offset < len(data) {
        let progress = Io::stderr_write(data[offset..len(data)])
        assert(progress.written >= 0 && progress.written <= len(data) - offset, "invalid write progress")
        offset += progress.written
        validate_empty = false
        match progress.error { Some(error) -> return Err(error), None -> {} }
        assert(offset == len(data) || progress.written > 0, "write made no progress")
    }
    Ok()
}

pub fn error_text(error: Io::IoError) -> str { error.message }

pub type ErrorKind {
    NotFound, PermissionDenied, AlreadyExists, InvalidInput, InvalidData,
    UnexpectedEnd, BrokenPipe, Closed, Unsupported, Other,
}

pub type IoError = { kind: ErrorKind, message: str, native_code: ?i64 }

pub type ReadChunk = { data: bytes, end: bool }

pub type WriteProgress = { written: int, error: ?IoError }

pub type ReadOps<R> = { read: fn(mut R, int) -> Result<ReadChunk, IoError> &mut }

pub type WriteOps<W> = { write: fn(mut W, bytes) -> WriteProgress &mut }

pub fn stdin_read(max_bytes: int) -> Result<ReadChunk, IoError> @Fiber

pub fn stdout_write(data: bytes) -> WriteProgress @Fiber

pub fn stderr_write(data: bytes) -> WriteProgress @Fiber

pub type ReadBuffer

pub type WriteBuffer

pub type ReadPosition = Storage::Identity

pub fn read_position() -> ReadPosition { Storage::fresh_identity() }

pub fn guard_read(position: ReadPosition) -> () { Storage::guard_read(position) }

pub fn guard_seek(position: ReadPosition) -> () { Storage::guard_seek(position) }

pub fn read_buffer(capacity: int) -> ReadBuffer {
    assert(capacity > 0, "read buffer capacity")
    ReadBuffer.{ capacity: capacity, data: b"", offset: 0, end: false, binding: None }
}

pub fn write_buffer(capacity: int) -> WriteBuffer {
    assert(capacity > 0, "write buffer capacity")
    WriteBuffer.{ capacity: capacity, pending: [], first: 0, snapshot: None, draining: false, binding: None }
}

pub fn read_buffered<R>(mut buffer: ReadBuffer, mut reader: R,
    ops: ReadOps<R>, max_bytes: int) -> Result<ReadChunk, IoError> &mut { read_buffered_impl(mut buffer, mut reader, ops, max_bytes, None) }

pub fn read_buffered_at<R>(mut buffer: ReadBuffer, mut reader: R,
    ops: ReadOps<R>, max_bytes: int, position: ReadPosition) -> Result<ReadChunk, IoError> &mut { read_buffered_impl(mut buffer, mut reader, ops, max_bytes, Some(position)) }

pub fn write_buffered<W>(mut buffer: WriteBuffer, mut writer: W,
    ops: WriteOps<W>, data: bytes) -> WriteProgress &mut {
    assert(buffer.capacity > 0, "write buffer capacity")
    let incoming = buffer_binding(writer, ops.write, None)
    check_binding(buffer.binding, incoming)
    var accepted = 0
    var validate_empty = len(data) == 0
    loop {
        if pending_count(buffer) == 0 {
            buffer.snapshot = None; buffer.first = 0; buffer.draining = false; buffer.binding = None
        }
        if !buffer.draining && accepted < len(data) {
            let room = buffer.capacity - pending_count(buffer)
            let count = if room < len(data) - accepted { room } else { len(data) - accepted }
            for accepted..accepted + count as index { buffer.pending !> Array::push(data[index]) }
            accepted += count
            if pending_count(buffer) > 0 { buffer.binding = Some(incoming) }
        }
        if !validate_empty && accepted == len(data) { last .{ written: accepted, error: None } }
        let offered = if validate_empty { b"" } else { pending_bytes(mut buffer) }
        validate_empty = false
        if len(offered) > 0 { buffer.draining = true }
        let progress = checked_write(ops.write(mut writer, offered), len(offered))
        consume_written(mut buffer, progress.written)
        match progress.error { Some(error) -> last .{ written: accepted, error: Some(error) }, None -> {} }
    }
}

pub fn flush<W>(mut buffer: WriteBuffer, mut writer: W,
    ops: WriteOps<W>) -> Result<(), IoError> &mut {
    assert(buffer.capacity > 0, "write buffer capacity")
    let incoming = buffer_binding(writer, ops.write, None)
    check_binding(buffer.binding, incoming)
    loop {
        let offered = pending_bytes(mut buffer)
        if len(offered) > 0 { buffer.draining = true }
        let progress = checked_write(ops.write(mut writer, offered), len(offered))
        consume_written(mut buffer, progress.written)
        match progress.error { Some(error) -> last Err(error), None -> {} }
        if pending_count(buffer) == 0 { last Ok() }
    }
}

type BufferBinding = { receiver: Storage::Identity, operation: Storage::Identity, position: Storage::Identity }
type ReadBufferState = { capacity: int, mut data: bytes, mut offset: int, mut end: bool, mut binding: ?BufferBinding }
type WriteBufferState = { capacity: int, mut pending: []u8, mut first: int, mut snapshot: ?bytes, mut draining: bool, mut binding: ?BufferBinding }
fn buffer_binding<R, F>(receiver: R, operation: F, position: ?ReadPosition) -> BufferBinding {
    let identity = Storage::reference_identity(receiver)
    .{ receiver: identity, operation: Storage::callable_identity(operation), position: position ?? identity }
}
fn check_binding(previous: ?BufferBinding, incoming: BufferBinding) {
    match previous { Some(value) -> assert(value == incoming, "buffer has pending data for another receiver, position or operation"), None -> {} }
}
fn checked_read(chunk: ReadChunk, maximum: int) -> ReadChunk {
    assert(len(chunk.data) <= maximum, "read exceeds requested count")
    if maximum == 0 { assert(len(chunk.data) == 0 && !chunk.end, "zero read must return empty non-EOF data") }
    else { assert(len(chunk.data) > 0 || chunk.end, "read made no progress") }
    chunk
}
fn checked_write(progress: WriteProgress, maximum: int) -> WriteProgress {
    assert(progress.written >= 0 && progress.written <= maximum, "invalid write progress")
    assert(maximum == 0 || progress.written > 0 || progress.error is Some(_), "write made no progress")
    progress
}
fn take_read(mut buffer: ReadBuffer, maximum: int, guard: Storage::ReadGuard) -> ReadChunk &mut {
    let available = len(buffer.data) - buffer.offset
    let count = if maximum < available { maximum } else { available }
    let data = buffer.data[buffer.offset..buffer.offset + count]
    buffer.offset += count
    let end = buffer.end && buffer.offset == len(buffer.data)
    if buffer.offset == len(buffer.data) {
        buffer.data = b""; buffer.offset = 0; buffer.end = false; buffer.binding = None
        Storage::read_reservation(guard, false)
    } else { Storage::read_reservation(guard, true) }
    .{ data: data, end: end }
}
fn read_buffered_impl<R>(mut buffer: ReadBuffer, mut reader: R, ops: ReadOps<R>, maximum: int, position: ?ReadPosition) -> Result<ReadChunk, IoError> &mut {
    assert(buffer.capacity > 0, "read buffer capacity")
    assert(maximum >= 0, "negative read count")
    let incoming = buffer_binding(reader, ops.read, position)
    check_binding(buffer.binding, incoming)
    let cached = maximum > 0 && buffer.offset < len(buffer.data)
    let scoped guard = Storage::read_guard(buffer, reader, ops.read, position, cached)
    if cached { return Ok(take_read(mut buffer, maximum, guard)) }
    let offered = if maximum == 0 { 0 } else { buffer.capacity }
    let chunk = checked_read(ops.read(mut reader, offered)?, offered)
    if maximum == 0 { return Ok(chunk) }
    buffer.data = chunk.data; buffer.offset = 0; buffer.end = chunk.end; buffer.binding = Some(incoming)
    Ok(take_read(mut buffer, maximum, guard))
}
fn pending_count(buffer: WriteBuffer) -> int {
    match buffer.snapshot { Some(data) -> len(data) - buffer.first, None -> len(buffer.pending) }
}
fn pending_bytes(mut buffer: WriteBuffer) -> bytes &mut {
    match buffer.snapshot {
        Some(data) -> data[buffer.first..len(data)],
        None -> {
            let data = Bytes::from_array(buffer.pending)
            Array::truncate(mut buffer.pending, 0)
            buffer.snapshot = Some(data); buffer.first = 0
            data
        },
    }
}
fn consume_written(mut buffer: WriteBuffer, count: int) &mut {
    let _ = pending_bytes(mut buffer)
    buffer.first += count
    if pending_count(buffer) == 0 {
        buffer.snapshot = None; buffer.first = 0; buffer.draining = false; buffer.binding = None
    } else { buffer.draining = true }
}
