pub type Ordering { Less, Equal, Greater }
pub type Ops<T> = { compare: fn(T, T) -> Ordering }

fn merge<T>(left: []T, right: []T, ops: Ops<T>) -> []T @{} &{} {
    let mut output: []T = []
    var first = 0
    var second = 0
    while first < len(left) && second < len(right) {
        match ops.compare(left[first], right[second]) {
            Ordering::Greater -> { output !> Array::push(right[second]); second += 1 },
            _ -> { output !> Array::push(left[first]); first += 1 },
        }
    }
    while first < len(left) { output !> Array::push(left[first]); first += 1 }
    while second < len(right) { output !> Array::push(right[second]); second += 1 }
    output
}

pub fn sorted<T>(items: []T, ops: Ops<T>) -> []T @{} &{} {
    let mut runs: [][]T = []
    for items as item { runs !> Array::push([item]) }
    while len(runs) > 1 {
        let mut following: [][]T = []
        var index = 0
        while index < len(runs) {
            if index + 1 == len(runs) { following !> Array::push(runs[index]) }
            else { following !> Array::push(merge(runs[index], runs[index + 1], ops)) }
            index += 2
        }
        Array::truncate(mut runs, 0)
        for following as run { runs !> Array::push(run) }
    }
    if len(runs) == 0 { [] } else { runs[0] }
}

pub fn binary_search<T>(items: []T, value: T, ops: Ops<T>) -> Result<int, int> @{} &{} {
    var lower = 0
    var upper = len(items)
    while lower < upper {
        let middle = lower + (upper - lower) / 2
        match ops.compare(items[middle], value) {
            Ordering::Less -> { lower = middle + 1 },
            _ -> { upper = middle },
        }
    }
    if lower < len(items) && ops.compare(items[lower], value) is Ordering::Equal {
        Ok(lower)
    } else { Err(lower) }
}

pub fn compare_int(left: int, right: int) -> Ordering {
    if left < right { Ordering::Less } else if left > right { Ordering::Greater } else { Ordering::Equal }
}
pub fn compare_str(left: str, right: str) -> Ordering {
    if left < right { Ordering::Less } else if left > right { Ordering::Greater } else { Ordering::Equal }
}
pub fn compare_bytes(left: bytes, right: bytes) -> Ordering {
    if left < right { Ordering::Less } else if left > right { Ordering::Greater } else { Ordering::Equal }
}

pub fn total_f64(left: f64, right: f64) -> Ordering {
    if left != left { if right != right { Ordering::Equal } else { Ordering::Greater } }
    else if right != right { Ordering::Less }
    else if left < right { Ordering::Less }
    else if left > right { Ordering::Greater }
    else if left == 0.0 && right == 0.0 {
        if 1.0 / left < 1.0 / right { Ordering::Less }
        else if 1.0 / left > 1.0 / right { Ordering::Greater }
        else { Ordering::Equal }
    } else { Ordering::Equal }
}
