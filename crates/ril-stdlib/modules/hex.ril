use ril/bytes
use ril/num
use ril/unicode

pub type HexError = { offset: int }

fn digit(value: u8) -> u8 {
    if value < 10u8 { 48u8 + value } else { 87u8 + value }
}

pub fn encode(data: bytes) -> str {
    let mut output: []u8 = []
    for Bytes::to_array(data) as value {
        output !> Array::push(digit(value >> 4u8))
        output !> Array::push(digit(value & 15u8))
    }
    Unicode::decode_utf8(Bytes::from_array(output)) ?? \_error -> panic("hex encoding is ASCII")
}

fn value(digit: u32) -> ?u8 {
    let result = if digit >= 48u32 && digit <= 57u32 { Some(digit - 48u32) }
        else if digit >= 65u32 && digit <= 70u32 { Some(digit - 55u32) }
        else if digit >= 97u32 && digit <= 102u32 { Some(digit - 87u32) }
        else { None }
    match result { None -> None, Some(number) -> Some(Num::convert<u32, u8>(number) ?? \_error -> panic("hex digit range")) }
}

pub fn decode(text: str) -> Result<bytes, HexError> {
    let scalars = String::scalars(text)
    let mut output: []u8 = []
    var index = 0
    while index < len(scalars) {
        let high = value(scalars[index]) ?? return Err(HexError.{ offset: index })
        if index + 1 == len(scalars) { return Err(HexError.{ offset: index }) }
        let low = value(scalars[index + 1]) ?? return Err(HexError.{ offset: index + 1 })
        output !> Array::push((high << 4u8) | low)
        index += 2
    }
    Ok(Bytes::from_array(output))
}
