use ril/_storage as Storage
use ril/bytes
use ril/num
use ril/order
use ril/unicode
pub type NativeString = Storage::NativeString
pub type NativeError { InvalidEncoding, WrongPlatform }
pub type Platform { Windows, Posix }
pub fn platform() -> Platform { if Storage::platform_windows() { Platform::Windows } else { Platform::Posix } }
fn byte_units(data: bytes) -> []u16 {
    let mut units: []u16 = []
    for Bytes::to_array(data) as value { units !> Array::push(Num::convert<u8, u16>(value) ?? \_error -> panic("byte widening")) }
    units
}
pub fn from_string(text: str) -> NativeString {
    if !Storage::platform_windows() { return Storage::native_from_units(byte_units(String::utf8(text)), false) }
    let mut units: []u16 = []
    for String::scalars(text) as value {
        if value < 65536u32 {
            units !> Array::push(Num::convert<u32, u16>(value) ?? \_error -> panic("UTF-16 unit"))
        } else {
            let pair = value - 65536u32
            units !> Array::push(Num::convert<u32, u16>(0xd800u32 + (pair >> 10u32)) ?? \_error -> panic("high surrogate"))
            units !> Array::push(Num::convert<u32, u16>(0xdc00u32 + (pair & 1023u32)) ?? \_error -> panic("low surrogate"))
        }
    }
    Storage::native_from_units(units, true)
}
pub fn to_string(value: NativeString) -> Result<str, NativeError> {
    let units = Storage::native_units(value)
    if !Storage::native_windows(value) {
        let mut bytes: []u8 = []
        for units as unit { bytes !> Array::push(Num::convert<u16, u8>(unit) ?? \_error -> panic("native byte width")) }
        return match Unicode::decode_utf8(Bytes::from_array(bytes)) {
            Ok(text) -> Ok(text), Err(_) -> Err(NativeError::InvalidEncoding),
        }
    }
    let mut scalars: []u32 = []
    var index = 0
    while index < len(units) {
        let first = Num::convert<u16, u32>(units[index]) ?? \_error -> panic("unit widening")
        if first < 0xd800u32 || first > 0xdfffu32 { scalars !> Array::push(first); index += 1 }
        else {
            if first >= 0xdc00u32 || index + 1 == len(units) { return Err(NativeError::InvalidEncoding) }
            let second = Num::convert<u16, u32>(units[index + 1]) ?? \_error -> panic("unit widening")
            if second < 0xdc00u32 || second > 0xdfffu32 { return Err(NativeError::InvalidEncoding) }
            scalars !> Array::push(65536u32 + (first - 0xd800u32) * 1024u32 + second - 0xdc00u32)
            index += 2
        }
    }
    Ok(Storage::string_from_scalars(scalars))
}
pub fn from_posix_bytes(data: bytes) -> Result<NativeString, NativeError> {
    if Storage::platform_windows() { Err(NativeError::WrongPlatform) }
    else { Ok(Storage::native_from_units(byte_units(data), false)) }
}
pub fn posix_bytes(value: NativeString) -> Result<bytes, NativeError> {
    if Storage::native_windows(value) { return Err(NativeError::WrongPlatform) }
    let mut bytes: []u8 = []
    for Storage::native_units(value) as unit { bytes !> Array::push(Num::convert<u16, u8>(unit) ?? \_error -> panic("native byte width")) }
    Ok(Bytes::from_array(bytes))
}
pub fn from_windows_units(units: []u16) -> Result<NativeString, NativeError> {
    if Storage::platform_windows() { Ok(Storage::native_from_units(units, true)) } else { Err(NativeError::WrongPlatform) }
}
pub fn windows_units(value: NativeString) -> Result<[]u16, NativeError> {
    if Storage::native_windows(value) { Ok(Storage::native_units(value)) } else { Err(NativeError::WrongPlatform) }
}
pub fn compare(left: NativeString, right: NativeString) -> Order::Ordering {
    let left_windows = Storage::native_windows(left)
    let right_windows = Storage::native_windows(right)
    if left_windows != right_windows { return if left_windows { Order::Ordering::Greater } else { Order::Ordering::Less } }
    let first = Storage::native_units(left)
    let second = Storage::native_units(right)
    for 0..(if len(first) < len(second) { len(first) } else { len(second) }) as index {
        if first[index] < second[index] { return Order::Ordering::Less }
        if first[index] > second[index] { return Order::Ordering::Greater }
    }
    Order::compare_int(len(first), len(second))
}
