use ril/_storage as Storage
use ril/order

pub type Heap<T>
type HeapState<T> = { mut items: [](T, bigint), compare: fn(T, T) -> Order::Ordering @{} &{}, mut serial: bigint }

pub fn new<T>(ops: Order::Ops<T>) -> Heap<T> {
    let compare: fn(T, T) -> Order::Ordering @{} &{} = ops.compare
    Heap<T>.{ items: [], compare: Storage::environment_free(compare), serial: 0bigint }
}
pub fn len<T>(heap: Heap<T>) -> int { Prelude::len(heap.items) }
pub fn peek<T>(heap: Heap<T>) -> ?T {
    if Prelude::len(heap.items) == 0 { None } else { Some(heap.items[0].0) }
}

fn before<T>(left: (T, bigint), right: (T, bigint), compare: fn(T, T) -> Order::Ordering @{} &{}) -> bool @{} &{} {
    match compare(left.0, right.0) {
        Order::Ordering::Less -> true,
        Order::Ordering::Greater -> false,
        Order::Ordering::Equal -> left.1 < right.1,
    }
}

pub fn push<T>(mut heap: Heap<T>, value: T) &mut {
    let stable = value
    let entry = (stable, heap.serial)
    var index = Prelude::len(heap.items)
    let mut path: []int = []
    while index > 0 {
        let parent = (index - 1) / 2
        if !before(entry, heap.items[parent], heap.compare) { last }
        path !> Array::push(parent)
        index = parent
    }
    Array::push(mut heap.items, entry)
    var hole = Prelude::len(heap.items) - 1
    for path as parent { heap.items[hole] = heap.items[parent]; hole = parent }
    heap.items[hole] = entry
    heap.serial += 1bigint
}

pub fn pop<T>(mut heap: Heap<T>) -> ?T &mut {
    let count = Prelude::len(heap.items)
    if count == 0 { return None }
    let answer = heap.items[0].0
    let final_item = heap.items[count - 1]
    let remaining = count - 1
    let mut path: []int = []
    var index = 0
    if remaining > 0 {
        while index < remaining / 2 {
            let left = index * 2 + 1
            let right = left + 1
            let child = if right < remaining && before(heap.items[right], heap.items[left], heap.compare) { right } else { left }
            if !before(heap.items[child], final_item, heap.compare) { last }
            path !> Array::push(child)
            index = child
        }
    }
    let _ = Array::pop(mut heap.items)
    if remaining > 0 {
        var hole = 0
        for path as child { heap.items[hole] = heap.items[child]; hole = child }
        heap.items[hole] = final_item
    }
    Some(answer)
}
