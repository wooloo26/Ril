pub type Builder
type BuilderState = { mut chunks: []str }

pub fn new() -> Builder { Builder.{ chunks: [] } }

pub fn append(mut builder: Builder, text: str) &mut {
    if len(text) > 0 { Array::push(mut builder.chunks, text) }
}

pub fn append_scalar(mut builder: Builder, value: u32) -> Result<(), Unicode::ScalarError> &mut {
    let text = Unicode::from_scalar(value)?
    append(mut builder, text)
    Ok()
}

pub fn clear(mut builder: Builder) &mut { Array::truncate(mut builder.chunks, 0) }

pub fn to_string(builder: Builder) -> str {
    let mut scalars: []u32 = []
    for builder.chunks as chunk {
        for Storage::string_scalars(chunk) as scalar { Array::push(mut scalars, scalar) }
    }
    Storage::string_from_scalars(scalars)
}
use ril/_storage as Storage
use ril/unicode
