pub fn first<T>(items: []T) -> ?T { get(items, 0) }

pub fn get<T>(items: []T, index: int) -> ?T {
    if index < 0 || index >= len(items) { None } else { Some(items[index]) }
}

pub fn contains<T>(items: []T, value: T) -> bool {
    for items as item { if item == value { return true } }
    false
}

pub fn reverse<T>(items: []T) -> []T {
    let mut output: []T = []
    var index = len(items)
    while index > 0 { index -= 1; output !> Array::push(items[index]) }
    output
}

pub fn concat<T>(left: []T, right: []T) -> []T {
    let mut output: []T = []
    for left as item { output !> Array::push(item) }
    for right as item { output !> Array::push(item) }
    output
}

pub fn map<T, U>(items: []T, transform: fn(T) -> U) -> []U {
    let mut output: []U = []
    for items as item { output !> Array::push(transform(item)) }
    output
}

pub fn filter<T>(items: []T, predicate: fn(T) -> bool) -> []T {
    let mut output: []T = []
    for items as item { if predicate(item) { output !> Array::push(item) } }
    output
}

pub fn fold<T, A>(items: []T, initial: A, step: fn(A, T) -> A) -> A {
    var accumulated = initial
    for items as item { accumulated = step(accumulated, item) }
    accumulated
}

pub fn find<T>(items: []T, predicate: fn(T) -> bool) -> ?T {
    for items as item { if predicate(item) { return Some(item) } }
    None
}

pub fn any<T>(items: []T, predicate: fn(T) -> bool) -> bool {
    for items as item { if predicate(item) { return true } }
    false
}

pub fn all<T>(items: []T, predicate: fn(T) -> bool) -> bool {
    for items as item { if !predicate(item) { return false } }
    true
}

pub fn for_each<T>(items: []T, action: fn(T) -> ()) {
    for items as item { action(item) }
}

pub fn push<T>(mut items: []T, value: T) &mut

pub fn pop<T>(mut items: []T) -> ?T &mut

pub fn insert<T>(mut items: []T, index: int, value: T) &mut

pub fn remove<T>(mut items: []T, index: int) -> T &mut

pub fn truncate<T>(mut items: []T, length: int) &mut
