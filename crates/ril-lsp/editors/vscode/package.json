{
  "name": "ril-lang",
  "displayName": "Ril Language",
  "description": "TypeScript-style Monokai syntax highlighting, semantic tokens, pipeline auto-suggestions, and local Language Server (ril lsp) for Ril (.ril)",
  "version": "0.1.0",
  "publisher": "ril-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ril"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ril",
        "aliases": [
          "Ril",
          "ril"
        ],
        "extensions": [
          ".ril"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ril",
        "scopeName": "source.ril",
        "path": "./syntaxes/ril.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ril",
        "scopes": {
          "parameter": [
            "variable.parameter.ril"
          ],
          "type.declaration": [
            "entity.name.type.ril"
          ],
          "type": [
            "support.type.ril"
          ],
          "typeParameter": [
            "support.type.ril"
          ],
          "namespace": [
            "support.class.ril"
          ],
          "enumMember": [
            "constant.other.enum.ril"
          ],
          "variable.readonly": [
            "constant.other.constant.ril"
          ],
          "function.defaultLibrary": [
            "support.function.ril"
          ],
          "function": [
            "entity.name.function.ril"
          ],
          "macro": [
            "entity.other.attribute-name.effect.ril"
          ],
          "property": [
            "variable.other.property.ril"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "ril.restartServer",
        "title": "Ril: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Ril",
      "properties": {
        "ril.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `ril` binary. When empty, auto-detects workspace target/debug/ril, target/release/ril, cargo run, or `ril` in PATH."
        },
        "ril.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the `ril` binary when `ril.serverPath` is explicitly set."
        },
        "ril.completion.dotToPipe": {
          "type": "boolean",
          "default": true,
          "description": "Suggest pipeable functions after `.` (rewriting `x.fn` into `x |> Mod::fn(...)`)."
        },
        "ril.completion.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Include unimported `ril/*` stdlib and `pkg/*` modules in pipeline completions with automatic `use` insertion."
        },
        "ril.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type inlay hints on unannotated `let`/`var` bindings and closure parameters."
        },
        "ril.docExamples.subtleHighlight": {
          "type": "boolean",
          "default": true,
          "description": "Apply subtle opacity and background tint to fenced `-- ```ril` doc-comment code examples to visually distinguish them from live code."
        }
      }
    }
  }
}
