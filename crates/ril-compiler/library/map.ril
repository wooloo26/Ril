pub halt type Key = \T -> match <T> {
    <[let K: let V]> -> <K>,
    _ -> <never>,
}

pub halt type Value = \T -> match <T> {
    <[let K: let V]> -> <V>,
    _ -> <never>,
}

pub halt fn get<K, V>(via values: [K: via V], key: K) -> infer ?V { values?[key] }

pub halt fn set<K, V>(mut values: [K: via V], key: K, via value: V) &mut -> () {
    values[key] = value
}

pub halt fn keys<K, V>(via values: [K: via V]) -> new []K {
    let mut result: []K = []
    for values as (key, _) { result !> Array::push(key) }
    result
}

pub halt fn values<K, V>(via entries: [K: via V]) -> infer [via]V {
    let mut result: [via]V = []
    for entries as (_, value) { result !> Array::push(value) }
    result
}
