-- These operations share the source-defined prelude Set identity.
pub halt fn empty<T>() -> new Set<T>
pub halt fn insert<T>(mut values: Set<T>, item: T) &mut -> bool
pub halt fn contains<T>(via values: Set<T>, item: T) -> bool
pub halt fn remove<T>(mut values: Set<T>, item: T) &mut -> bool
pub halt fn to_array<T>(via values: Set<T>) -> new []T

pub halt type Elem = \T -> match <T> {
    <Set<let Item>> -> <Item>,
    _ -> <never>,
}

pub halt fn from<T>(values: []T) -> new Set<T> {
    let mut result = empty<T>()
    for values as item { let _ = insert(mut result, item) }
    result
}
