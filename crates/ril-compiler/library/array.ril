-- Storage operations select concrete authority from the checked element schema.
pub halt fn push<T>(mut values: [via]T, via item: T) &mut -> ()
pub halt fn insert<T>(mut values: [via]T, index: i64, via item: T) &mut -> ()
pub halt fn pop<T>(via values: [via]T) &mut -> infer ?T
pub halt fn truncate<T>(mut values: [via]T, length: i64) &mut -> ()

pub halt type Elem = \T -> match <T> {
    <[]let Item> -> <Item>,
    _ -> <never>,
}

pub halt fn first<T>(via values: [via]T) -> infer ?T { values?[0] }

pub halt fn contains<T>(via values: [via]T, via item: T) -> bool {
    for values as value {
        if value == item { return true }
    }
    false
}

pub fn map<T, U>(values: []T, via transform: fn(T) @& -> U) -> new []U {
    let mut result: []U = []
    for values as item { result !> push(transform(item)) }
    result
}

pub fn filter<T>(values: []T, via predicate: fn(T) @& -> bool) -> new []T {
    let mut result: []T = []
    for values as item {
        if predicate(item) { result !> push(item) }
    }
    result
}

pub fn fold<T, U>(values: []T, initial: U, via combine: fn(U, T) @& -> U) -> U {
    var result = initial
    for values as item { result = combine(result, item) }
    result
}

pub halt fn reverse<T>(values: []T) -> new []T {
    let mut result: []T = []
    let count = len(values)
    for 0..count as index { result !> push(values[count - index - 1]) }
    result
}
