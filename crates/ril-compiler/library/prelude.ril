-- Canonical foundational declarations. The compiler binds bodyless
-- declarations in this source to the language's primitive contracts.
pub halt fn len<T |> LenTarget>(via item: T) -> i64
pub fn inner<W |> NominalWrapper>(via wrapper: W) -> infer Unwrap<W>
pub fn clone<T |> SharedObject>(via value: T) -> new T
pub fn derive<T |> SharedObject>(base: T, recipe: fn(mut draft: Draft<T>) @& -> ()) -> T
pub meta fn byte_size(value: Type) -> i64
pub meta fn type_name(value: Type) -> str
pub halt fn panic(message: str) -> never
pub halt fn assert(condition: bool, message: str = "assertion failed") -> ()
pub fn print(text: str) @Fiber -> ()
pub fn println(text: str) @Fiber -> ()

pub type Option<T> { Some(T), None }
pub type Result<T, E> { Ok(T), Err(E) }
pub opaque type Set<T> = [T: ()]

pub halt type Tuple = \T -> match <T> {
    <()> -> <T>,
    <(let M let _, let N let _)> -> <T>,
    <(let M let _, ..)> -> <T>,
    _ -> <never>,
}
