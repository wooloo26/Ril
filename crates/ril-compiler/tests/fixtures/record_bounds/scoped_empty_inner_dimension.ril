fn first<T:{items:[0][2]int,..R}>(value:(T,T))->int{len(value.(0).items)}
fn forward<S>(value:({items:[0][2]int,tag:str,..S},{items:[0][2]int,tag:str,..S}))->int{first(value)}
pub fn test_native(){let left:[0][2]int=[];let right:[0][2]int=[];assert(forward((.{items:left,tag:"same"},.{items:right,tag:"same"}))==0)}
