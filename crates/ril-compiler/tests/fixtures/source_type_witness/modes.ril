type Cell={mut value:int}
fn bump(mut cell:Cell)&mut{cell.value+=1}
fn identity<T>(value:T)->T{value}
fn number(value:int=7)->int{value}
pub fn test_native(){
    let action=identity(bump)
    let mut cell=Cell.{value:1}
    action(mut cell)
    assert(cell.value==2)
    let supplied=identity(number)
    assert(supplied()==7)
}
