use ril/io
type Reader={scratch:Immut<[2]u8>,mut calls:int}
fn read(mut current:Reader,limit:int)->Result<Io::ReadChunk,Io::IoError>&mut{
    current.calls+=1
    assert(current.scratch[0]==1u8)
    Ok(.{data:b"",end:true})
}
pub fn test_native(){
    let backing:[2]u8=[1u8,2u8]
    let expected=1u8
    let mut reader=Reader.{scratch:backing,calls:0}
    assert(Io::read_all(mut reader,.{read:read}) is Ok(_))
    assert(reader.calls==1 && len(reader.scratch)==2 && backing[0]==expected)
}
