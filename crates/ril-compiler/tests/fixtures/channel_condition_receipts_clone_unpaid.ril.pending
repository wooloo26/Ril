use ril/concurrent::{scope}
use ril/concurrent/channel

fn unpaid(value:Option<Result<int,str>>)->Result<(),Concurrent::TaskFault> @Async{
    scope \mut s->{
        match value{
            Some(inner)->{
                assert(inner is Ok(_)|Err(_))
                let copied=clone(inner)
                let (mut tx,mut rx)=Channel::bounded<Result<int,str>>(1)
                assert(Channel::send(mut tx,copied) is Ok())
                match Channel::recv(mut rx){Ok(_)->(),Err(_)->panic("receive")}
                Channel::close(tx)
                Channel::close(rx)
            },
            None->()
        }
        let child=s.fork(\->())
        assert(child.join() is Ok()|Err(_))
        Ok()
    }
}
