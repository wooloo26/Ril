meta fn left(left:int=1)->int{left}
meta fn right(right:int=2)->int{right}
meta fn second<T>(first:T,second:T)->T{second}
meta let ANSWER={
    let pending:Result<int,str>=Ok(7)
    assert(pending is Ok(_))
    let selected=second(left,right)
    assert(selected()==2)
    selected(right:7)
}
meta let _=assert(ANSWER==7)
pub fn test_native() &{ANSWER}{assert(ANSWER==7)}
