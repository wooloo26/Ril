use ril/concurrent::{scope}
use ril/concurrent/channel
fn publish(mut endpoint:Channel::Sender<Result<int,str>>,value:Result<int,str>,choice:bool)->Result<(),Channel::ChannelError> @Fiber &mut{
    let sent=Channel::send(mut endpoint,value)
    assert(sent is Ok())
    if choice {return sent}else{return Err(Channel::ChannelError::Closed)}
}
pub fn test_native() @Async{
    let result=scope \mut s->{
        let task=s.fork(\->())
        assert(task.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Result<int,str>>(1)
        let payload:Result<int,str>=Ok(7)
        let sent=publish(mut tx,payload,false)
        match sent{
            Ok()->{let received=Channel::recv(mut rx);match received{Ok(value)->assert(value is Ok(7)|Err(_)),Err(_)->panic("receive failed")}},
            Err(_)->assert(payload is Ok(7)|Err(_))
        }
        let ticket=Channel::detach(mut rx)
        let restored=Channel::attach(ticket)
        Channel::close(tx)
        Channel::close(restored)
        Ok()
    }
    assert(result is Ok()|Err(_))
}
