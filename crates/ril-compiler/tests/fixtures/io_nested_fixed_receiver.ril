use ril/io
type Reader={scratch:([2]u8,[0][3]int),mut calls:int}
fn read(mut reader:Reader,limit:int)->Result<Io::ReadChunk,Io::IoError>&mut{
    reader.calls+=1
    reader.scratch.0[0]=9u8
    assert(len(reader.scratch.1)==0)
    Ok(.{data:b"",end:true})
}
pub fn test_native(){
    let mut reader=Reader.{scratch:([1u8,2u8],[]),calls:0}
    let result=Io::read_all(mut reader,.{read:read})
    match result{Ok(data)->assert(data==b""),Err(_)->panic("read")}
    assert(reader.calls==1 && reader.scratch.0[0]==9u8)
}
