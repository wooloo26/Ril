use ril/concurrent::{scope}
use ril/concurrent/channel

fn consume(value:Option<int>)->Result<(),Concurrent::TaskFault> @Async{
    scope \mut s->{
        let child=s.fork(\->())
        assert(child.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Option<int>>(1)
        assert(Channel::send(mut tx,value) is Ok())
        assert(Channel::recv(mut rx) is Ok(_))
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
}

pub fn test_native() @Async{
    assert(consume(Some(7)) is Ok()|Err(_))
    assert(consume(None) is Ok()|Err(_))
}
