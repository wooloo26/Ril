use ril/concurrent::{scope}
use ril/concurrent/channel
fn consume(value:Immut<[str:Result<int,str>]>)->Result<(),Concurrent::TaskFault> @Async{
    scope \mut s->{
        let task=s.fork(\->())
        assert(task.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Immut<[str:Result<int,str>]>>(1)
        assert(Channel::send(mut tx,value) is Ok())
        match Channel::recv(mut rx){Ok(business)->assert(business["a"] is Some(Ok(_)|Err(_))|None),Err(_)->panic("receive")}
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
}
pub fn test_native(){}
