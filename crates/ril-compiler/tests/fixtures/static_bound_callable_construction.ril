meta fn right(right:int=2)->int{right}
meta fn pass<T:{id:i8,..R}>(value:T)->T{value}
meta let ANSWER={
    let pending:Result<int,str>=Ok(7)
    assert(pending is Ok(_))
    let carrier=pass(.{id:1,handler:right})
    carrier.handler()
}
meta let _=assert(ANSWER==2)
pub fn test_native() &{ANSWER}{assert(ANSWER==2)}
