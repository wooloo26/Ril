meta fn echo<n:int>()->Result<int,str>{Ok(n)}
meta fn block_shadow<n:int>()->Result<int,str>{
    {let n=11;let local:Result<int,str>=Ok(n);assert(local is Ok(_)|Err(_));()}
    echo<n>()
}
meta fn pattern_shadow<n:int>()->Result<int,str>{
    match Some(11){
        Some(n)->{let local:Result<int,str>=Ok(n);assert(local is Ok(_)|Err(_));()},
        None->()
    }
    echo<n>()
}
meta fn loop_shadow<n:int>()->Result<int,str>{
    for [11] as n{let local:Result<int,str>=Ok(n);assert(local is Ok(_)|Err(_))}
    echo<n>()
}
meta let ANSWER={
    let a=block_shadow<7>()
    let b=pattern_shadow<7>()
    let c=loop_shadow<7>()
    let x=match a{Ok(value)->value,Err(_)->0}
    let y=match b{Ok(value)->value,Err(_)->0}
    let z=match c{Ok(value)->value,Err(_)->0}
    x+y+z
}
meta let _=assert(ANSWER==21)
pub fn test_native() &{ANSWER}{assert(ANSWER==21)}
