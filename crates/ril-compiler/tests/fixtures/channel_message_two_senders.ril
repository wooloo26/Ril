use ril/concurrent::{scope}
use ril/concurrent/channel
fn publish(mut endpoint:Channel::Sender<Result<int,str>>,value:Result<int,str>)->Result<(),Channel::ChannelError> @Fiber &mut{
    Channel::send(mut endpoint,value)
}
fn relay(mut endpoint:Channel::Sender<Result<int,str>>,value:Result<int,str>)->Result<(),Channel::ChannelError> @Fiber &mut{
    publish(mut endpoint,value)
}
pub fn test_native() @Async{
    let result=scope \mut s->{
        let (tx,mut rx)=Channel::bounded<Result<int,str>>(2)
        let first=s.fork(\->{
            let mut own=clone(tx)
            let payload:Result<int,str>=Ok(11)
            assert(relay(mut own,payload) is Ok())
            Channel::close(own)
        })
        let second=s.fork(\->{
            let mut own=clone(tx)
            let payload:Result<int,str>=Err("second")
            assert(relay(mut own,payload) is Ok())
            Channel::close(own)
        })
        assert(first.join() is Ok()|Err(_))
        assert(second.join() is Ok()|Err(_))
        match Channel::recv(mut rx){Ok(value)->assert(value is Ok(_)|Err(_)),Err(_)->panic("first")}
        match Channel::recv(mut rx){Ok(value)->assert(value is Ok(_)|Err(_)),Err(_)->panic("second")}
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
    assert(result is Ok()|Err(_))
}
