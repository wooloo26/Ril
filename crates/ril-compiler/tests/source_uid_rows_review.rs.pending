//! Independent unregistered Source regressions for genuine Type transport,
//! finite row composition, and declaration-only default reception.
//! No Cargo or semantic/native execution has been performed for this file.
use ril_compiler::{CheckOptions, CompilationOutcome, Session};

fn positive(source: &str) {
    for layout in ["pointer32", "pointer64"] {
        let program = Session::with_options(
            source.as_bytes().to_vec(),
            CheckOptions {
                target: layout.into(),
                ..Default::default()
            },
        )
        .verify()
        .unwrap_or_else(|outcome| panic!("{layout}\n{source}\n{outcome:?}"));
        ril_compiler::lower::lower_core(&program).unwrap();
    }
}

fn type_conflict(source: &str) {
    for layout in ["pointer32", "pointer64"] {
        let outcome = Session::with_options(
            source.as_bytes().to_vec(),
            CheckOptions {
                target: layout.into(),
                ..Default::default()
            },
        )
        .check();
        assert!(
            matches!(&outcome,CompilationOutcome::Rejected{diagnostics}
            if diagnostics.iter().any(|diagnostic| diagnostic.code == "E0301")),
            "{layout}\n{source}\n{outcome:?}"
        );
    }
}

#[test]
fn declaration_probe_checks_the_original_default_without_a_call() {
    for source in [
        "fn dynamic()->[]int{[7,9]}\nfn unused(value:[2]int=dynamic()){}",
        "fn triple(values:[3]int)->int{0}\nfn unused(callback:fn([2]int)->int=triple){}",
        "type Holder={item:[0][2]int}\nfn old()->[0][3]int{[]}\nfn unused(value:Holder=.{item:old()}){}",
    ] {
        type_conflict(source);
    }
}

#[test]
fn declaration_defaults_keep_fresh_context_and_real_earlier_formal_assumptions() {
    for source in [
        "fn unused(value:[2]int=[7,9]){}",
        "fn unused(first:[2]int,second:[2]int=first){}",
        "fn direct(values:[2]int)->int{0}\nfn unused(callback:fn([2]int)->int=direct){}",
    ] {
        positive(source);
    }
}

#[test]
fn bare_type_forwarding_uses_its_actual_formal_and_return_sources() {
    positive(
        "fn id<T>(value:T)->T{value}\nfn forward<U>(value:U)->U{id<U>(value)}\nfn example(){let values:[2]int=[7,9];let received:[2]int=forward(values)}",
    );
    positive(
        "fn first<U,T:{items:[2]U,..R}>(value:(T,int))->U{value.0.items[0]}\nfn forward<U,S>(value:({items:[2]U,tag:str,..S},int))->U{first<U>(value)}\nfn example(){let values:[2]int=[7,9];assert(forward((.{items:values,tag:\"same\"},0))==7)}",
    );
    type_conflict("fn wrong<U,V>(value:U)->V{value}");
}

#[test]
fn closed_row_composition_preserves_a_zero_outer_array_and_callback_source() {
    positive(
        "fn same(value:int)->int{value}\nfn pass<U,T:{items:[2]U,..R}>(value:T)->T{value}\nfn forward<U,S>(value:{items:[2]U,tag:str,..S})->{items:[2]U,tag:str,..S}{pass<U>(value)}\nfn outer<U,S>(value:{items:[2]U,tag:str,..S})->{items:[2]U,tag:str,..S}{forward<U,S>(value)}\nfn example(){let values:[2]int=[7,9];let extra:[0][3]int=[];let received=outer(.{items:values,tag:\"same\",extra:extra,action:same});assert(received.action(received.items[0])==7)}",
    );
}

#[test]
fn an_open_row_or_static_key_does_not_become_a_closed_type_proof() {
    for source in [
        "fn forget<R>(value:{id:int,..R})->{id:int}{value}\nfn example(){let value=forget<{}>(.{id:1})}",
        "fn unused<T>()->int{0}\nfn forward<T,K:keyof T>(record:T,key:K)->int{unused<K>()}",
    ] {
        let outcome = Session::new(source.as_bytes().to_vec()).check();
        // This is explicitly a nonauthorization guard. NI is not counted as
        // negative language conformance until its required source proof exists.
        assert!(
            !matches!(
                &outcome,
                CompilationOutcome::Accepted { .. } | CompilationOutcome::Built { .. }
            ),
            "{source}\n{outcome:?}"
        );
    }
}
