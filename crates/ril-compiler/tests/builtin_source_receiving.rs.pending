//! Pending direct-builtin receiving gate. No OS operation is executed.
use ril_compiler::{CheckOptions, CompilationOutcome, Session};

fn session(source: &str, target: &str) -> Session {
    Session::with_options(
        source.as_bytes().to_vec(),
        CheckOptions {
            target: target.into(),
            ..CheckOptions::default()
        },
    )
}

#[test]
fn four_actual_builtin_headers_receive_open_or_declared_fiber_bounds() {
    for target in ["pointer32", "pointer64"] {
        for source in [
            "fn example(){let input:Io::ReadOps<File::Handle>=.{read:File::read_chunk};let output:Io::WriteOps<File::Handle>=.{write:File::write};let wait:fn(mut Process::Child)->Result<Process::ExitStatus,Process::ProcessError>=Process::wait;let terminate:fn(mut Process::Child)->Result<(),Process::ProcessError>=Process::terminate}",
            "fn example(){let read:fn(mut File::Handle,int)->Result<Io::ReadChunk,Io::IoError>@Fiber&mut=File::read_chunk;let write:fn(mut File::Handle,bytes)->Io::WriteProgress@Fiber&mut=File::write}",
        ] {
            let verified = session(source, target)
                .verify()
                .unwrap_or_else(|outcome| panic!("{target}: {source}\n{outcome:?}"));
            ril_compiler::lower::lower_core(&verified).unwrap();
        }
    }
}

#[test]
fn builtin_mutable_formals_cannot_be_received_as_readonly_parameters() {
    for target in ["pointer32", "pointer64"] {
        let source =
            "fn example(){let write:fn(File::Handle,bytes)->Io::WriteProgress=File::write}";
        let outcome = session(source, target).check();
        assert!(
            matches!(&outcome, CompilationOutcome::Rejected { diagnostics } if diagnostics.iter().any(|diagnostic|diagnostic.code=="E0301")),
            "{target}: {outcome:?}"
        );
    }
}

#[test]
fn an_explicit_closed_effect_row_is_rejected_by_real_latent_builtin_probe() {
    for target in ["pointer32", "pointer64"] {
        let source = "fn example(){let read:fn(mut File::Handle,int)->Result<Io::ReadChunk,Io::IoError>@{}&mut=File::read_chunk}";
        let outcome = session(source, target).check();
        assert!(
            matches!(&outcome, CompilationOutcome::Rejected { diagnostics } if diagnostics.iter().any(|diagnostic|diagnostic.code=="E0534")),
            "{target}: {outcome:?}"
        );
    }
}

#[test]
fn unknown_rows_and_empty_stored_callable_arrays_do_not_get_builtin_receipts() {
    for target in ["pointer32", "pointer64"] {
        for source in [
            "fn example(){let read:fn(mut File::Handle,int)->Result<Io::ReadChunk,Io::IoError>@Missing&mut=File::read_chunk}",
            "fn example(){let stored:[0]fn()->int@Fiber=[];let closed:[0]fn()->int@{}=stored}",
        ] {
            let outcome = session(source, target).check();
            assert!(
                matches!(
                    &outcome,
                    CompilationOutcome::Rejected { .. } | CompilationOutcome::NotImplemented { .. }
                ),
                "{target}: {source}\n{outcome:?}"
            );
            // This is a non-authorization assertion. NI is not reported as a
            // completed negative semantic case or native execution.
        }
    }
}
