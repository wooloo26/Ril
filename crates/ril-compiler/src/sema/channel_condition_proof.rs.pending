//! Unregistered pure structural helper proposal. The independent Source reader
//! must supply actual canonical head resolution and a Source-grounded Result
//! subject; recorded constant/type/name metadata cannot manufacture premises.
use ril_syntax::ast::{Pattern, PatternKind};

#[derive(Clone, Copy, PartialEq, Eq)]
enum CanonicalResultHead {
    Ok,
    Err,
}

fn exhaustive_wildcard_result(
    pattern: &Pattern,
    resolve: impl Fn(&[String]) -> Option<CanonicalResultHead>,
) -> Option<bool> {
    let PatternKind::Alternative(alternatives) = &pattern.kind else {
        return None;
    };
    if alternatives.len() != 2 {
        return None;
    }
    let mut ok = false;
    let mut error = false;
    for alternative in alternatives {
        let PatternKind::Constructor {
            path, arguments, ..
        } = &alternative.kind
        else {
            return None;
        };
        if !matches!(
            arguments.as_slice(),
            [Pattern {
                kind: PatternKind::Wildcard,
                ..
            }]
        ) {
            return None;
        }
        match resolve(path)? {
            CanonicalResultHead::Ok => ok = true,
            CanonicalResultHead::Err => error = true,
        }
    }
    (ok && error).then_some(true)
}
