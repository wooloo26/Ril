//! Unregistered independent review draft. Do not include this module yet.
//! Intended as a cfg(test) child of channel_condition_source.rs, where the
//! Source-only reconstruction helper is visible. No case below has been run.
//! These are Source/receipt nonauthorization tests, not end-to-end evidence
//! that any formerly rejected channel program has been repaired.
use super::*;
use crate::sema::{
    SemanticFacts,
    channel_messages::{ChannelAction, ChannelGuard, GuardLiteral},
};

const PREDICATE: &str = "value is Ok(_)|Err(_)";

fn source_proof(text: &str, predicate: &str) -> Option<ResultSource> {
    let parsed = ril_syntax::parse(text);
    assert!(parsed.is_ok(), "{:?}", parsed.diagnostics);
    let header = parsed
        .program
        .statements
        .iter()
        .find_map(|statement| match &statement.kind {
            StmtKind::Function(function) if function.name == "example" => Some(function),
            _ => None,
        })
        .unwrap();
    let start = text.find(predicate).unwrap() as u32;
    result_source(
        &parsed.program,
        header,
        &[],
        Span {
            file: ril_compiler_core::source::FileId(0),
            start,
            end: start + predicate.len() as u32,
        },
        &mut 65_536,
    )
    .unwrap()
}

fn assert_no_normal_entry_theorem(proof: Option<ResultSource>) {
    assert!(proof.is_none_or(|proof| {
        proof
            .controls
            .iter()
            .any(|control| matches!(control, SourceControl::UnprovedPrefix))
    }));
}

#[test]
fn later_call_tuple_and_array_operands_cannot_skip_a_nontrivial_normal_prefix() {
    for expression in [
        "collect(may_abort(flag), value is Ok(_)|Err(_))",
        "(may_abort(flag), value is Ok(_)|Err(_))",
        "[{may_abort(flag);true}, value is Ok(_)|Err(_)]",
    ] {
        let text = format!(
            "fn may_abort(flag:bool){{if flag{{panic(\"aborted\")}}}}\nfn collect(first:(),second:bool){{()}}\nfn example(flag:bool,value:Result<int,str>){{let ignored={expression}}}"
        );
        assert_no_normal_entry_theorem(source_proof(&text, PREDICATE));
    }
}

#[test]
fn later_some_arm_cannot_forget_guarded_or_partially_matching_predecessors() {
    for text in [
        "fn example(flag:bool,other:Option<Result<int,str>>){match other{Some(_) if flag->(),Some(inner)->assert(inner is Ok(_)|Err(_)),None->()}}",
        "fn example(other:Option<Result<int,str>>){match other{Some(Err(_))->(),Some(inner)->assert(inner is Ok(_)|Err(_)),None->()}}",
    ] {
        assert_no_normal_entry_theorem(source_proof(text, "inner is Ok(_)|Err(_)"));
    }
}

fn optional_projection(guard: &ChannelGuard) -> ChannelGuard {
    ChannelGuard {
        terms: guard
            .terms
            .iter()
            .map(|term| {
                term.iter()
                    .copied()
                    .filter(|literal| matches!(literal, GuardLiteral::Optional { .. }))
                    .collect()
            })
            .collect(),
        incomplete: guard.incomplete,
    }
    .normalized()
    .expect("a finite guard projection stays normalized")
}

fn widened_receipts(
    facts: &mut SemanticFacts,
) -> Vec<crate::sema::channel_messages::ChannelMessageFact> {
    // Deliberately preserve Optional presence while weakening all physical
    // receipt/head guards together. A Some-only check must not stand in for
    // an earlier guarded arm's no-match proof or operand normal completion.
    for event in &mut facts.channel_messages {
        event.guard = optional_projection(&event.guard);
    }
    for exit in &mut facts.channel_exits {
        exit.guard = optional_projection(&exit.guard);
    }
    facts
        .channel_messages
        .iter()
        .filter(|event| matches!(event.action, ChannelAction::ConditionEvaluated { .. }))
        .cloned()
        .collect()
}

#[test]
fn physical_receipts_cannot_recover_the_missing_path_when_guards_are_jointly_weakened() {
    for body in [
        "let ignored=(may_abort(flag),value is Ok(_)|Err(_));Ok()",
        "match other{Some(_) if flag->(),Some(inner)->assert(inner is Ok(_)|Err(_)),None->()};Ok()",
    ] {
        let text = format!(
            "fn may_abort(flag:bool){{if flag{{panic(\"aborted\")}}}}\nfn example(flag:bool,value:Result<int,str>,other:Option<Result<int,str>>)->Result<(),Concurrent::TaskFault> @Async{{Concurrent::scope \\mut s->{{{body}}}}}"
        );
        let verified = crate::Session::new(text.as_bytes().to_vec())
            .verify()
            .unwrap();
        let mut facts = verified.facts().clone();
        let receipts = widened_receipts(&mut facts);
        assert!(
            !receipts.is_empty(),
            "the case must contain real emitted observations"
        );
        for event in receipts {
            assert_eq!(
                super::super::Analysis::new(&facts).truth(&event).unwrap(),
                None
            );
        }
    }
    // This deliberately invokes only the new truth theorem. Full validator
    // mutation needs a separate real business-channel history and must check
    // all coverage/receive-source metadata jointly; no such pass is claimed.
}
