#[test]
fn preserved_nine_scope_source_must_verify_completely_before_core_lowering() {
    let source =
        ril_test::case_source("tests/regressions/channels.ril::channel-message-optional-callback-scope-budget");
    let verified = crate::Session::new(source.as_bytes().to_vec())
        .verify()
        .unwrap_or_else(|error| panic!("original nine-scope program: {error:?}"));
    crate::lower::lower_core(&verified).unwrap();
}
