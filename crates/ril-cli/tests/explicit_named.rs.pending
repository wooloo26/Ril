//! Unregistered until Source/Core gates accept the unchanged explicit sources.
#[path = "support/native_probe.rs"]
mod native_probe;

#[test]
fn immediate_named_type_prefixes_execute_the_real_original_programs() {
    for (source, name) in [
        (
            include_str!(
                "../../ril-compiler/tests/fixtures/record_bounds/pending/scoped_symbolic_array_explicit.ril"
            ),
            "explicit fixed symbolic member",
        ),
        (
            include_str!(
                "../../ril-compiler/tests/fixtures/record_bounds/pending/scoped_symbolic_empty_explicit.ril"
            ),
            "explicit empty outer symbolic member",
        ),
        (
            include_str!(
                "../../ril-compiler/tests/fixtures/record_bounds/pending/scoped_symbolic_callable_explicit.ril"
            ),
            "explicit symbolic callable member",
        ),
        (
            include_str!(
                "../../ril-compiler/tests/fixtures/record_bounds/pending/explicit_named_prefix.ril.pending"
            ),
            "unused explicit Type and partial prefix",
        ),
    ] {
        native_probe::executes(source, name);
    }
}
