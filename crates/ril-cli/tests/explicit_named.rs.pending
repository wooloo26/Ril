//! Unregistered until Source/Core gates accept the unchanged explicit sources.
#[path = "support/native_probe.rs"]
mod native_probe;

#[test]
fn immediate_named_type_prefixes_execute_the_real_original_programs() {
    for (source, name) in [
        (
            ril_test::case_source(
                "tests/regressions/record-bounds.ril::scoped-symbolic-array-explicit",
            ),
            "explicit fixed symbolic member",
        ),
        (
            ril_test::case_source(
                "tests/regressions/record-bounds.ril::scoped-symbolic-empty-explicit",
            ),
            "explicit empty outer symbolic member",
        ),
        (
            ril_test::case_source(
                "tests/regressions/record-bounds.ril::scoped-symbolic-callable-explicit",
            ),
            "explicit symbolic callable member",
        ),
        (
            ril_test::case_source("tests/regressions/record-bounds.ril::explicit-named-prefix"),
            "unused explicit Type and partial prefix",
        ),
    ] {
        native_probe::executes(source, name);
    }
}
