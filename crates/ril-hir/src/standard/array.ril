pub fn get<T>(xs: []T, index: int) &return(xs) -> new ?T {
    if index < 0 || index >= len(xs) {
        None
    } else {
        Some(xs[index])
    }
}

pub fn at<T>(xs: []T, index: int) &return(xs) -> new ?T {
    if index < 0 || index >= len(xs) {
        None
    } else {
        Some(xs[index])
    }
}

pub fn contains<T>(xs: []T, target: T) -> bool {
    var i = 0
    while i < len(xs) {
        if xs[i] == target {
            return true
        }
        i += 1
    }
    false
}

pub fn map<T, U>(xs: []T, f: fn(T) -> U) -> new []U {
    let mut out: []U = []
    var i = 0
    while i < len(xs) {
        Array::push(mut out, f(xs[i]))
        i += 1
    }
    new out
}

pub fn filter<T>(xs: []T, pred: fn(T) -> bool) &return(xs) -> new []T {
    let mut out: []T = []
    var i = 0
    while i < len(xs) {
        if pred(xs[i]) {
            Array::push(mut out, xs[i])
        }
        i += 1
    }
    new out
}
