-- [case: known-vectors, run-pass]
-- spec: STD#bytes-binary-encoding-and-digests
use ril/encoding/hex

pub fn test_known_vectors() {
    assert(Hex::encode(b"\x00\xAF\xFF") == "00afff")
    assert(Hex::decode("00AfFF") is Ok(b"\x00\xAF\xFF"))
    assert(Hex::decode("") is Ok(b""))
    assert(Hex::decode("0") is Err(.{ offset: 0 }))
    assert(Hex::decode("a0g0") is Err(.{ offset: 2 }))
    assert(Hex::decode("00 ") is Err(.{ offset: 2 }))
}
