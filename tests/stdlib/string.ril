-- [case: byte-length, run-pass]
-- spec: STD#string
pub fn test_byte_length() {
    assert(len("Aé🙂") == 3 && String::byte_len("Aé🙂") == 7)
}

-- [case: concat-join, run-pass]
-- spec: STD#string
pub fn test_concat_join() {
    assert(String::concat("a", "b") == "ab" && String::join(["a", "b"], "-") == "a-b")
}

-- [case: contains, run-pass]
-- spec: STD#string
pub fn test_contains() {
    assert(String::contains("abc", "") && String::contains("abc", "bc"))
}

-- [case: find, run-pass]
-- spec: STD#string
pub fn test_find() {
    assert(String::find("é🙂é", "🙂") == Some(1) && String::find("abc", "") == Some(0))
}

-- [case: lines, run-pass]
-- spec: STD#string
pub fn test_lines() {
    assert(String::lines("a\r\nb\n") == ["a", "b"] && String::lines("") == [])
}

-- [case: offsets, run-pass]
-- spec: STD#string
pub fn test_offsets() {
    assert(String::byte_offset("Aé🙂", 2) == Some(3) && String::scalar_offset("Aé🙂", 2) == None && String::scalar_offset("Aé🙂", 7) == Some(3))
}

-- [case: prefix-suffix, run-pass]
-- spec: STD#string
pub fn test_prefix_suffix() {
    assert(String::starts_with("abc", "") && String::ends_with("abc", "bc"))
}

-- [case: replace-boundaries, run-pass]
-- spec: STD#string
pub fn test_replace_boundaries() {
    assert(String::replace("ab", "", "-") == "-a-b-")
}

-- [case: replace-nonoverlap, run-pass]
-- spec: STD#string
pub fn test_replace_nonoverlap() {
    assert(String::replace("aaa", "aa", "x") == "xa")
}

-- [case: scalar-at, run-pass]
-- spec: STD#string
pub fn test_scalar_at() {
    assert(String::scalar_at("Aé🙂", 1) == Some(233u32) && String::scalar_at("a", -1) == None)
}

-- [case: scalars, run-pass]
-- spec: STD#string
pub fn test_scalars() {
    assert(String::scalars("Aé") == [65u32, 233u32])
}

-- [case: slice, run-pass]
-- spec: STD#string
pub fn test_slice() {
    assert(String::slice("abc", 2, 1) == None && String::slice("abc", 3, 3) == Some(""))
}

-- [case: split-empty, run-pass]
-- spec: STD#string
pub fn test_split_empty() {
    assert(String::split("", "") == [])
}

-- [case: split-empty-fields, run-pass]
-- spec: STD#string
pub fn test_split_empty_fields() {
    assert(String::split("a,,", ",") == ["a", "", ""])
}

-- [case: split-scalars, run-pass]
-- spec: STD#string
pub fn test_split_scalars() {
    assert(String::split("é🙂", "") == ["é", "🙂"])
}

-- [case: standalone-cr, run-pass]
-- spec: STD#string
pub fn test_standalone_cr() {
    assert(String::lines("a\rb") == ["a\rb"])
}

-- [case: trim, run-pass]
-- spec: STD#string
pub fn test_trim() {
    assert(String::trim(" \tvalue\n") == "value")
}

-- [case: utf8, run-pass]
-- spec: STD#string
pub fn test_utf8() {
    assert(String::utf8("é") == b"\xC3\xA9")
}
