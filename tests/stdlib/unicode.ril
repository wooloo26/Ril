--@ case: reject-continuation
--@ mode: run-pass
--@ spec: STD#unicode-and-stringbuilder
--@ entry: test_reject_continuation
--@ file: reject-continuation.ril
use ril/unicode

pub fn test_reject_continuation() {
    assert(Unicode::decode_utf8(b"a\x80") is Err(.{ offset: 1 }))
}
--@ end-file
--@ end-case

