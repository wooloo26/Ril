-- [case: foundational-operations, run-pass]
-- spec: SPEC#built-in-foundational-operations
-- spec: STD#prelude-and-module-index
type UserId(int)

pub fn test_foundational_operations() {
    let value = UserId(7)
    assert(inner(value) == 7)
    let original = [1, 2]
    let mut detached = clone(original)
    detached !> Array::push(3)
    let snapshot = clone_immut(detached)
    detached !> Array::push(4)
    assert(original == [1, 2] && snapshot == [1, 2, 3])
    let revised = .{ theme: "dark" } |> derive \mut draft -> { draft.theme = "light" }
    assert(revised.theme == "light")
}
