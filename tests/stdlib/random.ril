-- [case: entropy-empty, run-pass]
-- spec: STD#time-and-randomness
-- requires: entropy
use ril/random

pub fn test_entropy_empty() @Fiber {
    assert(Random::entropy(0) is Ok(b""))
}

-- [case: entropy-nonempty, run-pass]
-- spec: STD#time-and-randomness
-- requires: entropy
use ril/random

pub fn test_entropy_nonempty() @Fiber {
    match Random::entropy(16) {
        Ok(data) -> assert(len(data) == 16),
        Err(error) -> { let _ = error.kind },
    }
}

-- [case: negative-entropy-safe, run-pass]
-- spec: STD#time-and-randomness
-- companion: negative-entropy
-- requires: entropy
use ril/random

pub fn test_negative_entropy_safe() @Fiber {
    assert(Random::entropy(0) is Ok(b""))
}

-- [case: negative-entropy, run-panic]
-- spec: STD#time-and-randomness
-- companion: negative-entropy-safe
-- requires: entropy
-- Panics: negative entropy
use ril/random

pub fn test_negative_entropy() @Fiber {
    let _ = Random::entropy(-1) ?? \_error -> b""
}

-- [case: seed-and-clone, run-pass]
-- spec: STD#time-and-randomness
-- seed: 0
use ril/random

pub fn test_seed_and_clone() {
    let mut rng = Random::seeded(0u64)
    assert(Random::next_u64(mut rng) == 0xe220a8397b1dcdafu64)
    let mut independent = clone(rng)
    assert(Random::next_u64(mut rng) == Random::next_u64(mut independent))
    for 0..100 as _index { assert(Random::below(mut rng, 7u64) < 7u64) }
}

-- [case: zero-upper-safe, run-pass]
-- spec: STD#time-and-randomness
-- companion: zero-upper
use ril/random

pub fn test_zero_upper_safe() {
    let mut rng = Random::seeded(0u64)
    assert(Random::below(mut rng, 1u64) == 0u64)
}

-- [case: zero-upper, run-panic]
-- spec: STD#time-and-randomness
-- companion: zero-upper-safe
-- Panics: zero upper
use ril/random

pub fn test_zero_upper() {
    let mut rng = Random::seeded(0u64)
    let _ = Random::below(mut rng, 0u64)
}
