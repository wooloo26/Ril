--@ case: mutable-callback
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_mutable_callback
--@ file: mutable-callback.ril
pub fn test_mutable_callback() {
    let empty: []int = []
    var total = 0
    let mut visit = \n -> { total += n }
    Array::for_each([1, 2, 3], mut visit)
    assert(total == 6)
}
--@ end-file
--@ end-case

--@ case: mutation
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_mutation
--@ file: mutation.ril
pub fn test_mutation() {
    let empty: []int = []
    let mut values: []int = []
    values !> Array::push(2)
    values !> Array::insert(0, 1)
    values !> Array::insert(2, 3)
    assert(values == [1, 2, 3])
    assert(Array::remove(mut values, 1) == 2)
    assert(Array::pop(mut values) == Some(3))
    values !> Array::truncate(10)
    assert(values == [1])
    values !> Array::truncate(0)
    assert(Array::pop(mut values) == None)
}
--@ end-file
--@ end-case

--@ case: queries
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_queries
--@ file: queries.ril
pub fn test_queries() {
    let empty: []int = []
    assert(Array::first([1, 2]) == Some(1))
    assert(Array::first(empty) == None)
    assert(Array::get([1], -1) == None && Array::get([1], 1) == None)
    assert(Array::get([1], 0) == Some(1))
    assert(Array::contains([1, 2], 2) && !Array::contains(empty, 1))
}
--@ end-file
--@ end-case

