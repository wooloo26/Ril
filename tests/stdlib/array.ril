-- [case: constructive-operations, run-pass]
-- spec: STD#array
pub fn test_constructive_operations() {
    let empty: []int = []
    assert(Array::reverse([1, 2]) == [2, 1])
    assert(Array::concat([1], [2]) == [1, 2])
    assert(Array::map([1, 2], \n -> n * 2) == [2, 4])
    assert(Array::filter([1, 2], \n -> n > 1) == [2])
    assert(Array::fold([1, 2], 0, \sum, n -> sum + n) == 3)
}

-- [case: insert-negative-safe, run-pass]
-- spec: STD#array
-- companion: insert-negative
pub fn test_insert_negative_safe() {
    let mut values = [0]
    Array::insert(mut values, 0, 1)
}

-- [case: insert-negative, run-panic]
-- spec: STD#array
-- companion: insert-negative-safe
-- Panics: insert negative
pub fn test_insert_negative() {
    let mut values = [0]
    Array::insert(mut values, -1, 1)
}

-- [case: insert-past-end-safe, run-pass]
-- spec: STD#array
-- companion: insert-past-end
pub fn test_insert_past_end_safe() {
    let mut values = [0]
    Array::insert(mut values, 1, 1)
}

-- [case: insert-past-end, run-panic]
-- spec: STD#array
-- companion: insert-past-end-safe
-- Panics: insert past end
pub fn test_insert_past_end() {
    let mut values = [0]
    Array::insert(mut values, 2, 1)
}

-- [case: mutable-callback, run-pass]
-- spec: STD#array
pub fn test_mutable_callback() {
    let empty: []int = []
    var total = 0
    let mut visit = \n -> { total += n }
    Array::for_each([1, 2, 3], mut visit)
    assert(total == 6)
}

-- [case: mutation, run-pass]
-- spec: STD#array
pub fn test_mutation() {
    let empty: []int = []
    let mut values: []int = []
    values !> Array::push(2)
    values !> Array::insert(0, 1)
    values !> Array::insert(2, 3)
    assert(values == [1, 2, 3])
    assert(Array::remove(mut values, 1) == 2)
    assert(Array::pop(mut values) == Some(3))
    values !> Array::truncate(10)
    assert(values == [1])
    values !> Array::truncate(0)
    assert(Array::pop(mut values) == None)
}

-- [case: queries, run-pass]
-- spec: STD#array
pub fn test_queries() {
    let empty: []int = []
    assert(Array::first([1, 2]) == Some(1))
    assert(Array::first(empty) == None)
    assert(Array::get([1], -1) == None && Array::get([1], 1) == None)
    assert(Array::get([1], 0) == Some(1))
    assert(Array::contains([1, 2], 2) && !Array::contains(empty, 1))
}

-- [case: remove-end-safe, run-pass]
-- spec: STD#array
-- companion: remove-end
pub fn test_remove_end_safe() {
    let mut values = [0]
    let _ = Array::remove(mut values, 0)
}

-- [case: remove-end, run-panic]
-- spec: STD#array
-- companion: remove-end-safe
-- Panics: remove end
pub fn test_remove_end() {
    let mut values = [0]
    let _ = Array::remove(mut values, 1)
}

-- [case: short-circuit, run-pass]
-- spec: STD#array
pub fn test_short_circuit() {
    let empty: []int = []
    assert(Array::find([1, 2], \n -> n == 2) == Some(2))
    assert(Array::any([1, 2], \n -> n == 1))
    assert(Array::all([1, 2], \n -> n > 0))
    assert(!Array::any(empty, \n -> true) && Array::all(empty, \n -> false))
    assert(Array::fold(empty, 7, \sum, n -> sum + n) == 7)
}

-- [case: short-circuit-call-count, run-pass]
-- spec: STD#array
pub fn test_short_circuit_call_count() {
    var calls = 0
    let mut predicate = \value: int -> { calls += 1; value == 2 }
    assert(Array::any([1, 2, 3], mut predicate) && calls == 2)
    calls = 0
    assert(Array::find([1, 2, 3], mut predicate) == Some(2) && calls == 2)
}

