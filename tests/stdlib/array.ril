--@ case: short-circuit
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_short_circuit
--@ file: short-circuit.ril
pub fn test_short_circuit() {
    let empty: []int = []
    assert(Array::find([1, 2], \n -> n == 2) == Some(2))
    assert(Array::any([1, 2], \n -> n == 1))
    assert(Array::all([1, 2], \n -> n > 0))
    assert(!Array::any(empty, \n -> true) && Array::all(empty, \n -> false))
    assert(Array::fold(empty, 7, \sum, n -> sum + n) == 7)
}
--@ end-file
--@ end-case

--@ case: short-circuit-call-count
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_short_circuit_call_count
--@ file: short-circuit-call-count.ril
pub fn test_short_circuit_call_count() {
    var calls = 0
    let mut predicate = \value: int -> { calls += 1; value == 2 }
    assert(Array::any([1, 2, 3], mut predicate) && calls == 2)
    calls = 0
    assert(Array::find([1, 2, 3], mut predicate) == Some(2) && calls == 2)
}
--@ end-file
--@ end-case

