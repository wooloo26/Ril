--@ case: constructive-operations
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_constructive_operations
--@ file: constructive-operations.ril
pub fn test_constructive_operations() {
    let empty: []int = []
    assert(Array::reverse([1, 2]) == [2, 1])
    assert(Array::concat([1], [2]) == [1, 2])
    assert(Array::map([1, 2], \n -> n * 2) == [2, 4])
    assert(Array::filter([1, 2], \n -> n > 1) == [2])
    assert(Array::fold([1, 2], 0, \sum, n -> sum + n) == 3)
}
--@ end-file
--@ end-case

