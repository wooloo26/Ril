-- [case: assert-eq-safe, run-pass]
-- spec: STD#testing
-- companion: assert-eq
use ril/test

pub fn test_assert_eq_safe() {
    Test::assert_eq(1, 1)
}

-- [case: assert-eq, run-panic]
-- spec: STD#testing
-- companion: assert-eq-safe
-- Panics: assert eq
use ril/test

pub fn test_assert_eq() {
    Test::assert_eq(1, 2)
}

-- [case: assert-ne-safe, run-pass]
-- spec: STD#testing
-- companion: assert-ne
use ril/test

pub fn test_assert_ne_safe() {
    Test::assert_ne(1, 2)
}

-- [case: assert-ne, run-panic]
-- spec: STD#testing
-- companion: assert-ne-safe
-- Panics: assert ne
use ril/test

pub fn test_assert_ne() {
    Test::assert_ne(1, 1)
}

-- [case: assert-ok-safe, run-pass]
-- spec: STD#testing
-- companion: assert-ok
use ril/test

pub fn test_assert_ok_safe() {
    let value: Result<int, str> = Ok(1)
    let _ = Test::assert_ok(value)
}

-- [case: assert-ok, run-panic]
-- spec: STD#testing
-- companion: assert-ok-safe
-- Panics: assert ok
use ril/test

pub fn test_assert_ok() {
    let value: Result<int, str> = Err("bad")
    let _ = Test::assert_ok(value)
}

-- [case: assert-some-safe, run-pass]
-- spec: STD#testing
-- companion: assert-some
use ril/test

pub fn test_assert_some_safe() {
    let _ = Test::assert_some(Some(1))
}

-- [case: assert-some, run-panic]
-- spec: STD#testing
-- companion: assert-some-safe
-- Panics: assert some
use ril/test

pub fn test_assert_some() {
    let value: ?int = None
    let _ = Test::assert_some(value)
}

-- [case: assertion-helpers, run-pass]
-- spec: STD#testing
use ril/test

pub fn test_assertion_helpers() {
    Test::assert_eq([1, 2], [1, 2])
    Test::assert_ne(1, 2)
    assert(Test::assert_some(Some(3)) == 3)
    let value: Result<int, str> = Ok(4)
    assert(Test::assert_ok(value) == 4)
}

-- [case: fallible-test-entry, run-pass]
-- spec: SPEC#test-conventions-and-execution-protocol
-- spec: STD#testing-examples
use ril/num

pub fn test_fallible_test_entry() -> Result<(), Num::NumError> {
    let value = Num::parse_int("42")?
    assert(value == 42)
    Ok()
}
