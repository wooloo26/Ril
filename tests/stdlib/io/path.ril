-- [case: lexical-components, run-pass]
-- spec: STD#native-strings-and-paths
use ril/os
use ril/path
use ril/order

pub fn test_lexical_components() {
    let path = Path::from_string("src/main.ril")
    assert(Path::extension(path) == Some(Os::from_string("ril")))
    assert(Path::file_name(path) == Some(Os::from_string("main.ril")))
    assert(Path::parent(Path::from_string("one")) == Some(Path::from_string("")))
    assert(Path::file_name(Path::from_string("")) == None)
    assert(Path::extension(Path::from_string(".profile")) == None)
    assert(Path::extension(Path::from_string("a.")) == Some(Os::from_string("")))
    assert(Path::extension(Path::from_string("a.tar.gz")) == Some(Os::from_string("gz")))
}

-- [case: posix-lexical, run-pass]
-- spec: STD#native-strings-and-paths
-- requires: posix
use ril/os
use ril/path
use ril/order

pub fn test_posix_lexical() {
    assert(Path::is_absolute(Path::from_string("/a")))
    assert(!Path::is_absolute(Path::from_string("C:a")))
    assert(Path::join(Path::from_string("/a"), Path::from_string("/b")) == Path::from_string("/b"))
    assert(Path::normalize_lexical(Path::from_string("/a/../../b")) == Path::from_string("/b"))
    assert(Path::normalize_lexical(Path::from_string("a/..")) == Path::from_string("."))
    assert(Path::normalize_lexical(Path::from_string("../../a")) == Path::from_string("../../a"))
}

-- [case: windows-lexical, run-pass]
-- spec: STD#native-strings-and-paths
-- requires: windows
use ril/os
use ril/path
use ril/order

pub fn test_windows_lexical() {
    assert(Path::is_absolute(Path::from_string("C:\\a")))
    assert(!Path::is_absolute(Path::from_string("C:a")))
    assert(Path::join(Path::from_string("C:\\a"), Path::from_string("\\b")) == Path::from_string("C:\\b"))
    assert(Path::join(Path::from_string("C:\\a"), Path::from_string("D:b")) == Path::from_string("D:b"))
    assert(Path::normalize_lexical(Path::from_string("C:/a/../b")) == Path::from_string("C:\\b"))
    let verbatim = Path::from_string("\\\\?\\C:\\a\\..\\b")
    assert(Path::normalize_lexical(verbatim) == verbatim)
}
