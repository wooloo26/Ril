--@ case: snapshot-and-queries
--@ mode: run-pass
--@ spec: STD#bytes-binary-encoding-and-digests
--@ entry: test_snapshot_and_queries
--@ file: snapshot-and-queries.ril
use ril/bytes

pub fn test_snapshot_and_queries() {
    let mut array = [1u8, 2u8]
    let frozen = Bytes::from_array(array)
    array[0] = 9u8
    let mut copy = Bytes::to_array(frozen)
    copy[1] = 8u8
    assert(frozen == b"\x01\x02")
    assert(Bytes::slice(frozen, 0, 1) == Some(b"\x01"))
    assert(Bytes::slice(frozen, 2, 1) == None)
    assert(Bytes::concat(b"a", b"b") == b"ab")
    assert(Bytes::find(b"abc", b"") == Some(0))
    assert(Bytes::find(b"abc", b"bc") == Some(1))
    assert(Bytes::at(frozen, 1) == Some(2u8) && Bytes::at(frozen, -1) == None)
}
--@ end-file
--@ end-case
