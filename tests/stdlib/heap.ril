--@ case: minimum-and-empty
--@ mode: run-pass
--@ spec: STD#ordering-deques-and-heaps
--@ entry: test_minimum_and_empty
--@ file: minimum-and-empty.ril
use ril/heap
use ril/order

pub fn test_minimum_and_empty() {
    let mut heap = Heap::new<int>(.{ compare: Order::compare_int })
    assert(Heap::peek(heap) == None && Heap::pop(mut heap) == None)
    Heap::push(mut heap, 3); Heap::push(mut heap, 1); Heap::push(mut heap, 2)
    assert(Heap::len(heap) == 3 && Heap::peek(heap) == Some(1))
    assert(Heap::pop(mut heap) == Some(1))
    assert(Heap::pop(mut heap) == Some(2))
    assert(Heap::pop(mut heap) == Some(3))
}
--@ end-file
--@ end-case

--@ case: stable-equal-priority
--@ mode: run-pass
--@ spec: STD#ordering-deques-and-heaps
--@ entry: test_stable_equal_priority
--@ file: stable-equal-priority.ril
use ril/heap
use ril/order
type Entry = { rank: int, label: str }

pub fn test_stable_equal_priority() {
    let mut heap = Heap::new<Entry>(.{ compare: \a, b -> Order::compare_int(a.rank, b.rank) })
    Heap::push(mut heap, Entry.{ rank: 1, label: "a" })
    Heap::push(mut heap, Entry.{ rank: 1, label: "b" })
    assert(Heap::pop(mut heap) == Some(Entry.{ rank: 1, label: "a" }))
    assert(Heap::pop(mut heap) == Some(Entry.{ rank: 1, label: "b" }))
}
--@ end-file
--@ end-case
