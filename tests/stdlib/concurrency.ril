-- [case: child-panic, run-pass]
-- spec: STD#structured-concurrency-and-panic-containment
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

pub fn test_child_panic() @Concurrent {
    let result = scope \mut s -> { s.fork(\-> panic("child")); Ok() }
    assert(result is Err(TaskFault::Panicked(_)))
}

-- [case: double-fault, run-pass]
-- spec: STD#structured-concurrency-and-panic-containment
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel
type Guard = { on_close: fn() -> () }

pub fn test_double_fault() @Concurrent {
    let result = scope \mut s -> {
        s.fork(\-> { let scoped resource = Guard.{ on_close: \-> panic("cleanup") }; panic("body") })
        Ok()
    }
    assert(result is Err(TaskFault::DoubleFaultFatal(_)))
}

-- [case: fork-join, run-pass]
-- spec: STD#structured-concurrency-and-panic-containment
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

pub fn test_fork_join() @Concurrent {
    let result = scope \mut s -> { let task = s.fork(\-> 42); task.join() }
    assert(result is Ok(42))
}

-- [case: nested-business-result, run-pass]
-- spec: STD#structured-concurrency-and-panic-containment
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

pub fn test_nested_business_result() @Concurrent {
    let result = scope \mut s -> {
        let task = s.fork(\-> { let value: Result<int, str> = Err("business"); value })
        let business = task.join()?
        Ok(business)
    }
    match result { Ok(business) -> assert(business is Err("business")), Err(_fault) -> panic("unexpected fault") }
}
