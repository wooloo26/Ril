--@ case: uleb128-vectors
--@ mode: run-pass
--@ spec: STD#bytes-binary-encoding-and-digests
--@ entry: test_uleb128_vectors
--@ file: uleb128-vectors.ril
use ril/bytes
use ril/encoding/binary

pub fn test_uleb128_vectors() {
    let values = [0u64, 127u64, 128u64, 18446744073709551615u64]
    for values as value {
        let mut output: []u8 = []
        Binary::write_uleb128(mut output, value)
        let mut cursor = Binary::cursor(Bytes::from_array(output))
        let decoded = Binary::read_uleb128(mut cursor) ?? \_error -> panic("decode")
        assert(decoded == value)
        assert(Binary::remaining(cursor) == 0)
    }
    let mut output: []u8 = []
    Binary::write_uleb128(mut output, 128u64)
    assert(Bytes::from_array(output) == b"\x80\x01")
}
--@ end-file
--@ end-case
