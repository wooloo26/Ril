--@ file: f64-canonical-nan.ril
use ril/bytes
use ril/encoding/binary

pub fn test_f64_canonical_nan() {
    let mut cursor = Binary::cursor(b"\xFF\xF0\x00\x00\x00\x00\x00\x01")
    let nan = Binary::read_f64(mut cursor, Binary::ByteOrder::Big) ?? \_error -> panic("decode")
    assert(nan != nan)
    let mut output: []u8 = []
    Binary::write_f64(mut output, nan, Binary::ByteOrder::Big)
    assert(Bytes::from_array(output) == b"\x7F\xF8\x00\x00\x00\x00\x00\x00")
}
