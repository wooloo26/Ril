--@ case: byte-sequences
--@ mode: run-pass
--@ spec: STD#bytes-binary-encoding-and-digests
--@ entry: test_byte_sequences
--@ file: byte-sequences.ril
use ril/bytes
use ril/encoding/binary

pub fn test_byte_sequences() {
    let mut output: []u8 = []
    Binary::write_bytes(mut output, b"abc")
    let mut cursor = Binary::cursor(Bytes::from_array(output))
    assert(Binary::read_bytes(mut cursor, 0) is Ok(b""))
    assert(Binary::read_bytes(mut cursor, 2) is Ok(b"ab"))
    assert(Binary::read_bytes(mut cursor, 2) is Err(Binary::BinaryError::UnexpectedEnd))
    assert(cursor.offset == 2)
}
--@ end-file
--@ end-case

--@ case: f32-big
--@ mode: run-pass
--@ spec: STD#bytes-binary-encoding-and-digests
--@ entry: test_f32_big
--@ file: f32-big.ril
use ril/bytes
use ril/encoding/binary

pub fn test_f32_big() {
    let mut output: []u8 = []
    Binary::write_f32(mut output, 1.0f32, Binary::ByteOrder::Big)
    assert(Bytes::from_array(output) == b"\x3F\x80\x00\x00")
    let mut cursor = Binary::cursor(Bytes::from_array(output))
    assert(Binary::remaining(cursor) == 4)
    assert(Binary::read_f32(mut cursor, Binary::ByteOrder::Big) is Ok(1.0f32))
    assert(cursor.offset == 4 && Binary::remaining(cursor) == 0)
    assert(Binary::read_f32(mut cursor, Binary::ByteOrder::Big) is Err(Binary::BinaryError::UnexpectedEnd))
    assert(cursor.offset == 4)
}
--@ end-file
--@ end-case

--@ case: f32-canonical-nan
--@ mode: run-pass
--@ spec: STD#bytes-binary-encoding-and-digests
--@ entry: test_f32_canonical_nan
--@ file: f32-canonical-nan.ril
use ril/bytes
use ril/encoding/binary

pub fn test_f32_canonical_nan() {
    let mut cursor = Binary::cursor(b"\xFF\x80\x00\x01")
    let nan = Binary::read_f32(mut cursor, Binary::ByteOrder::Big) ?? \_error -> panic("decode")
    assert(nan != nan)
    let mut output: []u8 = []
    Binary::write_f32(mut output, nan, Binary::ByteOrder::Big)
    assert(Bytes::from_array(output) == b"\x7F\xC0\x00\x00")
}
--@ end-file
--@ end-case

