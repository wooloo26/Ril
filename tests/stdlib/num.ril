--@ case: int-parse-format
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_int_parse_format
--@ file: int-parse-format.ril
use ril/num

pub fn test_int_parse_format() {
    assert(Num::parse_int("2a", 16) is Ok(42))
    assert(Num::format_int(42, 16) is Ok("2a"))
    assert(Num::parse_int("", 1) is Err(Num::NumError::InvalidRadix))
    assert(Num::parse_int(" 1") is Err(Num::NumError::InvalidSyntax))
}
