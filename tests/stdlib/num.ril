--@ case: repeated-numeric-conversion
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ spec: SPEC#generic-parameters-defaults-and-value-sorts
--@ entry: test_repeated_numeric_conversion
--@ file: repeated-numeric-conversion.ril
use ril/num
pub fn test_repeated_numeric_conversion() {
    var count = 0
    for [1, 2] as value {
        assert(Num::convert<int, u8>(value) is Ok(_))
        count += 1
    }
    assert(count == 2)
}
--@ end-file
--@ end-case

--@ case: numeric-callable-views
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: numeric-callable-arity-mismatch
--@ entry: test_numeric_callable_views
--@ file: numeric-callable-views.ril
use ril/num
pub fn test_numeric_callable_views() {
    let parse = Num::parse_int
    assert(parse("42") is Ok(42))
    assert(parse("2a", 16) is Ok(42))
    let explicit_parse: fn(str, int) -> Result<int, Num::NumError> = Num::parse_int
    assert(explicit_parse("2a", 16) is Ok(42))
    let format = Num::format_int
    assert(format(42) is Ok("42"))
    let explicit_format: fn(int, int) -> Result<str, Num::NumError> = Num::format_int
    assert(explicit_format(42, 16) is Ok("2a"))
}
--@ end-file
--@ end-case

--@ case: numeric-callable-arity-mismatch
--@ mode: check-fail
--@ spec: STD#numbers-and-mathematics
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: numeric-callable-views
-- Error [E0301]: A default does not remove a parameter from a callable type.
--@ file: numeric-callable-arity-mismatch.ril
use ril/num
fn example() {
    let parse: fn(str) -> Result<int, Num::NumError> = Num::parse_int
}
--@ end-file
--@ end-case

--@ case: numeric-callable-ascribed-default
--@ mode: check-fail
--@ spec: STD#numbers-and-mathematics
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: numeric-callable-views
-- Error [E0314]: A typed callable receives the destination's signature without defaults.
--@ file: numeric-callable-ascribed-default.ril
use ril/num
fn example() {
    let parse: fn(str, int) -> Result<int, Num::NumError> = Num::parse_int
    let _ = parse("42")
}
--@ end-file
--@ end-case

--@ case: bigint-parse-format
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_bigint_parse_format
--@ file: bigint-parse-format.ril
use ril/num

pub fn test_bigint_parse_format() {
    assert(Num::parse_bigint("2a", 16) is Ok(42bigint))
    assert(Num::format_bigint(42bigint, 16) is Ok("2a"))
    assert(Num::parse_bigint("", 1) is Err(Num::NumError::InvalidRadix))
    assert(Num::parse_bigint(" 1") is Err(Num::NumError::InvalidSyntax))
}
--@ end-file
--@ end-case

--@ case: conversion-boundaries
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_conversion_boundaries
--@ file: conversion-boundaries.ril
use ril/num

pub fn test_conversion_boundaries() {
    assert(Num::parse_u8("256") is Err(Num::NumError::OutOfRange))
    assert(Num::parse_u8("-0") is Ok(0u8))
    assert(Num::parse_u8("-1") is Err(Num::NumError::OutOfRange))
    assert(Num::convert<f64, int>(1.5) is Err(Num::NumError::OutOfRange))
    assert(Num::convert<int, u8>(255) is Ok(255u8))
    assert(Num::convert<int, u8>(256) is Err(Num::NumError::OutOfRange))
    assert(Num::format_f64(0.000001) == "0.000001")
    assert(Num::format_f64(0.0000001) == "1e-7")
}
--@ end-file
--@ end-case

--@ case: f32-parse-format
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_f32_parse_format
--@ file: f32-parse-format.ril
use ril/num

pub fn test_f32_parse_format() {
    assert(Num::parse_f32(".5") is Ok(0.5f32))
    assert(Num::format_f32(1.0f32) == "1.0")
    assert(Num::format_f32(-0.0f32) == "-0.0")
    assert(Num::parse_f32("1e9999") is Err(Num::NumError::OutOfRange))
}
--@ end-file
--@ end-case

--@ case: f64-parse-format
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_f64_parse_format
--@ file: f64-parse-format.ril
use ril/num

pub fn test_f64_parse_format() {
    assert(Num::parse_f64(".5") is Ok(0.5f64))
    assert(Num::format_f64(1.0f64) == "1.0")
    assert(Num::format_f64(-0.0f64) == "-0.0")
    assert(Num::parse_f64("1e9999") is Err(Num::NumError::OutOfRange))
}
--@ end-file
--@ end-case

--@ case: i16-parse-format
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_i16_parse_format
--@ file: i16-parse-format.ril
use ril/num

pub fn test_i16_parse_format() {
    assert(Num::parse_i16("2a", 16) is Ok(42i16))
    assert(Num::format_i16(42i16, 16) is Ok("2a"))
    assert(Num::parse_i16("", 1) is Err(Num::NumError::InvalidRadix))
    assert(Num::parse_i16(" 1") is Err(Num::NumError::InvalidSyntax))
}
--@ end-file
--@ end-case

