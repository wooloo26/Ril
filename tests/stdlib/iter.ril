--@ case: adapters-and-cursor
--@ mode: run-pass
--@ spec: STD#explicit-iteration
--@ entry: test_adapters_and_cursor
--@ file: adapters-and-cursor.ril
use ril/iter

pub fn test_adapters_and_cursor() {
    let source = Iter::indexed([10, 20, 30])
    let mapped = Iter::map(source, \n -> n * 2)
    let filtered = Iter::filter(mapped, \n -> n > 20)
    assert(Iter::collect(0, filtered) == [40, 60])
    assert(Iter::collect((0, 0), Iter::take(source, 2)) == [10, 20])
    assert(Iter::fold(0, source, 0, \sum, n -> sum + n) == 60)
    let mut cursor = Iter::cursor(0)
    assert(Iter::pull(mut cursor, source) == Some(10))
    assert(Iter::pull(mut cursor, source) == Some(20))
    assert(Iter::pull(mut cursor, source) == Some(30))
    assert(Iter::pull(mut cursor, source) == None)
    assert(Iter::pull(mut cursor, source) == None && cursor.ended)
}
--@ end-file
--@ end-case

--@ case: negative-index-safe
--@ mode: run-pass
--@ spec: STD#explicit-iteration
--@ companion: negative-index
--@ entry: test_negative_index_safe
--@ file: negative-index-safe.ril
use ril/iter

pub fn test_negative_index_safe() {
    assert(Iter::collect(0, Iter::indexed([1])) == [1])
}
--@ end-file
--@ end-case

