--@ case: assertion-helpers
--@ mode: run-pass
--@ spec: STD#testing
--@ entry: test_assertion_helpers
--@ file: assertion-helpers.ril
use ril/test

pub fn test_assertion_helpers() {
    Test::assert_eq([1, 2], [1, 2])
    Test::assert_ne(1, 2)
    assert(Test::assert_some(Some(3)) == 3)
    let value: Result<int, str> = Ok(4)
    assert(Test::assert_ok(value) == 4)
}
--@ end-file
--@ end-case

--@ case: fallible-test-entry
--@ mode: run-pass
--@ spec: SPEC#test-conventions-and-execution-protocol
--@ spec: STD#testing-examples
--@ entry: test_fallible_test_entry
--@ file: fallible-test-entry.ril
use ril/num

pub fn test_fallible_test_entry() -> Result<(), Num::NumError> {
    let value = Num::parse_int("42")?
    assert(value == 42)
    Ok()
}
--@ end-file
--@ end-case
