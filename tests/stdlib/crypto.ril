-- [case: sha256-abc, run-pass]
-- spec: STD#bytes-binary-encoding-and-digests
use ril/crypto
use ril/encoding/hex

pub fn test_sha256_abc() {
    let text = "abc"
    assert(Hex::encode(Crypto::sha256(text)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(Crypto::sha256_bytes(String::utf8(text)) == Crypto::sha256(text))
    assert(len(Crypto::sha256(text)) == 32)
}

-- [case: sha256-empty, run-pass]
-- spec: STD#bytes-binary-encoding-and-digests
use ril/crypto
use ril/encoding/hex

pub fn test_sha256_empty() {
    let text = ""
    assert(Hex::encode(Crypto::sha256(text)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert(Crypto::sha256_bytes(String::utf8(text)) == Crypto::sha256(text))
    assert(len(Crypto::sha256(text)) == 32)
}
