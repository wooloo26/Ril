--@ case: partial-progress-error
--@ mode: run-pass
--@ spec: STD#error-and-stream-contracts
--@ entry: test_partial_progress_error
--@ file: partial-progress-error.ril
use ril/io
use ril/bytes
type Reader = { data: bytes, mut offset: int }
type Sink = { mut data: []u8 }
fn read_memory(mut reader: Reader, maximum: int) -> Result<Io::ReadChunk, Io::IoError> &mut {
    assert(maximum >= 0)
    if maximum == 0 { return Ok(.{ data: b"", end: false }) }
    let remaining = len(reader.data) - reader.offset
    let count = if maximum < remaining { maximum } else { remaining }
    let data = Bytes::slice(reader.data, reader.offset, reader.offset + count) ?? panic("fixture bounds")
    reader.offset += count
    Ok(.{ data: data, end: reader.offset == len(reader.data) })
}
fn write_memory(mut sink: Sink, data: bytes) -> Io::WriteProgress &mut {
    for Bytes::to_array(data) as value { sink.data !> Array::push(value) }
    .{ written: len(data), error: None }
}
fn partial(mut sink: Sink, data: bytes) -> Io::WriteProgress &mut {
    let count = if len(data) < 2 { len(data) } else { 2 }
    for 0..count as index { sink.data !> Array::push(Bytes::at(data, index) ?? panic("fixture bounds")) }
    .{ written: count, error: Some(.{ kind: Io::ErrorKind::BrokenPipe, message: "closed", native_code: None }) }
}

pub fn test_partial_progress_error() {
    let mut sink = Sink.{ data: [] }
    let result = Io::write_all(mut sink, b"abcd", .{ write: partial })
    match result { Err(error) -> assert(error.kind == Io::ErrorKind::BrokenPipe), Ok() -> panic("expected failure") }
    assert(Bytes::from_array(sink.data) == b"ab")
}
--@ end-file
--@ end-case

