-- [case: buffered-round-trip, run-pass]
-- spec: STD#buffered-streams
use ril/io
use ril/bytes
type Reader = { data: bytes, mut offset: int }
type Sink = { mut data: []u8 }
fn read_memory(mut reader: Reader, maximum: int) -> Result<Io::ReadChunk, Io::IoError> &mut {
    assert(maximum >= 0)
    if maximum == 0 { return Ok(.{ data: b"", end: false }) }
    let remaining = len(reader.data) - reader.offset
    let count = if maximum < remaining { maximum } else { remaining }
    let data = Bytes::slice(reader.data, reader.offset, reader.offset + count) ?? panic("fixture bounds")
    reader.offset += count
    Ok(.{ data: data, end: reader.offset == len(reader.data) })
}
fn write_memory(mut sink: Sink, data: bytes) -> Io::WriteProgress &mut {
    for Bytes::to_array(data) as value { sink.data !> Array::push(value) }
    .{ written: len(data), error: None }
}

pub fn test_buffered_round_trip() {
    let mut reader = Reader.{ data: b"abc", offset: 0 }
    let mut input = Io::read_buffer(2)
    let first = Io::read_buffered(mut input, mut reader, .{ read: read_memory }, 1) ?? \_error -> panic("read")
    assert(first.data == b"a" && !first.end)
    let mut sink = Sink.{ data: [] }
    let mut output = Io::write_buffer(8)
    let progress = Io::write_buffered(mut output, mut sink, .{ write: write_memory }, b"abc")
    assert(progress.written == 3 && progress.error == None)
    assert(Io::flush(mut output, mut sink, .{ write: write_memory }) is Ok())
    assert(Bytes::from_array(sink.data) == b"abc")
}

-- [case: empty-read-without-eof-safe, run-pass]
-- spec: STD#error-and-stream-contracts
-- companion: empty-read-without-eof
use ril/io
type Reader = { mut attempts: int }
fn invalid(mut reader: Reader, maximum: int) -> Result<Io::ReadChunk, Io::IoError> &mut {
    reader.attempts += 1
    Ok(.{ data: b"", end: false })
}
fn valid(mut reader: Reader, maximum: int) -> Result<Io::ReadChunk, Io::IoError> &mut {
    reader.attempts += 1
    Ok(.{ data: b"", end: true })
}

pub fn test_empty_read_without_eof_safe() {
    let mut reader = Reader.{ attempts: 0 }
    assert(Io::read_all(mut reader, .{ read: valid }) is Ok(b""))
    assert(reader.attempts == 1)
}

