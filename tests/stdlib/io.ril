--@ case: buffered-seek-released
--@ mode: run-pass
--@ spec: STD#buffered-streams
--@ spec: STD#files-and-directories
--@ companion: buffered-seek-reserved
--@ entry: test_native
--@ requires: filesystem
--@ file: source.ril
use ril/io
use ril/file
fn wrapped(mut file:File::Handle,maximum:int)->Result<Io::ReadChunk,Io::IoError> @Fiber &mut{
    File::read_chunk(mut file,maximum)
}
pub fn test_native() @Fiber{
    let scoped mut file=File::open("buffered-seek.bin") ?? \_error->panic("open")
    let mut buffer=Io::read_buffer(2)
    let first=Io::read_buffered(mut buffer,mut file,.{read:wrapped},1) ?? \_error->panic("read")
    assert(first.data==b"a")
    let cached=Io::read_buffered(mut buffer,mut file,.{read:wrapped},1) ?? \_error->panic("read cache")
    assert(cached.data==b"b")
    assert((File::seek(mut file,File::SeekFrom::Start(0i64)) ?? \_error->panic("seek"))==0u64)
    let reread=File::read_chunk(mut file,1) ?? \_error->panic("reread")
    assert(reread.data==b"a")
}
--@ end-file
--@ file: buffered-seek.bin
abc
--@ end-file
--@ end-case

