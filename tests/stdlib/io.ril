--@ case: position-static-reflection
--@ mode: check-pass
--@ spec: STD#buffered-streams
--@ spec: STD#prelude-and-module-index
--@ file: source.ril
use ril/io
type Position=Io::ReadPosition
meta fn identity(value:Io::ReadPosition)->Io::ReadPosition{value}
meta let _=assert(byte_size(type<Position>)==byte_size(type<int>))
meta let _=assert(byte_size(type<Io::ReadPosition>)==byte_size(type<int>))
meta let _=assert(type<Position>==type<Io::ReadPosition>)
meta let _=assert(type<Io::ReadPosition>!=type<int>)
--@ end-file
--@ end-case

