--@ source: guarded-read-positions
--@ file: source.ril
use ril/io
type Reader={position:Io::ReadPosition,mut calls:int}
fn reading(mut reader:Reader,maximum:int)->Result<Io::ReadChunk,Io::IoError> &mut{
    Io::guard_read(reader.position)
    reader.calls+=1
    if maximum==0 {Ok(.{data:b"",end:false})} else {Ok(.{data:b"ab",end:false})}
}
fn alternate(mut reader:Reader,maximum:int)->Result<Io::ReadChunk,Io::IoError> &mut{
    Io::guard_read(reader.position)
    reader.calls+=1
    Ok(.{data:b"",end:true})
}
fn reposition(mut reader:Reader) &mut{
    Io::guard_seek(reader.position)
    reader.calls=0
}
pub fn test_identity(){
    let position=Io::read_position()
    let duplicate=clone(position)
    assert(duplicate==position && Io::read_position()!=position)
    Io::guard_read(duplicate)
    Io::guard_seek(position)
}
pub fn test_cache(){
    let position=Io::read_position()
    let mut reader=Reader.{position:position,calls:0}
    let mut buffer=Io::read_buffer(2)
    let first=Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,clone(position)) ?? \_error->panic("read")
    assert(first.data==b"a" && reader.calls==1)
    let zero=Io::read_buffered_at(mut buffer,mut reader,.{read:reading},0,position) ?? \_error->panic("zero")
    assert(zero.data==b"" && !zero.end && reader.calls==2)
    let cached=Io::read_buffered_at(position:position,mut reader:reader,mut buffer:buffer,max_bytes:1,ops:.{read:reading}) ?? \_error->panic("cache")
    assert(cached.data==b"b" && reader.calls==2)
    reposition(mut reader)
    assert(reader.calls==0)
}
pub fn test_alternate(){
    let position=Io::read_position()
    let mut reader=Reader.{position:position,calls:0}
    let mut buffer=Io::read_buffer(2)
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,position) is Ok(_))
    assert(alternate(mut reader,1) is Ok(_))
}
pub fn test_other_position(){
    let position=Io::read_position()
    let mut reader=Reader.{position:position,calls:0}
    let mut other=Reader.{position:Io::read_position(),calls:0}
    let mut buffer=Io::read_buffer(2)
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,position) is Ok(_))
    assert(alternate(mut other,1) is Ok(_))
    assert(reader.calls==1 && other.calls==1)
}
pub fn test_switch(){
    let position=Io::read_position()
    let mut reader=Reader.{position:position,calls:0}
    let mut buffer=Io::read_buffer(2)
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,position) is Ok(_))
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,Io::read_position()) is Ok(_))
}
pub fn test_seek(){
    let position=Io::read_position()
    let mut reader=Reader.{position:position,calls:0}
    let mut buffer=Io::read_buffer(2)
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,position) is Ok(_))
    reposition(mut reader)
}
pub fn test_shared_position(){
    let position=Io::read_position()
    let mut reader=Reader.{position:position,calls:0}
    let mut wrapper=Reader.{position:clone(position),calls:0}
    let mut buffer=Io::read_buffer(2)
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:reading},1,position) is Ok(_))
    assert(alternate(mut wrapper,1) is Ok(_))
}
fn spin_read(mut reader:Reader,maximum:int)->Result<Io::ReadChunk,Io::IoError> &mut{
    Io::guard_read(reader.position)
    reader.calls+=1
    loop{}
}
fn attempt(position:Io::ReadPosition)->bool{
    with Div::exhausted()->true
    with Div::budget(200)
    let mut reader=Reader.{position:position,calls:0}
    let mut buffer=Io::read_buffer(2)
    assert(Io::read_buffered_at(mut buffer,mut reader,.{read:spin_read},1,position) is Ok(_))
    false
}
pub fn test_abort(){
    let position=Io::read_position()
    assert(attempt(position))
    Io::guard_read(position)
    Io::guard_seek(position)
}
