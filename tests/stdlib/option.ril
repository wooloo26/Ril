--@ case: option-unwrap-or
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_option_unwrap_or
--@ file: option-unwrap-or.ril
pub fn test_option_unwrap_or() {
    assert(Options::unwrap_or(Some(2), 9) == 2 && Options::unwrap_or(None, 9) == 9)
}
--@ end-file
--@ end-case

--@ case: option-unwrap-or-else
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_option_unwrap_or_else
--@ file: option-unwrap-or-else.ril
pub fn test_option_unwrap_or_else() {
    assert(Options::unwrap_or_else(Some(2), \-> panic("unused")) == 2)
}
