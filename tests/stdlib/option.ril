-- [case: callback-laziness, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_callback_laziness() {
    var calls = 0
    let mut fallback = \-> { calls += 1; 9 }
    assert(Options::unwrap_or_else(Some(1), mut fallback) == 1 && calls == 0)
    assert(Options::unwrap_or_else(None, mut fallback) == 9 && calls == 1)
    let mut transform = \value: int -> { calls += 1; value + 1 }
    assert(Options::map(None, mut transform) == None && calls == 1)
    assert(Options::map(Some(1), mut transform) == Some(2) && calls == 2)
}

-- [case: expect-none-safe, run-pass]
-- spec: STD#optional-and-fallible-values
-- companion: expect-none
pub fn test_expect_none_safe() {
    assert(Options::expect(Some(1), "present") == 1)
}

-- [case: expect-none, run-panic]
-- spec: STD#optional-and-fallible-values
-- companion: expect-none-safe
-- Panics: expect none
pub fn test_expect_none() {
    let value: ?int = None
    let _ = Options::expect(value, "none")
}

-- [case: option-and-then, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_and_then() {
    assert(Options::and_then(Some(2), \n -> Some(n + 1)) == Some(3))
}

-- [case: option-and-then-none, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_and_then_none() {
    assert(Options::and_then(None, \n: int -> Some(n)) == None)
}

-- [case: option-expect, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_expect() {
    assert(Options::expect(Some(2), "present") == 2)
}

-- [case: option-fallback, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_fallback() {
    assert(Options::unwrap_or_else(None, \-> 9) == 9)
}

-- [case: option-map, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_map() {
    assert(Options::map(Some(2), \n -> n + 1) == Some(3))
}

-- [case: option-map-none, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_map_none() {
    assert(Options::map(None, \n: int -> n + 1) == None)
}

-- [case: option-unwrap-or, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_unwrap_or() {
    assert(Options::unwrap_or(Some(2), 9) == 2 && Options::unwrap_or(None, 9) == 9)
}

-- [case: option-unwrap-or-else, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_option_unwrap_or_else() {
    assert(Options::unwrap_or_else(Some(2), \-> panic("unused")) == 2)
}
