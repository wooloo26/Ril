--@ case: callback-laziness
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_callback_laziness
--@ file: callback-laziness.ril
pub fn test_callback_laziness() {
    var calls = 0
    let mut fallback = \-> { calls += 1; 9 }
    assert(Options::unwrap_or_else(Some(1), mut fallback) == 1 && calls == 0)
    assert(Options::unwrap_or_else(None, mut fallback) == 9 && calls == 1)
    let mut transform = \value: int -> { calls += 1; value + 1 }
    assert(Options::map(None, mut transform) == None && calls == 1)
    assert(Options::map(Some(1), mut transform) == Some(2) && calls == 2)
}
--@ end-file
--@ end-case

--@ case: expect-none-safe
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ companion: expect-none
--@ entry: test_expect_none_safe
--@ file: expect-none-safe.ril
pub fn test_expect_none_safe() {
    assert(Options::expect(Some(1), "present") == 1)
}
--@ end-file
--@ end-case

--@ case: expect-none
--@ mode: run-panic
--@ spec: STD#optional-and-fallible-values
--@ companion: expect-none-safe
--@ entry: test_expect_none
-- Panics: expect none
--@ file: expect-none.ril
pub fn test_expect_none() {
    let value: ?int = None
    let _ = Options::expect(value, "none")
}
--@ end-file
--@ end-case

--@ case: option-and-then
