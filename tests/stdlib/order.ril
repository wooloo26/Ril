--@ case: float-total-order
--@ mode: run-pass
--@ spec: STD#ordering-deques-and-heaps
--@ entry: test_float_total_order
--@ file: float-total-order.ril
use ril/order

pub fn test_float_total_order() {
    let nan = 0.0 / 0.0
    assert(Order::total_f64(-0.0, 0.0) == Order::Ordering::Less)
    assert(Order::total_f64(nan, nan) == Order::Ordering::Equal)
    assert(Order::total_f64(1.0 / 0.0, nan) == Order::Ordering::Less)
}
--@ end-file
--@ end-case

--@ case: sorting-and-search
--@ mode: run-pass
--@ spec: STD#ordering-deques-and-heaps
--@ entry: test_sorting_and_search
--@ file: sorting-and-search.ril
use ril/order

pub fn test_sorting_and_search() {
    let order = .{ compare: Order::compare_int }
    assert(Order::sorted([3, 1, 1], order) == [1, 1, 3])
    assert(Order::binary_search([1, 1, 3], 1, order) is Ok(0))
    assert(Order::binary_search([1, 1, 3], 2, order) is Err(2))
    let empty: []int = []
    assert(Order::binary_search(empty, 1, order) is Err(0))
    assert(Order::compare_str("a", "b") == Order::Ordering::Less)
    assert(Order::compare_bytes(b"b", b"a") == Order::Ordering::Greater)
}
--@ end-file
--@ end-case

--@ case: stable-ties
--@ mode: run-pass
--@ spec: STD#ordering-deques-and-heaps
--@ entry: test_stable_ties
--@ file: stable-ties.ril
use ril/order
type Entry = { rank: int, name: str }

pub fn test_stable_ties() {
    let values = [Entry.{ rank: 1, name: "a" }, Entry.{ rank: 1, name: "b" }]
    let sorted = Order::sorted(values, .{ compare: \a, b -> Order::compare_int(a.rank, b.rank) })
    assert(Array::map(sorted, \.name) == ["a", "b"])
}
--@ end-file
--@ end-case
