--@ case: clock-observations
--@ mode: run-pass
--@ spec: STD#time-and-randomness
--@ entry: test_clock_observations
--@ requires: clock
--@ file: clock-observations.ril
use ril/time
use ril/clock

pub fn test_clock_observations() @Fiber {
    let first = Time::monotonic()
    Time::sleep(Time::duration_nanos(0i64))
    let second = Time::monotonic()
    let elapsed = Time::elapsed(first, second) ?? \_error -> panic("elapsed")
    assert(inner(elapsed) >= 0i64)
    assert(Clock::now().nanos < 1000000000u32)
}
--@ end-file
--@ end-case

--@ case: negative-sleep-safe
