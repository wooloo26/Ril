--@ case: algebra-and-order
--@ mode: run-pass
--@ spec: STD#set
--@ entry: test_algebra_and_order
--@ file: algebra-and-order.ril
pub fn test_algebra_and_order() {
    let left = Set::of([3, 1, 3])
    let right = Set::from([1, 2])
    assert(Set::contains(left, 3) && len(left) == 2)
    assert(Set::values(Set::union(left, right)) == [3, 1, 2])
    assert(Set::values(Set::intersect(left, right)) == [1])
    assert(Set::values(Set::diff(left, right)) == [3])
    let mut changed = clone(left)
    assert(!Set::insert(mut changed, 1))
    assert(Set::remove(mut changed, 3))
    assert(!Set::remove(mut changed, 3))
    assert(Set::insert(mut changed, 3))
    assert(Set::values(changed) == [1, 3])
}
--@ end-file
--@ end-case
