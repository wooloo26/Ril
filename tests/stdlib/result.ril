--@ case: recover
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_recover
--@ file: recover.ril
pub fn test_recover() {
    let value: Result<int, str> = Ok(2)
    assert(Results::recover(value, \_error -> 0) == 2)
}
--@ end-file
--@ end-case

--@ case: recover-error
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_recover_error
--@ file: recover-error.ril
pub fn test_recover_error() {
    let value: Result<int, str> = Err("bad")
    assert(Results::recover(value, \text -> len(text)) == 3)
}
--@ end-file
