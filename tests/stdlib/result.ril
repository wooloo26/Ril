-- [case: and-then, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_and_then() {
    let value: Result<int, str> = Ok(2)
    assert(Results::and_then(value, \n -> { let next_result: Result<int, str> = Ok(n + 1); next_result }) is Ok(3))
}

-- [case: and-then-preserves-error, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_and_then_preserves_error() {
    let value: Result<int, str> = Err("bad")
    assert(Results::and_then(value, \n -> { let next_result: Result<int, str> = Ok(n); next_result }) is Err("bad"))
}

-- [case: expect, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_expect() {
    let value: Result<int, str> = Ok(2)
    assert(Results::expect(value, "present") == 2)
}

-- [case: expect-error-safe, run-pass]
-- spec: STD#optional-and-fallible-values
-- companion: expect-error
pub fn test_expect_error_safe() {
    let value: Result<int, str> = Ok(1)
    assert(Results::expect(value, "present") == 1)
}

-- [case: expect-error, run-panic]
-- spec: STD#optional-and-fallible-values
-- companion: expect-error-safe
-- Panics: expect error
pub fn test_expect_error() {
    let value: Result<int, str> = Err("bad")
    let _ = Results::expect(value, "error")
}

-- [case: map-err, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_map_err() {
    let value: Result<int, str> = Ok(2)
    assert(Results::map_err(value, \text -> len(text)) is Ok(2))
}

-- [case: map-error-value, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_map_error_value() {
    let value: Result<int, str> = Err("bad")
    assert(Results::map_err(value, \text -> len(text)) is Err(3))
}

-- [case: map-ok, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_map_ok() {
    let value: Result<int, str> = Ok(2)
    assert(Results::map(value, \n -> n + 1) is Ok(3))
}

-- [case: map-preserves-error, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_map_preserves_error() {
    let value: Result<int, str> = Err("bad")
    assert(Results::map(value, \n -> n + 1) is Err("bad"))
}

-- [case: recover, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_recover() {
    let value: Result<int, str> = Ok(2)
    assert(Results::recover(value, \_error -> 0) == 2)
}

-- [case: recover-error, run-pass]
-- spec: STD#optional-and-fallible-values
pub fn test_recover_error() {
    let value: Result<int, str> = Err("bad")
    assert(Results::recover(value, \text -> len(text)) == 3)
}
