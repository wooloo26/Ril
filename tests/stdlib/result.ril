--@ case: and-then
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_and_then
--@ file: and-then.ril
pub fn test_and_then() {
    let value: Result<int, str> = Ok(2)
    assert(Results::and_then(value, \n -> { let next_result: Result<int, str> = Ok(n + 1); next_result }) is Ok(3))
}
--@ end-file
--@ end-case

--@ case: and-then-preserves-error
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_and_then_preserves_error
--@ file: and-then-preserves-error.ril
pub fn test_and_then_preserves_error() {
    let value: Result<int, str> = Err("bad")
    assert(Results::and_then(value, \n -> { let next_result: Result<int, str> = Ok(n); next_result }) is Err("bad"))
}
--@ end-file
--@ end-case

--@ case: expect
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ entry: test_expect
--@ file: expect.ril
pub fn test_expect() {
    let value: Result<int, str> = Ok(2)
    assert(Results::expect(value, "present") == 2)
}
--@ end-file
--@ end-case

--@ case: expect-error-safe
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
--@ companion: expect-error
--@ entry: test_expect_error_safe
--@ file: expect-error-safe.ril
pub fn test_expect_error_safe() {
    let value: Result<int, str> = Ok(1)
    assert(Results::expect(value, "present") == 1)
}
--@ end-file
--@ end-case

--@ case: expect-error
--@ mode: run-panic
--@ spec: STD#optional-and-fallible-values
--@ companion: expect-error-safe
--@ entry: test_expect_error
-- Panics: expect error
--@ file: expect-error.ril
pub fn test_expect_error() {
    let value: Result<int, str> = Err("bad")
    let _ = Results::expect(value, "error")
}
--@ end-file
--@ end-case

--@ case: map-err
--@ mode: run-pass
--@ spec: STD#optional-and-fallible-values
