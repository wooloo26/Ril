--@ case: decisive-result-suppresses-right-fault
--@ mode: run-pass
--@ spec: STD#result-order-and-failures
--@ entry: test_decisive_result_suppresses_right_fault
--@ file: decisive-result-suppresses-right-fault.ril
use ril/parallel

pub fn test_decisive_result_suppresses_right_fault() {
    let found = Parallel::find([0, 1], \n -> { if n == 0 { true } else { panic("right") } })
    assert(found == Some(0))
}
--@ end-file
--@ end-case

--@ case: decisive-result-suppresses-right-double-fault
--@ mode: run-pass
--@ spec: STD#result-order-and-failures
--@ entry: test_decisive_result_suppresses_right_double_fault
--@ file: right-double-fault.ril
use ril/parallel
type Guard = { on_close: fn() -> () }

pub fn test_decisive_result_suppresses_right_double_fault() {
    let found = Parallel::find([0, 1], \index -> {
        if index == 0 { return true }
        let scoped resource = Guard.{ on_close: \-> panic("right cleanup") }
        panic("right body")
    })
    assert(found == Some(0))
}
--@ end-file
--@ end-case

--@ case: fold-fault-source-index
--@ mode: run-pass
--@ spec: STD#fold-results
--@ entry: test_fold_fault_source_index
--@ file: fold-fault-source-index.ril
use ril/parallel
use ril/concurrent::{scope, TaskFault}

pub fn test_fold_fault_source_index() @Concurrent {
    let mut data: []int = []
    for 0..130 as index { Array::push(mut data, index) }
    let input = clone_immut(data)
    let result = scope \mut tasks -> {
        tasks.fork(\-> Parallel::fold(input, \-> 0,
            \sum, item -> { if item == 65 { panic("fold local") }; sum + item },
            \left, right -> left + right))
        Ok()
    }
    match result {
        Err(TaskFault::Panicked(info)) -> assert(info.index == Some(65)),
        _ -> panic("expected indexed fold fault"),
    }
}
--@ end-file
--@ end-case

--@ case: independent-fault-precedence
--@ mode: run-pass
--@ spec: STD#mutation-and-concurrency-limits
--@ entry: test_independent_fault_precedence
--@ file: independent-fault-precedence.ril
use ril/parallel
use ril/concurrent::{scope, TaskFault}
type Guard = { on_close: fn() -> () }

pub fn test_independent_fault_precedence() @Concurrent {
    let result = scope \mut tasks -> {
        tasks.fork(\-> Parallel::join3(
            \-> panic("first panic"),
            \-> { let scoped resource = Guard.{ on_close: \-> panic("second cleanup") }; panic("second body") },
            \-> { let scoped resource = Guard.{ on_close: \-> panic("third cleanup") }; panic("third body") },
        ))
        Ok()
    }
    match result {
        Err(TaskFault::DoubleFaultFatal(info)) -> assert(info.cleanup.message == "second cleanup"),
        _ -> panic("expected earlier double fault"),
    }
}
--@ end-file
--@ end-case

--@ case: disjoint-writes
--@ mode: run-pass
--@ spec: STD#deterministic-data-parallelism-and-divide-and-conquer-primitives
--@ entry: test_disjoint_writes
--@ file: disjoint-writes.ril
use ril/parallel
type Cell = { mut count: int }

pub fn test_disjoint_writes() {
    let mut cells = [Cell.{ count: 1 }, Cell.{ count: 2 }]
    cells !> Parallel::for_each(\mut cell -> { cell.count *= 2 })
    assert(cells[0].count == 2 && cells[1].count == 4)
}
--@ end-file
--@ end-case

--@ case: empty-combinators
--@ mode: run-pass
--@ spec: STD#deterministic-data-parallelism-and-divide-and-conquer-primitives
--@ entry: test_empty_combinators
--@ file: empty-combinators.ril
use ril/parallel

pub fn test_empty_combinators() {
    let empty: []int = []
    assert(Parallel::map(empty, \n -> n + 1) == [])
    assert(Parallel::find(empty, \n -> true) == None)
    assert(Parallel::first(empty, \n -> true) == None)
    assert(!Parallel::any(empty, \n -> true))
}
--@ end-file
--@ end-case

--@ case: fold-group-boundaries
--@ mode: run-pass
--@ spec: STD#fold-results
--@ entry: test_fold_group_boundaries
--@ file: fold-group-boundaries.ril
use ril/parallel

pub fn test_fold_group_boundaries() {
    for [0, 1, 63, 64, 65, 128, 129] as size {
        let mut data: []int = []
        for 0..size as _index { data !> Array::push(0) }
        let value = Parallel::fold(clone_immut(data), \-> 10, \sum, item -> sum + item, \left, right -> left + right)
        let groups = if size == 0 { 1 } else { (size + 63) / 64 }
        assert(value == groups * 10)
    }
}
--@ end-file
--@ end-case

--@ case: nonpositive-bound-safe
