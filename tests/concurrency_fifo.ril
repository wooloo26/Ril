-- @suite concurrency_deterministic
-- @default_stage run

-- @case fifo_scheduler_runs_spawned_tasks_in_deterministic_order run-pass backend=both
-- @expect-stdout a1
-- @expect-stdout b1
-- @expect-stdout a2
-- @expect-stdout b2
-- @expect-stdout done
eff Sched {
    ctl yield_now() -> ()
    ctl spawn(new work: fn() @Sched @io &once -> ()) -> ()
}

type Step {
    Done
    Yielded(ctl() @io -> new Step)
    Spawned(.{ mut child: fn() @Sched @io &once -> (), mut cont: ctl() @io -> new Step })
}

type TaskItem {
    Fresh(fn() @Sched @io &once -> ())
    Cont(ctl() @io -> new Step)
}

fn step_fresh(new work: fn() @Sched @io &once -> ()) @io -> new Step {
    with {
        ctl Sched::yield_now = \new k -> Step::Yielded(new k)
        ctl Sched::spawn = \new child, new k -> Step::Spawned(.{
            mut child: new child,
            mut cont: new k,
        })

        work()
        Step::Done
    }
}

fn run_fifo(new entry: fn() @Sched @io &once -> ()) @io -> () {
    let mut ready: [mut]TaskItem = [TaskItem::Fresh(new entry)]
    defer {
        while let Some(mut item) = Array::pop_front(mut ready) {
            match new item {
                TaskItem::Cont(mut k) -> unwind_ctl(new k)
                TaskItem::Fresh(_) -> ()
            }
        }
    }
    while let Some(mut item) = Array::pop_front(mut ready) {
        let mut outcome = match new item {
            TaskItem::Fresh(mut f) -> step_fresh(new f)
            TaskItem::Cont(mut k) -> k()
        }
        match new outcome {
            Step::Done -> ()
            Step::Yielded(mut k) -> Array::push(mut ready, new TaskItem::Cont(new k))
            Step::Spawned(.{ mut child, mut cont }) -> {
                Array::push(mut ready, new TaskItem::Cont(new cont))
                Array::push(mut ready, new TaskItem::Fresh(new child))
            }
        }
    }
}

fn main() @io -> () {
    run_fifo(new \-> {
        Sched::spawn(new \-> {
            println("b1")
            Sched::yield_now()
            println("b2")
        })
        println("a1")
        Sched::yield_now()
        println("a2")
    })
    println("done")
}

-- @case ctl_yield_over_array_map_and_abort_runs_defer run-pass backend=both
-- @expect-stdout cleanup
-- @expect-stdout 2:4:6
eff Yield<T> {
    ctl emit(value: T) -> ()
}

fn main() @io -> () {
    let mut out: []int = []
    with {
        ctl Yield<int>::emit = \v, new k -> {
            Array::push(mut out, v)
            if len(ref out) < 3 { k() } else { unwind_ctl(new k) }
        }
        defer println("cleanup")
        let _ = Array::map([1, 2, 3, 4, 5], \x -> { Yield<int>::emit(x * 2); x })
    }
    println("{out[0]}:{out[1]}:{out[2]}")
}

-- @case wildcard_ctl_arm_eagerly_aborts_and_unwinds_defer run-pass backend=both
-- @expect-stdout defer-before-arm
-- @expect-stdout arm-body
-- @expect-stdout 80
eff Fail<E> {
    ctl raise(err: E) -> never
}

fn run_fail(flag: bool) @io -> int {
    with ctl Fail<str>::raise = \_err, _ -> {
        println("arm-body")
        80
    }
    defer println("defer-before-arm")
    if flag { Fail<str>::raise("bad") }
    10
}

fn main() @io -> () {
    println("{run_fail(true)}")
}

-- @case nested_ctl_prompts_forward_outer_ops_correctly run-pass backend=both
-- @expect-stdout 10:20:30:done
eff Outer {
    ctl emit(v: int) -> ()
}

eff Inner {
    ctl ask() -> int
}

fn main() @io -> () {
    let mut out: []int = []
    with {
        ctl Outer::emit = \v, new k -> {
            Array::push(mut out, v)
            k()
        }
        var step = 10
        with {
            ctl Inner::ask = \new k -> {
                let cur = step
                step += 10
                k(cur)
            }
            Outer::emit(Inner::ask())
            Outer::emit(Inner::ask())
            Outer::emit(Inner::ask())
        }
    }
    println("{out[0]}:{out[1]}:{out[2]}:done")
}

-- @case route1_dynamic_dispatch_and_parent_stack_handler_arms run-pass backend=both
-- @expect-stdout inner:outer
eff Tag {
    fn get() -> str
}

fn main() @io -> () {
    let read = \-> Tag::get()
    with Tag::get = \-> "outer"
    let result = with {
        Tag::get = \-> "inner:{Tag::get()}"
        read()
    }
    println(result)
}

-- @case defer_lifo_order_on_normal_return_panic_and_abort run-pass backend=both
-- @expect-stdout n3:n2:n1
-- @expect-stdout r2:r1
-- @expect-stdout p-caught
-- @expect-stdout a2:a1
eff Abort {
    ctl stop() -> never
}

fn early(mut log: []str) &mut -> int {
    defer Array::push(mut log, "r1")
    defer Array::push(mut log, "r2")
    return 7
}

fn main() @io -> () {
    let mut normal: []str = []
    {
        defer Array::push(mut normal, "n1")
        defer Array::push(mut normal, "n2")
        defer Array::push(mut normal, "n3")
    }
    println(String::join(new normal, ":"))

    let mut ret_log: []str = []
    assert(early(mut ret_log) == 7)
    println(String::join(new ret_log, ":"))

    let panic_res = recover_panic(\-> {
        var step = 0
        defer { assert(step == 2) }
        defer { step = 2 }
        panic("boom")
    })
    match panic_res {
        Ok(_) -> panic("expected panic")
        Err(_) -> println("p-caught")
    }

    let mut abort_log: []str = []
    with {
        ctl Abort::stop = \_ -> ()
        defer Array::push(mut abort_log, "a1")
        defer Array::push(mut abort_log, "a2")
        Abort::stop()
    }
    println(String::join(new abort_log, ":"))
}

-- @case single_panic_in_defer_is_catchable_via_recover_panic run-pass backend=both
-- @expect-stdout normal-defer-panic
-- @expect-stdout abort-defer-panic
eff Stop {
    ctl halt() -> never
}

fn main() @io -> () {
    let r1 = recover_panic(\-> {
        defer panic("normal-defer-panic")
        ()
    })
    match r1 {
        Ok(_) -> panic("expected panic")
        Err(Panicked(info)) -> println(panic_message(info))
    }

    let r2 = recover_panic(\-> {
        with {
            ctl Stop::halt = \_ -> ()
            defer panic("abort-defer-panic")
            Stop::halt()
        }
    })
    match r2 {
        Ok(_) -> panic("expected panic")
        Err(Panicked(info)) -> println(panic_message(info))
    }
}

-- @case ctl_stack_pool_reuses_stacks_across_many_prompts run-pass backend=both
-- @expect-stdout 4950
eff Tick {
    ctl step(v: int) -> int
}

fn main() @io -> () {
    var total = 0
    for 0..100 as i {
        total += with {
            ctl Tick::step = \v, new k -> k(v)
            Tick::step(i)
        }
    }
    println("{total}")
}
