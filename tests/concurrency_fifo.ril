-- @suite concurrency_deterministic
-- @default_stage run

-- @case fifo_scheduler_runs_spawned_tasks_in_deterministic_order run-pass backend=both
-- @expect-stdout a1
-- @expect-stdout b1
-- @expect-stdout a2
-- @expect-stdout b2
-- @expect-stdout done
use ril/io
eff Sched {
    ctl yield_now() -> ()
    ctl spawn(work: fn() @Sched @io -> ()) -> ()
}

type Step {
    Done
    Yielded(ctl() @io -> new Step)
    Spawned(.{ child: fn() @Sched @io -> (), cont: ctl() @io -> new Step })
}

type TaskItem {
    Fresh(fn() @Sched @io -> ())
    Cont(ctl() @io -> new Step)
}

fn step_fresh(work: fn() @Sched @io -> ()) @io -> new Step {
    with {
        ctl Sched::yield_now = \k -> Step::Yielded(k)
        ctl Sched::spawn = \child, k -> Step::Spawned(.{
            child,
            cont: k,
        })

        work()
        Step::Done
    }
}

fn run_fifo(entry: fn() @Sched @io -> ()) @io -> () {
    let mut ready: []TaskItem = [TaskItem::Fresh(entry)]
    defer {
        while let Some(item) = Array::pop_front(mut ready) {
            match item {
                TaskItem::Cont(k) -> unwind_ctl(k)
                TaskItem::Fresh(_) -> ()
            }
        }
    }
    while let Some(item) = Array::pop_front(mut ready) {
        let outcome = match item {
            TaskItem::Fresh(f) -> step_fresh(f)
            TaskItem::Cont(k) -> k()
        }
        match outcome {
            Step::Done -> ()
            Step::Yielded(k) -> Array::push(mut ready, TaskItem::Cont(k))
            Step::Spawned(.{ child, cont }) -> {
                Array::push(mut ready, TaskItem::Cont(cont))
                Array::push(mut ready, TaskItem::Fresh(child))
            }
        }
    }
}

fn main() @io -> () {
    run_fifo(\-> {
        Sched::spawn(\-> {
            Io::println("b1")
            Sched::yield_now()
            Io::println("b2")
        })
        Io::println("a1")
        Sched::yield_now()
        Io::println("a2")
    })
    Io::println("done")
}

-- @case ctl_yield_over_array_map_and_abort_runs_defer run-pass backend=both
-- @expect-stdout cleanup
-- @expect-stdout 2:4:6
use ril/io
eff Yield<T> {
    ctl emit(value: T) -> ()
}

fn main() @io -> () {
    let mut out: []int = []
    with {
        ctl Yield<int>::emit = \v, k -> {
            Array::push(mut out, v)
            if len(ref out) < 3 { k() } else { unwind_ctl(k) }
        }
        defer Io::println("cleanup")
        let _ = Array::map([1, 2, 3, 4, 5], \x -> { Yield<int>::emit(x * 2); x })
    }
    Io::println("{out?[0] ?? -1}:{out?[1] ?? -1}:{out?[2] ?? -1}")
}

-- @case wildcard_ctl_arm_eagerly_aborts_and_unwinds_defer run-pass backend=both
-- @expect-stdout defer-before-arm
-- @expect-stdout arm-body
-- @expect-stdout 80
use ril/io
eff Fail<E> {
    ctl raise(err: E) -> never
}

fn run_fail(flag: bool) @io -> int {
    with ctl Fail<str>::raise = \_err -> {
        Io::println("arm-body")
        80
    }
    defer Io::println("defer-before-arm")
    if flag { Fail<str>::raise("bad") }
    10
}

fn main() @io -> () {
    Io::println("{run_fail(true)}")
}

-- @case nested_ctl_prompts_forward_outer_ops_correctly run-pass backend=both
-- @expect-stdout 10:20:30:done
use ril/io
eff Outer {
    ctl emit(v: int) -> ()
}

eff Inner {
    ctl ask() -> int
}

fn main() @io -> () {
    let mut out: []int = []
    with {
        ctl Outer::emit = \v, k -> {
            Array::push(mut out, v)
            k()
        }
        var step = 10
        with {
            ctl Inner::ask = \k -> {
                let cur = step
                step += 10
                k(cur)
            }
            Outer::emit(Inner::ask())
            Outer::emit(Inner::ask())
            Outer::emit(Inner::ask())
        }
    }
    Io::println("{out?[0] ?? -1}:{out?[1] ?? -1}:{out?[2] ?? -1}:done")
}

-- @case route1_dynamic_dispatch_and_parent_stack_handler_arms run-pass backend=both
-- @expect-stdout inner:outer
use ril/io
eff Tag {
    fn get() -> str
}

fn main() @io -> () {
    let read = \-> Tag::get()
    with Tag::get = \-> "outer"
    let result = with {
        Tag::get = \-> "inner:{Tag::get()}"
        read()
    }
    Io::println(result)
}

-- @case defer_lifo_order_on_normal_return_panic_and_abort run-pass backend=both
-- @expect-stdout n3:n2:n1
-- @expect-stdout r2:r1
-- @expect-stdout p-caught
-- @expect-stdout a2:a1
use ril/io
use ril/panic
eff Abort {
    ctl stop() -> never
}

fn early(mut log: []str) -> int {
    defer Array::push(mut log, "r1")
    defer Array::push(mut log, "r2")
    return 7
}

fn main() @io -> () {
    let mut normal: []str = []
    {
        defer Array::push(mut normal, "n1")
        defer Array::push(mut normal, "n2")
        defer Array::push(mut normal, "n3")
    }
    Io::println(String::join(ref normal, ":"))

    let mut ret_log: []str = []
    assert(early(mut ret_log) == 7)
    Io::println(String::join(ref ret_log, ":"))

    let panic_res = Panic::recover(\-> {
        var step = 0
        defer { if step == 2 { step = 3 } }
        defer { step = 2 }
        panic("boom")
    })
    match panic_res {
        Ok(_) -> panic("expected panic")
        Err(_) -> Io::println("p-caught")
    }

    let mut abort_log: []str = []
    with {
        ctl Abort::stop = \-> ()
        defer Array::push(mut abort_log, "a1")
        defer Array::push(mut abort_log, "a2")
        Abort::stop()
    }
    Io::println(String::join(ref abort_log, ":"))
}

-- @case defer_panic_statically_rejected_e0627 compile-fail E0627 stage=access
fn main() -> () {
    defer panic("normal-defer-panic")
    -- ^ E0627
    ()
}

-- @case ctl_stack_pool_reuses_stacks_across_many_prompts run-pass backend=both
-- @expect-stdout 4950
use ril/io
eff Tick {
    ctl step(v: int) -> int
}

fn main() @io -> () {
    var total = 0
    for 0..100 as i {
        total += with {
            ctl Tick::step = \v, k -> k(v)
            Tick::step(i)
        }
    }
    Io::println("{total}")
}
