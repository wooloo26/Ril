--@ case: array-reverse-involution
--@ mode: run-pass
--@ spec: STD#array
--@ entry: test_array_reverse_involution
--@ file: array-reverse-involution.ril
pub fn test_array_reverse_involution() {
    for [[], [1], [1, 2], [1, 2, 1]] as items { assert(Array::reverse(Array::reverse(items)) == items) }
}
--@ end-file
--@ end-case

--@ case: generated-numeric-round-trip
--@ mode: run-pass
--@ spec: STD#numbers-and-mathematics
--@ entry: test_generated_numeric_round_trip
--@ seed: 20261012
--@ file: generated-numeric-round-trip.ril
use ril/random
use ril/num

pub fn test_generated_numeric_round_trip() {
    let mut rng = Random::seeded(20261012u64)
    for 0..256 as _index {
        let value = Random::next_u64(mut rng)
        for [2, 10, 16, 36] as radix {
            let text = Num::format_u64(value, radix) ?? \_error -> panic("format")
            let parsed = Num::parse_u64(text, radix) ?? \_error -> panic("parse")
            assert(parsed == value)
        }
    }
}
--@ end-file
--@ end-case

--@ case: hex-round-trip
--@ mode: run-pass
--@ spec: STD#bytes-binary-encoding-and-digests
--@ entry: test_hex_round_trip
--@ file: hex-round-trip.ril
use ril/encoding/hex

pub fn test_hex_round_trip() {
    for [b"", b"Ril", b"\x00\xFF"] as data {
        let decoded = Hex::decode(Hex::encode(data)) ?? \_error -> panic("decode")
        assert(decoded == data)
    }
}
--@ end-file
--@ end-case

--@ case: set-membership-laws
--@ mode: run-pass
--@ spec: STD#set
--@ entry: test_set_membership_laws
--@ file: set-membership-laws.ril
pub fn test_set_membership_laws() {
    let left = Set::from([1, 2, 3])
    let right = Set::from([2, 3, 4])
    assert(Set::union(left, right) == Set::union(right, left))
    assert(Set::intersect(left, right) == Set::intersect(right, left))
    assert(Set::union(Set::diff(left, right), Set::intersect(left, right)) == left)
}
--@ end-file
--@ end-case

--@ case: signed-division-identity
--@ mode: run-pass
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ entry: test_signed_division_identity
--@ file: signed-division-identity.ril
pub fn test_signed_division_identity() {
    for [-7, -1, 0, 1, 7] as value {
        for [-3, -1, 1, 3] as divisor {
            assert(value == (value / divisor) * divisor + value % divisor)
            let remainder = value % divisor
            assert(remainder == 0 || (remainder < 0) == (value < 0))
        }
    }
}
--@ end-file
--@ end-case
