-- @forbid E0531
nominal type Node = .{ var value: int, var ^mut next: ?Node }
fn copy(mut target: Node, ref reader: Node) &mut -> () {
    target.value = reader.value
}
fn run(count: int) -> int {
    let mut tail = Node.{ value: 4, next: None }
    let mut initial = Node.{ value: 7, next: Some(^mut tail) }
    initial.value += 1
    var ^mut head = initial
    for 0..count as i {
        let mut node = Node.{ value: i, next: Some(^mut head) }
        node.value += 1
        head = ^mut node
    }
    head.value += 1
    match ref head.next {
        Some(first) -> match ref first.next {
            Some(second) -> {
                copy(mut tail, ref second)
                -- ^ E0524
                second.value
            }
            None -> 0
        }
        None -> 0
    }
}

-- @case snapshot_checks_follow_callback_receivers_in_recursive_data compile-fail E0535 no-prelude
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
nominal type Node = .{ action: fn(new Shelf) -> int, next: ?Node }
fn freeze(new source: Shelf) -> int { let snapshot = new source; snapshot.item.count }
fn count(new source: Shelf) -> int { source.item.count }
fn visit(node: Node, new input: Shelf) -> int {
    match node.next {
        Some(tail) -> visit(tail, new input)
        None -> node.action(new input)
    }
}
fn observe() -> () {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let head = Node.{ action: count, next: Some(Node.{ action: freeze, next: None }) }
    let observed = visit(head, new Shelf.{ item: ^mut live })
    -- ^ E0535
    live.count += 8
    assert(observed == 2)
}

-- @case snapshot_checks_converge_when_recursive_calls_wrap_an_argument compile-fail E0535 no-prelude
type Cell = .{ var count: int }
nominal type Node = .{ ^mut value: Cell, mut next: ?Node }
fn freeze(new source: Node) -> int { let snapshot = new source; snapshot.value.count }
fn visit(action: fn(new Node) -> int, new input: Node, depth: int) -> int {
    if depth == 0 { action(new input) }
    else {
        let outer = Cell.{ count: 5 }
        visit(action, new Node.{ value: ^mut Cell.{ count: outer.count }, next: Some(new input) }, depth - 1)
    }
}
fn observe() -> () {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let observed = visit(freeze, new Node.{ value: ^mut live, next: None }, 1)
    -- ^ E0535
    live.count += 8
    assert(observed == 5)
}
