-- @case conditional_replacement_preserves_both_origins compile-pass
type Holder = .{ var ref visible: Cell }
fn overwrite(flag: bool, mut holder: Holder, ref other: Cell) &mut -> ref(holder | other) Cell {
    if flag { holder.visible = other }
