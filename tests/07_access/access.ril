-- @case replaced_member_participates_in_call_overlap compile-fail E0524
type Holder = .{ var ref visible: Cell }
fn copy(mut target: Cell, ref reader: Holder) &mut -> () { target.count = reader.visible.count }
fn overlap(mut holder: Holder, mut target: Cell) &mut -> () {
    holder.visible = ref target
    copy(mut target, ref holder)
    -- ^ E0524
}

-- @case call_entry_graph_includes_later_argument_preparation compile-pass
type Holder = .{ var ref visible: Cell }
fn see(ref holder: Holder, _marker: ()) -> ref(holder) Cell { holder.visible }
fn overwrite(mut holder: Holder, ref other: Cell) &mut -> ref(other) Cell {
    see(ref holder, { holder.visible = other; () })
}

