    right.count += 1
}
fn update() -> () {
    let mut first = Node.{ count: 20, next: None }
    let mut second = Node.{ count: 22, next: None }
    first.next = ^mut Some(^mut second)
    second.next = ^mut Some(^mut first)
    edit(mut first, mut second)
    -- ^ E0523
}

-- @case handing_off_a_wrapper_keeps_its_independent_ref_source compile-pass
type Shelf = .{ ref item: Cell }
fn wrap(ref source: Cell) &return(ref source) -> new Shelf { Shelf.{ item: ref source } }
fn read() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    let ref independent = ref cell
    let mut shelf = wrap(ref cell)
    let ref moved = new shelf
    independent.count + moved.item.count
}

-- @case handing_off_a_wrapper_ends_views_of_its_members compile-fail E0549
type Shelf = .{ ref item: Cell }
fn wrap(ref source: Cell) &return(ref source) -> new Shelf { Shelf.{ item: ref source } }
fn read() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    let mut shelf = wrap(ref cell)
    let ref view = ref shelf.item
    let ref moved = new shelf
    view.count + moved.item.count
    -- ^ E0549
}

