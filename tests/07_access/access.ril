-- @case replaced_member_is_in_new_call_entry compile-pass
type Holder = .{ var ref visible: Cell }
fn see(ref holder: Holder) -> ref(holder) Cell { holder.visible }
fn overwrite(mut holder: Holder, ref other: Cell) &mut -> ref(other) Cell {
