}

-- @case only_break_paths_contribute_to_normal_loop_storage compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn replace(mut shelf: Shelf, ^mut replacement: Cell, again: bool) &mut &^mut -> () {
    while true {
        if again { continue }
        shelf.item = ^mut replacement
        break
    }
}
fn update(mut shelf: Shelf, ^mut discarded: Cell, ^mut replacement: Cell, again: bool) &mut &^mut -> () {
-- ^ E0527
    shelf.item = ^mut discarded
    replace(mut shelf, ^mut replacement, again)
}

-- @case the_previous_iterations_branch_keeps_carried_arguments_disjoint compile-pass
fn add(mut left: Cell, mut right: Cell) &mut -> () {
    left.count += 1
    right.count += 1
}
fn update(again: bool, swap: bool) -> () {
    let mut first = Cell.{ count: 1 }
    let mut second = Cell.{ count: 2 }
    var ^mut left = first
    var ^mut right = second
    while again {
        add(mut left, mut right)
        if swap {
            left = ^mut second
            right = ^mut first
        } else {
            left = ^mut first
            right = ^mut second
        }
    }
    add(mut left, mut right)
}

-- @case shared_chain_keeps_deep_aliases_after_the_loop compile-fail E0524
-- @forbid E0531
nominal type Node = .{ var value: int, var ^mut next: ?Node }
fn copy(mut target: Node, ref reader: Node) &mut -> () {
    target.value = reader.value
}
fn run(count: int) -> int {
    let mut tail = Node.{ value: 4, next: None }
    let mut initial = Node.{ value: 7, next: Some(^mut tail) }
    initial.value += 1
    var ^mut head = initial
    for 0..count as i {
        let mut node = Node.{ value: i, next: Some(^mut head) }
        node.value += 1
        head = ^mut node
    }
    head.value += 1
    match ref head.next {
        Some(first) -> match ref first.next {
            Some(second) -> {
                copy(mut tail, ref second)
                -- ^ E0524
                second.value
            }
            None -> 0
        }
        None -> 0
    }
}
