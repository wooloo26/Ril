-- @case replacing_a_reference_slot_removes_its_old_origin compile-pass
fn copy(mut target: Cell, ref source: Cell) &mut -> () { target.count = source.count }
fn update() -> () {
    let mut previous = Cell.{ count: 1 }
    let mut current = Cell.{ count: 2 }
    var ref reader = ref previous
    reader = ref current
    copy(mut previous, ref reader)
    current.count += 1
}

