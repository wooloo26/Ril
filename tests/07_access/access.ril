-- @case nested_shared_replacement_keeps_writable_outer_layers compile-pass
type Layer = .{ var ^mut saved: Cell, ^mut writable: Cell, ref observed: Cell, snapshot: Cell }
type Frame = .{ mut middle: .{ mut inner: Layer } }
fn rewrite(mut frame: Frame, ^mut source: Cell) &mut &^mut -> int {
    frame.middle.inner.saved = ^mut source
    frame.middle.inner.saved.count += 1
    frame.middle.inner.writable.count += 1
    frame.middle.inner.observed.count + frame.middle.inner.snapshot.count
}

