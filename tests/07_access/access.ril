-- @suite access
-- @default_stage access

-- @prelude
type Cell = .{ var count: int }

-- @case immutable_record_can_be_read compile-pass
fn observe() -> int {
    let cell = Cell.{ count: 1 }
    cell.count
}

-- @case immutable_record_suppresses_replaceable_member compile-fail E0520
fn update() -> () {
    let cell = Cell.{ count: 1 }
    cell.count = 2
    -- ^ E0520
}

-- @case immutable_root_cannot_supply_a_mutable_argument compile-fail E0520
fn edit(mut cell: Cell) &mut -> () { cell.count += 1 }
fn update() -> () {
    let cell = Cell.{ count: 1 }
    edit(mut cell)
    -- ^ E0520
}

-- @case idle_local_writer_requires_writable_use compile-fail E0527
fn observe() -> int {
    let mut cell = Cell.{ count: 1 }
    -- ^ E0527
    cell.count
}

-- @case live_observer_sees_an_existing_writer compile-pass
fn observe() -> int {
    let mut cell = Cell.{ count: 1 }
    let ref view = ref cell
    cell.count = 2
    view.count
}

-- @case live_observer_cannot_replace_a_member compile-fail E0520
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    let ref view = ref cell
    cell.count = 2
    view.count = 3
    -- ^ E0520
}

-- @case observer_root_cannot_supply_a_mutable_argument compile-fail E0520
fn edit(mut cell: Cell) &mut -> () { cell.count += 1 }
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    let ref view = ref cell
    cell.count = 2
    edit(mut view)
    -- ^ E0520
}

-- @case explicit_local_shared_alias_can_write compile-pass
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    cell.count
}

-- @case persistent_mutable_alias_requires_acknowledgment compile-fail E0510
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut other = cell
    -- ^ E0510
    other.count += 1
    cell.count
}

-- @case mutable_slot_replacement_cannot_duplicate_a_writer compile-fail E0510
fn update() -> int {
    let mut source = Cell.{ count: 1 }
    var mut target = Cell.{ count: 2 }
    target.count += 1
    target = source
    -- ^ E0510
    target.count += 1
    source.count
}

-- @case mutable_slot_replacement_cannot_upgrade_a_snapshot compile-fail E0520
fn update() -> int {
    let source = Cell.{ count: 1 }
    var mut target = Cell.{ count: 2 }
    target.count += 1
    target = source
    -- ^ E0520
    target.count += 1
    target.count
}

-- @case local_snapshot_cannot_publish_a_live_writer compile-fail E0535
fn observe() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    let snapshot = cell
    -- ^ E0535
    snapshot.count
}

-- @case immutable_object_slot_rejects_replacement compile-fail E0501
fn update() -> () {
    let cell = Cell.{ count: 1 }
    cell = Cell.{ count: 2 }
    -- ^ E0501
}

-- @case immutable_var_slot_can_receive_another_snapshot compile-pass
fn update() -> int {
    var cell = Cell.{ count: 1 }
    let snapshot = Cell.{ count: 2 }
    cell = snapshot
    cell.count
}

-- @case mutable_var_slot_can_receive_a_new_object compile-pass
fn update() -> int {
    var mut cell = Cell.{ count: 1 }
    cell = Cell.{ count: 2 }
    cell.count += 1
    cell.count
}

-- @case mutable_var_slot_cannot_supply_handoff_qualification compile-fail E0548
fn update() -> int {
    var mut cell = Cell.{ count: 1 }
    cell.count += 1
    cell = Cell.{ count: 2 }
    let mut moved = new cell
    -- ^ E0548
    moved.count += 1
    moved.count
}

-- @case shared_alias_survives_replacement_of_its_original_slot compile-pass
fn update() -> int {
    var mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    cell = Cell.{ count: 2 }
    cell.count += 1
    alias.count += 1
    alias.count + cell.count
}

-- @case live_shared_writer_prevents_exclusive_handoff compile-fail E0548
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    let _ = new cell
    -- ^ E0548
}

-- @case temporary_mutable_parameter_cannot_form_shared_alias compile-fail E0528
fn update(mut cell: Cell) &mut -> () {
    let ^mut alias = cell
    -- ^ E0528
    alias.count += 1
}

-- @case an_existing_shared_member_can_be_received_from_a_mutable_parameter compile-pass
type Holder = .{ ^mut child: Cell }
fn update(mut holder: Holder) &mut -> () {
    let ^mut alias = holder.child
    alias.count += 1
}

-- @case mutable_receiver_resumes_after_scoped_call compile-pass
fn edit(mut cell: Cell) &mut -> () { cell.count += 1 }
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    edit(mut cell)
    cell.count += 1
    cell.count
}

-- @case mutable_argument_blocks_overlapping_captured_slot_replacement compile-fail E0523
fn update() -> int {
    var mut cell = Cell.{ count: 1 }
    edit(mut cell)
    -- ^ E0523
    cell.count
    where
        fn edit(mut borrowed: Cell) &up(var mut cell) &mut -> () {
            cell = Cell.{ count: 2 }
            borrowed.count += 1
        }
}

-- @case a_view_of_a_mutable_argument_is_unavailable_after_its_call compile-fail E0204
fn edit(mut cell: Cell) &mut -> () {
    let ref observer = ref cell
    cell.count += 1
    assert(observer.count > 1)
}
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    edit(mut cell)
    observer.count
    -- ^ E0204
}

-- @case mutable_record_can_replace_a_scalar_slot compile-pass
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count = 2
    cell.count
}

-- @case fixed_scalar_member_cannot_be_replaced compile-fail E0520
type Entry = .{ fixed: int, var changed: int }
fn update() -> () {
    let mut entry = Entry.{ fixed: 1, changed: 2 }
    entry.changed = 3
    entry.fixed = 4
    -- ^ E0520
}

-- @case scalar_member_cannot_anchor_a_ref_view compile-fail E0402
fn observe() -> () {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    let ref view = ref cell.count
    -- ^ E0402
}

-- @case nested_writable_member_can_replace_a_scalar_slot compile-pass
fn update() -> int {
    let mut record = .{ mut child: Cell.{ count: 1 } }
    record.child.count = 2
    record.child.count
}

-- @case scoped_local_is_unavailable_after_its_block compile-fail E0204
fn observe() -> int {
    { let mut cell = Cell.{ count: 1 }; cell.count += 1 }
    cell.count
    -- ^ E0204
}

-- @case shared_alias_can_leave_a_block compile-pass
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut saved = {
        let ^mut alias = cell
        alias.count += 1
        ^mut alias
    }
    saved.count += 1
    saved.count
}

-- @case shared_alias_leaving_a_block_prevents_handoff compile-fail E0548
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    let ^mut saved = {
        let ^mut alias = cell
        alias.count += 1
        ^mut alias
    }
    saved.count += 1
    let _ = new cell
    -- ^ E0548
}

-- @case exclusive_handoff_can_continue_from_the_new_binding compile-pass
fn update() -> int {
    let mut cell = Cell.{ count: 1 }
    let ref view = ref cell
    let previous = view.count
    let mut next = new cell
    let mut last = new next
    last.count += 1
    previous + last.count
}

-- @case scalar_member_cannot_supply_a_mutable_object compile-fail E0402
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    let mut item = cell.count
    -- ^ E0402
}

-- @case immutable_member_cannot_supply_a_shared_writer compile-fail E0527
type Container = .{ var active: bool, child: Cell }
fn update() -> () {
    let mut container = Container.{ active: true, child: Cell.{ count: 1 } }
    container.active = false
    let ^mut alias = container.child
    -- ^ E0527
    alias.count += 1
}

-- @case writes_require_a_declared_member compile-fail E0336
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    cell.missing = 2
    -- ^ E0336
}

-- @case writes_require_a_declared_root compile-fail E0204
fn update() -> () {
    missing.count = 2
    -- ^ E0204
}

-- @case a_conditional_overlapping_pair_cannot_receive_exclusive_borrows compile-fail E0523
fn pair(mut left: Cell, mut right: Cell) &mut -> () {
    left.count += 1
    right.count += 1
}
fn update(overlap: bool) -> () {
    let mut first = Cell.{ count: 1 }
    let mut second = Cell.{ count: 2 }
    var ^mut left = first
    var ^mut right = second
    if overlap {
        left = ^mut first
        right = ^mut first
    } else {
        left = ^mut first
        right = ^mut second
    }
    pair(mut left, mut right)
    -- ^ E0523
}

-- @case record_schema_cannot_repeat_a_member compile-fail E0210
type Entry = .{ child: Cell, mut child: Cell }
-- ^ E0210

-- @case captured_writer_prevents_handoff compile-fail E0548
fn update() -> () {
    let mut cell = Cell.{ count: 1 }
    let ^mut edit = \-> { cell.count += 1 }
    edit()
    let _ = new cell
    -- ^ E0548
}

-- @case writing_a_fresh_shared_local_does_not_satisfy_reception compile-fail E0527
fn update() -> () {
    let ^mut cell = ^mut Cell.{ count: 1 }
    -- ^ E0527
    cell.count += 1
}

-- @case shared_var_can_receive_its_existing_writer_on_replacement compile-pass
fn update() -> int {
    var ^mut cell = Cell.{ count: 1 }
    cell.count += 1
    let mut source = Cell.{ count: 2 }
    cell = ^mut source
    cell.count += 1
    cell.count
}

-- @case reachable_helper_can_supply_shared_slot_reception compile-pass
fn update() -> int {
    var ^mut cell = Cell.{ count: 1 }
    let mut source = Cell.{ count: 2 }
    replace()
    cell.count += 1
    cell.count
    where
        fn replace() &up(var ^mut cell, mut source) -> () {
            cell = ^mut source
        }
}

-- @case fresh_shared_replacement_does_not_supply_reachable_reception compile-fail E0527
fn update() -> () {
    var ^mut cell = Cell.{ count: 1 }
    -- ^ E0527
    cell.count += 1
    cell = ^mut Cell.{ count: 2 }
    cell.count += 1
}

-- @case local_mutates_record compile-pass
fn increment() -> int {
    let mut cell = Cell.{ count: 0 }
    cell.count += 1
    cell.count
}

-- @case writable_parameter_compile_pass compile-pass
fn increment(mut cell: Cell) &mut -> int {
    cell.count += 1
    cell.count
}

-- @case mutable_parameter_requires_write compile-fail E0527
fn observe(mut cell: Cell) -> int { cell.count }
-- ^ E0527

-- @case recursive_forwarding_is_ungrounded compile-fail E0527
fn cycle(mut cell: Cell) -> () { cycle(mut cell) }
-- ^ E0527

-- @case mutual_recursion_has_grounded_writer compile-pass
fn first(mut cell: Cell, n: int) &mut -> () { second(mut cell, n) }
fn second(mut cell: Cell, n: int) &mut -> () {
    if n < 1 { cell.count = n } else { first(mut cell, n - 1) }
}

-- @case dead_branch_is_not_write_authority compile-fail E0527
fn try_edit(mut cell: Cell) -> () {
    if false { cell.count = 2 }
}

-- @case var_requires_replacement compile-fail E0527
fn stale() -> int {
    var n = 0
    -- ^ E0527
    n
}

-- @case replacing_immutable_slot compile-fail E0501
fn bad() -> () {
    let n = 0
    n = 1
    -- ^ E0501
}

-- @case missing_write_clause compile-fail E0510
fn missing(mut cell: Cell) -> () { cell.count = 2 }
-- ^ E0510
-- @forbid E0527

-- @case excessive_write_clause compile-fail E0529
fn unnecessary(cell: Cell) &mut -> () {}
-- ^ E0529

-- @case returning_fresh_requires_new_annotation compile-fail E0544
fn create() -> Cell { Cell.{ count: 0 } }
-- ^ E0544

-- @case named_construction compile-pass
fn create() -> new Cell { Cell.{ count: 0 } }

-- @case handoff_ends_binding compile-fail E0549
fn transfer() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut other = new cell
    other.count += 2
    cell.count
    -- ^ E0549
}

-- @case handoff_ends_dependent_view compile-fail E0549
fn transfer() -> int {
    let mut cell = Cell.{ count: 1 }
    let ref view = ref cell
    let mut other = new cell
    other.count += 2
    view.count
    -- ^ E0549
}

-- @case overlapping_mut_writers compile-fail E0523
fn incr(mut a: Cell, mut b: Cell) &mut -> () { a.count += 1; b.count += 1 }
fn call() -> () {
    let mut cell = Cell.{ count: 0 }
    incr(mut cell, mut cell)
    -- ^ E0523
}

-- @case handoff_ends_only_compatible_branch_paths compile-pass
fn kept(flag: bool) -> int {
    let mut left = Cell.{ count: 1 }
    let mut right = Cell.{ count: 2 }
    let ref view = if flag {
        let _ = new left
        ref right
    } else {
        let _ = new right
        ref left
    }
    view.count
}

-- @case possible_handoff_still_ends_original_path compile-fail E0549
fn lost(flag: bool) -> int {
    let mut left = Cell.{ count: 1 }
    if flag { let _ = new left }
    left.count
    -- ^ E0549
}

-- @case overlapping_read_write compile-fail E0524
fn copy(mut a: Cell, ref b: Cell) &mut -> () { a.count = b.count }
fn run() -> () {
    let mut cell = Cell.{ count: 0 }
    copy(mut cell, ref cell)
    -- ^ E0524
}

-- @case named_callable_capture_overlaps_a_mutable_argument compile-fail E0524
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ref view = ref cell
    work(mut cell)
    -- ^ E0524
    where
        fn work(mut input: Cell) &mut &up(ref view) -> int {
            input.count += 1
            view.count
        }
}

-- @case new_argument_cannot_end_a_named_callable_capture compile-fail E0549
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ref view = ref cell
    work(new cell)
    -- ^ E0549
    where
        fn work(new item: Cell) &up(ref view) -> int { item.count + view.count }
}

-- @case readonly_closure_capture_overlaps_a_mutable_argument compile-fail E0524
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ref view = ref cell
    let ref work = \mut input: Cell -> {
        input.count += 1
        view.count
    }
    work(mut cell)
    -- ^ E0524
}

-- @case mutable_closure_capture_overlaps_a_mutable_argument compile-fail E0523
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ^mut work = \mut input: Cell -> {
        input.count += 1
        cell.count += 2
        cell.count
    }
    work(mut cell)
    -- ^ E0523
}

-- @case independent_capture_and_mutable_argument_can_be_used_together compile-pass
fn run() -> int {
    let mut a = Cell.{ count: 1 }
    let mut b = Cell.{ count: 2 }
    work(mut a)
    where
        fn work(mut input: Cell) &mut &up(mut b) -> int {
            input.count += 1
            b.count += 1
            input.count + b.count
        }
}

-- @case a_captured_observer_can_alias_a_read_only_argument compile-pass
fn run(ref cell: Cell) -> int {
    let ref view = ref cell
    observe(ref cell)
    where
        fn observe(ref item: Cell) &up(ref view) -> int { item.count + view.count }
}

-- @case mutable_formal_cannot_supply_a_retained_writer compile-fail E0528
fn keep(^mut item: Cell) -> ^mut(item) Cell { item }
fn bad(mut item: Cell) &mut -> ^mut(item) Cell {
    item.count += 1
    keep(^mut item)
    -- ^ E0528
}

-- @case mutable_formal_cannot_return_new_ownership compile-fail E0528
fn bad(mut item: Cell) &mut -> new Cell { new item }
-- ^ E0528

-- @case anonymous_mutable_formal_cannot_return_owned_authority compile-fail E0528
fn run() -> () {
    let bad = \mut item: Cell -> new item
    -- ^ E0528
}

-- @case mutable_formal_can_forward_an_existing_shared_member compile-pass
fn keep(^mut item: Cell) -> ^mut(item) Cell { item }
fn saved(mut holder: .{ var reads: int, ^mut child: Cell }) &mut -> ^mut(holder) Cell {
    holder.reads += 1
    keep(^mut holder.child)
}

-- @case a_ref_argument_can_observe_a_replaceable_binding compile-pass
fn read(ref item: Cell) -> int { item.count }
fn run() -> int {
    var mut item = Cell.{ count: 3 }
    item.count += 1
    let previous = read(ref item)
    item = Cell.{ count: 6 }
    previous + item.count
}

-- @case two_ref_arguments_can_observe_the_same_source compile-pass
fn read(ref a: Cell, ref b: Cell) -> int { a.count + b.count }
fn run(ref item: Cell) -> int { read(ref item, ref item) }

-- @case two_mutable_arguments_can_use_disjoint_sources compile-pass
fn update(mut a: Cell, mut b: Cell) &mut -> () {
    a.count += 1
    b.count += 2
}
fn run() -> int {
    let mut a = Cell.{ count: 1 }
    let mut b = Cell.{ count: 2 }
    update(mut a, mut b)
    a.count + b.count
}

-- @case coincident_shared_arguments_can_both_be_retained compile-pass
type SharedPair = .{ ^mut left: Cell, ^mut right: Cell }
fn retain_pair(^mut left: Cell, ^mut right: Cell) &^mut &return(^mut left, ^mut right) -> new SharedPair {
    SharedPair.{ left: ^mut left, right: ^mut right }
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut pair = retain_pair(^mut cell, ^mut cell)
    pair.left.count += 1
    pair.right.count
}

-- @case shared_participant_can_yield_a_nested_scoped_mutable_borrow compile-pass
type SharedPair = .{ ^mut left: Cell, ^mut right: Cell }
fn edit(mut cell: Cell) &mut -> () { cell.count += 1 }
fn retain_pair(^mut left: Cell, ^mut right: Cell) &mut &^mut &return(^mut left, ^mut right) -> new SharedPair {
    edit(mut left)
    SharedPair.{ left: ^mut left, right: ^mut right }
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut pair = retain_pair(^mut cell, ^mut cell)
    pair.left.count += 1
    pair.right.count
}

-- @case exclusive_argument_cannot_overlap_a_shared_argument compile-fail E0523
fn edit_and_retain(mut writer: Cell, ^mut retained: Cell) &mut -> ^mut(retained) Cell {
    writer.count += 1
    retained
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut kept = edit_and_retain(mut cell, ^mut cell)
    -- ^ E0523
    kept.count += 1
    cell.count
}

-- @case shared_formal_and_capture_may_alias_during_a_nested_borrow compile-fail E0524
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    let ^mut saved = retain(^mut cell)
    saved.count += 1
    cell.count
    where
        fn retain(^mut input: Cell) &mut &up(^mut alias) -> ^mut(input) Cell {
            alias.count += 1
            edit(mut input, ref alias)
            -- ^ E0524
            input
        }
}

-- @case read_only_capture_is_disjoint_from_shared_formal compile-pass
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut other = Cell.{ count: 2 }
    let ^mut alias = other
    alias.count += 1
    let ^mut saved = retain(^mut cell)
    saved.count += 1
    cell.count
    where
        fn retain(^mut input: Cell) &mut &up(ref alias) -> ^mut(input) Cell {
            edit(mut input, ref alias)
            input
        }
}

-- @case inferred_writable_capture_may_alias_a_shared_formal compile-fail E0524
type Shelf = .{ var ^mut value: Cell }
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    let mut shelf = Shelf.{ value: ^mut Cell.{ count: 2 } }
    let ^mut retain = \^mut input: Cell -> {
        alias.count += 1
        edit(mut input, ref alias)
        -- ^ E0524
        shelf.value = ^mut input
    }
    retain(^mut cell)
    shelf.value.count
}

-- @case inferred_read_only_capture_is_disjoint_from_shared_formal compile-pass
type Shelf = .{ var ^mut value: Cell }
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut other = Cell.{ count: 2 }
    let ^mut alias = other
    alias.count += 1
    let mut shelf = Shelf.{ value: ^mut Cell.{ count: 3 } }
    let ^mut retain = \^mut input: Cell -> {
        edit(mut input, ref alias)
        shelf.value = ^mut input
    }
    retain(^mut cell)
    shelf.value.count
}

-- @case distinct_shared_formals_do_not_prove_independence_for_a_nested_call compile-fail E0524
type Pair = .{ ^mut left: Cell, ^mut right: Cell }
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn retain(^mut left: Cell, ^mut right: Cell) &mut &^mut &return(^mut left, ^mut right) -> new Pair {
    edit(mut left, ref right)
    -- ^ E0524
    Pair.{ left: ^mut left, right: ^mut right }
}

-- @case separate_exclusive_fields_of_one_shared_formal_can_be_reborrowed compile-pass
type Pair = .{ mut left: Cell, mut right: Cell }
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn retain(^mut pair: Pair) &mut -> ^mut(pair) Pair {
    edit(mut pair.left, ref pair.right)
    pair
}

-- @case borrowing_separate_containers_preserves_their_shared_member_mode compile-pass
type Holder = .{ ^mut item: Cell }
fn update(mut first: Holder, mut second: Holder) &mut -> () {
    first.item.count += 1
    second.item.count += 1
}
fn run() -> () {
    let mut cell = Cell.{ count: 1 }
    let mut first = Holder.{ item: ^mut cell }
    let mut second = Holder.{ item: ^mut cell }
    update(mut first, mut second)
}

-- @case separate_container_borrows_do_not_prove_their_shared_members_independent compile-fail E0524
type Holder = .{ ^mut item: Cell }
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn update(mut first: Holder, mut second: Holder) &mut -> () {
    second.item.count += 1
    edit(mut first.item, ref second.item)
    -- ^ E0524
}

-- @case separate_shared_members_of_one_formal_may_alias compile-fail E0524
type Pair = .{ ^mut left: Cell, ^mut right: Cell }
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn update(mut pair: Pair) &mut -> () {
    edit(mut pair.left, ref pair.right)
    -- ^ E0524
}

-- @case retaining_one_shared_argument_cannot_satisfy_an_aliased_formal compile-fail E0527
fn retain_one(^mut retained: Cell, ^mut unretained: Cell) -> ^mut(retained) Cell {
-- ^ E0527
    retained
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut kept = retain_one(^mut cell, ^mut cell)
    kept.count += 1
    cell.count
