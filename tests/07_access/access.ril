-- @case publication_on_a_panicking_path_is_retention compile-pass
type Shelf = .{ var ^mut item: Cell }
fn store(mut shelf: Shelf, ^mut source: Cell, ^mut replacement: Cell, stop: bool) &mut &^mut -> () {
    shelf.item = ^mut source
    if stop { panic("stop") }
    shelf.item = ^mut replacement
