-- @case exclusive_arguments_remain_disjoint_when_branches_swap_them compile-pass
fn edit(mut left: Cell, mut right: Cell) &mut -> () {
    left.count += 1
    right.count += 1
}
fn update(swap: bool) -> () {
    let mut first = Cell.{ count: 1 }
    let mut second = Cell.{ count: 2 }
    var ^mut left = first
    var ^mut right = second
    if swap {
        left = ^mut second
        right = ^mut first
    }
    edit(mut left, mut right)
}

-- @case cyclic_arguments_share_a_reachable_descendant compile-fail E0523
nominal type Node = .{ var count: int, var ^mut next: ?Node }
fn edit(mut left: Node, mut right: Node) &mut -> () {
