fn wrap(cell: Cell) &return(cell) -> new Both {
    Both.{ old: cell, fresh: [Cell.{ value: 3 }] }
}
fn edit(cell: Cell) -> int {
    let mut writable: .{ old: Cell, mut fresh: [mut]Cell } = wrap(cell)
    writable.fresh[0].value += 1
    writable.fresh[0].value
}

