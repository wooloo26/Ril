-- @suite access
-- @default_stage access

-- @prelude
type Cell = .{ var count: int }

-- @case local_mutates_record compile-pass
fn increment() -> int {
    let mut cell = Cell.{ count: 0 }
    cell.count += 1
    cell.count
}

-- @case writable_parameter_compile_pass compile-pass
fn increment(mut cell: Cell) &mut -> int {
    cell.count += 1
    cell.count
}

-- @case mutable_parameter_requires_write compile-fail E0527
fn observe(mut cell: Cell) -> int { cell.count }
-- ^ E0527

-- @case recursive_forwarding_is_ungrounded compile-fail E0527
fn cycle(mut cell: Cell) -> () { cycle(mut cell) }
-- ^ E0527

-- @case mutual_recursion_has_grounded_writer compile-pass
fn first(mut cell: Cell, n: int) &mut -> () { second(mut cell, n) }
fn second(mut cell: Cell, n: int) &mut -> () {
    if n < 1 { cell.count = n } else { first(mut cell, n - 1) }
}

-- @case dead_branch_is_not_write_authority compile-fail E0527
fn try_edit(mut cell: Cell) -> () {
    if false { cell.count = 2 }
}

-- @case var_requires_replacement compile-fail E0527
fn stale() -> int {
    var n = 0
    -- ^ E0527
    n
}

-- @case replacing_immutable_slot compile-fail E0501
fn bad() -> () {
    let n = 0
    n = 1
    -- ^ E0501
}

-- @case missing_write_clause compile-fail E0510
fn missing(mut cell: Cell) -> () { cell.count = 2 }
-- ^ E0510
-- @forbid E0527

-- @case excessive_write_clause compile-fail E0529
fn unnecessary(cell: Cell) &mut -> () {}
-- ^ E0529

-- @case returning_fresh_requires_new_annotation compile-fail E0544
fn create() -> Cell { Cell.{ count: 0 } }
-- ^ E0544

-- @case named_construction compile-pass
fn create() -> new Cell { Cell.{ count: 0 } }

-- @case handoff_ends_binding compile-fail E0549
fn transfer() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut other = new cell
    other.count += 2
    cell.count
    -- ^ E0549
}

-- @case handoff_ends_dependent_view compile-fail E0549
fn transfer() -> int {
    let mut cell = Cell.{ count: 1 }
    let ref view = ref cell
    let mut other = new cell
    other.count += 2
    view.count
    -- ^ E0549
}

-- @case overlapping_mut_writers compile-fail E0523
fn incr(mut a: Cell, mut b: Cell) &mut -> () { a.count += 1; b.count += 1 }
fn call() -> () {
    let mut cell = Cell.{ count: 0 }
    incr(mut cell, mut cell)
    -- ^ E0523
}

-- @case handoff_ends_only_compatible_branch_paths compile-pass
fn kept(flag: bool) -> int {
    let mut left = Cell.{ count: 1 }
    let mut right = Cell.{ count: 2 }
    let ref view = if flag {
        let _ = new left
        ref right
    } else {
        let _ = new right
        ref left
    }
    view.count
}

-- @case possible_handoff_still_ends_original_path compile-fail E0549
fn lost(flag: bool) -> int {
    let mut left = Cell.{ count: 1 }
    if flag { let _ = new left }
    left.count
    -- ^ E0549
}

-- @case overlapping_read_write compile-fail E0524
fn copy(mut a: Cell, ref b: Cell) &mut -> () { a.count = b.count }
fn run() -> () {
    let mut cell = Cell.{ count: 0 }
    copy(mut cell, ref cell)
    -- ^ E0524
}

-- @case named_callable_capture_overlaps_a_mutable_argument compile-fail E0524
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ref view = ref cell
    work(mut cell)
    -- ^ E0524
    where
        fn work(mut input: Cell) &mut &up(ref view) -> int {
            input.count += 1
            view.count
        }
}

-- @case new_argument_cannot_end_a_named_callable_capture compile-fail E0549
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ref view = ref cell
    work(new cell)
    -- ^ E0549
    where
        fn work(new item: Cell) &up(ref view) -> int { item.count + view.count }
}

-- @case readonly_closure_capture_overlaps_a_mutable_argument compile-fail E0524
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ref view = ref cell
    let ref work = \mut input: Cell -> {
        input.count += 1
        view.count
    }
    work(mut cell)
    -- ^ E0524
}

-- @case mutable_closure_capture_overlaps_a_mutable_argument compile-fail E0523
fn run() -> int {
    let mut cell = Cell.{ count: 3 }
    let ^mut work = \mut input: Cell -> {
        input.count += 1
        cell.count += 2
        cell.count
    }
    work(mut cell)
    -- ^ E0523
}

-- @case independent_capture_and_mutable_argument_can_be_used_together compile-pass
fn run() -> int {
    let mut a = Cell.{ count: 1 }
    let mut b = Cell.{ count: 2 }
    work(mut a)
    where
        fn work(mut input: Cell) &mut &up(mut b) -> int {
            input.count += 1
            b.count += 1
            input.count + b.count
        }
}

-- @case a_captured_observer_can_alias_a_read_only_argument compile-pass
fn run(ref cell: Cell) -> int {
    let ref view = ref cell
    observe(ref cell)
    where
        fn observe(ref item: Cell) &up(ref view) -> int { item.count + view.count }
}

-- @case mutable_formal_cannot_supply_a_retained_writer compile-fail E0528
fn keep(^mut item: Cell) -> ^mut(item) Cell { item }
fn bad(mut item: Cell) &mut -> ^mut(item) Cell {
    item.count += 1
    keep(^mut item)
    -- ^ E0528
}

-- @case mutable_formal_cannot_return_new_ownership compile-fail E0528
fn bad(mut item: Cell) &mut -> new Cell { new item }
-- ^ E0528

-- @case anonymous_mutable_formal_cannot_return_owned_authority compile-fail E0528
fn run() -> () {
    let bad = \mut item: Cell -> new item
    -- ^ E0528
}

-- @case mutable_formal_can_forward_an_existing_shared_member compile-pass
fn keep(^mut item: Cell) -> ^mut(item) Cell { item }
fn saved(mut holder: .{ var reads: int, ^mut child: Cell }) &mut -> ^mut(holder) Cell {
    holder.reads += 1
    keep(^mut holder.child)
}

-- @case a_ref_argument_can_observe_a_replaceable_binding compile-pass
fn read(ref item: Cell) -> int { item.count }
fn run() -> int {
    var mut item = Cell.{ count: 3 }
    item.count += 1
    let previous = read(ref item)
    item = Cell.{ count: 6 }
    previous + item.count
}

-- @case two_ref_arguments_can_observe_the_same_source compile-pass
fn read(ref a: Cell, ref b: Cell) -> int { a.count + b.count }
fn run(ref item: Cell) -> int { read(ref item, ref item) }

-- @case two_mutable_arguments_can_use_disjoint_sources compile-pass
fn update(mut a: Cell, mut b: Cell) &mut -> () {
    a.count += 1
    b.count += 2
}
fn run() -> int {
    let mut a = Cell.{ count: 1 }
    let mut b = Cell.{ count: 2 }
    update(mut a, mut b)
    a.count + b.count
}

-- @case nested_mutable_call_proves_the_outer_use compile-pass
fn update(mut item: Cell) &mut -> () { item.count += 1 }
fn relay(mut item: Cell) &mut -> () { update(mut item) }
fn run() -> int {
    let mut item = Cell.{ count: 3 }
    relay(mut item)
    item.count
}

-- @case reachable_write_on_one_alternative_satisfies_mutable_use compile-pass
fn update(mut item: Cell, modify: bool) &mut -> int {
    if modify { item.count += 1 }
    item.count
}

-- @case nested_shared_call_preserves_retained_authority compile-pass
fn keep(^mut item: Cell) -> ^mut(item) Cell { item }
fn relay(^mut item: Cell) -> ^mut(item) Cell { keep(^mut item) }

-- @case retaining_a_local_alias_keeps_its_formal_authority compile-pass
fn keep(^mut source: Cell) &mut -> ^mut(source) Cell {
    let ^mut alias = source
    alias.count += 1
    alias
}

-- @case retaining_one_shared_formal_does_not_retain_its_sibling compile-fail E0527
fn keep(^mut a: Cell, ^mut b: Cell) -> ^mut(a) Cell { a }
-- ^ E0527

-- @case call_markers_must_match_a_mutable_formal compile-fail E0406
fn update(mut item: Cell) &mut -> () { item.count += 1 }
fn run(ref item: Cell) -> () {
    update(ref item)
    -- ^ E0406
}

-- @case mutable_formal_is_a_fixed_slot compile-fail E0502
fn reset(mut item: Cell) &mut -> () {
    item = Cell.{ count: 0 }
    -- ^ E0502
    item.count += 1
}

-- @case a_new_argument_can_supply_construction_authority compile-pass
fn update(new owned: Cell) -> int {
    let mut item = new owned
    item.count += 1
    item.count
}
fn run() -> int { update(new Cell.{ count: 41 }) }

-- @case a_read_only_argument_cannot_supply_construction_authority compile-fail E0548
fn consume(new item: Cell) -> int { item.count }
fn run(ref item: Cell) -> int {
    consume(new item)
    -- ^ E0548
}

-- @case a_plain_argument_requires_a_snapshot compile-fail E0535
fn read(item: Cell) -> int { item.count }
fn run(mut item: Cell) &mut -> int {
    item.count += 1
    read(item)
    -- ^ E0535
}

-- @case a_named_helper_must_declare_its_capture compile-fail E0510
fn run() -> int {
    let number = 3
    read()
    where
        fn read() -> int { number }
        -- ^ E0510
}

-- @case independent_allocations compile-pass
fn copy(mut a: Cell, ref b: Cell) &mut -> () { a.count = b.count }
fn run() -> () {
    let mut a = Cell.{ count: 0 }
    let b = Cell.{ count: 1 }
    copy(mut a, ref b)
}

-- @case shared_return_retains compile-pass
fn keep(^mut cell: Cell) -> ^mut(cell) Cell { cell }

-- @case shared_parameter_not_retained compile-fail E0527
fn edit(^mut cell: Cell) &mut -> () { cell.count = 2 }
-- ^ E0527

-- @case overwriting_a_publication_ends_retention compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn overwrite(mut shelf: Shelf, ^mut incoming: Cell, ^mut replacement: Cell) &mut &^mut -> () {
-- ^ E0527
    shelf.item = ^mut incoming
    shelf.item = ^mut replacement
}

-- @case overwriting_an_ancestor_ends_nested_retention compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
type Holder = .{ var mut shelf: Shelf }
fn overwrite(mut holder: Holder, ^mut incoming: Cell, ^mut replacement: Cell) &mut &^mut -> () {
-- ^ E0527
    holder.shelf.item = ^mut incoming
    holder.shelf = Shelf.{ item: ^mut replacement }
}

-- @case publication_survives_in_a_caller_member compile-pass
type Shelf = .{ var ^mut item: Cell }
type Holder = .{ mut shelf: Shelf }
fn store(mut holder: Holder, ^mut source: Cell) &mut &^mut -> () {
    holder.shelf.item = ^mut source
}

-- @case a_caller_can_overwrite_retention_from_a_callee compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn publish(mut shelf: Shelf, ^mut source: Cell) &mut &^mut -> () {
    shelf.item = ^mut source
}
fn overwrite(mut shelf: Shelf, ^mut discarded: Cell, ^mut retained: Cell) &mut &^mut -> () {
-- ^ E0527
    publish(mut shelf, ^mut discarded)
    shelf.item = ^mut retained
}

-- @case a_callee_can_overwrite_retention_from_its_caller compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn publish(mut shelf: Shelf, ^mut source: Cell) &mut &^mut -> () {
    shelf.item = ^mut source
}
fn overwrite(mut shelf: Shelf, ^mut discarded: Cell, ^mut retained: Cell) &mut &^mut -> () {
-- ^ E0527
    shelf.item = ^mut discarded
    publish(mut shelf, ^mut retained)
}

-- @case a_recursive_callee_can_guarantee_replacement compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn publish(mut shelf: Shelf, ^mut source: Cell, recur: bool) &mut &^mut -> () {
    if recur { publish(mut shelf, ^mut source, false) }
    else { shelf.item = ^mut source }
}
fn overwrite(mut shelf: Shelf, ^mut discarded: Cell, ^mut retained: Cell, recur: bool) &mut &^mut -> () {
-- ^ E0527
    shelf.item = ^mut discarded
    publish(mut shelf, ^mut retained, recur)
}

-- @case mutual_recursion_guarantees_a_store_but_can_change_its_source compile-fail E0527
type Shelf = .{ var ^mut left: Cell, var ^mut right: Cell }
fn publish(mut shelf: Shelf, ^mut a: Cell, ^mut b: Cell, recur: bool) &mut &^mut -> () {
    if recur { relay(mut shelf, ^mut b, ^mut a) }
    else {
        shelf.left = ^mut a
        shelf.right = ^mut b
    }
}
fn relay(mut shelf: Shelf, ^mut a: Cell, ^mut b: Cell) &mut &^mut -> () {
    publish(mut shelf, ^mut a, ^mut b, false)
}
fn overwrite(mut shelf: Shelf, ^mut discarded: Cell, ^mut first: Cell, ^mut second: Cell, recur: bool) &mut &^mut -> () {
-- ^ E0527
    shelf.left = ^mut discarded
    publish(mut shelf, ^mut first, ^mut second, recur)
}

-- @case recursive_callee_can_return_without_replacing_the_old_source compile-pass
type Shelf = .{ var ^mut item: Cell }
fn publish(mut shelf: Shelf, ^mut source: Cell, n: int) &mut &^mut -> () {
    if n > 0 { publish(mut shelf, ^mut source, n - 1) }
    else if n == 0 { shelf.item = ^mut source }
}
fn relay(mut shelf: Shelf, ^mut original: Cell, ^mut replacement: Cell, n: int) &mut &^mut -> () {
    shelf.item = ^mut original
    publish(mut shelf, ^mut replacement, n)
}

-- @case nonreturning_recursion_cannot_ground_a_later_write compile-fail E0527
fn spin(mut item: Cell) -> () {
-- ^ E0527
    spin(mut item)
    item.count += 1
}

-- @case a_local_closure_retains_the_parameter_it_stores compile-pass
type Shelf = .{ var ^mut item: Cell }
fn overwrite(mut shelf: Shelf, ^mut kept: Cell) &mut &^mut -> () {
    let store = \mut dst: Shelf, ^mut value: Cell -> { dst.item = ^mut value }
    store(mut shelf, ^mut kept)
}

-- @case all_selected_local_closures_replace_the_previous_source compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn overwrite(
    mut shelf: Shelf,
    ^mut discarded: Cell,
    -- ^ E0527
    ^mut kept: Cell,
    flag: bool
) &mut &^mut -> () {
    shelf.item = ^mut discarded
    let first = \mut dst: Shelf, ^mut value: Cell -> { dst.item = ^mut value }
    let second = \mut dst: Shelf, ^mut value: Cell -> { dst.item = ^mut value }
    let store = if flag { first } else { second }
    store(mut shelf, ^mut kept)
}

-- @case a_named_callable_alias_retains_the_parameter_it_stores compile-pass
type Shelf = .{ var ^mut item: Cell }
fn store(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn relay(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    let write = store
    write(mut shelf, ^mut value)
}

-- @case selected_named_aliases_can_guarantee_a_storage_update compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn first(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn second(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn overwrite(
    mut shelf: Shelf,
    ^mut discarded: Cell,
    -- ^ E0527
    ^mut kept: Cell,
    flag: bool
) &mut &^mut -> () {
    shelf.item = ^mut discarded
    let write = if flag { first } else { second }
    write(mut shelf, ^mut kept)
}

-- @case selected_named_aliases_can_preserve_a_prior_store compile-pass
type Shelf = .{ var ^mut item: Cell, var ^mut spare: Cell }
fn first(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn second(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.spare = ^mut value
}
fn overwrite(mut shelf: Shelf, ^mut previous: Cell, ^mut next: Cell, flag: bool) &mut &^mut -> () {
    shelf.item = ^mut previous
    let write = if flag { first } else { second }
    write(mut shelf, ^mut next)
}

-- @case a_named_function_and_closure_can_guarantee_the_same_store compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn replace(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn overwrite(
    mut shelf: Shelf,
    ^mut discarded: Cell,
    -- ^ E0527
    ^mut retained: Cell,
    choose_named: bool
) &mut &^mut -> () {
    shelf.item = ^mut discarded
    let write: fn(mut Shelf, ^mut Cell) &mut &^mut -> () =
        if choose_named { replace } else {
            \mut shelf: Shelf, ^mut value: Cell -> { shelf.item = ^mut value }
        }
    write(mut shelf, ^mut retained)
}

-- @case an_unreachable_loop_break_cannot_ground_a_later_write compile-fail E0527
fn diverge() -> () {
    while true {
        while true { break }
        diverge()
        break
    }
}
fn change(mut cell: Cell) &mut -> () {
-- ^ E0527
    diverge()
    cell.count += 1
}

-- @case each_reachable_loop_break_preserves_its_recursive_store compile-fail E0527
type Shelf = .{ var ^mut item: Cell }
fn publish(mut shelf: Shelf, ^mut source: Cell, recur: bool) &mut &^mut -> () {
    while true {
        if recur { publish(mut shelf, ^mut source, false) }
        else { shelf.item = ^mut source }
        break
    }
}
fn overwrite(mut shelf: Shelf, ^mut discarded: Cell, ^mut retained: Cell, recur: bool) &mut &^mut -> () {
-- ^ E0527
    shelf.item = ^mut discarded
    publish(mut shelf, ^mut retained, recur)
}

-- @case conditional_callee_update_keeps_the_unmodified_retention_path compile-pass
type Shelf = .{ var ^mut item: Cell }
fn publish(mut shelf: Shelf, ^mut source: Cell, enabled: bool) &mut &^mut -> () {
    if enabled { shelf.item = ^mut source }
}
fn relay(mut shelf: Shelf, ^mut original: Cell, ^mut replacement: Cell, enabled: bool) &mut &^mut -> () {
    shelf.item = ^mut original
    publish(mut shelf, ^mut replacement, enabled)
}

-- @case named_relay_preserves_the_destination_of_a_publication compile-pass
type Shelf = .{ var ^mut item: Cell }
type Holder = .{ mut shelf: Shelf }
fn publish(mut shelf: Shelf, ^mut source: Cell) &mut &^mut -> () {
    shelf.item = ^mut source
}
fn relay(mut holder: Holder, ^mut source: Cell) &mut &^mut -> () {
    publish(mut holder.shelf, ^mut source)
}

-- @case publication_on_one_return_path_is_retention compile-pass
type Shelf = .{ var ^mut item: Cell }
fn store(mut shelf: Shelf, ^mut source: Cell, ^mut replacement: Cell, stop: bool) &mut &^mut -> () {
    shelf.item = ^mut source
    if stop { return }
    shelf.item = ^mut replacement
