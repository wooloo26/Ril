-- @suite concurrency_isolation
-- @default_stage access

-- @case rejects_replaceable_capture compile-fail E0601
use ril/fiber
fn bad() @fiber -> () {
    var count = 0
    Fiber::scope \mut s -> {
        let task = Fiber::spawn(mut s) \-> {
        -- ^ E0601
            count += 1
        }
        Fiber::join(mut s, task)
    }
}

-- @case run_does_not_handle_io compile-fail E0612
use ril/fiber
fn bad() -> () {
-- ^ E0612
    Fiber::run \-> {
        Fiber::yield_now()
        println("observable")
    }
}

-- @case correct_scope_effects compile-pass
use ril/fiber
fn run() -> int {
    Fiber::run \-> Fiber::scope \mut s -> {
        let a = Fiber::spawn(mut s) \-> 19
        let b = Fiber::spawn(mut s) \-> 23
        Fiber::join(mut s, a) + Fiber::join(mut s, b)
    }
}

-- @case owned_join_ends_the_task_path compile-fail E0549
use ril/fiber
fn invalid() @fiber -> () {
    Fiber::scope \mut s -> {
        let mut task = Fiber::spawn(mut s) \-> 1
        let first = Fiber::join(mut s, new task)
        let second = Fiber::join(mut s, new task)
        -- ^ E0549
    }
}

-- @case every_memoized_fallible_join_requires_inspection compile-fail E0720
use ril/fiber
fn work() -> new !<int, str> { Ok(1) }
fn invalid() @fiber -> () {
    Fiber::scope \mut s -> {
        let task = Fiber::spawn(mut s) \-> work()
        match Fiber::join(mut s, task) { Ok(_) -> (); Err(_) -> () }
        let ignored = Fiber::join(mut s, task)
        -- ^ E0720
    }
}

-- @case memoized_join_loop_cannot_discard_an_earlier_result compile-fail E0720
use ril/fiber
fn work() -> new !<int, str> { Ok(1) }
fn invalid() @fiber -> () {
    Fiber::scope \mut s -> {
        let task = Fiber::spawn(mut s) \-> work()
        var pending = Fiber::join(mut s, task)
        assert(pending == Ok(1))
        for 0..2 as _index {
            pending = Fiber::join(mut s, task)
            -- ^ E0720
        }
        assert(pending == Ok(1))
    }
}

-- @case owned_join_does_not_thaw_existing_snapshot compile-fail E0520
use ril/fiber
fn invalid() @fiber -> () {
    let snapshot = [1]
    Fiber::scope \mut s -> {
        let mut task = Fiber::spawn(mut s) \-> snapshot
        let mut values = Fiber::join(mut s, new task)
        -- ^ E0520
        Array::push(mut values, 2)
    }
}

-- @case channel_disallows_frozen_shared_payload compile-fail E0548
use ril/channel
fn bad() @fiber -> () {
    let Channel::ChannelPair.{ mut tx, mut rx } = Channel::bounded(2)
    let xs = [1, 2]
    match Channel::send(mut tx, xs) { Ok() -> (); Err(_) -> () }
    -- ^ E0548
    let _ = Channel::recv(mut rx)
}

-- @case nested_result_must_be_joined compile-fail E0720
use ril/fiber
fn job() -> new !<int, str> { Ok(5) }
fn bad() @fiber -> () {
    Fiber::scope \mut s -> {
        let _ = Fiber::spawn(mut s) \-> job()
        -- ^ E0720
    }
}

-- @case stateful_handler_cannot_cross_fiber_boundary compile-fail E0615
use ril/fiber
eff Clock { fn tick() -> int }
fn bad() -> int {
    var ticks = 0
    with Clock::tick = \-> { ticks += 1; ticks }
    Fiber::run \-> Clock::tick()
    -- ^ E0615
}

-- @case channel_checks_sendable_through_nominal_representation compile-fail E0301
use ril/channel
type Cell = .{ var value: int }
nominal type Borrowed = .{ ref view: Cell }
fn bad() -> () {
    let _ = Channel::bounded<Borrowed>(1)
    -- ^ E0301
}
