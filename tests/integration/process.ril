--@ case: argument-round-trip
--@ mode: run-pass
--@ spec: STD#environment-and-processes
--@ entry: test_argument_round_trip
--@ requires: process
--@ build: child.ril -> child.exe
--@ file: root.ril
use ril/process
use ril/os
use ril/path

pub fn test_argument_round_trip() @Fiber {
    let arguments = [Os::from_string("a b"), Os::from_string(""), Os::from_string("quoted\"value"), Os::from_string("trailing\\")]
    let command = Process::command(Path::from_string("./child.exe"), arguments) |> derive \mut draft -> {
        draft.stdout = Process::OutputMode::Capture
        draft.stderr = Process::OutputMode::Capture
    }
    let output = Process::run(command) ?? \_error -> panic("launch")
    assert(Process::success(output.status))
    assert(output.stdout == b"ok\x0A" && output.stderr == b"")
}
--@ end-file
--@ file: child.ril
use ril/env
use ril/os
pub fn main() @Fiber {
    assert(Env::args() == [Os::from_string("a b"), Os::from_string(""), Os::from_string("quoted\"value"), Os::from_string("trailing\\")])
    println("ok")
}
--@ end-file
--@ end-case

--@ case: capture-limit
--@ mode: run-pass
--@ spec: STD#environment-and-processes
--@ entry: test_capture_limit
--@ requires: process
--@ build: child.ril -> child.exe
--@ file: root.ril
use ril/process
use ril/path

pub fn test_capture_limit() @Fiber {
    let command = Process::command(Path::from_string("./child.exe"), []) |> derive \mut draft -> { draft.stdout = Process::OutputMode::Capture }
    assert(Process::run(command, 1) is Err(Process::ProcessError::CaptureLimit))
}
--@ end-file
--@ file: child.ril
pub fn main() @Fiber { println("too much") }
--@ end-file
--@ end-case

--@ case: capture-nonzero-exit
--@ mode: run-pass
--@ spec: STD#environment-and-processes
--@ entry: test_capture_nonzero_exit
--@ requires: process
--@ build: child.ril -> child.exe
--@ file: root.ril
use ril/process
use ril/path
use ril/os

pub fn test_capture_nonzero_exit() @Fiber {
    let command = Process::command(Path::from_string("./child.exe"), []) |> derive \mut draft -> {
        draft.stdout = Process::OutputMode::Capture
        draft.stderr = Process::OutputMode::Capture
    }
    let output = Process::run(command) ?? \_error -> panic("run")
    assert(output.status == Process::ExitStatus::Exited(1u32))
    assert(!Process::success(output.status))
    assert(output.stdout == b"child\x0A" && output.stderr == b"failure\x0A")
}
--@ end-file
--@ file: child.ril
pub fn main() -> Result<(), str> @Fiber { println("child"); Err("failure") }
--@ end-file
--@ end-case

--@ case: spawn-wait-terminate
--@ mode: run-pass
--@ spec: STD#environment-and-processes
--@ entry: test_spawn_wait_terminate
--@ requires: process
--@ build: child.ril -> child.exe
--@ file: root.ril
use ril/process
use ril/path
use ril/os

pub fn test_spawn_wait_terminate() @Fiber {
    let command = Process::command(Path::from_string("./child.exe"), []) |> derive \mut draft -> {
        draft.stdout = Process::OutputMode::Null
        draft.stderr = Process::OutputMode::Null
    }
    let mut child = Process::spawn(command) ?? \_error -> panic("spawn")
    let first = Process::wait(mut child) ?? \_error -> panic("wait")
    let second = Process::wait(mut child) ?? \_error -> panic("wait again")
    assert(Process::success(first) && first == second)
    assert(Process::terminate(mut child) is Ok())
    let result = Process::with_child(command, \mut handle -> Process::wait(mut handle))
    assert(result is Ok(Process::ExitStatus::Exited(0u32)))
}
--@ end-file
--@ file: child.ril
pub fn main() {}
--@ end-file
--@ end-case
