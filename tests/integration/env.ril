--@ case: snapshot-and-validation
--@ mode: run-pass
--@ spec: STD#environment-and-processes
--@ entry: test_snapshot_and_validation
--@ args: ["a b",""]
--@ env: RIL_TEST_EMPTY=
--@ unset-env: RIL_TEST_ABSENT
--@ file: snapshot-and-validation.ril
use ril/env
use ril/os
use ril/path
use ril/io
use ril/order

pub fn test_snapshot_and_validation() @Fiber {
    let args = Env::args()
    assert(args == [Os::from_string("a b"), Os::from_string("")])
    assert(Env::get(Os::from_string("RIL_TEST_EMPTY")) is Ok(Some(Os::from_string(""))))
    assert(Env::get(Os::from_string("RIL_TEST_ABSENT")) is Ok(None))
    match Env::get(Os::from_string("bad=name")) { Err(error) -> assert(error.kind == Io::ErrorKind::InvalidInput), Ok(_) -> panic("invalid name") }
    let entries = Env::all()
    for 1..len(entries) as index { assert(Os::compare(entries[index - 1].0, entries[index].0) != Order::Ordering::Greater) }
    assert(Path::is_absolute(Env::current_dir() ?? \_error -> panic("cwd")))
    assert(Path::is_absolute(Env::temp_dir() ?? \_error -> panic("temp")))
}
--@ end-file
--@ end-case
