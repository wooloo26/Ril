-- [case: standard-input, run-program]
-- spec: STD#error-and-stream-contracts
-- exit: 0
-- stdout: empty
-- stderr: empty
-- stdin: input.bin
-- file: root.ril
use ril/io
use ril/bytes
pub fn main() -> Result<(), str> @Fiber {
    let zero = Results::map_err(Io::stdin_read(0), Io::error_text)?
    assert(zero.data == b"" && !zero.end)
    let mut received: []u8 = []
    loop {
        let chunk = Results::map_err(Io::stdin_read(2), Io::error_text)?
        assert(len(chunk.data) <= 2)
        for Bytes::to_array(chunk.data) as value { received !> Array::push(value) }
        if chunk.end { last }
    }
    assert(Bytes::from_array(received) == b"A\x00\xFF")
    Ok()
}

-- file: input.bin hex
41 00 ff

-- [case: standard-streams, run-program]
-- spec: STD#error-and-stream-contracts
-- exit: 0
-- stdout: expected.stdout
-- stderr: expected.stderr
-- file: root.ril
use ril/io
pub fn main() @Fiber {
    let out = Io::stdout_write(b"")
    let err = Io::stderr_write(b"")
    assert(out.written == 0 && out.error == None)
    assert(err.written == 0 && err.error == None)
    assert(Io::write_stdout("Aé\r\n") is Ok())
    assert(Io::write_stderr("🙂\n") is Ok())
}

-- file: expected.stderr hex
f0 9f 99 82 0a

-- file: expected.stdout hex
41 c3 a9 0d 0a
