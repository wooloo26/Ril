-- @suite runtime_effects
-- @default_stage run

-- @case division_by_zero_unwinds run-panic "integer division by zero" backend=both
fn divide(n: int) -> int { 20 / n }
fn main() -> () { let _ = divide(0) }

-- @case negative_shift_unwinds run-panic "negative shift count" backend=both
fn shift(n: int) -> int { 15 << n }
fn main() -> () { let _ = shift(-1) }

-- @case cleanup_runs_in_reverse_order run-pass backend=both
-- @expect-stdout second
-- @expect-stdout first
opaque type Resource use(close) = .{ message: str }
fn acquire(message: str) -> new Resource { Resource.{ message } }
fn close(new resource: Resource) @io -> () { println(resource.message) }
fn main() @io -> () {
    use first = acquire("first")
    use second = acquire("second")
}

-- @case panic_runs_cleanup run-panic "failure" backend=both
-- @expect-stdout cleanup
opaque type Resource use(close) = .{ id: int }
fn close(new resource: Resource) @io -> () { println("cleanup") }
fn main() @io -> () {
    use resource = Resource.{ id: 1 }
    panic("failure")
}

-- @case double_panic_aborts run-abort backend=both
opaque type Bomb use(detonate) = .{ id: int }
fn detonate(new _b: Bomb) -> () { panic("second") }
fn main() -> () {
    let outcome = absorb_panic \-> {
        use _b = Bomb.{ id: 1 }
        panic("first")
    }
    match outcome { Ok(_) -> (); Err(_) -> () }
}

-- @case lexical_user_effect run-pass backend=both
-- @expect-stdout 42
eff Clock { fn now() -> int }
fn main() @io -> () {
    with Clock::now = \-> 42
    println("{Clock::now()}")
}

-- @case panic_absorption run-pass backend=both
-- @expect-stdout survived
fn main() @io -> () {
    let outcome = absorb_panic \-> { panic("caught") }
    match outcome { Ok(_) -> (); Err(_) -> println("survived") }
}

-- @case evidence_passes_through_call run-pass backend=both
-- @expect-stdout 41
eff Clock { fn now() -> int }
fn time() @Clock -> int { Clock::now() }
fn main() @io -> () {
    with Clock::now = \-> 41
    println("{time()}")
}

-- @case escaping_closure_keeps_lexical_evidence run-pass backend=both
-- @expect-stdout 3
eff Clock { fn now() -> int }
fn factory() -> fn() @Clock -> int {
    with Clock::now = \-> 3
    \-> Clock::now()
}
fn main() @io -> () {
    let clock = factory()
    with Clock::now = \-> 9
    println("{clock()}")
}

-- @case first_class_immutable_capture run-pass backend=both
-- @expect-stdout 16
fn make(x: int) &capture -> fn(int) -> int { \y: int -> x + y }
fn main() @io -> () {
    let f = make(10)
    println("{f(6)}")
}

-- @case captured_variable_uses_shared_slot run-pass backend=both
-- @expect-stdout 2:3:3
fn main() @io -> () {
    var count = 1
    let ^mut next = \-> { count += 1; count }
    let first = next()
    let second = next()
    println("{first}:{second}:{count}")
}

-- @case local_named_fn_uses_captured_slots run-pass backend=both
-- @expect-stdout 6
fn total(n: int) -> int {
    var sum = 1
    add(n)
    sum
where
    fn add(value: int) &up(var sum) -> () { sum += value }
}
fn main() @io -> () { println("{total(5)}") }

-- @case draft_changes_only_the_copy run-pass backend=both
-- @expect-stdout 3:5:2
type Profile = .{ count: int, values: []int }
fn main() @io -> () {
    let base = Profile.{ count: 3, values: [1] }
    let updated = derive(base) \mut draft -> {
        draft.count = 5
        Array::push(mut draft.values, 2)
    }
    println("{base.count}:{updated.count}:{len(updated.values)}")
}

-- @case local_effect_dispatches_through_its_handler run-pass backend=both
-- @expect-stdout 42
fn main() @io -> () {
    with Shift::apply = \left, right -> left - right
    println("{Shift::apply(right: 1, left: 43)}")
where
    eff Shift { fn apply(left: int, right: int) -> int }
}

-- @case effects_with_same_operation_names_keep_distinct_evidence run-pass backend=both
-- @expect-stdout 12:34
eff First { fn read() -> int }
eff Second { fn read() -> int }
fn main() @io -> () {
    with First::read = \-> 12
    with Second::read = \-> 34
    println("{First::read()}:{Second::read()}")
}

-- @case inferred_propagation_returns_widened_error run-pass backend=both
-- @expect-stdout first
type Basic { First }
type Extended { ..Basic; Second }
fn first() -> new !<int, Basic> { Err(Basic::First) }
fn second() -> new !<int, Extended> { Ok(3) }
fn main() @io -> () {
    let sum = \-> {
        let a = first()?
        Ok(a + second()?)
    }
    match sum() {
        Ok(_) -> println("success")
        Err(First) -> println("first")
        Err(Second) -> println("second")
    }
}

-- @case spread_effect_dispatches_to_original_operation run-pass backend=both
fn invoke() @Combined -> int { Combined::read() }
eff Root { fn read() -> int }
eff Middle { ..Root }
eff Combined { ..Middle; fn extra() -> () }
fn main() -> () {
    with Root::read = \-> 42
    assert(invoke() == 42)
}

-- @case panic_boundary_accepts_first_class_action_and_opaque_info run-pass backend=both
-- @expect-stdout expected failure
fn fail() -> int { panic("expected failure") }
fn main() @io -> () {
    let action = fail
    let caught: !<int, PanicError> = absorb_panic(action)
    match caught {
        Ok(_) -> panic("panic should have been absorbed")
        Err(PanicError::Panicked(info)) -> {
            assert(String::inspect(info) == "<PanicInfo>")
            println(panic_message(info))
        }
    }
}
