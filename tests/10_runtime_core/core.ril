-- @case inspection_obeys_opaque_boundaries_in_nested_values run-pass backend=both
-- @file pkg/secret.ril
pub opaque type Token = int
pub opaque type Packet { Hidden(int) }
pub fn token(value: int) -> Token { value }
pub fn packet() -> new Packet { Hidden(72) }
pub fn inside() -> str { String::inspect(token(42)) }
-- @file pkg/main.ril
use pkg/secret as Secret
fn describe<T>(value: T) -> str { String::inspect(value) }
fn describe_items<T>(items: []?T) -> str { describe(items) }
fn make() @io -> Secret::Token { println("evaluated"); Secret::token(42) }
fn main() @io -> () {
    assert(Secret::inside() == "42")
    assert(String::inspect(make()) == "<Token>")
    assert(String::inspect(Secret::packet()) == "<Packet>")
    let token = Secret::token(17)
    let values = .{ plain: 17, sealed: [Some(token), None] }
    assert(describe(values) == ".{{ plain: 17, sealed: [Some(<Token>), None] }}")
    assert(describe_items(values.sealed) == "[Some(<Token>), None]")
}
-- @expect-stdout evaluated

-- @case static_arguments_are_evaluated_with_the_callers_specialization run-pass backend=both
meta fn square(x: int) -> int { x * x }
fn selected(meta n: int, meta doubled: int = n * 2, tail: int = doubled) -> int {
    square(n) + tail
}
fn forward(meta n: int) -> int {
    let direct = selected(n + 1)
    let anonymous = (\meta n: int, tail: int = n -> tail)(n + 2)
    direct + anonymous
}
fn main() -> () {
    assert(forward(2) == 19 && forward(3) == 29)
}

-- @case recursive_static_arguments_stop_at_the_selected_branch run-pass backend=both
fn accumulate(meta n: int) -> int {
    if n == 0 { 0 } else { n + accumulate(n - 1) }
}
fn main() -> () {
    assert(accumulate(0) == 0 && accumulate(9) == 45)
}

-- @case generic_call_forwards_specialized_type_values run-pass backend=both
