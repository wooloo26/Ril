-- @case guarded_static_coordinate_keeps_its_dependent_return_through_a_call run-pass backend=both
fn read<T: .{ .. }>(via item: T, meta key: str |> Key<T>) -> infer T.(key) {
    item.(key)
}
fn relay<T: .{ .. }>(via item: T, meta key: str |> Key<T>) -> infer T.(key) {
    read(item, key)
}
fn main() -> () {
    let value = .{ number: 42, label: "read" }
    assert(relay(value, "number") == 42 && relay(value, "label") == "read")
