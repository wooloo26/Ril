-- @case map_update_replaces_structurally_equal_key run-pass backend=both
fn main() -> () {
    let mut table = [(1, "a"): 10]
    table[(1, "a")] = 20
    table[(2, "b")] = 30
    assert(len(ref table) == 2)
    assert(table?[(1, "a")] == Some(20))
    assert(table == [(2, "b"): 30, (1, "a"): 20])
}

