-- @suite runtime_core
-- @default_stage run

-- @case bigints_and_float run-pass backend=both
-- @expect-stdout 1267650600228229401496703205376
-- @expect-stdout -2:-1
fn main() @io -> () {
    let big = 1 << 100
    println("{big}")
    println("{-7 / 3}:{-7 % 3}")
    assert(3.0 * 2.0 == 6.0)
}

-- @case bin_exit_status_return run-pass backend=both
-- @expect-exit 1
fn main() -> new !<(), str> { Err("message on stderr") }

-- @case unicode_and_index run-pass backend=both
-- @expect-stdout 2:β
fn main() @io -> () {
    let text = "αβ"
    assert(bytes"\xFF\0"[0] == 255)
    println("{len(text)}:{text[1]}")
}

-- @case managed_graph_and_clone run-pass backend=both
-- @expect-stdout 11:1
type Cell = .{ var count: int }
fn main() @io -> () {
    let snap = Cell.{ count: 1 }
    let mut cell = clone(snap)
    cell.count += 10
    println("{cell.count}:{snap.count}")
}

-- @case ssa_branches_and_loops run-pass backend=both
-- @expect-stdout 15
fn sum(limit: int) -> int {
    var total = 0
    var i = 1
    while i <= limit {
        total += i
        i += 1
    }
    total
}
fn main() @io -> () {
    let choose = sum(5)
    let value = if choose > 10 { choose } else { 0 }
    println("{value}")
}

-- @case meta_prunes_unreachable_foreign_call run-pass backend=both
-- @expect-stdout present
-- @file pkg/main.ril
use pkg/host
meta let AVAILABLE = false
fn main() @io -> () {
    if AVAILABLE { Host::ril_test_symbol_that_is_not_linked() }
    println("present")
}
-- @file pkg/host.d.ril
pub fn ril_test_symbol_that_is_not_linked() @io -> ()

-- @case static_snapshot run-pass backend=both
-- @expect-stdout 6
meta fn values(scale: int) -> []int { [scale, scale * 2, scale * 3] }
fn main() @io -> () {
    let vector = values(2)
    println("{vector[2]}")
}

-- @case generic_type_match_specializes_before_codegen run-pass backend=both
-- @expect-stdout int:7
-- @expect-stdout true
fn describe<T>(item: T) -> str {
    match <T> {
        <int> -> "int:{item}"
        _ -> String::inspect(item)
    }
}
fn main() @io -> () {
    println(describe(7))
    println(describe(true))
}

-- @case narrowing_and_generalized_callable run-pass backend=both
-- @expect-stdout 5:true
fn unwrap(value: ??int) -> int {
    if value == None { return 0 }
    if value == None { return 1 }
    value + 1
}
fn main() @io -> () {
    let identity = \x -> x
    let value: int = identity(unwrap(Some(Some(4))))
    let truth: bool = identity(true)
    println("{value}:{truth}")
}

-- @case record_defaults_are_evaluated_in_order run-pass backend=both
-- @expect-stdout 22
nominal type Settings = .{ start: int, finish: int = start + 10 }
fn main() @io -> () {
    let settings = Settings.{ start: 12 }
    println("{settings.finish}")
}

-- @case signature_checks_entry_and_successful_exit run-pass backend=both
-- @expect-stdout 5
type Span = .{ low: int, high: int }
type Problem { OutOfOrder; Empty }

fn create(low |> ordered(high), high: int) -> new !<Span, Problem> |> non_empty
where
    fn ordered(low: int, high: int) -> new !<(), Problem> {
        if low <= high { Ok() } else { Err(Problem::OutOfOrder) }
    }
    fn non_empty(x: Span) -> new !<(), Problem> {
        if x.low < x.high { Ok() } else { Err(Problem::Empty) }
    }
{
    Ok(Span.{ low, high })
}

fn main() @io -> () {
    assert(create(2, 1) == Err(Problem::OutOfOrder))
    assert(create(3, 3) == Err(Problem::Empty))
    match create(2, 5) { Ok(value) -> println("{value.high}"); Err(_) -> panic("entry unexpectedly failed") }
}

-- @case text_and_array_slices run-pass backend=both
-- @expect-stdout βγ
fn main() @io -> () {
    assert([0, 1, 2, 3][1..=2] == [1, 2])
    assert([0, 1]?[4..] == None)
    println("αβγ"[1..])
}
