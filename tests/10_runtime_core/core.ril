-- @case static_snapshot run-pass backend=both
-- @expect-stdout 6
meta fn values(scale: int) -> []int { [scale, scale * 2, scale * 3] }
fn main() @io -> () {
    let vector = values(2)
    println("{vector[2]}")
}

-- @case generic_type_match_specializes_before_codegen run-pass backend=both
-- @expect-stdout int:7
-- @expect-stdout true
fn describe<T>(item: T) -> str {
    match <T> {
        <int> -> "int:{item}"
        _ -> String::inspect(item)
    }
}
fn main() @io -> () {
    println(describe(7))
    println(describe(true))
}

-- @case narrowing_and_generalized_callable run-pass backend=both
-- @expect-stdout 5:true
fn unwrap(value: ??int) -> int {
    if value == None { return 0 }
    if value == None { return 1 }
    value + 1
}
fn main() @io -> () {
    let identity = \x -> x
    let value: int = identity(unwrap(Some(Some(4))))
    let truth: bool = identity(true)
    println("{value}:{truth}")
}

-- @case record_defaults_are_evaluated_in_order run-pass backend=both
-- @expect-stdout 22
nominal type Settings = .{ start: int, finish: int = start + 10 }
fn main() @io -> () {
    let settings = Settings.{ start: 12 }
    println("{settings.finish}")
}

-- @case signature_checks_entry_and_successful_exit run-pass backend=both
-- @expect-stdout 5
type Span = .{ low: int, high: int }
type Problem { OutOfOrder; Empty }

fn create(low |> ordered(high), high: int) -> new !<Span, Problem> |> non_empty
where
    fn ordered(low: int, high: int) -> new !<(), Problem> {
        if low <= high { Ok() } else { Err(Problem::OutOfOrder) }
    }
    fn non_empty(x: Span) -> new !<(), Problem> {
        if x.low < x.high { Ok() } else { Err(Problem::Empty) }
    }
{
    Ok(Span.{ low, high })
}

fn main() @io -> () {
    assert(create(2, 1) == Err(Problem::OutOfOrder))
    assert(create(3, 3) == Err(Problem::Empty))
    match create(2, 5) { Ok(value) -> println("{value.high}"); Err(_) -> panic("entry unexpectedly failed") }
}

-- @case text_and_array_slices run-pass backend=both
-- @expect-stdout βγ
fn main() @io -> () {
    assert([0, 1, 2, 3][1..=2] == [1, 2])
    assert([0, 1]?[4..] == None)
    println("αβγ"[1..])
}

-- @case navigation_flattens_optional_members_and_keeps_postfix_chain run-pass backend=both
-- @expect-stdout localhost:db:5432
type Config = .{ host: ?str }
type Route = .{ pair: (str, int) }
fn host(config: ?Config) -> str { config?.host ?? "localhost" }
fn port(route: ?Route) -> int { route?.pair.1 ?? 80 }
fn main() @io -> () {
    println("{host(None)}:{host(Some(Config.{ host: Some("db") }))}:{port(Some(Route.{ pair: ("db", 5432) }))}")
    assert(host(Some(Config.{ host: None })) == "localhost")
    assert(port(None) == 80)
}

-- @case optional_index_skips_index_expression run-pass backend=both
fn main() -> () {
    let missing: ?[]int = None
    let present: ?[]int = Some([2, 7])
    assert(missing?[panic("index must be skipped")] == None)
    assert(present?[1] == Some(7))
    assert(present?[3] == None)
}

-- @case result_fallback_calls_a_first_class_function_lazily run-pass backend=both
fn recover(error: str) -> int { len(error) }
fn main() -> () {
    let rejected: !<int, str> = Err("failure")
    let accepted: !<int, str> = Ok(2)
    assert((rejected ?? recover) == 7)
    assert((accepted ?? \_ -> panic("fallback must be skipped")) == 2)
}

-- @case utf8_and_unicode_scalar_helpers_match_static_and_native run-pass backend=both
meta let ENCODED = String::encode_utf8("A😀")
meta let DECODED = String::decode_utf8(ENCODED)
meta let SCALARS = String::scalars("A😀")
fn main() -> () {
    let text = "A😀"
    assert(String::starts_with(text, "A") && String::ends_with(text, "😀"))
    assert(String::encode_utf8(text) == ENCODED)
    assert(String::decode_utf8(ENCODED) == DECODED)
    assert(String::decode_utf8(bytes"\xC0\xAF") == None)
    assert(String::at(text, 0) == Some(65) && String::at(text, 1) == Some(128512))
    assert(String::at(text, -1) == None && String::at(text, 2) == None)
    assert(String::scalars(text) == SCALARS)
    assert(String::from_scalars(SCALARS) == Some(text))
    assert(String::from_scalars([55296]) == None)
    assert(Bytes::at(ENCODED, 1) == Some(240))
    assert(Bytes::from_array(Bytes::to_array(ENCODED)) == Some(ENCODED))
    assert(Bytes::from_array([256]) == None)
}

-- @case included_sum_patterns_keep_members_for_the_binder run-pass backend=both
type Network { Offline; Timeout(int) }
type Account { Invalid }
type Failure { ..Network; ..Account; Other }
fn status(value: Failure) -> int {
    match value {
        Network as net -> match net { Offline -> 1; Timeout(status) -> status }
        ..Account -> 2
        Other -> 3
    }
}
fn main() -> () {
    assert(status(Network::Timeout(17) as Failure) == 17)
    assert(status(Account::Invalid as Failure) == 2)
    assert(status(Failure::Other) == 3)
}
