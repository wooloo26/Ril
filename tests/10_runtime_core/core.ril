-- @case meta_type_values_do_not_enter_native_argument_lists run-pass backend=both
fn classify<T>(meta witness: Type<T>) -> int {
    if witness == <int> { 42 } else { 0 }
}
fn main() -> () {
    assert(classify<int>(<int>) == 42)
    assert(classify<str>(<str>) == 0)
