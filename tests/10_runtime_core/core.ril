fn factory(meta offset: int) -> fn(int) -> int { \value: int -> value + offset }
fn main() -> () {
    let add = factory(2)
    assert(add(40) == 42)
}

-- @case direct_anonymous_meta_parameters_specialize_the_closure run-pass backend=both
fn main() -> () {
    let from_type = (\meta witness: Type<int> -> if witness == <int> { 20 } else { 0 })(<int>)
    let from_value = (\meta offset: int = 3, value: int = 19 -> value + offset)()
