fn relay<T>() -> bool { is_integer(<T>) }
fn main() -> () {
    assert(relay<int>() && !relay<str>())
}

-- @case static_match_prunes_dependent_recursive_arguments run-pass backend=both
fn accumulate(meta n: int) -> int {
    match n {
        0 -> 0
        _ -> n + accumulate(n - 1)
    }
}
fn main() -> () { assert(accumulate(5) == 15) }

