-- @suite concurrency_isolation
-- @default_stage access

-- @case ctl_op_requires_ctl_arm_prefix compile-fail E0623 stage=type
eff Yield { ctl emit(v: int) -> () }
fn bad() -> () {
    with {
        Yield::emit = \_, new k -> k()
        -- ^ E0623
        Yield::emit(1)
    }
}

-- @case fn_op_forbids_ctl_arm_prefix compile-fail E0623 stage=type
eff Clock { fn now() -> int }
fn bad() -> int {
    with {
        ctl Clock::now = \-> 1
        -- ^ E0623
        Clock::now()
    }
}

-- @case unconsumed_ctl_continuation_rejected compile-fail E0625
eff Yield { ctl emit() -> () }
fn bad() -> () {
    with {
        ctl Yield::emit = \new k -> {
        -- ^ E0625
            let _ = k
            ()
        }
        Yield::emit()
    }
}

-- @case must_consume_across_unhandled_ctl_requires_armed_defer compile-fail E0625
eff Yield { ctl emit() -> () }
eff Outer { ctl ping() -> () }
fn bad() @Outer -> () {
    with {
        ctl Yield::emit = \new k -> {
            Outer::ping()
            -- ^ E0625
            k()
        }
        Yield::emit()
    }
}

-- @case must_consume_across_unhandled_ctl_with_armed_defer_passes compile-pass
eff Yield { ctl emit() -> () }
eff Outer { ctl ping() -> () }
fn ok() @Outer -> () {
    with {
        ctl Yield::emit = \new k -> {
            defer unwind_ctl(new k)
            Outer::ping()
        }
        Yield::emit()
    }
}

-- @case defer_forbids_unhandled_ctl compile-fail E0616
eff Yield { ctl emit() -> () }
fn bad() @Yield -> () {
    defer Yield::emit()
    -- ^ E0616
}

-- @case defer_forbids_escaping_return compile-fail E0707
fn bad() -> int {
    defer { return 1 }
    -- ^ E0707
    0
}

-- @case defer_body_must_be_unit compile-fail E0301 stage=type
fn bad() -> () {
    defer 42
    -- ^ E0301
}

-- @case deep_handler_arm_rejects_once_rhs compile-fail E0534
eff Log { fn emit() -> () }
fn bad(new f: fn() &once -> ()) -> () {
    with {
        Log::emit = new f
        -- ^ E0534
        Log::emit()
    }
}

-- @case ctl_continuation_forbids_projected_invocation compile-fail E0548
eff Yield { ctl emit() -> () }
type Holder = .{ mut k: ctl() -> () }
fn bad() -> () {
    with {
        ctl Yield::emit = \new k -> {
            let mut h = Holder.{ mut k: new k }
            h.k()
            -- ^ E0548
        }
        Yield::emit()
    }
}

-- @case ctl_continuation_forbids_double_invocation compile-fail E0549
eff Yield { ctl emit() -> () }
fn bad() -> () {
    with {
        ctl Yield::emit = \new k -> {
            k()
            k()
            -- ^ E0549
        }
        Yield::emit()
    }
}

-- @case once_closure_forbids_capturing_must_consume compile-fail E0625
eff Yield { ctl emit() -> () }
fn take(new f: fn() &once -> ()) -> () { f() }
fn bad() -> () {
    with {
        ctl Yield::emit = \new k -> {
            let mut f: fn() &once -> () = \-> k()
            -- ^ E0625
            take(new f)
        }
        Yield::emit()
    }
}

-- @case shared_writer_forbids_downgrade_across_unhandled_ctl compile-fail E0523
eff Yield { ctl emit() -> () }
type Box = .{ var v: int }
fn touch(mut b: Box) @Yield &mut -> () {
    Yield::emit()
    b.v += 1
}
fn bad(^mut b: Box) @Yield &^mut -> () {
    touch(mut b)
    -- ^ E0523
}

-- @case effect_op_decl_forbids_open_effects compile-fail E0547 stage=type
eff Bad {
    fn run(f: fn() @ -> ()) -> ()
    -- ^ E0547
}

-- @case derive_forbids_outer_ctl compile-fail E0607
eff Yield { ctl emit() -> () }
type Box = .{ v: int }
fn bad(b: Box) @Yield -> Box {
    derive(b, \mut d -> {
    -- ^ E0607
        Yield::emit()
        d.v = 1
    })
}

-- @case recover_panic_forbids_outer_ctl_handler compile-fail E0608
eff Yield { ctl emit() -> () }
fn bad() -> () {
    with ctl Yield::emit = \new k -> k()
    let _ = recover_panic(\-> Yield::emit())
    -- ^ E0608
}

-- @case route1_closure_does_not_capture_outer_with_handler compile-fail E0534 stage=type
eff Clock { fn now() -> int }
fn make() -> fn() -> int {
-- ^ E0534
    with Clock::now = \-> 42
    \-> Clock::now()
}
