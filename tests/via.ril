}

-- @case higher_order_callback_in_a_recursive_member_checks_the_mode_pair compile-fail E0520
type Node(.{ action: fn(via Cell, via Cell) -> (), next: ?Node })
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn observe(via left: Cell, via right: Cell) -> () { assert(left.count == right.count) }
fn apply(node: Node) -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    node.action(^mut cell, ^mut alias)
    match node.next { Some(tail) -> apply(tail); None -> cell.count }
}
fn run() -> int {
    apply(Node::(.{ action: observe, next: Some(Node::(.{ action: combine, next: None })) }))
    -- ^ E0520
}

-- @case higher_order_callback_receives_projected_member_via_modes compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn apply(action: fn(via Cell, via Cell) -> (), mut frame: .{ via left: Cell, via right: Cell }) -> () {
    action(frame.left, frame.right)
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    let mut frame = .{ ^mut left: ^mut cell, ^mut right: ^mut cell }
    apply(combine, mut frame)
    -- ^ E0520
    cell.count
}

-- @case changing_callback_mode_pairs_breaks_compatibility compat-fail E0552
-- @baseline
pub fn apply(action: fn(via Cell, via Cell) -> (), flag: bool) -> int {
    let mut left = Cell.{ count: 1 }
    let mut right = Cell.{ count: 2 }
    left.count += 1
    right.count += 1
    if flag { action(^mut left, ref right) }
    else { action(mut left, ^mut right) }
    left.count
}
-- @revision
pub fn apply(action: fn(via Cell, via Cell) -> (), flag: bool) -> int {
-- ^ E0552
    let mut left = Cell.{ count: 1 }
    let mut right = Cell.{ count: 2 }
    left.count += 1
    right.count += 1
    if flag { action(^mut left, ^mut right) }
    else { action(mut left, ref right) }
    left.count
}

-- @case higher_order_writable_and_plain_instantiations_are_independent compile-pass
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
fn relay(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { apply(action, cell) }
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn read(via cell: Cell) -> int { cell.count }
fn run() -> int {
    let snapshot = Cell.{ count: 12 }
    let mut live = Cell.{ count: 29 }
    relay(read, snapshot) + relay(change, mut live)
}

-- @case higher_order_argument_demands_survive_recursion_and_named_values compile-fail E0520
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell, recur: bool) -> int {
    if recur { apply(action, cell, false) } else { action(cell) }
}
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn invalid() -> int {
    let snapshot = Cell.{ count: 41 }
    let action = change
    apply(action, snapshot, true)
    -- ^ E0520
}

-- @case consuming_callback_revokes_the_forwarded_argument_in_the_invoker compile-fail E0549
fn use_twice(via action: fn(via Cell) @& -> int, via cell: Cell) -> int {
    let result = action(cell)
    result + cell.count
    -- ^ E0549
}
fn take(via cell: Cell) -> int {
    let moved = new cell
    moved.count
}
fn invalid() -> int { use_twice(take, Cell.{ count: 21 }) }

-- @case consuming_callback_revokes_old_views_across_wrappers compile-fail E0549
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
fn relay(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { apply(action, cell) }
fn observe(via action: fn(via Cell) @& -> int, via cell: Cell) -> int {
    let ref view = ref cell
    let result = relay(action, cell)
    result + view.count
    -- ^ E0549
}
fn take(via cell: Cell) -> int {
    let moved = new cell
