pub type Action = fn() -> int
pub type Update = fn(mut Draft<[]Action>) &mut -> ()
pub fn edited(base: []Action, spare: []Action, update: Update) -> []Action {
-- ^ E0552
    derive(spare, update)
}

-- @case member_via_on_concrete_value_array_is_rejected compile-fail E0550
fn bad(xs: [via]int) -> int { xs[0] }
-- ^ E0550

-- @case member_via_on_concrete_value_map_is_rejected compile-fail E0550
fn bad(m: [str: via str]) -> int { len(m) }
-- ^ E0550

-- @case via_on_closed_value_only_generic_domain_is_rejected compile-fail E0550
fn bad<T: int | f64>(via x: T) -> T { x }
-- ^ E0550

-- @case unused_via_parameter_is_rejected compile-fail E0550
fn bad(via a: Cell, via b: Cell) -> int { a.count }
-- ^ E0550

-- @case single_mode_new_via_parameter_is_rejected compile-fail E0550
fn bad(via c: Cell) -> new Cell { new c }
-- ^ E0550

-- @case redundant_let_via_wildcard_is_rejected compile-fail E0550
fn bad(via c: Cell) -> int {
    let via _ = c
    -- ^ E0550
    c.count
}

-- @case redundant_if_let_via_binding_free_is_rejected compile-fail E0550
fn bad(via opt: ?Cell) -> bool {
    if let via None = opt {
    -- ^ E0550
        true
    } else {
        false
    }
}

-- @case redundant_shorthand_let_via_fixed_field_is_rejected compile-fail E0550
fn bad(via c: Cell) -> int {
    let fixed = .{ child: Cell.{ count: 1 } }
    let via .{ child } = fixed
    -- ^ E0550
    c.count + child.count
}

-- @case partial_wildcard_inside_via_record_and_match_is_allowed compile-pass
fn pick_field(via box: .{ via first: Cell, second: Cell }) -> infer Cell {
    let via .{ first, second: _ } = box
    first
}
fn pick_match(via box: .{ via first: Cell, tag: int }, via fallback: Cell) -> infer Cell {
    match via box {
        .{ first, tag: 1 } -> first
        _ -> fallback
    }
}

-- @case via_on_value_backed_nominal_rejected compile-fail E0550
type UserId(int)
fn bad(via x: UserId) -> UserId { x }
-- ^ E0550

-- @case via_on_value_only_nominal_union_rejected compile-fail E0550
type UserId(int)
fn bad<T: int | UserId>(via x: T) -> T { x }
-- ^ E0550

-- @case opaque_value_to_shared_breaks_compatibility compat-fail E0552
-- @baseline
pub opaque type Token(int)
pub fn make(x: int) -> Token { Token::(x) }
-- @revision
pub opaque type Token(.{ id: int })
pub fn make(x: int) -> new Token { Token::(.{ id: x }) }

-- @case opaque_value_to_value_preserves_compatibility compat-pass
-- @baseline
pub opaque type Token(int)
pub fn make() -> Token { Token::(1) }
-- @revision
pub opaque type Token(str)
pub fn make() -> Token { Token::("one") }
