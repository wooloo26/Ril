fn invalid(x: Cell) -> infer Cell { x }
-- ^ E0412

-- @case concrete_value_has_no_mode_family compile-fail E0550
fn invalid(via x: int) -> int { x }
-- ^ E0550

-- @case higher_order_infer_requires_a_lexical_via_input compile-fail E0412
fn invalid(callback: fn(Cell) -> infer Cell) -> () {}
-- ^ E0412

-- @case standalone_via_field_cannot_supply_a_callable_input_mode compile-fail E0412
type Invalid = .{ via callback: fn() -> infer Cell }
-- ^ E0412

-- @case higher_order_infer_accepts_its_own_mode_input compile-pass
type Transform = fn(via Cell) @& -> infer Cell
fn accept(callback: Transform) -> () {}

-- @case higher_order_mode_family_rejects_a_fixed_writer compile-fail E0407
fn use_snapshot(via action: fn(via Cell) @& -> ()) -> () {
    let snapshot = Cell.{ count: 41 }
    action(snapshot)
}
fn change(mut cell: Cell) &mut -> () { cell.count += 1 }
fn invalid() -> () {
    use_snapshot(change)
    -- ^ E0407
}

-- @case higher_order_callback_requires_a_writable_forwarded_argument compile-fail E0520
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn invalid() -> int {
    let snapshot = Cell.{ count: 41 }
    apply(change, snapshot)
    -- ^ E0520
}

-- @case higher_order_callback_requires_a_compatible_pair_of_root_modes compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn apply(action: fn(via Cell, via Cell) -> ()) -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    action(^mut cell, ^mut alias)
    cell.count
}
fn run() -> int {
    apply(combine)
    -- ^ E0520
}

-- @case higher_order_callback_mode_pairs_are_checked_per_call_site compile-pass
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn apply(action: fn(via Cell, via Cell) -> (), flag: bool) -> int {
    let mut left = Cell.{ count: 1 }
    let mut right = Cell.{ count: 2 }
    left.count += 1
    right.count += 1
    if flag { action(^mut left, ref right) }
    else { action(mut left, ^mut right) }
    left.count
}
fn run(flag: bool) -> int { apply(combine, flag) }

-- @case higher_order_member_via_callback_modes_are_checked_together compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(mut frame: .{ via left: Cell, via right: Cell }) &mut -> () {
    edit(mut frame.left, ref frame.right)
}
fn apply(action: fn(mut frame: .{ via left: Cell, via right: Cell }) &mut -> ()) -> int {
    let mut frame = .{ mut left: Cell.{ count: 1 }, ^mut right: Cell.{ count: 2 } }
    action(mut frame)
    frame.left.count
}
fn run() -> int {
    apply(combine)
    -- ^ E0520
}

-- @case higher_order_callback_selected_from_a_record_checks_the_mode_pair compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn apply(env: .{ action: fn(via Cell, via Cell) -> () }) -> int {
