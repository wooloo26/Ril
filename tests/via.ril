-- @suite via_compat
-- @default_stage access

-- @prelude
pub type Cell = .{ var count: int }

-- @case changing_published_result_array_length_breaks_compatibility compat-fail E0552
-- @baseline
pub fn batch() -> new []!<int, str> { [Ok(1), Ok(2)] }
-- @revision
pub fn batch() -> new []!<int, str> { [Ok(1), Ok(2), Ok(3)] }
-- ^ E0552

-- @case changing_array_values_preserves_the_result_layout compat-pass
-- @baseline
pub fn batch() -> new []!<int, str> { [Ok(1), Ok(2)] }
-- @revision
pub fn batch() -> new []!<int, str> { [Ok(3), Err("failed")] }

-- @case domain_tightened compat-fail E0552
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count += 1; c.count }
-- ^ E0552

-- @case equivalent_via_revision compat-pass
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count + 0 }

-- @case plain_reception_restricts_a_via_mode_in_each_snapshot_context compile-fail E0550
fn plain(value: Cell) -> Cell { value }
fn forward(via source: Cell) -> Cell { plain(source) }
-- ^ E0550
fn freeze(via source: Cell) -> Cell { let fixed = source; fixed }
-- ^ E0550
fn pack(via source: Cell) -> .{ item: Cell } {
-- ^ E0550
    let packed = .{ item: source }
    packed
}
fn returned(via source: Cell) -> Cell { source }
-- ^ E0550
fn run() -> int {
    let item = Cell.{ count: 1 }
    forward(item).count + freeze(item).count + pack(item).item.count + returned(item).count
}

-- @case plain_reception_does_not_implicitly_handoff_a_via_new_local compile-fail E0520
fn read(via source: Cell) -> Cell { source }
fn run() -> int {
    read(Cell.{ count: 1 }).count
    -- ^ E0520
}

-- @case adding_derive_can_tighten_a_published_via_domain compat-fail E0552
-- @baseline
pub fn update(via box: .{ via item: Cell, var stamp: int }) -> Cell {
    let copy = Cell.{ count: box.item.count + 1 }
    copy
}
-- @revision
pub fn update(via box: .{ via item: Cell, var stamp: int }) -> Cell {
-- ^ E0552
    derive(box.item) \mut draft -> { draft.count += 1 }
}

-- @case adding_a_snapshot_requirement_on_new_input_breaks_compatibility compat-fail E0552
-- @baseline
pub fn read(new input: .{ ^mut item: Cell }) -> int { input.item.count }
-- @revision
pub fn read(new input: .{ ^mut item: Cell }) -> int {
-- ^ E0552
    let snapshot = new input
    snapshot.item.count
}

-- @case freezing_only_a_child_relaxes_the_snapshot_contract compat-pass
-- @baseline
pub fn read(new input: .{ mut item: Cell, ^mut other: Cell }) -> int {
    let snapshot = new input
    snapshot.item.count
}
-- @revision
fn read_cell(new input: Cell) -> int {
    let snapshot = new input
    snapshot.count
}
pub fn read(new input: .{ mut item: Cell, ^mut other: Cell }) -> int {
    let mut held = new input
    read_cell(new held.item)
}

-- @case passing_new_live_boundaries_to_an_existing_callback_breaks_compatibility compat-fail E0552
-- @baseline
pub fn apply(action: fn(new .{ item: Cell }) -> int, new input: .{ item: Cell }) -> int {
    action(new .{ item: input.item })
}
-- @revision
pub fn apply(action: fn(new .{ item: Cell }) -> int, new input: .{ item: Cell }) -> int {
-- ^ E0552
    action(new input)
}

-- @case strengthening_a_private_callback_snapshot_contract_breaks_compatibility compat-fail E0552
-- @baseline
pub type Shelf = .{ ^mut item: Cell }
pub type Leaf = fn(new Shelf) -> int
fn selected(new shelf: Shelf) -> int { shelf.item.count }
pub fn supply(action: fn(Leaf, new Shelf) -> int, new shelf: Shelf) -> int {
    action(selected, new shelf)
}
-- @revision
pub type Shelf = .{ ^mut item: Cell }
pub type Leaf = fn(new Shelf) -> int
fn selected(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count }
pub fn supply(action: fn(Leaf, new Shelf) -> int, new shelf: Shelf) -> int {
-- ^ E0552
    action(selected, new shelf)
}

-- @case relaxing_a_renamed_private_callback_snapshot_contract_preserves_compatibility compat-pass
-- @baseline
pub type Shelf = .{ ^mut item: Cell }
pub type Leaf = fn(new Shelf) -> int
fn selected(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count }
pub fn supply(action: fn(Leaf, new Shelf) -> int, new shelf: Shelf) -> int {
    action(selected, new shelf)
}
-- @revision
pub type Shelf = .{ ^mut item: Cell }
pub type Leaf = fn(new Shelf) -> int
fn unrelated() -> int { 0 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
pub fn supply(action: fn(Leaf, new Shelf) -> int, new shelf: Shelf) -> int {
    action(count, new shelf)
}

-- @case strengthening_a_returned_callback_snapshot_contract_breaks_compatibility compat-fail E0552
-- @baseline
pub type Shelf = .{ ^mut item: Cell }
pub type Leaf = fn(new Shelf) -> int
fn selected(new shelf: Shelf) -> int { shelf.item.count }
pub fn make() -> Leaf { selected }
-- @revision
pub type Shelf = .{ ^mut item: Cell }
pub type Leaf = fn(new Shelf) -> int
fn selected(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count }
pub fn make() -> Leaf { selected }
-- ^ E0552

-- @case relaxing_a_stored_callback_snapshot_contract_is_compatible compat-pass
-- @baseline
pub type Shelf = .{ ^mut item: Cell }
pub type Slot = .{ var action: fn(new Shelf) -> int }
fn selected(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count }
pub fn install(mut slot: Slot) &mut -> () { slot.action = selected }
-- @revision
pub type Shelf = .{ ^mut item: Cell }
pub type Slot = .{ var action: fn(new Shelf) -> int }
fn count(new shelf: Shelf) -> int { shelf.item.count }
pub fn install(mut slot: Slot) &mut -> () { slot.action = count }

-- @case freezing_through_nested_via_calls_preserves_existing_sources compile-fail E0535
type Shelf = .{ ^mut item: Cell }
fn freeze(via input: Shelf) -> Shelf {
    let snapshot = new input
    snapshot
}
fn relay(via input: Shelf) -> Shelf { freeze(input) }
fn observe() -> int {
    let mut live = Cell.{ count: 1 }
    let mut shelf = Shelf.{ item: ^mut live }
    shelf.item.count += 1
    let before = relay(new shelf)
    -- ^ E0535
    live.count += 8
    before.item.count
}

-- @case freezing_through_a_local_via_closure_checks_live_sources compile-fail E0535
type Shelf = .{ ref item: Cell }
fn observe() -> int {
    let freeze = \via input: Shelf -> { let snapshot = new input; snapshot }
    let mut live = Cell.{ count: 1 }
    let mut shelf = Shelf.{ item: ref live }
    let before = freeze(new shelf)
    -- ^ E0535
    live.count += 8
    before.item.count
}

-- @case exclusive_mut_argument_of_via_aliased_arguments_excludes_the_shared_pair compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    combine(^mut cell, ^mut alias)
    -- ^ E0520
    cell.count
}

-- @case exclusive_mut_argument_of_via_arguments_allows_forwarding_mixed_modes compile-pass
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn relay(via left: Cell, via right: Cell) -> () { combine(left, right) }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let mut other = Cell.{ count: 2 }
    let ^mut alias = other
    alias.count += 1
    relay(mut cell, ^mut alias)
    cell.count
}

-- @case forwarding_via_through_a_known_closure_preserves_joint_restrictions compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn relay(via left: Cell, via right: Cell) -> () {
    let combine = \via writer: Cell, via reader: Cell -> edit(mut writer, ref reader)
    combine(left, right)
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    relay(^mut cell, ^mut alias)
    -- ^ E0520
    cell.count
}

-- @case repeated_via_forwarding_allows_shared_or_readonly_arguments compile-pass
fn read(via left: Cell, via right: Cell) -> int { left.count + right.count }
fn twice(via input: Cell) -> int { read(input, input) }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 2
    twice(^mut cell) + twice(ref cell)
}

-- @case a_closure_passing_captured_via_inputs_as_mut_restricts_their_enclosing_domain compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () {
    let ^mut action = \ -> edit(mut left, ref right)
    action()
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    combine(^mut cell, ^mut alias)
    -- ^ E0520
    cell.count
}

-- @case forwarding_captured_via_inputs_preserves_the_joint_domain compile-fail E0520
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
fn relay(via left: Cell, via right: Cell) -> () {
    let ^mut action = \ -> combine(left, right)
    action()
}
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    let ^mut alias = cell
    alias.count += 1
    relay(^mut cell, ^mut alias)
    -- ^ E0520
    cell.count
}

-- @case repeated_via_forwarding_rejects_exclusive_overlaps compile-fail E0520
fn read(via left: Cell, via right: Cell) -> int { left.count + right.count }
fn twice(via input: Cell) -> int { read(input, input) }
fn run() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 2
    twice(mut cell)
    -- ^ E0520
}

-- @case excluding_a_joint_via_row_breaks_compatibility compat-fail E0552
-- @baseline
pub fn combine(via left: Cell, via right: Cell) -> () { left.count += right.count }
-- @revision
fn edit(mut writer: Cell, ref reader: Cell) &mut -> () { writer.count += reader.count }
pub fn combine(via left: Cell, via right: Cell) -> () { edit(mut left, ref right) }
-- ^ E0552

-- @case changing_formal_origins_in_externally_stored_members_breaks_compatibility compat-fail E0552
-- @baseline
pub type Shelf = .{ var ^mut left: Cell, var ^mut right: Cell }
pub fn store(mut shelf: Shelf, ^mut a: Cell, ^mut b: Cell) &mut &^mut -> () {
    shelf.left = ^mut a
    shelf.right = ^mut b
}
-- @revision
pub type Shelf = .{ var ^mut left: Cell, var ^mut right: Cell }
pub fn store(mut shelf: Shelf, ^mut a: Cell, ^mut b: Cell) &mut &^mut -> () {
-- ^ E0552
    shelf.left = ^mut b
    shelf.right = ^mut a
}

-- @case making_a_guaranteed_store_conditional_breaks_compatibility compat-fail E0552
-- @baseline
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell, flag: bool) &mut &^mut -> () {
    shelf.item = ^mut value
}
-- @revision
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell, flag: bool) &mut &^mut -> () {
-- ^ E0552
    if flag { shelf.item = ^mut value }
}

-- @case a_helper_can_keep_the_same_published_storage_contract compat-pass
-- @baseline
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut source: Cell) &mut &^mut -> () { shelf.item = ^mut source }
-- @revision
pub type Shelf = .{ var ^mut item: Cell }
fn write(mut shelf: Shelf, ^mut source: Cell) &mut &^mut -> () { shelf.item = ^mut source }
pub fn store(mut shelf: Shelf, ^mut source: Cell) &mut &^mut -> () { write(mut shelf, ^mut source) }

-- @case recursion_can_keep_a_guaranteed_storage_contract compat-pass
-- @baseline
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell, flag: bool) &mut &^mut -> () {
    shelf.item = ^mut value
}
-- @revision
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell, flag: bool) &mut &^mut -> () {
    if flag { store(mut shelf, ^mut value, false) }
    else { shelf.item = ^mut value }
}

-- @case local_closure_keeps_the_exported_storage_contract compat-pass
-- @baseline
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
-- @revision
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    let replace = \mut dst: Shelf, ^mut stored: Cell -> { dst.item = ^mut stored }
    replace(mut shelf, ^mut value)
}

-- @case mutual_recursion_publishes_both_replacement_sources compile-pass
pub type Shelf = .{ var ^mut item: Cell, var ^mut other: Cell }
pub fn store(mut shelf: Shelf, ^mut a: Cell, ^mut b: Cell, flag: bool) &mut &^mut -> () {
    if flag { relay(mut shelf, ^mut b, ^mut a) }
    else {
        shelf.item = ^mut a
        shelf.other = ^mut b
    }
}
fn relay(mut shelf: Shelf, ^mut a: Cell, ^mut b: Cell) &mut &^mut -> () {
    store(mut shelf, ^mut a, ^mut b, false)
}

-- @case adding_an_operation_to_a_published_effect_breaks_compatibility compat-fail E0552
-- @baseline
pub eff Meter { fn read() -> int; fn reset() -> () }
pub fn report() @Meter -> int { Meter::read() }
-- @revision
pub eff Meter { fn read() -> int; fn reset() -> () }
pub fn report() @Meter -> int { Meter::reset(); Meter::read() }
-- ^ E0552

-- @case alias_dispatch_can_write_one_of_two_destinations compile-pass
pub type Shelf = .{ var ^mut item: Cell, var ^mut spare: Cell }
fn first(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn second(mut shelf: Shelf, ^mut value: Cell) &mut &^mut -> () {
    shelf.spare = ^mut value
}
pub fn store(mut shelf: Shelf, ^mut value: Cell, choose_first: bool) &mut &^mut -> () {
    let write = if choose_first { first } else { second }
    write(mut shelf, ^mut value)
}

-- @case alias_call_forwards_a_via_member_reception compile-fail E0520
fn change(via value: Cell) -> () { value.count += 1 }
fn relay(mut shelf: .{ via item: Cell }) &mut -> () {
    let write = change
    write(shelf.item)
}
fn invalid() -> () {
    let mut shelf = .{ item: Cell.{ count: 42 } }
    relay(mut shelf)
    -- ^ E0520
}

-- @case recursive_store_can_preserve_the_entry_value compile-pass
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell, n: int) &mut &^mut -> () {
    if n > 0 { store(mut shelf, ^mut value, n - 1) }
    else if n == 0 { shelf.item = ^mut value }
}

-- @case propagation_can_exit_before_a_storage_update compile-pass
pub type Shelf = .{ var ^mut item: Cell }
pub fn store(mut shelf: Shelf, ^mut value: Cell, status: !<(), str>) &mut &^mut -> new !<(), str> {
    status?
    shelf.item = ^mut value
    Ok()
}

-- @case signature_format compile-pass no-prelude
-- @expect-sig square "fn square(x: int) -> int"
fn square(x: int) -> int { x * x }

