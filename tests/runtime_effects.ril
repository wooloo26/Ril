-- @case effects_with_same_operation_names_keep_distinct_evidence run-pass backend=both
-- @expect-stdout 12:34
use ril/io
eff First { fn read() -> int }
eff Second { fn read() -> int }
fn main() @io -> () {
    with First::read = \-> 12
    with Second::read = \-> 34
    Io::println("{First::read()}:{Second::read()}")
}

-- @case inferred_propagation_returns_widened_error run-pass backend=both
-- @expect-stdout first
use ril/io
type Basic { First }
type Extended { ..Basic; Second }
fn first() -> new !<int, Basic> { Err(Basic::First) }
fn second() -> new !<int, Extended> { Ok(3) }
fn main() @io -> () {
    let sum = \-> {
        let a = first()?
        Ok(a + second()?)
    }
    match sum() {
        Ok(_) -> Io::println("success")
        Err(Basic::First) -> Io::println("first")
        Err(Extended::Second) -> Io::println("second")
    }
}

-- @case spread_effect_dispatches_to_original_operation run-pass backend=both
fn invoke() @Combined -> int { Combined::read() }
eff Root { fn read() -> int }
eff Middle { ..Root }
eff Combined { ..Middle; fn extra() -> () }
fn main() -> () {
    with Root::read = \-> 42
    assert(invoke() == 42)
}

-- @case panic_boundary_accepts_first_class_action_and_opaque_info run-pass backend=both
-- @expect-stdout expected failure
use ril/io
use ril/panic
fn fail() -> int { panic("expected failure") }
fn main() @io -> () {
    let action = fail
    let caught: !<int, Panic::Error> = Panic::recover(action)
    match caught {
        Ok(_) -> panic("panic should have been recovered")
        Err(Panic::Error::Panicked(info)) -> {
            assert(String::inspect(info) == "<Report>")
            Io::println(Panic::message(info))
        }
    }
}

-- @case different_generic_effect_instances_keep_distinct_evidence run-pass backend=both
eff State<T> { fn read() -> T; fn decode(data: T) -> int }
fn int_value() @State<int> -> int { State<int>::read() }
fn main() -> () {
    with {
        State<int>::read = \-> 42
        State<str>::read = \-> "six"
        State<str>::decode = \data -> len(data)
        assert(int_value() == 42)
        assert(State<str>::decode(State<str>::read()) == 3)
    }
}

-- @case polymorphic_named_effect_dispatch_specializes_evidence run-pass backend=both
eff State<T> { fn read() -> T }
fn read<T>() @State<T> -> T { State<T>::read() }
fn main() -> () {
    with {
        State<int>::read = \-> 40
        State<str>::read = \-> "ok"
        assert(read<int>() == 40)
        assert(read<str>() == "ok")
    }
}

-- @case generic_effect_spread_substitutes_arguments_transitively run-pass backend=both
eff State<T> { fn read() -> T }
eff Mid<T> { ..State<T> }
eff Large<T> { ..Mid<T>; fn extra() -> () }
fn read<T>() @Large<T> -> T { Large<T>::read() }
fn main() -> () {
    with {
        Mid<int>::read = \-> 42
        State<str>::read = \-> "value"
        assert(read<int>() == 42)
        assert(read<str>() == "value")
    }
}

-- @case escaping_closure_writes_its_callers_actual_capture run-pass backend=both
type Counter = .{ var count: int }
type Tick = fn() &up -> int
fn counter(^mut state: Counter) &capture &^mut &return(^mut state) -> new Tick {
    \-> { state.count += 1; state.count }
}
fn main() -> () {
    let mut state = Counter.{ count: 0 }
    let ^mut tick = counter(^mut state)
    assert(tick() == 1 && tick() == 2 && state.count == 2)
}

-- @case invoking_a_stored_closure_exercises_its_container_and_captures run-pass backend=both
type Counter = .{ var count: int }
fn main() -> () {
    let mut state = Counter.{ count: 0 }
    let ^mut current = state
    let mut callbacks = .{ ^mut tick: \-> { current.count += 1; current.count } }
    assert((callbacks.tick)() == 1 && current.count == 1 && state.count == 1)
}

-- @case abstract_mutable_callable_writes_its_formal run-pass backend=both
type Tick = fn() &up -> int
fn tick(mut callback: Tick) &mut -> int { callback() }
fn main() -> () {
    var count = 0
    let ^mut callback = \-> { count += 1; count }
    assert(tick(mut callback) == 1)
}

-- @case isolated_closure_in_new_return_handles_its_own_panic run-pass backend=both
use ril/panic
fn protected(values: []int) -> new !<int, Panic::Error> {
    Panic::recover \-> {
        match values?[1] {
            Some(v) -> v
            None -> panic("missing element 1")
        }
    }
}
fn main() -> () {
    let Err(Panic::Error::Panicked(info)) = protected([1]) else { panic("expected error") }
    assert(len(Panic::message(info)) > 0)
}

-- @case draft_updates_only_the_selected_occurrence run-pass backend=both
-- @expect-stdout 1:1:3:1:8:7:7
use ril/io
type Cell = .{ count: int }
fn main() @io -> () {
    let first = Cell.{ count: 1 }
    let outside = Cell.{ count: 7 }
    let row = [first]
    let base = (row, row)
    let updated = derive(base) \mut draft -> {
        Array::push(mut draft.0, outside)
        Array::push(mut draft.0, outside)
        draft.0[1].count = 8
    }
    assert(len(base.0) == 1 && len(base.1) == 1)
    assert(len(updated.0) == 3 && len(updated.1) == 1)
    assert(updated.0[1].count == 8 && updated.0[2].count == 7 && outside.count == 7)
    Io::println("{len(base.0)}:{len(base.1)}:{len(updated.0)}:{len(updated.1)}:{updated.0[1].count}:{updated.0[2].count}:{outside.count}")
}

-- @case draft_inserts_map_entry_without_changing_base run-pass backend=both
-- @expect-stdout 1:2:10:20
use ril/io
fn main() @io -> () {
    let base = [1: 10]
    let updated = derive(base) \mut draft -> { draft[2] = 20 }
    assert(len(base) == 1 && base?[2] == None)
    assert(len(updated) == 2 && updated?[1] == Some(10) && updated?[2] == Some(20))
    let Some(first) = updated?[1] else { panic("missing original entry") }
    let Some(second) = updated?[2] else { panic("missing inserted entry") }
    Io::println("{len(base)}:{len(updated)}:{first}:{second}")
}

-- @case draft_can_replace_a_fixed_tuple_member_with_a_shorter_array run-pass backend=both
-- @expect-stdout 2:1:2:7
use ril/io
type Cell = .{ count: int }
fn main() @io -> () {
    let row = [Cell.{ count: 1 }, Cell.{ count: 7 }]
    let base = (row, row)
    let updated = derive(base) \mut draft -> { draft.0 = [row[1]] }
    assert(len(updated.0) == 1)
    Io::println("{len(base.0)}:{len(updated.0)}:{len(updated.1)}:{updated.0[0].count}")
}

-- @case draft_writes_to_the_current_path_after_reordering run-pass backend=both
-- @expect-stdout 1:7:7:2:1:7
use ril/io
type Cell = .{ count: int }
fn main() @io -> () {
    let row = [Cell.{ count: 1 }, Cell.{ count: 7 }]
    let base = (row, row)
    let updated = derive(base) \mut draft -> {
        draft.0 = [row[1], row[0]]
        draft.0[1].count = 2
    }
    assert(len(updated.0) == 2 && len(updated.1) == 2)
    Io::println("{base.0[0].count}:{base.0[1].count}:{updated.0[0].count}:{updated.0[1].count}:{updated.1[0].count}:{updated.1[1].count}")
}

-- @case aborted_derive_preserves_the_base_and_inserted_source run-pass backend=both
-- @expect-stdout 2:1:7:7
use ril/io
use ril/panic
type Cell = .{ count: int }
fn main() @io -> () {
    let outside = Cell.{ count: 7 }
    let row = [Cell.{ count: 1 }, outside]
    let base = (row, row)
    let caught = Panic::recover \-> {
        let _ = derive(base) \mut draft -> {
            Array::push(mut draft.0, outside)
            if len(ref draft.0) > 1 { draft.0[1].count = 8 }
            panic("aborted derive")
        }
    }
    let Err(Panic::Error::Panicked(_)) = caught else { panic("derive unexpectedly published") }
    Io::println("{len(base.0)}:{base.0[0].count}:{base.0[1].count}:{outside.count}")
}

-- @case empty_record_and_unit_payload_sums_are_draft_roots run-pass backend=both
type Kind { Present(); Empty }
fn main() -> () {
    let empty = derive(.{}) \mut _ -> ()
    let some = derive(Some()) \mut _ -> ()
    let tagged = derive(Kind::Present()) \mut _ -> ()
    assert(empty == .{} && some == Some(()) && tagged == Kind::Present(()))
    let option = Some
    let variant = Kind::Present
    assert(option(()) == some && variant(()) == tagged)
    let Some() = some else { panic("unit payload was lost") }
    let Kind::Present() = tagged else { panic("unit payload was lost") }
}

-- @case aborted_draft_dispatches_body_and_cleanup_effects run-panic "aborted draft" backend=both
-- @expect-stdout 5:8
use ril/io
eff Report { fn emit(value: int) -> () }
opaque type Event(.{ value: int })
fn record(event: Event) @Report -> () { Report::emit(event.value) }
fn main() @io -> () {
    with Report::emit = \value: int -> {
        if value == 5 { Io::print("5:") } else { Io::println("{value}") }
    }
    let shared = [1, 7]
    let base = (shared, shared)
    let _ = derive(base) \mut draft -> {
        let finish = Event::(.{ value: 8 })
        defer record(finish)
        Report::emit(5)
        Array::push(mut draft.0, 7)
        panic("aborted draft")
    }
}

-- @case draft_matches_and_updates_active_variant_payload run-pass backend=both
type Cell = .{ count: int }
type Kind { Present(Cell); Empty }
fn main() -> () {
    let base = Kind::Present(Cell.{ count: 7 })
    let updated = derive(base) \mut draft -> {
        match draft {
            Kind::Present(mut payload) -> { payload.count = 8 }
            Kind::Empty -> ()
        }
    }
    assert(base == Kind::Present(Cell.{ count: 7 }) && updated == Kind::Present(Cell.{ count: 8 }))
}

-- @case mutable_cleanup_changes_the_callers_resource run-pass backend=both
opaque type Handle(.{ var id: int })
fn close(mut handle: Handle) &mut -> () { handle.id = 42 }
fn scope(mut handle: Handle) &mut -> () {
    defer close(mut handle)
    let before = handle.id
    assert(before == 41)
}
fn main() -> () {
    let mut handle = Handle::(.{ id: 41 })
    scope(mut handle)
    assert(handle.id == 42)
}

-- @case draft_inner_writes_nominal_tuple_coordinates run-pass backend=both
type Pair(int, int)
fn main() -> () {
    let base = Pair::(1, 2)
    let updated = derive(base) \mut draft -> {
        inner(mut draft).0 = 41
        (draft |> mut inner).1 += 1
    }
    assert(inner(base) == (1, 2) && inner(updated) == (41, 3))
}

-- @case proved_map_invariants_slice_and_unreachable_runtime run-pass backend=both
type ValidSpan = \s: .{ lo: int, hi: int } -> if s.lo <= s.hi { <()> } else { <never> }
type Port(int) |> Between(1, 65535)
type Span(.{ lo: int, hi: int }) |> ValidSpan

fn get_key(m: [str: int], k: str |> In(m)) -> int { m[k] }
fn slice_window(xs: []int, a: int, b: int |> AtLeast(a)) -> new []int |> Len(b - a) {
    if 0 <= a && b <= len(xs) {
        xs[a..b]
    } else {
        Array::repeat(0, b - a)
    }
}

fn main() -> () {
    let mut scores: [str: int] = ["ada": 10]
    scores["grace"] = 20
    scores["ada"] += 5
    var sum = 0
    for ref scores as (k, _) {
        sum += scores[k]
    }
    assert(sum == 35 && get_key(clone(ref scores), "ada") == 15)

    let p = Port::(8080)
    let sp = Span::(.{ lo: 2, hi: 5 })
    let span_len = if sp.lo <= sp.hi { sp.hi - sp.lo }
    let xs = [10, 20, 30, 40, 50]
    let win = slice_window(xs, sp.lo, sp.hi)
    assert(inner(p) == 8080 && span_len == 3 && len(win) == 3 && win[0] == 30 && win[2] == 50)
}
