-- @case cloned_callable_uses_dynamic_handler_at_call_site run-pass backend=both
eff Clock { fn tick() -> int }
eff Other { fn tick() -> int }
fn main() -> () {
    var counter = 0
    with Other::tick = \-> { counter += 1; counter }
    let callbacks = [\-> Clock::tick()]
    with Clock::tick = \-> 99
    let copied = clone(callbacks)
    assert(copied[0]() == 99)
    assert(Other::tick() == 1)
}

-- @case clone_ignores_handlers_for_operations_a_named_callable_does_not_use run-pass backend=both
eff Clock { fn now() -> int; fn tick() -> int }
fn main() -> () {
    var counter = 0
    with Clock::tick = \-> { counter += 1; counter }
    with Clock::now = \-> 42
    let copied = clone([now])
    assert(copied[0]() == 42 && Clock::tick() == 1)
}
fn now() @Clock -> int { Clock::now() }

-- @case captured_variable_uses_shared_slot run-pass backend=both
