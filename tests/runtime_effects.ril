-- @suite runtime_effects
-- @default_stage run

-- @case division_by_zero_unwinds run-panic "integer division by zero" backend=both
fn divide(n: int) -> int { 20 / n }
fn main() -> () { let _ = divide(0) }

-- @case negative_shift_unwinds run-panic "negative shift count" backend=both
fn shift(n: int) -> int { 15 << n }
fn main() -> () { let _ = shift(-1) }

-- @case cleanup_runs_in_reverse_order run-pass backend=both
-- @expect-stdout second
-- @expect-stdout first
opaque type Resource(.{ message: str }) use(close)
fn acquire(message: str) -> new Resource { Resource::(.{ message }) }
fn close(new resource: Resource) @io -> () { println(resource.message) }
fn main() @io -> () {
    use first = acquire("first")
    use second = acquire("second")
}

-- @case panic_runs_cleanup run-panic "failure" backend=both
-- @expect-stdout cleanup
opaque type Resource(.{ id: int }) use(close)
fn close(new resource: Resource) @io -> () { println("cleanup") }
fn main() @io -> () {
    use resource = Resource::(.{ id: 1 })
    panic("failure")
}

-- @case panic_runs_both_cleanups_through_their_installed_handler run-panic "failure" backend=both
-- @expect-stdout second
-- @expect-stdout first
eff Finalize { fn report(message: str) -> () }
opaque type Resource(.{ message: str }) use(close)
fn close(new resource: Resource) @Finalize -> () { Finalize::report(resource.message) }
fn main() @io -> () {
    with Finalize::report = \message: str -> println(message)
    use first = Resource::(.{ message: "first" })
    use second = Resource::(.{ message: "second" })
    panic("failure")
}

-- @case double_panic_aborts run-abort backend=both
opaque type Bomb(.{ id: int }) use(detonate)
fn detonate(new _b: Bomb) -> () { panic("second") }
fn main() -> () {
    let outcome = absorb_panic \-> {
        use _b = Bomb::(.{ id: 1 })
        panic("first")
    }
    match outcome { Ok(_) -> (); Err(_) -> () }
}

-- @case lexical_user_effect run-pass backend=both
-- @expect-stdout 42
eff Clock { fn now() -> int }
fn main() @io -> () {
    with Clock::now = \-> 42
    println("{Clock::now()}")
}

-- @case panic_absorption run-pass backend=both
-- @expect-stdout survived
fn main() @io -> () {
    let outcome = absorb_panic \-> { panic("caught") }
    match outcome { Ok(_) -> (); Err(_) -> println("survived") }
}

-- @case evidence_passes_through_call run-pass backend=both
-- @expect-stdout 41
eff Clock { fn now() -> int }
fn time() @Clock -> int { Clock::now() }
fn main() @io -> () {
    with Clock::now = \-> 41
    println("{time()}")
}

-- @case escaping_closure_keeps_lexical_evidence run-pass backend=both
-- @expect-stdout 3
eff Clock { fn now() -> int }
fn factory() -> fn() @Clock -> int {
    with Clock::now = \-> 3
    \-> Clock::now()
}
fn main() @io -> () {
    let clock = factory()
    with Clock::now = \-> 9
    println("{clock()}")
}

-- @case first_class_immutable_capture run-pass backend=both
-- @expect-stdout 16
fn make(x: int) &capture -> fn(int) -> int { \y: int -> x + y }
fn main() @io -> () {
    let f = make(10)
    println("{f(6)}")
}

-- @case cloned_callable_keeps_its_lexical_handler run-pass backend=both
eff Clock { fn tick() -> int }
eff Other { fn tick() -> int }
fn main() -> () {
    var counter = 0
    with Other::tick = \-> { counter += 1; counter }
    let callbacks = {
        with Clock::tick = \-> 42
        [\-> Clock::tick()]
    }
    with Clock::tick = \-> 99
    let copied = clone(callbacks)
    assert(copied[0]() == 42)
    assert(Other::tick() == 1)
}

-- @case clone_ignores_handlers_for_operations_a_named_callable_does_not_use run-pass backend=both
eff Clock { fn now() -> int; fn tick() -> int }
fn main() -> () {
    var counter = 0
    with Clock::tick = \-> { counter += 1; counter }
    with Clock::now = \-> 42
    let copied = clone([now])
    assert(copied[0]() == 42 && Clock::tick() == 1)
}
fn now() @Clock -> int { Clock::now() }

-- @case captured_variable_uses_shared_slot run-pass backend=both
-- @expect-stdout 2:3:3
fn main() @io -> () {
    var count = 1
    let ^mut next = \-> { count += 1; count }
    let first = next()
    let second = next()
    println("{first}:{second}:{count}")
}

-- @case local_named_fn_uses_captured_slots run-pass backend=both
-- @expect-stdout 6
fn total(n: int) -> int {
    var sum = 1
    add(n)
    sum
where
    fn add(value: int) &up(var sum) -> () { sum += value }
}
fn main() @io -> () { println("{total(5)}") }

-- @case draft_changes_only_the_copy run-pass backend=both
-- @expect-stdout 3:5:2
type Profile = .{ count: int, values: []int }
fn main() @io -> () {
    let base = Profile.{ count: 3, values: [1] }
    let updated = derive(base) \mut draft -> {
        draft.count = 5
        Array::push(mut draft.values, 2)
    }
    println("{base.count}:{updated.count}:{len(updated.values)}")
}

-- @case derive_receives_via_snapshots_through_projections_and_callbacks run-pass backend=both
type Cell = .{ count: int }
fn forward(
    action: fn(via .{ via item: Cell, var stamp: int }) -> Cell,
    via box: .{ via item: Cell, var stamp: int },
) -> Cell {
    action(box)
}
fn member(via box: .{ via item: Cell, var stamp: int }) -> Cell {
    derive(box.item) \mut draft -> { draft.count += 1 }
}
fn replace(via box: .{ via item: Cell, var stamp: int }) -> []Cell {
    let base = [Cell.{ count: 1 }]
    derive(base) \mut draft -> { draft[0] = box.item }
}
fn main() -> () {
    let item = Cell.{ count: 4 }
    let fixed = .{ mut item: Cell.{ count: 6 }, var stamp: 0 }
    let mut writer = .{ item, var stamp: 0 }
    writer.stamp += 1
    assert(forward(member, fixed).count == 7 && fixed.item.count == 6)
    assert(forward(member, mut writer).count == 5 && writer.item.count == 4)
    assert(member(fixed).count == 7 && fixed.item.count == 6)
    assert(member(mut writer).count == 5 && writer.item.count == 4)
    assert(replace(fixed)[0].count == 6)
}

-- @case local_effect_dispatches_through_its_handler run-pass backend=both
-- @expect-stdout 42
fn main() @io -> () {
    with Shift::apply = \left, right -> left - right
    println("{Shift::apply(right: 1, left: 43)}")
where
    eff Shift { fn apply(left: int, right: int) -> int }
}

-- @case effects_with_same_operation_names_keep_distinct_evidence run-pass backend=both
-- @expect-stdout 12:34
eff First { fn read() -> int }
eff Second { fn read() -> int }
fn main() @io -> () {
    with First::read = \-> 12
    with Second::read = \-> 34
    println("{First::read()}:{Second::read()}")
}

-- @case inferred_propagation_returns_widened_error run-pass backend=both
-- @expect-stdout first
type Basic { First }
type Extended { ..Basic; Second }
fn first() -> new !<int, Basic> { Err(Basic::First) }
fn second() -> new !<int, Extended> { Ok(3) }
fn main() @io -> () {
    let sum = \-> {
        let a = first()?
        Ok(a + second()?)
    }
    match sum() {
        Ok(_) -> println("success")
        Err(Basic::First) -> println("first")
        Err(Extended::Second) -> println("second")
    }
}

-- @case spread_effect_dispatches_to_original_operation run-pass backend=both
fn invoke() @Combined -> int { Combined::read() }
eff Root { fn read() -> int }
eff Middle { ..Root }
eff Combined { ..Middle; fn extra() -> () }
fn main() -> () {
    with Root::read = \-> 42
    assert(invoke() == 42)
}

-- @case panic_boundary_accepts_first_class_action_and_opaque_info run-pass backend=both
-- @expect-stdout expected failure
fn fail() -> int { panic("expected failure") }
fn main() @io -> () {
    let action = fail
    let caught: !<int, PanicError> = absorb_panic(action)
    match caught {
        Ok(_) -> panic("panic should have been absorbed")
        Err(PanicError::Panicked(info)) -> {
            assert(String::inspect(info) == "<PanicInfo>")
            println(panic_message(info))
        }
    }
}

-- @case different_generic_effect_instances_keep_distinct_evidence run-pass backend=both
eff State<T> { fn read() -> T; fn decode(data: T) -> int }
fn int_value() @State<int> -> int { State<int>::read() }
fn main() -> () {
    with {
        State<int>::read = \-> 42
        State<str>::read = \-> "six"
        State<str>::decode = \data -> len(data)
    }
    assert(int_value() == 42)
    assert(State<str>::decode(State<str>::read()) == 3)
}

-- @case polymorphic_named_effect_dispatch_specializes_evidence run-pass backend=both
eff State<T> { fn read() -> T }
fn read<T>() @State<T> -> T { State<T>::read() }
fn main() -> () {
    with {
        State<int>::read = \-> 40
        State<str>::read = \-> "ok"
    }
    assert(read<int>() == 40)
    assert(read<str>() == "ok")
}

-- @case generic_effect_spread_substitutes_arguments_transitively run-pass backend=both
eff State<T> { fn read() -> T }
eff Mid<T> { ..State<T> }
eff Large<T> { ..Mid<T>; fn extra() -> () }
fn read<T>() @Large<T> -> T { Large<T>::read() }
fn main() -> () {
    with {
        Mid<int>::read = \-> 42
        State<str>::read = \-> "value"
    }
    assert(read<int>() == 42)
    assert(read<str>() == "value")
}

-- @case escaping_closure_writes_its_callers_actual_capture run-pass backend=both
type Counter = .{ var count: int }
type Tick = fn() &up -> int
fn counter(^mut state: Counter) &capture &^mut &return(^mut state) -> new Tick {
    \-> { state.count += 1; state.count }
}
fn main() -> () {
    let mut state = Counter.{ count: 0 }
    let ^mut tick = counter(^mut state)
    assert(tick() == 1 && tick() == 2 && state.count == 2)
}

-- @case invoking_a_stored_closure_exercises_its_container_and_captures run-pass backend=both
type Counter = .{ var count: int }
fn main() -> () {
    let mut state = Counter.{ count: 0 }
    let ^mut current = state
    let mut callbacks = .{ ^mut tick: \-> { current.count += 1; current.count } }
    assert((callbacks.tick)() == 1 && current.count == 1 && state.count == 1)
}

-- @case abstract_mutable_callable_writes_its_formal run-pass backend=both
type Tick = fn() &up -> int
fn tick(mut callback: Tick) &mut -> int { callback() }
fn main() -> () {
    var count = 0
    let ^mut callback = \-> { count += 1; count }
    assert(tick(mut callback) == 1)
}

-- @case isolated_closure_in_new_return_handles_its_own_panic run-pass backend=both
fn protected(values: []int) -> new !<int, PanicError> {
    absorb_panic \-> values[1]
}
fn main() -> () {
    let Err(PanicError::Panicked(info)) = protected([1]) else { panic("expected error") }
    assert(len(panic_message(info)) > 0)
}

-- @case draft_updates_only_the_selected_occurrence run-pass backend=both
-- @expect-stdout 1:1:3:1:8:7:7
type Cell = .{ count: int }
fn main() @io -> () {
    let first = Cell.{ count: 1 }
    let outside = Cell.{ count: 7 }
    let row = [first]
    let base = (row, row)
    let updated = derive(base) \mut draft -> {
        Array::push(mut draft.0, outside)
        Array::push(mut draft.0, outside)
        draft.0[1].count = 8
    }
    assert(len(base.0) == 1 && len(base.1) == 1)
    assert(len(updated.0) == 3 && len(updated.1) == 1)
    assert(updated.0[1].count == 8 && updated.0[2].count == 7 && outside.count == 7)
    println("{len(base.0)}:{len(base.1)}:{len(updated.0)}:{len(updated.1)}:{updated.0[1].count}:{updated.0[2].count}:{outside.count}")
}

-- @case draft_inserts_map_entry_without_changing_base run-pass backend=both
-- @expect-stdout 1:2:10:20
fn main() @io -> () {
    let base = [1: 10]
    let updated = derive(base) \mut draft -> { draft[2] = 20 }
    assert(len(base) == 1 && base?[2] == None)
    assert(len(updated) == 2 && updated?[1] == Some(10) && updated?[2] == Some(20))
    let Some(first) = updated?[1] else { panic("missing original entry") }
    let Some(second) = updated?[2] else { panic("missing inserted entry") }
    println("{len(base)}:{len(updated)}:{first}:{second}")
}

-- @case draft_can_replace_a_fixed_tuple_member_with_a_shorter_array run-pass backend=both
-- @expect-stdout 2:1:2:7
type Cell = .{ count: int }
fn main() @io -> () {
    let row = [Cell.{ count: 1 }, Cell.{ count: 7 }]
    let base = (row, row)
    let updated = derive(base) \mut draft -> { draft.0 = [row[1]] }
    println("{len(base.0)}:{len(updated.0)}:{len(updated.1)}:{updated.0[0].count}")
}

-- @case draft_writes_to_the_current_path_after_reordering run-pass backend=both
-- @expect-stdout 1:7:7:2:1:7
type Cell = .{ count: int }
fn main() @io -> () {
    let row = [Cell.{ count: 1 }, Cell.{ count: 7 }]
    let base = (row, row)
    let updated = derive(base) \mut draft -> {
        draft.0 = [row[1], row[0]]
        draft.0[1].count = 2
    }
    println("{base.0[0].count}:{base.0[1].count}:{updated.0[0].count}:{updated.0[1].count}:{updated.1[0].count}:{updated.1[1].count}")
}

-- @case aborted_draft_preserves_the_base_and_inserted_source run-pass backend=both
-- @expect-stdout 2:1:7:7
type Cell = .{ count: int }
fn main() @io -> () {
    let outside = Cell.{ count: 7 }
    let row = [Cell.{ count: 1 }, outside]
    let base = (row, row)
    let caught = absorb_panic \-> {
        let _ = derive(base) \mut draft -> {
            Array::push(mut draft.0, outside)
            draft.0[1].count = 8
            panic("aborted draft")
        }
    }
    let Err(PanicError::Panicked(_)) = caught else { panic("draft unexpectedly published") }
    println("{len(base.0)}:{base.0[0].count}:{base.0[1].count}:{outside.count}")
}

-- @case empty_record_and_unit_payload_sums_are_draft_roots run-pass backend=both
type Kind { Present(); Empty }
fn main() -> () {
    let empty = derive(.{}) \mut _ -> ()
    let some = derive(Some()) \mut _ -> ()
    let tagged = derive(Kind::Present()) \mut _ -> ()
    assert(empty == .{} && some == Some(()) && tagged == Kind::Present(()))
    let option = Some
    let variant = Kind::Present
    assert(option(()) == some && variant(()) == tagged)
    let Some() = some else { panic("unit payload was lost") }
    let Kind::Present() = tagged else { panic("unit payload was lost") }
}

-- @case aborted_draft_dispatches_body_and_cleanup_effects run-panic "aborted draft" backend=both
-- @expect-stdout 5:8
eff Report { fn emit(value: int) -> () }
opaque type Event(.{ value: int }) use(record)
fn record(new event: Event) @Report -> () { Report::emit(event.value) }
fn main() @io -> () {
    with Report::emit = \value: int -> {
        if value == 5 { print("5:") } else { println("{value}") }
    }
    let shared = [1, 7]
    let base = (shared, shared)
    let _ = derive(base) \mut draft -> {
        use _finish = Event::(.{ value: 8 })
        Report::emit(5)
        Array::push(mut draft.0, 7)
        panic("aborted draft")
    }
}

-- @case draft_matches_and_updates_active_variant_payload run-pass backend=both
type Cell = .{ count: int }
type Kind { Present(Cell); Empty }
fn main() -> () {
    let base = Kind::Present(Cell.{ count: 7 })
    let updated = derive(base) \mut draft -> {
        match draft {
            Kind::Present(mut payload) -> { payload.count = 8 }
            Kind::Empty -> ()
        }
    }
    assert(base == Kind::Present(Cell.{ count: 7 }) && updated == Kind::Present(Cell.{ count: 8 }))
}

-- @case mutable_cleanup_changes_the_callers_resource run-pass backend=both
opaque type Handle(.{ var id: int }) use(close)
fn close(mut handle: Handle) &mut -> () { handle.id = 42 }
fn scope(mut handle: Handle) &mut -> () {
    use scoped = handle
    let before = scoped.id
    assert(before == 41)
}
fn main() -> () {
    let mut handle = Handle::(.{ id: 41 })
    scope(mut handle)
    assert(handle.id == 42)
}

-- @case draft_inner_writes_nominal_tuple_coordinates run-pass backend=both
type Pair(int, int)
fn main() -> () {
    let base = Pair::(1, 2)
    let updated = derive(base) \mut draft -> {
        inner(mut draft).0 = 41
        (draft |> mut inner).1 += 1
    }
    assert(inner(base) == (1, 2) && inner(updated) == (41, 3))
}
