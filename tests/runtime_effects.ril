-- @suite runtime_effects
-- @default_stage run

-- @case static_proofs_and_proved_stdlib_runtime run-pass backend=both
linear type Token(int)
fn drop_tok(t: Token) -> int { inner(t) }
fn div_shift(a: int, d |> NonZero, k |> Nat) -> int { (a / d) << k }
fn lower_bound(xs: []int, target: int) -> int |> Between(0, len(xs)) {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] < target { lo = mid + 1 } else { hi = mid }
    }
    lo
}
fn main() -> () {
    assert(div_shift(25, 5, 2) == 20)
    assert(Numeric::abs(-7) == 7 && Numeric::min(3, 9) == 3 && Numeric::max(3, 9) == 9)
    assert(Numeric::clamp(15, 0, 10) == 10)
    let raw = bytes"ril"
    assert(raw[0] == 114 && raw[2] == 108 && raw?[9] == None)
    let arr = Bytes::to_array(raw)
    assert(arr[0] == 114 && arr[2] == 108)
    let mut xs = Array::repeat(0, 3)
    xs[0] = 10
    xs[2] = 30
    Array::swap(mut xs, 0, 2)
    assert(Array::first(ref xs) == Some(30) && Array::last(ref xs) == Some(10))
    let sorted = [10, 20, 30, 40]
    let idx = lower_bound(sorted, 25)
    let mut ys = clone(sorted)
    Array::insert(mut ys, idx, 25)
    assert(ys == [10, 20, 25, 30, 40])
    assert(Array::remove(mut ys, 2) == 25)
    let mut toks: []Token = []
    Array::insert(mut toks, 0, Token::(42))
    let tok = Array::remove(mut toks, 0)
    assert(drop_tok(tok) == 42)
    while let Some(rem) = Array::pop(mut toks) {
        let _ = drop_tok(rem)
    }
}

-- @case cleanup_runs_in_reverse_order run-pass backend=both
-- @expect-stdout second
-- @expect-stdout first
use ril/io
opaque type Resource(.{ message: str })
fn acquire(message: str) -> new Resource { Resource::(.{ message }) }
fn close(resource: Resource) @io -> () { Io::println(resource.message) }
fn main() @io -> () {
    let first = acquire("first")
    defer close(first)
    let second = acquire("second")
    defer close(second)
}

-- @case panic_runs_cleanup run-panic "failure" backend=both
-- @expect-stdout cleanup
use ril/io
opaque type Resource(.{ id: int })
fn close(_resource: Resource) @io -> () { Io::println("cleanup") }
fn main() @io -> () {
    let resource = Resource::(.{ id: 1 })
    defer close(resource)
    panic("failure")
}

-- @case panic_runs_both_cleanups_through_their_installed_handler run-panic "failure" backend=both
-- @expect-stdout second
-- @expect-stdout first
use ril/io
eff Finalize { fn report(message: str) -> () }
opaque type Resource(.{ message: str })
fn close(resource: Resource) @Finalize -> () { Finalize::report(resource.message) }
fn main() @io -> () {
    with Finalize::report = \message: str -> Io::println(message)
    let first = Resource::(.{ message: "first" })
    defer close(first)
    let second = Resource::(.{ message: "second" })
    defer close(second)
    panic("failure")
}

-- @case double_panic_statically_prevented compile-fail E0627
use ril/panic
fn main() -> () {
    let outcome = Panic::recover \-> {
        defer panic("second")
        -- ^ E0627
        panic("first")
    }
    match outcome { Ok(_) -> (); Err(_) -> () }
}

