    let second:Option<Result<int,str>>=Some(Err("inner"))
    let third:Option<Result<int,str>>=None
    assert(consume(first,first) is Ok()|Err(_))
    assert(consume(second,second) is Ok()|Err(_))
    assert(consume(third,third) is Ok()|Err(_))
}

