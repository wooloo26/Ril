use ril/concurrent::{scope}
use ril/concurrent/channel

fn unpaid(value:Option<Result<int,str>>)->Result<(),Concurrent::TaskFault> @Async{
    scope \mut s->{
        match value{Some(inner)->assert(inner is Ok(_)|Err(_)),None->()}
        let child=s.fork(\->())
        assert(child.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Result<Result<int,str>,str>>(1)
        let nested:Result<Result<int,str>,str>=Ok(Ok(7))
        assert(nested is Ok(_)|Err(_))
        assert(Channel::send(mut tx,nested) is Ok())
        match Channel::recv(mut rx){
            Ok(business)->assert(business is Ok(_)|Err(_)),
            Err(_)->panic("receive")
        }
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
}
