use ril/concurrent::{scope}
use ril/concurrent/channel
fn publish(mut endpoint:Channel::Sender<Result<int,str>>,value:Result<int,str>)->Result<(),Channel::ChannelError> @Fiber &mut{
    Channel::send(mut endpoint,value)
}
pub fn test_native() @Async{
    let result=scope \mut s->{
        let task=s.fork(\->())
        assert(task.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Result<int,str>>(2)
        let first:Result<int,str>=Ok(11)
        let second:Result<int,str>=Err("second")
        assert(publish(mut tx,first) is Ok())
        assert(publish(mut tx,second) is Ok())
        match Channel::recv(mut rx){Ok(value)->assert(value is Ok(11)|Err(_)),Err(_)->panic("first")}
        match Channel::recv(mut rx){Ok(value)->assert(value is Ok(_)|Err("second")),Err(_)->panic("second")}
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
    assert(result is Ok()|Err(_))
}
