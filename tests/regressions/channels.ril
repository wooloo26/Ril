--@ source: source-channel-message-optional-callback-scope-budget
--@ file: source.ril
use ril/concurrent::{scope}
use ril/concurrent/channel

fn consume(value:Option<Result<int,str>>,other:Option<Result<int,str>>)->Result<(),Concurrent::TaskFault> @Async{
    scope \mut s->{
        let child=s.fork(\->())
        assert(child.join() is Ok()|Err(_))
        match other{Some(inner)->assert(inner is Ok(_)|Err(_)),None->()}
        let (mut tx,mut rx)=Channel::bounded<Option<Result<int,str>>>(1)
        assert(Channel::send(mut tx,value) is Ok())
        match Channel::recv(mut rx){
            Ok(business)->match business{
                Some(inner)->assert(inner is Ok(_)|Err(_)),
                None->()
            },
            Err(_)->panic("receive")
        }
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
}

fn alias_unknown_optional(value:Option<Result<int,str>>)->Result<(),Concurrent::TaskFault> @Async{
    consume(value,value)
}
fn named_optional_callback(value:Option<Result<int,str>>) @Async{
    assert(consume(value,value) is Ok()|Err(_))
}
fn through_named_optional_callback(value:Option<Result<int,str>>) @Async{
    named_optional_callback(value)
}
fn through_single_optional_callback(value:Option<Result<int,str>>) @Async{
    let mapped=Array::map([1],\number:int->{named_optional_callback(value);number})
}

pub fn test_native() @Async{
    let first:Option<Result<int,str>>=Some(Ok(7))
    let second:Option<Result<int,str>>=Some(Err("inner"))
    let third:Option<Result<int,str>>=None
    assert(alias_unknown_optional(first) is Ok()|Err(_))
    assert(alias_unknown_optional(second) is Ok()|Err(_))
    assert(alias_unknown_optional(third) is Ok()|Err(_))
    through_named_optional_callback(first)
    through_named_optional_callback(second)
    through_named_optional_callback(third)
    through_single_optional_callback(first)
    through_single_optional_callback(second)
    through_single_optional_callback(third)
}
