--@ source: source-channel-message-formal-failed-send-loses-original
--@ file: source.ril
use ril/concurrent::{scope}
use ril/concurrent/channel
fn publish(mut endpoint:Channel::Sender<Result<int,str>>,value:Result<int,str>)->Result<(),Channel::ChannelError> @Fiber &mut{
    Channel::send(mut endpoint,value)
}
pub fn test_native() @Async{
    let result=scope \mut s->{
        let task=s.fork(\->())
        assert(task.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Result<int,str>>(1)
        let payload:Result<int,str>=Ok(7)
        let sent=publish(mut tx,payload)
        match sent{
            Ok()->{let received=Channel::recv(mut rx);match received{Ok(value)->assert(value is Ok(7)|Err(_)),Err(_)->panic("receive failed")}},
            Err(_)->()
        }
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
    assert(result is Ok()|Err(_))
}
