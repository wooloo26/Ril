use ril/concurrent::{scope}
use ril/concurrent/channel

fn consume(value:Option<Result<int,str>>)->Result<(),Concurrent::TaskFault> @Async{
    scope \mut s->{
        match value{Some(inner)->assert(inner is Ok(_)|Err(_)),None->()}
        let child=s.fork(\->())
        assert(child.join() is Ok()|Err(_))
        let (mut tx,mut rx)=Channel::bounded<Option<Result<int,str>>>(1)
        assert(Channel::send(mut tx,value) is Ok())
        match Channel::recv(mut rx){
            Ok(business)->match business{
                Some(inner)->assert(inner is Ok(_)|Err(_)),
                None->()
            },
            Err(_)->panic("receive")
        }
        Channel::close(tx)
        Channel::close(rx)
        Ok()
    }
}

pub fn test_some_ok() @Async{
    let value:Option<Result<int,str>>=Some(Ok(7))
    assert(consume(value) is Ok()|Err(_))
}

pub fn test_some_err() @Async{
    let value:Option<Result<int,str>>=Some(Err("inner"))
    assert(consume(value) is Ok()|Err(_))
}

pub fn test_none() @Async{
    let value:Option<Result<int,str>>=None
    assert(consume(value) is Ok()|Err(_))
}
