--@ source: declared-payload-contexts
--@ file: source.ril
type Record({ matrix: [2][0][3]int })
type Pair([0][2]int, [0][3]int)
type Choice { Value({ matrix: [2][0][3]int }), Empty }
pub fn test_declared() {
    let record = Record(.{ matrix: [[], []] })
    let pair = Pair([], [])
    let choice = Choice::Value(.{ matrix: [[], []] })
    assert(len(inner(record).matrix) == 2)
    assert(len(inner(pair).0) == 0 && len(inner(pair).1) == 0)
    match choice { Choice::Value(data) -> assert(len(data.matrix) == 2), Choice::Empty -> assert(false) }
}
--@ end-file
--@ end-source

