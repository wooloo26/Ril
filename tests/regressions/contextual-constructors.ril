--@ source: nested-receiving-contexts
--@ file: source.ril
type Layer = { matrix: [2][0][3]int }
fn option_size(value: ?[0][2]int) -> int {
    match value { Some(items) -> len(items), None -> 0 }
}
fn result_size(value: Result<[0][2]int, str>) -> int {
    match value { Ok(items) -> len(items), Err(_) -> 0 }
}
pub fn test_native() {
    let option: ?[0][2]int = Some([])
    let qualified: ?[0][2]int = Prelude::Some([])
    let result: Result<[0][2]int, str> = Ok([])
    let failure: Result<int, [0][2]int> = Err([])
    assert(option_size(option) == 0)
    assert(option_size(qualified) == 0)
    assert(result_size(result) == 0)
    match failure { Ok(_) -> assert(false), Err(items) -> assert(len(items) == 0) }
    let nested: Result<Layer, int> = Ok(Layer.{ matrix: [[], []] })
    match nested { Ok(layer) -> assert(len(layer.matrix) == 2), Err(_) -> assert(false) }
    let anonymous: ?{ matrix: [2][0][3]int } = Some(.{ matrix: [[], []] })
    match anonymous { Some(layer) -> assert(len(layer.matrix) == 2), None -> assert(false) }
    let small: Result<[2]u8, str> = Ok([1, 2])
    match small { Ok(items) -> assert(items == [1u8, 2u8]), Err(_) -> assert(false) }
    let piped: ?[0][2]int = [] |> Some
    assert(option_size(piped) == 0)
}
--@ end-file
--@ end-source

