--@ case: conditional-control
--@ mode: run-pass
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#conditional-expressions
--@ spec: SPEC#loop-expressions
--@ entry: test_native
--@ file: source.ril
meta fn select(item: ?int) -> int {
    if let Some(value) = item { value + 1 } else { 3 }
}
meta fn once(item: ?int) -> int {
    while let Some(value) = item {
        assert(value == 7)
        last
    }
    9
}
meta let FOUND = select(Some(7))
meta let ABSENT = select(None)
meta let ONCE = once(Some(7))
meta let EMPTY = once(None)
meta let _ = assert(FOUND == 8 && ABSENT == 3 && ONCE == 9 && EMPTY == 9)
pub fn test_native() &{FOUND, ABSENT, ONCE, EMPTY} {
    assert(FOUND == 8 && ABSENT == 3 && ONCE == 9 && EMPTY == 9)
}
--@ end-file
--@ end-case

--@ case: array-window-graph
--@ mode: run-pass
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#pattern-matching
--@ spec: SPEC#range-and-slicing-expressions
--@ entry: test_native
--@ file: source.ril
meta fn tail(values: [3]int) -> [2]int {
    let [_, ..rest] = values
    rest
}
meta let SOURCE: [3]int = [1, 2, 3]
meta let TAIL: [2]int = tail(SOURCE)
meta let BOTH = (SOURCE, TAIL)
pub fn test_native() &{SOURCE, TAIL, BOTH} {
    assert(TAIL[0] == 2 && len(TAIL) == 2)
    let mut copied = clone(TAIL)
    copied[0] = 7
    assert(copied[0] == 7 && SOURCE[1] == 2 && BOTH.1[0] == 2)
}
--@ end-file
--@ end-case

--@ case: window-backing-joint-clone
--@ mode: run-pass
--@ spec: SPEC#range-and-slicing-expressions
--@ spec: SPEC#static-computation-and-totality
--@ companion: array-window-graph
--@ entry: test_native
--@ file: source.ril
meta fn tail(values: [3]int) -> [2]int { let [_, ..rest] = values; rest }
meta let SOURCE: [3]int = [1, 2, 3]
meta let BOTH = (SOURCE, tail(SOURCE))
pub fn test_native() &{SOURCE, BOTH} {
    let mut copied = ^mut clone(BOTH)
    copied.0[1] = 7
    assert(copied.1[0] == 7 && SOURCE[1] == 2 && BOTH.1[0] == 2)
}
--@ end-file
--@ end-case

--@ case: reject-repeating-condition-budget
--@ mode: check-fail
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#loop-expressions
--@ companion: conditional-control
-- Error [E0811]: every repeated pattern condition retains the static event budget
--@ file: source.ril
meta fn repeat() -> int {
    while let Some(value) = Some(7) { assert(value == 7); next }
    0
}
meta let VALUE = repeat()
--@ end-file
--@ end-case

--@ case: unselected-conditional-events
--@ mode: run-pass
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#conditional-expressions
--@ spec: SPEC#loop-expressions
--@ entry: test_native
--@ file: source.ril
meta fn absent(item: ?int) -> int {
    if let Some(value) = item { assert(false); value } else { 17 }
}
meta fn skipped(item: ?int) -> int {
    while let Some(value) = item { assert(false); last }
    19
}
meta fn outer_target() -> int {
    loop {
        while let Some(value) = (if true { last 23 } else { Some(7) }) {
            assert(false)
            last
        }
    }
}
meta let ABSENT = absent(None)
meta let SKIPPED = skipped(None)
meta let OUTER = outer_target()
pub fn test_native() &{ABSENT, SKIPPED, OUTER} {
    assert(ABSENT == 17 && SKIPPED == 19 && OUTER == 23)
}
--@ end-file
--@ end-case

--@ case: reject-unselected-conditional-type-error
--@ mode: check-fail
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#conditional-expressions
--@ companion: unselected-conditional-events
-- Error [E0301]: an unselected conditional branch is still checked
--@ file: source.ril
meta fn absent(item: ?int) -> int {
    if let Some(value) = item { let wrong: int = "bad"; value } else { 17 }
}
meta let ANSWER = absent(None)
--@ end-file
--@ end-case

--@ case: nested-rest-window-sources
--@ mode: run-pass
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#pattern-matching
--@ spec: SPEC#range-and-slicing-expressions
--@ entry: test_native
--@ file: source.ril
meta fn exact(values: [0][2]int) -> int { len(values) }
meta fn nested(values: [4][0][2]int) -> [2][0][2]int {
    let [_, ..middle, _] = values
    let [..again] = middle
    assert(exact(again[0]) == 0 && exact(again[1]) == 0)
    again
}
meta fn record_tail(packet: { id: int, values: [0][2]int }) -> [0][2]int {
    let .{ id, ..rest } = packet
    assert(id == 7 && exact(rest.values) == 0)
    rest.values
}
meta let SOURCE: [4][0][2]int = [[], [], [], []]
meta let MIDDLE = nested(SOURCE)
meta let RECORD = record_tail(.{ id: 7, values: [] })
pub fn test_native() &{MIDDLE, RECORD} {
    assert(len(MIDDLE) == 2 && len(MIDDLE[0]) == 0 && len(RECORD) == 0)
}
--@ end-file
--@ end-case

--@ case: for-nested-irrefutable-rest
--@ mode: run-pass
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#pattern-matching
--@ spec: SPEC#loop-expressions
--@ entry: test_native
--@ file: source.ril
meta fn inspect(values: [2]([3]int, int)) -> int {
    for values as ([front, ..tail], ..) {
        let exact: [2]int = tail
        assert(front > 0 && len(exact) == 2)
        next
    }
    29
}
meta let ANSWER = inspect([([1, 2, 3], 7), ([4, 5, 6], 8)])
pub fn test_native() &{ANSWER} { assert(ANSWER == 29) }
--@ end-file
--@ end-case

--@ case: reject-dynamic-rest-fixed-dimension
--@ mode: check-fail
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#pattern-matching
--@ companion: nested-rest-window-sources
-- Error [E0301]: a dynamic source does not gain a fixed extent from its values
--@ file: source.ril
meta fn invalid(values: []int) -> [2]int {
    let [..tail] = values
    tail
}
meta let VALUES = invalid([1, 2])
--@ end-file
--@ end-case

--@ case: default-source-schema-scope
--@ mode: run-pass
--@ spec: SPEC#static-computation-and-totality
--@ spec: SPEC#pattern-matching
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ file: source.ril
meta fn remaining(values: [3]int, selected: [2]int = {
    let [_, ..tail] = values
    tail
}) -> [2]int {
    let [..result] = selected
    result
}
meta let DEFAULT = remaining([1, 2, 3])
meta let EXPLICIT = remaining([4, 5, 6], [8, 9])
pub fn test_native() &{DEFAULT, EXPLICIT} {
    assert(DEFAULT[0] == 2 && DEFAULT[1] == 3)
    assert(EXPLICIT[0] == 8 && EXPLICIT[1] == 9)
}
--@ end-file
--@ end-case
