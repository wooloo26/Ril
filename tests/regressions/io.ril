-- [case: io-callback-empty-write-capture, check-fail]
-- spec: STD#error-and-stream-contracts
-- companion: io-callback-empty-write-inspection
-- Error [E0534]: An empty write still checks the operation's latent capture contract.
-- file: source.ril
use ril/io
type Writer={mut calls:int}
fn example(){
    let external:[2]u8=[1u8,2u8]
    let mut writer=Writer.{calls:0}
    let callback=\mut current:Writer,data:bytes->{
        current.calls+=1
        assert(external[0]==1u8)
        .{written:len(data),error:None}
    }
    assert(Io::write_all(mut writer,b"",.{write:callback}) is Ok(_)|Err(_))
}

-- [source: source-io-callback-result-inspection]
-- file: source.ril
use ril/io
type Reader={scratch:[2]u8,pending:Result<int,str>,mut calls:int}
fn read(mut reader:Reader,limit:int)->Result<Io::ReadChunk,Io::IoError>&mut{
    reader.calls+=1
    assert(reader.pending is Ok(_)|Err(_))
    Ok(.{data:b"",end:true})
}
fn example(){
    let pending:Result<int,str>=Ok(1)
    let mut reader=Reader.{scratch:[1u8,2u8],pending:pending,calls:0}
    assert(Io::read_all(mut reader,.{read:read}) is Ok(_)|Err(_))
}

