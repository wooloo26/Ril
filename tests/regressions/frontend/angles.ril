type Box<T>= { value: T }
meta let SAME = <Box<Box<i64>>>==<Box<Box<i64>>>
meta let DIFF = <i64>!=<str>
meta let SHIFT = 16 >> 1
type Flag<flag: bool> = i64
type Selected = Flag<(2 > 1)>

