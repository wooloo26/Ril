-- [case: forward-and-local-signature, front-pass]
-- spec: SPEC#static-type-values-and-type-quotation
fn choose_flag() -> i64 {
    choose<true && false>(4)
where
    fn choose<flag: bool>(value: i64) -> i64 { if flag { value } else { 0 } }
}
fn use_later() -> i64 { identity<i64>(4) }
fn identity<T>(value: T) -> T { value }

-- [case: qualified-and-imported-alias, front-pass]
-- spec: SPEC#static-type-values-and-type-quotation
-- file: root.ril
use generic_items
use generic_items::{identity as id}
fn twice() -> i64 {
    let same = id
    GenericItems::identity<i64>(same<i64>(4))
}
-- file: generic_items.ril
pub fn identity<T>(value: T) -> T { value }

-- [case: parameter-and-sequential-shadow, front-pass]
-- spec: SPEC#static-type-values-and-type-quotation
fn generic<T>(value: T) -> T { value }
fn compare(generic: i64, other: i64, low: i64, high: i64) -> bool {
    generic < other && high > (low)
}
fn compare_after_binding() -> bool {
    let first = generic<i64>(1)
    let generic = first
    generic < 2 && 3 > (2)
}

-- [case: close-suffix-rescan, front-pass]
