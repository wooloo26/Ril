-- [case: guards-and-static-pattern-binders, front-pass]
-- spec: SPEC#structural-type-pattern-matching
halt type Guard = \T -> match <T> {
    <(let M let Head, ..let Tail)> -> <{ mode: M, head: Head, tail: Tail }>,
    <{ let M field: let U, ..let Rest }> -> <{ mode: M, field: U, rest: Rest }>,
    _ -> <never>,
}
type Box<T |> Guard> = { value: T }
fn choose<T: i64 | f64>(value: T) -> T { value }

