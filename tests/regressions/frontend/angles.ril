-- [case: declaration-aware-constant-argument-discovers-imports, front-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- file: root.ril
fn choose<enabled: bool>(value: i64) -> i64 {
    if enabled { value } else { 0 }
}
fn example() -> i64 {
    choose<{ use flags::{ENABLED}; ENABLED }>(7)
}
-- file: flags.ril
pub let ENABLED = true

-- [case: constructor-alias-in-constant-argument, front-pass]
-- spec: SPEC#static-type-values-and-type-quotation
fn choose<enabled: bool>() -> bool { enabled }
fn example() -> bool {
    choose<{
        use Option::{Some as present}
        Some(1) is present(_)
    }>()
}

