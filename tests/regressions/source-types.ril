--@ source: source-owned-record-types
--@ file: source.ril
type Wrapped<T> = { item: T }
fn wrap<T>(value: T) -> Wrapped<T> { Wrapped<T>.{ item: value } }
fn stamp<R>(value: { ..R }) -> { stamp: int, ..R } { .{ ..value, stamp: 7 } }
fn identity<T>(value: T) -> T { value }
fn first(value: int = 4) -> int { value }
pub fn test_owned_records() {
    let input: [0][2]int = []
    let record = stamp(wrap(input))
    let output: typeof(input) = identity(record.item)
    let pair: (typeof(input), typeof(record.item)) = (output, record.item)
    assert(len(pair.0) == 0 && len(pair.1) == 0 && record.stamp == 7)
    let callbacks = stamp(wrap(first))
    assert(callbacks.item(value: 9) == 9 && callbacks.item() == 4)
}
--@ end-file
--@ end-source

