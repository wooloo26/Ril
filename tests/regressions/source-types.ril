--@ case: reject-owned-record-spread-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: owned-record-types-pointer64
-- Error [E0301]: An empty spread field retains its hidden inner dimension.
--@ file: source.ril
fn invalid() {
    let input: [0][3]int = []
    let record = .{ item: input }
    let wrong: { item: [0][2]int } = .{ ..record }
}
--@ end-file
--@ end-case

--@ case: reject-owned-record-constructor-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: owned-record-types-pointer32
-- Error [E0301]: A typed constructor cannot recontextualize a stored empty array.
--@ file: source.ril
type Wrapped<T> = { item: T }
fn invalid() {
    let input: [0][3]int = []
    let wrong = Wrapped<[0][2]int>.{ item: input }
}
--@ end-file
--@ end-case

--@ case: reject-owned-record-typeof-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: owned-record-types-pointer64
-- Error [E0301]: Nested typeof uses the declared complete field type.
--@ file: source.ril
fn invalid() {
    let input: [0][2]int = []
    let other: [0][3]int = []
    let record = .{ item: input }
    let wrong: (typeof(input), typeof(record.item)) = (other, other)
}
--@ end-file
--@ end-case
