-- [case: effectful-transition, check-pass]
-- target: pointer64
-- spec: STD#explicit-iteration
-- companion: imported-definitions
-- file: source.ril
use ril/iter
var step_calls = 0
fn step(state: int) -> Iter::Step<int, int> &{mut step_calls} {
    step_calls += 1
    if state >= 5 { Iter::Step::Done } else { Iter::Step::Yielded(state * 10, state + 1) }
}
fn collect_from(state: int) -> []int &{mut step_calls} {
    let source: Iter::Source<int, int> = .{ step: step }
    Iter::collect(state, source)
}
fn filtered_from(state: int, limit: int) -> []int &{mut step_calls} {
    let source: Iter::Source<int, int> = .{ step: step }
    Iter::collect(state, Iter::filter(source, \number -> number > limit))
}

-- [case: generic-alias-scope, run-pass]
-- entry: test_alias_scope
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: imported-definitions
-- file: source.ril
type Step<S, T> { Done, Yielded(T, S) }
type Source<S, T> = { step: fn(S) -> Step<S, T> }
fn nested<S, T>(source: Source<S, T>) -> Source<(S, int), T> &capture {
    .{ step: \state: (S, int) -> match source.step(state.0) {
        Step::Done -> Step::Done<(S, int), T>,
        Step::Yielded(item, successor) -> Step::Yielded<(S, int), T>(item, (successor, state.1 + 1)),
    } }
}
fn step(state: int) -> Step<int, int> {
    if state == 0 { Step::Yielded<int, int>(1, 1) } else { Step::Done<int, int> }
}
pub fn test_alias_scope() {
    let source: Source<(int, int), int> = nested(.{ step: step })
    assert(source.step((0, 0)) is Step::Yielded(_, _))
}

-- [case: private-callback-state, run-pass]
-- entry: test_private_state
-- spec: SPEC#binding-permissions-and-storage-matrix
-- companion: generic-alias-scope
-- file: source.ril
fn preserve(action: fn() -> ()) -> int {
    var state = [1]
    action()
    let before = state[0]
    state = [2]
    before + state[0]
}
pub fn test_private_state() { assert(preserve(\ -> ()) == 3) }
