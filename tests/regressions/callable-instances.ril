--@ source: runtime-selection
--@ file: source.ril
eff Read<T> { get() -> T }
eff Mark<T> { touch() -> () }
var trace = 0
fn read<T>() -> T @Read<T> { Read<T>::get() }
fn second<T, U>(first: T, other: U) -> U @Mark<T> { Mark<T>::touch(); other }
pub fn test_instances() &{mut trace} {
    with Read<int>::get() -> resume 7
    with Read<str>::get() -> resume "seven"
    with Mark<int>::touch() -> resume ()
    trace = 0
    let generic = read
    let integer = ({ trace = trace * 10 + 1; generic })<int>
    let text = ({ trace = trace * 10 + 2; generic })<str>
    assert(integer() == 7 && text() == "seven" && trace == 12)
    let partial = second<int>
    let alias = partial
    assert(alias(1, "two") == "two")
    let finished = partial<bool>
    assert(finished(2, true))
}
fn main() &{mut trace} { test_instances() }
--@ end-file
--@ end-source

