--@ source: instantiation-budget
--@ file: source.ril
eff Read<T> { get() -> T }
fn read<T>() -> T @Read<T> { Read<T>::get() }
fn no_work<T>() -> int { let unused = read<T>; 7 }
pub fn test_instances() {
    let selected = no_work<int>
    let limited = { with Div::exhausted() -> 99; Div::budget(1, selected) }
    let stopped = { with Div::exhausted() -> 99; Div::budget(0, selected) }
    assert(limited == 7 && stopped == 99)
}
fn main() { test_instances() }
--@ end-file
--@ end-source

