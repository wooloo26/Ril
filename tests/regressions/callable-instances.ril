--@ source: phantom-instances
--@ file: source.ril
eff Mark<T> { get() -> int }
fn read<T>() -> int @Mark<T> { Mark<T>::get() }
pub fn test_instances() {
    with Mark<int>::get() -> resume 7
    with Mark<str>::get() -> resume 11
    let integer = read<int>
    let text = read<str>
    let callbacks = (integer, text)
    assert(callbacks.0() == 7 && callbacks.1() == 11)
}
--@ end-file
--@ end-source

