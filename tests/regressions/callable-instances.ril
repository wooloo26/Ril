--@ source: foreign-runtime-selection
--@ file: root.ril
use foreign
var trace = 0
fn mark(digit: int) -> int &{mut trace} { trace = trace * 10 + digit; digit }
pub fn test_native() &{mut trace} {
    trace = 0
    let generic = Foreign::identity
    let selected = ({ mark(1); generic })<int>
    assert(trace == 1)
    assert(selected(mark(2)) == 2 && trace == 12)
    let integer = ({ mark(3); Foreign::zero })<int>
    assert(integer() == 0 && trace == 123)
    let constant = ({ mark(4); Foreign::number })<7>
    assert(constant() == 7 && trace == 1234)
    let piped = mark(5) |> ({ mark(6); Foreign::identity })<int>
    assert(piped == 5 && trace == 123456)
}
--@ end-file
--@ file: foreign.d.ril
pub fn identity<T>(value: T) -> T
pub fn zero<T>() -> T
pub fn number<n: int>() -> int
--@ end-file
--@ end-source

