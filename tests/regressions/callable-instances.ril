--@ source: nearby-instance
--@ file: source.ril
eff Read<T> { get() -> T }
fn read<T>(value: T) -> T @Read<T> { Read<T>::get() }
pub fn test_instances() {
    with Read<int>::get() -> resume 7
    with Read<str>::get() -> resume "seven"
    assert(read(0) == 7)
    let stored = read
    assert(stored("") == "seven")
}
fn main() { test_instances() }
