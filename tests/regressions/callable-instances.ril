--@ case: reject-stored-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: transport-pointer64
-- Error [E0301]: A stored instance keeps its selected hidden dimension.
--@ file: source.ril
fn identity<T>(value: T) -> T { value }
fn invalid() {
    let selected = identity<[0][2]int>
    let value: [0][3]int = []
    selected(value)
}
--@ end-file
--@ end-case

--@ case: reject-incompatible-view
--@ mode: check-fail
--@ spec: SPEC#type-identity-and-subtyping
--@ companion: transport-pointer64
-- Error [E0301]: Ascription cannot replace an implementation's selected type.
--@ file: source.ril
fn identity<T>(value: T) -> T { value }
fn invalid() { let wrong: fn(int) -> int = identity<bool> }
--@ end-file
--@ end-case

