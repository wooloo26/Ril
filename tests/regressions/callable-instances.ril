--@ source: transported-instances
--@ file: source.ril
fn identity<T>(value: T) -> T { value }
fn second<T, U>(left: T, right: U) -> U { right }
fn defaulted<T>(value: T, later: T = value) -> T { later }
type Reader<T> = fn() -> T &closure
fn make<T>(value: T) -> Reader<T> &capture {
    let selected = identity<T>
    \ -> selected(value)
}
pub fn test_instances() {
    let selected = identity<int>
    let alias = selected
    assert(alias(value: 7) == 7)
    let generic = identity
    assert(generic<bool>(true))
    let partial = second<int>
    assert(partial(1, "two") == "two")
    let finished = partial<str>
    assert(finished(2, "three") == "three")
    let take = identity<[0][2]int>
    let empty: [0][2]int = take([])
    let callbacks = .{ take: identity<[0][3]int> }
    let other: [0][3]int = callbacks.take([])
    assert(len(empty) == 0 && len(other) == 0)
    let choose = defaulted<int>
    assert(choose(value: 3) == 3 && choose(value: 3, later: 5) == 5)
    let reader = make(9)
    assert(reader() == 9)
    let require = Options::expect<int>
    assert(require(Some(6), "missing") == 6)
}
--@ end-file
--@ end-source

