-- [source: generated-iterator-nested-empty-extent]
-- file: source.ril
fn keep(value:[0][3]int)->[0][3]int{value}
pub fn test_native(){
    let empty:[0][3]int=[]
    let source=Iter::take(Iter::map(Iter::indexed([empty]),keep),1)
    let mut cursor=Iter::cursor((0,0))
    let received:[0][3]int=Iter::pull(mut cursor,source) ?? panic("missing item")
    assert(len(received)==0)
}

