-- [source: optional-projection-paths]
-- file: source.ril
fn exact(values: [2]int) -> int { values[0] + values[1] }
fn exercise(seed: int) -> int {
    var total = 0
    let values: [2]int = [seed, 9]
    let value: ?[2]int = Some(values)
    if value != None {
        let named = value
        total += exact(named)
    }
    let field_values: [2]int = [seed, 11]
    let packet: ?{items: [2]int} = Some(.{ items: field_values })
    if packet != None {
        let field = packet.items
        total += exact(field)
        let computed = packet.("items")
        total += exact(computed)
    }
    let first: [2]int = [seed, 13]
    let second: [2]int = [seed, 15]
    let pair: ?([2]int, [2]int) = Some((first, second))
    if pair != None {
        let member = pair.1
        total += exact(member)
        let selected = pair.(0)
        total += exact(selected)
    }
    let final_row: [2]int = [seed, 17]
    let matrix: [2][2]int = [first, final_row]
    let rows: ?[2][2]int = Some(matrix)
    if rows != None {
        let indexed = rows[1]
        total += exact(indexed)
    }
    let innermost: [2]int = [seed, 19]
    let inner: ?[2]int = Some(innermost)
    let nested: Option<Option<[2]int>> = Some(inner)
    if nested != None {
        let once = nested
        if once != None {
            let twice = once
            total += exact(twice)
        }
    }
    total
}
pub fn test_native() {
    assert(exercise(7) == 144)
    assert(exercise(3) == 116)
    assert(exercise(7) == 144)
}

