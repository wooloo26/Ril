--@ end-case

--@ case: reject-readonly-row-member
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: row-carriers-pointer64
-- Error [E0520]: Expanding a row alias preserves the input's read authority.
--@ file: source.ril
type Packet = { mut counter: int }
type Inner<R> = { child: Packet, ..R }
type Outer<R> = { flag: bool, ..Inner<R> }
fn invalid<R>(item: Outer<R>) { item.child.counter = 1 }
--@ end-file
--@ end-case

--@ case: reject-stored-row-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: row-carriers-pointer32
-- Error [E0301]: A row context cannot replace an already selected inner dimension.
--@ file: source.ril
type Inner<R> = { matrix: [0][2]int, ..R }
type Outer<R> = { flag: bool, ..Inner<R> }
fn take<R>(item: Outer<R>) {}
fn invalid() {
    let matrix: [0][3]int = []
    take(.{ flag: true, matrix, label: "kept" })
}
--@ end-file
--@ end-case
