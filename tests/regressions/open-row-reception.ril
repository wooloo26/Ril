--@ source: row-carriers
--@ file: source.ril
type Packet = { mut counter: int, values: [0][2]int }
type Inner<R> = { id: int, child: Packet, ..R }
type Outer<R> = { flag: bool, ..Inner<R> }
fn identity<R>(item: Outer<R>) -> Outer<R> { item }
fn success<R>(item: {..R}) -> Result<{..R}, str> { Ok(item) }
fn failure<R>(item: {..R}) -> Result<str, {..R}> { Err(item) }
fn optional<R>(item: Outer<R>) -> ?Outer<R> { Some(item) }
pub fn test_native() {
    let packet = Packet.{ counter: 1, values: [] }
    let item = .{ flag: true, id: 7, child: packet, label: "kept" }
    let direct = identity(item)
    assert(direct.label == "kept" && len(direct.child.values) == 0)
    match success(item) {
        Ok(value) -> assert(value.id == 7 && value.child.counter == 1),
        Err(_) -> assert(false),
    }
    match failure(item) {
        Ok(_) -> assert(false),
        Err(value) -> assert(value.label == "kept"),
    }
    match optional(item) {
        Some(value) -> assert(value.flag && len(value.child.values) == 0),
        None -> assert(false),
    }
}
--@ end-file
--@ end-source

