-- [source: none-receiving]
-- file: source.ril
type Packet = { id: int, items: [0][2]int }
type Holder = { mut packet: ?Packet }
fn inspect(value: ?Packet) -> int {
    match value { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
fn absent() -> ?Packet { None }
fn defaulted(value: ?Packet = None) -> int { inspect(value) }
fn nested(input: (?Packet, bool)) -> int { inspect(input.0) }
fn generic<T>(value: ?T) -> bool { value == None }
pub fn test_native() {
    let value: ?Packet = None
    let qualified: ?Packet = Prelude::None
    assert(inspect(value) == 0)
    assert(inspect(qualified) == 0)
    assert(inspect(None) == 0)
    assert(inspect(absent()) == 0)
    assert(defaulted() == 0)
    assert(nested((None, true)) == 0)
    let pair: (?Packet, bool) = (None, false)
    let record: { packet: ?Packet } = .{ packet: None }
    assert(inspect(pair.0) == 0)
    assert(inspect(record.packet) == 0)
    let mut values: []?Packet = []
    Array::push(mut values, None)
    Array::insert(mut values, 0, None)
    assert(len(values) == 2)
    assert(inspect(values[0]) == 0)
    let mut entries: [str: ?Packet] = [:]
    Map::set(mut entries, "none", None)
    assert(len(entries) == 1)
    let mut holder = Holder.{ packet: None }
    holder.packet = None
    assert(inspect(holder.packet) == 0)
    var selected: ?Packet = Some(Packet.{ id: 7, items: [] })
    selected = None
    assert(inspect(selected) == 0)
    assert(generic<Packet>(None))
}

