-- [case: derive-clone-view, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- entry: test_native
-- file: source.ril
type Document = { mut title: str }
pub fn test_native() {
    let document = Document.{ title: "Guide" }
    let alias = document
    let mut working = clone(document)
    let view observed = working
    let view read_title = \-> observed.title
    working.title = "Draft"
    assert(alias.title == "Guide")
    assert(read_title() == "Draft")
    let snapshot = clone_immut(observed)
    let revised = snapshot |> derive \mut draft -> { draft.title = "Revised" }
    assert(snapshot.title == "Draft" && revised.title == "Revised")
}

-- [case: derive-repeated-activation, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- entry: test_native
-- file: source.ril
type Document = { mut title: str }
fn revise(source: Immut<Document>) -> Immut<Document> {
    source |> derive \mut draft -> { draft.title = "Revised" }
}
pub fn test_native() {
    let source = clone_immut(Document.{ title: "Guide" })
    let first = revise(source)
    let second = revise(source)
    assert(source.title == "Guide" && first.title == "Revised" && second.title == "Revised")
}

