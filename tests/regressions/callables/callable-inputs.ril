-- [case: inferred-read-cannot-write, check-fail]
-- spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
-- companion: inferred-fixed-input
-- Error [E0520]: inferred readonly formals cannot recover interior write authority
-- file: source.ril
type Document = { mut title: str }
fn example() {
    let mut source = Document.{ title: "Guide" }
    let update = \item -> { item.title = "Changed" }
    update(source)
}

-- [case: derive-resumed-answer, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- companion: derive-construction
-- file: source.ril
type Counter = { mut value: int }
eff Read { get() -> int }
pub fn test_derive_resumed_answer() {
    let result = {
        with Read::get() -> (resume 7) |> derive \mut draft: Counter -> {
            draft.value += 1
        }
        Counter.{ value: Read::get() }
    }
    assert(result.value == 8)
}

