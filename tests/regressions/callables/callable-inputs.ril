-- [case: derive-resume-completion, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- spec: SPEC#effect-handlers
-- entry: test_native
-- file: source.ril
type Document = { mut title: str }
eff Read { get() -> int }
fn original() -> Immut<Document> @Read {
    let number = Read::get()
    assert(number == 7)
    clone_immut(Document.{ title: "Guide" })
}
fn revise(mut draft: Document) &mut { draft.title = "Revised" }
pub fn test_native() {
    let revised: Immut<Document> = {
        with Read::get() -> (resume 7) |> derive revise
        original()
    }
    assert(revised.title == "Revised")
}
