-- [case: derive-nested-fixed-input, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
type Grid = { mut rows: [0][2]int, mut title: str }
fn fixed(rows: [0][2]int) -> int { len(rows) }
pub fn test_native() {
    let source = Grid.{ rows: [], title: "Guide" }
    let revised = source |> derive \mut draft -> {
        assert(fixed(draft.rows) == 0)
        draft.title = "Revised"
    }
    assert(source.title == "Guide" && revised.title == "Revised")
}

