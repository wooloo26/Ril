-- [case: inferred-fixed-input, run-pass]
-- spec: SPEC#type-identity-and-subtyping
-- spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
-- entry: test_native
-- file: source.ril
fn take(values: [2]int) -> int { values[0] }
pub fn test_native() {
    let input: [2]int = [7, 9]
    let reader = \numbers -> take(numbers)
    assert(reader(input) == 7)
}

-- [case: named-empty-header-scopes, run-pass]
-- spec: SPEC#dual-tier-where-invariants
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
fn first() -> fn() -> int {
    same
where
    fn same() -> int { 7 }
    fn spare() -> bool { true }
}
fn second() -> fn() -> int {
    same
where
    fn same() -> int { 9 }
}
pub fn test_native() {
    let left = first()
    let right = second()
    assert(left() == 7 && right() == 9)
}

-- [case: derive-named-construction, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
type Grid = { mut rows: [0][2]int, mut title: str }
fn fixed(rows: [0][2]int) -> int { len(rows) }
fn revise(mut draft: Grid) &mut {
    assert(fixed(draft.rows) == 0)
    draft.title = "Revised"
}
pub fn test_native() {
    let revised = Grid.{ rows: [], title: "Guide" } |> derive revise
    assert(revised.title == "Revised")
}

-- [case: derive-distinct-targets, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- entry: test_native
-- file: source.ril
type Document = { mut title: str }
fn first_title(mut draft: Document) &mut { draft.title = "First" }
fn second_title(mut draft: Document) &mut { draft.title = "Second" }
pub fn test_native() {
    let source = clone_immut(Document.{ title: "Guide" })
    let first = source |> derive first_title
    let second = source |> derive second_title
    assert(source.title == "Guide" && first.title == "First" && second.title == "Second")
}

-- [case: derive-named-repeated-activation, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
type Grid = { mut rows: [0][2]int, mut title: str }
fn fixed(rows: [0][2]int) -> int { len(rows) }
fn revise(mut draft: Grid) &mut {
    assert(fixed(draft.rows) == 0)
    draft.title = "Revised"
}
fn transform(source: Immut<Grid>) -> Immut<Grid> { source |> derive revise }
pub fn test_native() {
    let source = clone_immut(Grid.{ rows: [], title: "Guide" })
    let first = transform(source)
    let second = transform(source)
    assert(source.title == "Guide" && first.title == "Revised" && second.title == "Revised")
}

