-- [source: source-private-helpers]
-- file: source.ril
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel
fn duplicate<T>(source:T)->T @Fiber{clone(source)}
fn forward<T>(source:T)->T @Fiber{duplicate(source)}
pub fn test_native() @Async{
    assert(duplicate(7)==7)
    let result=scope \mut s -> {
        let starter=s.fork(\->())
        starter.join()?
        let (tx,mut rx)=Channel::bounded<int>(2)
        let mut first=forward(tx)
        let mut second=duplicate(tx)
        let inner_result=scope \mut inner -> {
            let child=inner.fork(\->{
                let own=forward(tx)
                Channel::close(own)
            })
            child.join()?
            Ok()
        }
        assert(inner_result is Ok())
        Channel::close(tx)
        assert((first !> Channel::send(1)) is Ok())
        Channel::close(first)
        assert((second !> Channel::send(2)) is Ok())
        Channel::close(second)
        assert((rx !> Channel::recv()) is Ok(1))
        assert((rx !> Channel::recv()) is Ok(2))
        assert((rx !> Channel::recv()) is Err(Channel::ChannelError::Closed))
        Channel::close(rx)
        Ok()
    }
    assert(result is Ok())
}

