-- [case: command-derive, run-pass]
-- spec: SPEC#functional-updates-via-derive
-- entry: test_native
-- file: source.ril
use ril/process
use ril/path
use ril/os
pub fn test_native() {
    let command = Process::command(Path::from_string("./unused"), [Os::from_string("argument")])
    let captured = command |> derive \mut draft -> { draft.stdout = Process::OutputMode::Capture }
    assert(command.stdout == Process::OutputMode::Inherit)
    assert(captured.stdout == Process::OutputMode::Capture)
    assert(len(captured.args) == 1)
}

-- [case: closed-constructors, run-pass]
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
use ril/process
pub fn test_native() {
    let status = Process::ExitStatus::Exited(7u32)
    assert(status is Process::ExitStatus::Exited(7u32))
    let input = Process::Input::Data(b"input")
    assert(input is Process::Input::Data(b"input"))
}

-- [case: buffered-callback-source, run-pass]
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
use ril/io
use ril/bytes
type Sink = { mut data: []u8 }
fn write(mut sink: Sink, data: bytes) -> Io::WriteProgress &mut {
    for Bytes::to_array(data) as value { sink.data !> Array::push(value) }
    .{written: len(data), error: None}
}
pub fn test_native() {
    let mut sink = Sink.{data: []}
    let mut buffer = Io::write_buffer(8)
    let progress = Io::write_buffered(mut buffer, mut sink, .{write: write}, b"abc")
    assert(progress.written == 3 && progress.error == None)
    assert(Io::flush(mut buffer, mut sink, .{write: write}) is Ok())
    assert(Bytes::from_array(sink.data) == b"abc")
}

-- [case: repeated-reader, run-pass]
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
use ril/io
type Reader = { scratch: [0][2]int, mut calls: int }
fn read(mut reader: Reader, maximum: int) -> Result<Io::ReadChunk, Io::IoError> &mut {
    reader.calls += 1
    assert(len(reader.scratch) == 0)
    Ok(.{data: b"", end: true})
}
pub fn test_native() {
    let mut reader = Reader.{scratch: [], calls: 0}
    let _: Io::ReadOps<Reader> = .{read: read}
    assert(Io::read_all(mut reader, .{read: read}) is Ok(b""))
    assert(Io::read_all(mut reader, .{read: read}) is Ok(b""))
    assert(reader.calls == 2)
}

-- [case: repeated-reader-mismatch, check-fail]
-- spec: SPEC#type-identity-and-subtyping
-- companion: repeated-reader
-- Error [E0301]: generated callback reception cannot change hidden inner dimensions
-- file: source.ril
use ril/io
type Reader = { scratch: [0][2]int, mut calls: int }
type Other = { scratch: [0][3]int, mut calls: int }
fn read(mut reader: Other, maximum: int) -> Result<Io::ReadChunk, Io::IoError> &mut {
    reader.calls += 1
    Ok(.{data: b"", end: true})
}
fn example() {
    let mut reader = Reader.{scratch: [], calls: 0}
    assert(Io::read_all(mut reader, .{read: read}) is Ok(b""))
}

-- [case: byte-array-fresh, run-pass]
-- spec: SPEC#type-identity-and-subtyping
-- entry: test_native
-- file: source.ril
use ril/bytes
pub fn test_native() {
    let mut values = Bytes::to_array(b"ab")
    values[0] = 122u8
    assert(Bytes::from_array(values) == b"zb")
}

-- [case: command-args-not-fixed, check-fail]
-- spec: SPEC#type-identity-and-subtyping
-- companion: command-derive
-- Error [E0301]: the public command stores a dynamic argument view regardless of input cardinality
-- file: source.ril
use ril/process
use ril/path
use ril/os
fn fixed(values: [1]Os::NativeString) -> int { len(values) }
fn example() {
    let command = Process::command(Path::from_string("./unused"), [Os::from_string("argument")])
    assert(fixed(command.args) == 1)
}

