-- [case: repeated-closure-results, run-pass]
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- spec: SPEC#default-parameters-and-named-arguments
-- entry: test_native
-- file: source.ril
pub fn test_native() {
    let saved = 7
    let read = \-> saved
    let alias = read
    let wrapped = \-> alias()
    for [1, 2, 3] as number {
        assert(number > 0)
        assert(wrapped() == 7)
    }
    assert(wrapped() == 7)
}

-- [case: early-formal-before-abrupt-default, run-panic]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: early-formal-default
-- entry: test_native
-- Panics: the actual default stops before the closure body is entered.
-- file: source.ril
pub fn test_native() {
    let stop = \seed: int, answer: int = {
        let seen = seed
        assert(seen == 1)
        panic("default stops before body entry")
    } -> answer
    stop(1)
}

-- [case: early-formal-default, run-pass]
-- spec: SPEC#default-parameters-and-named-arguments
-- entry: test_native
-- file: source.ril
pub fn test_native() {
    let take = \seed: int, answer: int = {
        let seen = seed
        seen
    } -> answer
    assert(take(7) == 7)
    assert(take(7, 8) == 8)
    assert(take(9) == 9)
}
