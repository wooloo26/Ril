-- [source: optional-child-views]
-- file: source.ril
type Packet = { id: int, items: [0][2]int }
type Envelope = { packet: ?Packet }
type Pair = (?Packet, bool)
type Wrap<T> = { packet: ?T }
fn tuple_view(input: (?Packet, bool)) -> int {
    match input.0 { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
fn record_view(input: Envelope) -> int {
    match input.packet { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
fn alias_view(input: Pair) -> int {
    match input.0 { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
fn generic_view(input: Wrap<Packet>) -> int {
    match input.packet { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
fn array_view(input: []?Packet) -> int {
    match input[0] { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
fn frozen_view(input: Immut<{ packet: ?Packet }>) -> int {
    match input.packet { Some(packet) -> packet.id + len(packet.items), None -> 0 }
}
pub fn test_native() {
    let packet = Packet.{ id: 7, items: [] }
    assert(tuple_view((Some(packet), false)) == 7)
    assert(record_view(Envelope.{ packet: Some(packet) }) == 7)
    assert(alias_view((Some(packet), true)) == 7)
    assert(generic_view(Wrap<Packet>.{ packet: Some(packet) }) == 7)
    assert(array_view([Some(packet)]) == 7)
    assert(frozen_view(clone_immut(.{ packet: Some(packet) })) == 7)
}

