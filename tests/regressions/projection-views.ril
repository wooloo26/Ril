-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: optional-child-views-pointer64
-- Error [E0301]: Projection preserves the optional payload's declared inner dimension.
-- file: source.ril
type Packet = { id: int, items: [0][3]int }
fn exact(value: ?{ id: int, items: [0][2]int }) { let _ = value }
fn example(input: (?Packet, bool)) { exact(input.0) }

