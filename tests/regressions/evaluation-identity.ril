--@ case: application-loop-computed-callee-fixed-empty
--@ mode: run-pass
--@ spec: SPEC#abstract-machine-and-memory-semantics
--@ spec: SPEC#pipeline-operators
--@ spec: SPEC#type-identity-and-subtyping
--@ entry: test_native
--@ file: source.ril
fn take(values:[0][2]int)->int{len(values)+1}
pub fn test_native(){
    var index=0
    var total=0
    while index<3{
        total+=({take})([])
        total+=([] |> ({take}))
        index+=1
    }
    assert(index==3 && total==6)
}
--@ end-file
--@ end-case

--@ case: application-mutating-computed-callee-order
--@ mode: run-pass
--@ spec: SPEC#pipeline-operators
--@ entry: test_native
--@ file: source.ril
type Cell={mut value:int}
var trace=0
fn mark(digit:int)->int &{mut trace}{trace=trace*10+digit;digit}
fn bump(mut cell:Cell,increment:int)&mut{cell.value+=increment}
pub fn test_native() &{mut trace}{
    let mut cells=[Cell.{value:10}]
    cells[mark(1)-1] !> ({mark(2);bump})(mark(3))
    assert(trace==123 && cells[0].value==13)
}
--@ end-file
--@ end-case

--@ case: application-callee-selected-before-written-mutation
--@ mode: run-pass
--@ spec: SPEC#pipeline-operators
--@ entry: test_native
--@ file: source.ril
fn early(left:i32,right:i32)->i32{left*10+right}
fn late(left:i32,right:i32)->i32{100+left*10+right}
pub fn test_native(){
    var changed=false
    let result=1i32 |> (if changed{late}else{early})({changed=true;2i32})
    assert(result==12i32 && changed)
}
--@ end-file
--@ end-case

--@ case: entry-packets-across-allocating-targets
--@ mode: run-pass
--@ spec: SPEC#abstract-machine-and-memory-semantics
--@ spec: SPEC#type-identity-and-subtyping
--@ companion: entry-packets-after-allocating-default
--@ entry: test_native
--@ file: source.ril
fn fresh()->[]int{[3]}
fn first(input:[]int)->int{let scratch=fresh();input[0]+scratch[0]}
fn second(input:[]int)->int{let scratch=fresh();input[0]+scratch[0]}
fn choose(flag:bool)->int{
    var index=0
    var total=0
    while index<2{
        let primed=fresh()
        let input=fresh()
        let selected=if flag{first}else{second}
        assert(primed[0]==3)
        total+=selected(input)
        index+=1
    }
    total
}
pub fn test_native(){assert(choose(true)==12 && choose(false)==12)}
--@ end-file
--@ end-case

--@ case: entry-packets-after-allocating-default
--@ mode: run-pass
--@ spec: SPEC#abstract-machine-and-memory-semantics
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: entry-packets-across-allocating-targets
--@ entry: test_native
--@ file: source.ril
fn fresh()->[]int{[3]}
fn selected(input:[]int,later:[]int=fresh())->int{input[0]+later[0]}
pub fn test_native(){
    var index=0
    while index<2{
        let primed=fresh()
        let input=fresh()
        assert(primed[0]==3 && selected(input)==6)
        index+=1
    }
}
--@ end-file
--@ end-case

--@ case: named-declaration-binding-identities
--@ mode: run-pass
--@ spec: SPEC#named-function-declarations-and-contrast-matrix
--@ spec: SPEC#closures-factory-signatures-and-lexical-environments
--@ companion: entry-packets-across-allocating-targets
--@ entry: test_native
--@ file: source.ril
type Reader=fn()->int &closure
fn make(value:int)->Reader &capture{
    read
where
    fn read()->int &{closure,value}{value}
}
fn other(value:int)->Reader &capture{
    read
where
    fn read()->int &{closure,value}{value}
}
fn apply(read:Reader)->int{read()}
pub fn test_native(){
    let first=make(1)
    let second=make(2)
    let third=other(3)
    let alias=first
    assert(alias()==1 && second()==2 && third()==3 && apply(first)==1)
}
--@ end-file
--@ end-case

--@ case: retained-carrier-tag-sources
--@ mode: check-pass
--@ spec: SPEC#effect-handlers
--@ spec: SPEC#type-identity-and-subtyping
--@ companion: retained-carrier-caller-source
--@ file: source.ril
eff Read{get()->int}
type Reader=fn(bool)->Result<[]int,str> &closure
fn make_reader()->Reader &capture{
    with Read::get()->{let answer=resume 7;answer};
    \success:bool->{let number=Read::get();if success{Ok([number])}else{Err("no")}}
}
fn example(){let reader=make_reader();assert(reader(true) is Ok(_));assert(reader(false) is Err("no"))}
--@ end-file
--@ end-case

--@ case: retained-carrier-caller-source
--@ mode: check-pass
--@ spec: SPEC#effect-handlers
--@ spec: SPEC#type-identity-and-subtyping
--@ companion: retained-carrier-tag-sources
--@ file: source.ril
eff Read{get()->int}
type Reader=fn(Immut<Result<[]int,str>>)->Result<[]int,str> &closure
fn make_reader()->Reader &capture{
    with Read::get()->{let answer=resume 7;answer};
    \value:Immut<Result<[]int,str>>->{Read::get();value}
}
fn example(){let reader=make_reader();let original:Result<[]int,str>=Ok([1]);let returned=reader(original);assert(returned is Ok(_))}
--@ end-file
--@ end-case

