--@ source: application-mutable-reception
--@ file: source.ril
type Cell={mut value:int}
fn bump(mut cell:Cell)&mut{cell.value+=1}
fn retain(^mut cell:Cell)->Cell &^mut{cell}
pub fn test_pipeline_mut(){let mut cell=Cell.{value:1};cell !> bump;assert(cell.value==2)}
pub fn test_ordinary_retained(){
    let mut cell=Cell.{value:1}
    let mut returned=retain(^mut cell)
    returned.value+=1
    assert(cell.value==2)
}
--@ end-file
--@ end-source

