--@ case: application-default-binding-control
--@ mode: run-pass
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ file: source.ril
fn selected(value:int=7)->int{value}
pub fn test_native(){
    assert(selected()==7)
    assert(selected(value:9)==9)
    assert((11 |> selected)==11)
}
--@ end-file
--@ end-case

--@ case: application-ordinary-unknown-label-before-default
