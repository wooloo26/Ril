--@ source: application-suspending-prefixes
--@ file: source.ril
eff Read{get()->int}
var trace=0
fn mark(digit:int)->int &{mut trace}{trace=trace*10+digit;digit}
fn combine(left:int,right:int)->int &{mut trace}{mark(4);left*10+right}
fn ordinary_suspended()->int @Read &{mut trace}{
    ({let ignored=Read::get();mark(3);combine})(mark(1),mark(2))
}
fn pipeline_left_suspended()->int @Read &{mut trace}{
    Read::get() |> ({mark(3);combine})(mark(2))
}
fn pipeline_written_suspended()->int @Read &{mut trace}{
    mark(1) |> ({mark(3);combine})({let value=Read::get();mark(2);value})
}
fn pipeline_callee_suspended()->int @Read &{mut trace}{
    mark(1) |> ({let ignored=Read::get();mark(3);combine})(mark(2))
}
pub fn test_ordinary_suspended() &{mut trace}{
    trace=0
    with Read::get()->resume 0
    assert(ordinary_suspended()==12 && trace==3124)
}
pub fn test_pipeline_left_suspended() &{mut trace}{
    trace=0
    with Read::get()->{mark(1);resume 1}
    assert(pipeline_left_suspended()==12 && trace==1324)
}
pub fn test_pipeline_written_suspended() &{mut trace}{
    trace=0
    with Read::get()->resume 2
    assert(pipeline_written_suspended()==12 && trace==1324)
}
pub fn test_pipeline_callee_suspended() &{mut trace}{
    trace=0
    with Read::get()->resume 0
    assert(pipeline_callee_suspended()==12 && trace==1324)
}
--@ end-file
--@ end-source

