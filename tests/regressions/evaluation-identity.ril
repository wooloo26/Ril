--@ case: named-default-after-explicit-arguments
--@ mode: run-pass
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ companion: reject-stateful-parameter-default
-- Defaults remain pure; omitted right observes the earlier actual left value.
--@ file: source.ril
var trace=0
fn mark(digit:int)->int &{mut trace}{trace=trace*10+digit;digit}
fn combine(left:int=3,right:int=left+1)->int{left*10+right}
pub fn test_native() &{mut trace}{
    trace=0
    assert(combine(right:mark(2))==32 && trace==2)
    trace=0
    assert(combine(left:mark(1))==12 && trace==1)
    trace=0
    assert(combine()==34 && trace==0)
}
--@ end-file
--@ end-case

--@ case: reject-stateful-parameter-default
--@ mode: check-fail
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: named-default-after-explicit-arguments
-- The initial new identity fixture was impure; retain its source as a negative.
-- Error [E0409]: Defaults cannot retain state obligations even when the function declares them.
--@ file: source.ril
var trace=0
fn mark(digit:int)->int &{mut trace}{trace=trace*10+digit;digit}
fn combine(left:int=mark(3),right:int=mark(4))->int &{mut trace}{left*10+right}
pub fn test_native() &{mut trace}{
    trace=0
    assert(combine(right:mark(2))==32 && trace==23)
    trace=0
    assert(combine(left:mark(1))==14 && trace==14)
    trace=0
    assert(combine()==34 && trace==34)
}
--@ end-file
--@ end-case

--@ case: closure-objects-share-lexical-site
--@ mode: run-pass
--@ spec: SPEC#closures-factory-signatures-and-lexical-environments
--@ entry: test_native
--@ file: source.ril
type Adder=fn(int)->int &closure
fn make(base:int)->Adder &capture{\value:int->base+value}
pub fn test_native(){
    let first=make(10)
    let second=make(20)
    assert(first(1)==11 && second(1)==21)
    assert(first(2)==12 && second(2)==22)
}
--@ end-file
--@ end-case

--@ case: closure-default-uses-earlier-actual
--@ mode: run-pass
--@ spec: SPEC#named-function-declarations-and-contrast-matrix
--@ entry: test_native
--@ file: source.ril
pub fn test_native(){
    let action=\left:int,right:int=left+1 -> left*10+right
    assert(action(3)==34)
    assert(action(7)==78)
    assert(action(right:9,left:2)==29)
}
--@ end-file
--@ end-case

--@ case: closure-default-lexical-environment
--@ mode: run-pass
--@ spec: SPEC#named-function-declarations-and-contrast-matrix
--@ entry: test_native
--@ file: source.ril
pub fn test_native(){
    let action=\first:int=saved(),second:int=first+1,third:int=first+2,fourth:int=third+1 -> first*1000+second*100+third*10+fourth
    {
        assert(action()==7900)
        assert(action(2)==2345)
        assert(saved()==99)
    where
        fn saved()->int{99}
    }
where
    fn saved()->int{7}
}
--@ end-file
--@ end-case

--@ case: generated-adapter-per-call
--@ mode: run-pass
--@ spec: STD#explicit-iteration
--@ entry: test_native
--@ file: source.ril
fn doubled(first:int)->int{
    let indexed=Iter::indexed([first,first+1])
    let mapped=Iter::map(indexed,\value:int->value*2)
    let limited=Iter::take(mapped,1)
    let mut cursor=Iter::cursor((0,0))
    Iter::pull(mut cursor,limited) ?? 0
}
pub fn test_native(){
    assert(doubled(3)==6)
    assert(doubled(7)==14)
}
--@ end-file
--@ end-case

--@ case: repeated-pattern-value-read
--@ mode: run-pass
--@ spec: SPEC#value-tests-with-is
--@ entry: test_native
--@ file: source.ril
fn same_value(value:int, expected:int)->bool{value is expected}
fn is_one(value:int)->bool{value is 1}
pub fn test_native(){
    assert(same_value(1,1));assert(!same_value(2,1));assert(same_value(3,3))
    assert(is_one(1));assert(!is_one(2));assert(is_one(1))
}
--@ end-file
--@ end-case

--@ source: application-prefix-control
--@ file: source.ril
var trace=0
fn mark(digit:int)->int &{mut trace}{trace=trace*10+digit;digit}
fn combine(left:int,right:int)->int &{mut trace}{mark(4);left*10+right}
fn ordinary_callee_stop()->int &{mut trace}{
    ({mark(1);return 7})(mark(2),mark(3))
}
fn ordinary_first_stop()->int &{mut trace}{
    ({mark(1);combine})({mark(2);return 7},mark(3))
}
fn ordinary_last_stop()->int &{mut trace}{
    ({mark(1);combine})(mark(2),{mark(3);return 7})
}
fn pipeline_left_stop()->int &{mut trace}{
    ({mark(1);return 7}) |> ({mark(3);combine})(mark(2))
}
fn pipeline_written_stop()->int &{mut trace}{
    mark(1) |> ({mark(3);combine})({mark(2);return 7})
}
fn pipeline_callee_stop()->int &{mut trace}{
    mark(1) |> ({mark(3);return 7})(mark(2))
}
pub fn test_ordinary_callee_never() &{mut trace}{trace=0;assert(ordinary_callee_stop()==7 && trace==1)}
pub fn test_ordinary_first_never() &{mut trace}{trace=0;assert(ordinary_first_stop()==7 && trace==12)}
pub fn test_ordinary_last_never() &{mut trace}{trace=0;assert(ordinary_last_stop()==7 && trace==123)}
pub fn test_pipeline_left_never() &{mut trace}{trace=0;assert(pipeline_left_stop()==7 && trace==1)}
pub fn test_pipeline_written_never() &{mut trace}{trace=0;assert(pipeline_written_stop()==7 && trace==132)}
pub fn test_pipeline_callee_never() &{mut trace}{trace=0;assert(pipeline_callee_stop()==7 && trace==13)}
pub fn test_ordinary_order() &{mut trace}{
    trace=0
    let result=({mark(9);combine})(mark(1),mark(2))
    assert(result==12 && trace==9124)
}
pub fn test_pipeline_order() &{mut trace}{
    trace=0
    let result=mark(1) |> ({mark(9);combine})(mark(2))
    assert(result==12 && trace==1924)
}
--@ end-file
--@ end-source

