fn mark(digit:int)->int &{mut trace}{trace=trace*10+digit;digit}
fn combine(left:int,right:int)->int{left*10+right}
pub fn test_native() &{mut trace}{
    trace=0
    let result=({mark(1);combine})(mark(2),mark(3))
    assert(result==23 && trace==123)
}
