--@ case: application-repeated-source-interval
--@ mode: check-pass
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ file: source.ril no-final-newline
fn take(value:[2]int){}
fn repeat(values:[2]int){var count=0;for [0,1] as step{take(values);count+=1};assert(count>=0)}
fn example(){repeat([7,9])}
--@ end-file
--@ end-case

