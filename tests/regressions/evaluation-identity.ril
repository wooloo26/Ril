fn grow(mut values:[]int)&mut{values !> Array::push(3)}
fn forward(action:fn(mut []int)->(),mut values:[2]int)&mut{action(mut values)}
fn example(){let mut values:[2]int=[1,2];forward(grow,mut values)}
