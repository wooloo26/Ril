--@ case: application-repeated-ordinary-and-pipeline
--@ mode: run-pass
--@ spec: SPEC#abstract-machine-and-memory-semantics
--@ spec: SPEC#pipeline-operators
--@ entry: test_native
--@ file: source.ril
fn combine(first:int,second:int)->int{first*10+second}
fn ordinary(first:int)->int{combine(first,2)}
fn piped(first:int)->int{first |> combine(2)}
pub fn test_native(){
    assert(ordinary(1)==12 && ordinary(3)==32)
    assert(piped(1)==12 && piped(3)==32)
}
