-- [source: fallible-loop-input]
-- file: source.ril
fn active(index: int) -> Result<?int, str> {
    if index < 0 { Err("stopped") }
    else if index >= 3 { Ok(None) }
    else { Ok(Some(index + 1)) }
}
fn collect(fail_at: int) -> Result<int, str> {
    var index = 0
    var total = 0
    loop {
        let Some(work) = active(if index == fail_at { -1 } else { index })? else {
            last
        }
        total += work
        index += 1
    }
    Ok(total)
}
pub fn test_native() {
    assert(collect(99) is Ok(6))
    assert(collect(0) is Err("stopped") && collect(2) is Err("stopped"))
    assert(collect(99) is Ok(6))
}

