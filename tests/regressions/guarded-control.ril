-- [source: fallible-closure-tuples]
-- file: source.ril
fn active(value: int) -> Result<?(int, int), str> {
    if value < 0 { Err("negative") }
    else if value == 0 { Ok(None) }
    else { Ok(Some((value, value + 1))) }
}
fn compute(value: int) -> Result<int, str> {
    let reader: fn() -> Result<int, str> &closure = \-> {
        let Some((left, right)) = active(value)? else { return Ok(0) }
        Ok(left + right)
    }
    let answer = reader()
    answer
}
pub fn test_native() {
    assert(compute(3) is Ok(7) && compute(0) is Ok(0))
    assert(compute(-1) is Err("negative") && compute(4) is Ok(9))
}

