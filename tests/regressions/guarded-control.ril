--@ case: reject-fallible-nondivergent-else
--@ mode: check-fail
--@ spec: SPEC#guarded-bindings-and-non-vacuous-invariant
--@ companion: fallible-loop-input-pointer32
-- Error [E0321]: Propagation in the subject does not make a normal else diverge.
--@ file: source.ril
fn example(item: Result<?int, str>) -> Result<int, str> {
    let Some(value) = item? else { () }
    Ok(value)
}
--@ end-file
--@ end-case

--@ case: reject-fallible-vacuous-binding
--@ mode: check-fail
--@ spec: SPEC#guarded-bindings-and-non-vacuous-invariant
--@ companion: fallible-closure-tuples-pointer64
-- Error [E0309]: A guarded discard remains vacuous after propagation.
--@ file: source.ril
fn example(item: Result<?int, str>) -> Result<int, str> {
    let _ = item? else { return Ok(0) }
    Ok(1)
}
--@ end-file
--@ end-case
