-- [case: reject-uninspected-result-in-payload, check-fail]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: optional-array-shapes-pointer64
-- Error [E0720]: Inspecting an outer constructor does not inspect its record's Result.
-- file: source.ril
type Wrapped = { payload: Result<[0][2]int, int> }
fn outer_only(value: Result<Wrapped, int>) -> int {
    match value { Ok(wrapped) -> { let _ = wrapped; 0 }, Err(_) -> 0 }
}
fn example() {
    let items: [0][2]int = []
    let inner: Result<[0][2]int, int> = Ok(items)
    let outer: Result<Wrapped, int> = Ok(Wrapped.{ payload: inner })
    let _ = outer_only(outer)
}

-- [case: nested-constructor-context, check-pass]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: optional-array-shapes-pointer64
-- file: source.ril
type Wrapped = { payload: Result<[0][2]int, int> }
fn example() -> int {
    let value: Result<Wrapped, int> = Ok(Wrapped.{ payload: Ok([]) })
    match value {
        Ok(wrapped) -> match wrapped.payload { Ok(items) -> len(items), Err(_) -> 0 },
        Err(_) -> 0,
    }
}

-- [case: reject-unselected-writer-restoration, check-fail]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: optional-array-shapes-pointer64
-- Error [E0520]: A hypothetical payload cannot restore writable access through a readonly binding.
-- file: source.ril
type Cell = { mut count: int }
fn example() -> int {
    let value: ?Cell = None
    match value { Some(mut cell) -> { cell.count += 1; 1 }, None -> 0 }
}

