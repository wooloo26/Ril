-- [source: optional-array-shapes]
-- file: source.ril
type Packet = { id: int, items: [0][2]int }
type Wrapped = { payload: Result<[0][2]int, int> }
fn size(values: [0][2]int) -> int { len(values) }
fn inspect(value: ?Packet) -> int {
    match value { Some(packet) -> packet.id + size(packet.items), None -> 0 }
}
fn local_absent() -> int {
    let value: ?Packet = None
    match value { Some(packet) -> packet.id + size(packet.items), None -> 0 }
}
fn from_result(value: Result<Packet, int>) -> int {
    match value { Ok(packet) -> packet.id + size(packet.items), Err(_) -> 0 }
}
fn nested_result(value: Result<Wrapped, int>) -> int {
    match value {
        Ok(wrapped) -> match wrapped.payload { Ok(items) -> size(items), Err(_) -> 0 },
        Err(_) -> 0,
    }
}
pub fn test_native() {
    let packet = Packet.{ id: 7, items: [] }
    assert(inspect(Some(packet)) == 7)
    assert(inspect(None) == 0)
    assert(local_absent() == 0)
    assert(from_result(Ok(packet)) == 7)
    assert(from_result(Err(1)) == 0)
    assert(nested_result(Ok(Wrapped.{ payload: Ok(packet.items) })) == 0)
    assert(nested_result(Err(1)) == 0)
}

