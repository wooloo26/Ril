--@ source: source-non-tail-reference-answer
--@ file: source.ril
eff Read{get()->int}
fn ordinary_answer()->[]int{
    with Read::get()->{
        let answer=resume 7
        assert(answer[0]==7)
        clone(answer)
    }
    [Read::get()]
}
pub fn test_native(){let answer=ordinary_answer();assert(answer==[7])}
--@ end-file
--@ end-source

