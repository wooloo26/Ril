--@ source: symbolic-type-through-three-frames
--@ file: source.ril
fn identity<T>(value:T)->T{value}
fn forward<U>(value:U)->U{identity<U>(value)}
fn outer<V>(value:V)->V{forward<V>(value)}
pub fn test_native(){
    assert(outer(7)==7)
    let input:[2]int=[7,9]
    let output:[2]int=outer(input)
    let empty:[0][3]int=[]
    let received:[0][3]int=outer(empty)
    assert(output==[7,9] && len(received)==0)
}
--@ end-file
--@ end-source

