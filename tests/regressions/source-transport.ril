--@ source: bounded-record-tuple-return
--@ file: source.ril
fn first<U,T:{items:[2]U,..R}>(value:(T,int))->U{value.0.items[0]}
fn forward<U,S>(value:({items:[2]U,tag:str,..S},int))->U{first<U>(value)}
pub fn test_native(){
    let values:[2]int=[7,9]
    assert(forward((.{items:values,tag:"same"},0))==7)
}
