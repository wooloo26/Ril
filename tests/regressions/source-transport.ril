--@ source: const-nominal-formal-source-graph
--@ file: source.ril
type Token<size:int>(int)
fn identity(value:Token<1>)->Token<1>{value}
pub fn test_native(){
    let original:Token<1>=Token<1>(7)
    let received:Token<1>=identity(original)
    assert(inner(received)==7)
}
--@ end-file
--@ end-source

