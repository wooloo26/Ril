--@ source: open-record-through-generic-identity
--@ file: source.ril
fn identity<T>(value:T)->T{value}
fn forward<U,R>(value:{items:[2]U,..R})->{items:[2]U,..R}{identity(value)}
pub fn test_native(){
    let values:[2]int=[7,9]
    let received=forward(.{items:values,tag:"same"})
    assert(received.items[0]==7 && received.tag=="same")
}
