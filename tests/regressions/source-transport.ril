--@ source: generic-literal-collection-source-graphs
--@ file: source.ril
fn singleton<T>(value:T)->[1]T{[value]}
fn mapping<T>(value:T)->[str:T]{["one":value]}
fn first(items:[2]int)->int{items[0]}
fn example(){
    let empty:[0][3]int=[]
    let nested:[1][0][3]int=singleton(empty)
    let by_name:[str:[0][3]int]=mapping(empty)
    let callbacks:[1](fn([2]int)->int)=singleton(first)
    let callback_map:[str:(fn([2]int)->int)]=mapping(first)
    let items:[2]int=[7,9]
    assert(len(nested)==1 && len(nested[0])==0)
    assert(len(by_name)==1 && len(callback_map)==1)
    assert(callbacks[0](items)==7)
}
pub fn test_native(){example()}
--@ end-file
--@ end-source

