--@ case: returned-alias-dimension-conflict
--@ mode: check-fail
--@ spec: SPEC#type-identity-and-subtyping
-- Error [E0301]: A returned alias retains its declared nested array dimension.
--@ file: source.ril
type Box={items:[0][2]int}
type Other={items:[0][3]int}
fn make()->Box{Box.{items:[]}}
fn example(){var target=make();let replacement=Other.{items:[]};target=replacement}
