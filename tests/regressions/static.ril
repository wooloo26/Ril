--@ source: source-worker-allocation-pressure
--@ file: source.ril
-- Runtime.allocate collects at its initial live-object threshold of 1024.
-- The 1200 array allocations below necessarily cross it; only GC reduces live.
use ril/concurrent::{scope, TaskFault}
meta let ROOT = { let child = [7]; (child, child) }
pub fn test_native() @Concurrent &{ROOT} {
    let result = scope \mut s -> {
        let child = s.fork(\-> {
            for 0..1200 as index { let unused = [index, index + 1] }
            ROOT.0[0] + ROOT.1[0]
        })
        child.join()
    }
    assert(result is Ok(14))
    assert(ROOT.0 == [7] && ROOT.1 == [7])
}
--@ end-file
--@ end-source

