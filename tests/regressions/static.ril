--@ source: source-static-result-context-flow
--@ file: source.ril
meta fn empty<T>() -> []T { [] }
meta fn package<T, U>(value: T) -> (T, []U) { (value, []) }
meta fn relay<T>(value: T) -> (T, []int) {
    let other: []str = empty()
    return { package(value) }
}
meta let ANSWER = {
    let original: Result<int, str> = Ok(7)
    let first: (Result<int, str>, []int) = relay(original)
    let absent: ?(Result<int, str>, []int) = None
    let fallback: (Result<int, str>, []int) = absent ?? package(first.0)
    let wrapped: ?(Result<int, str>, []int) = Some(package(fallback.0))
    let previous = wrapped ?? package(original)
    let final: (Result<int, str>, []int) = Some(package(previous.0)) ?? package(original)
    let looped: []int = loop { last empty() }
    assert(len(looped) == 0)
    assert(final.0 is Ok(_))
    assert(len(final.1) == 0)
    7
}
meta let _ = assert(ANSWER == 7)
pub fn test_native() &{ANSWER} { assert(ANSWER == 7) }
--@ end-file
--@ end-source

