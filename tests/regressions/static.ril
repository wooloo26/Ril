--@ source: source-positive
--@ file: source.ril
meta fn empty<T>() -> []T { [] }
meta fn forward<U>() -> []U { empty() }
meta fn count(values: []int) -> int { len(values) }
meta fn retain<T, U>(value: T) -> (T, []U) { (value, []) }
meta fn right(right: int = 2) -> int { right }

meta let ITEMS: []int = empty()
meta let NESTED: [][0][2]int = empty()
meta let FORWARDED: []int = forward()
meta let BRANCH: []int = if true { empty() } else { empty() }
meta let LIFTED: []int = Some(empty()) ?? []
meta let COUNT = count(empty())
meta let ANSWER = {
    let pair: (fn(renamed: int) -> int, []int) = retain(right)
    pair.0(renamed: 7)
}
meta let _ = assert(len(ITEMS) == 0 && len(NESTED) == 0 && len(FORWARDED) == 0)
meta let _ = assert(len(BRANCH) == 0 && COUNT == 0 && ANSWER == 7)
meta let _ = assert(len(LIFTED) == 0)

pub fn test_native() &{ITEMS, NESTED, FORWARDED, BRANCH, LIFTED, COUNT, ANSWER} {
    assert(len(ITEMS) == 0 && len(NESTED) == 0 && len(FORWARDED) == 0)
    assert(len(BRANCH) == 0 && COUNT == 0 && ANSWER == 7)
    assert(len(LIFTED) == 0)
}
