--@ source: source-later-projection
--@ file: source.ril
-- Native regression: later meta projections reuse the original node.
meta fn shared() -> ([]int, []int) { let child = [1]; (child, child) }
meta let ROOT = shared()
meta let SELECTED = ROOT.0
pub fn test_native() &{ROOT, SELECTED} {
    let mut copied = ^mut clone((ROOT, SELECTED))
    (copied.0).0 !> Array::push(2)
    assert((copied.0).1 == [1, 2] && copied.1 == [1, 2])
    assert(ROOT.0 == [1] && SELECTED == [1])
}
--@ end-file
--@ end-source

