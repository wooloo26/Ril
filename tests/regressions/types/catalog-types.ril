-- [case: nested-constructor-patterns, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
-- entry: test_native
-- file: source.ril
use ril/process
fn nested(value: (Process::ExitStatus, { status: Process::ExitStatus })) -> bool {
    value is (Process::ExitStatus::Signaled(-1), .{status: Process::ExitStatus::Exited(4294967295)})
}
pub fn test_native() {
    let value = (Process::ExitStatus::Signaled(-1), .{status: Process::ExitStatus::Exited(4294967295u32)})
    assert(nested(value))
    assert(nested(value))
    assert(!nested((Process::ExitStatus::Signaled(0), .{status: Process::ExitStatus::Exited(4294967295u32)})))
}

-- [case: catalog-constant-patterns, run-pass]
-- spec: STD#numbers-and-mathematics
-- spec: SPEC#pattern-matching
-- entry: test_native
-- file: source.ril
use ril/num
fn invalid() -> bool {
    Num::parse_int("invalid") is Err(Num::NumError::InvalidSyntax)
}
pub fn test_native() {
    assert(invalid())
    assert(invalid())
    assert(!(Num::NumError::InvalidSyntax is Num::NumError::OutOfRange))
    let expected = Num::NumError::InvalidSyntax
    assert(Num::NumError::InvalidSyntax is expected)
}

-- [case: constructor-pattern-overflow, check-fail]
