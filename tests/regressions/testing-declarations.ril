--@ source: equality-helpers
--@ file: root.ril
use facade::{same, different}
use ril/test as Checks

fn equal<T>(left: T, right: T) -> bool { left == right }
fn different_values<T>(left: T, right: T) -> bool { left != right }
fn matches_value<T>(left: T, right: T) -> bool { left is right }
fn forwarded<T>(left: T, right: T) -> bool { equal(left, right) }
fn repeated<T>(count: int, left: T, right: T) -> bool {
    if count > 0 { repeated(count - 1, left, right) } else { left == right }
}
fn invoke(compare: fn([]int, []int) -> bool) {
    assert(compare([1, 2], [1, 2]))
}
fn bounded(limit: int) -> ?int {
    with Div::exhausted() -> None
    Some(Div::budget(limit, \-> { Checks::assert_eq(1, 1); 7 }))
}
pub fn test_equality_helpers() {
    same([1, 2], [1, 2])
    different(b"a", b"b", "different bytes")
    Checks::assert_eq<int>(expected: 3, actual: 3)
    Checks::assert_ne(unexpected: "b", actual: "a", message: "different text")
    let check = Checks::assert_eq
    check(.{ value: (1, "a") }, .{ value: (1, "a") })
    let unequal = Checks::assert_ne<[2]int>
    unequal([1, 2], [1, 3])
    assert(forwarded([1, 2], [1, 2]))
    assert(repeated(3, [1, 2], [1, 2]))
    assert(different_values([1, 2], [1, 3]))
    assert(matches_value([1, 2], [1, 2]))
    invoke(equal<[]int>)
    assert(bounded(1) == None && bounded(2) == Some(7))
    let left: Result<int, str> = Ok(7)
    let right: Result<int, str> = Ok(7)
    Checks::assert_eq(left, right)
    assert(left is Ok(7) && right is Ok(7))
    var order = 0
    Checks::assert_ne(increment(), increment(), message())
    assert(order == 3)
where
    fn increment() -> int &{closure, mut order} { order += 1; order }
    fn message() -> str &{closure, mut order} { assert(order == 2); order += 1; "ordered" }
}
--@ end-file
--@ file: facade.ril
pub use ril/test::{assert_eq as same, assert_ne as different}
--@ end-file
--@ end-source

