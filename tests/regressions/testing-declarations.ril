--@ case: reject-callable
--@ mode: check-fail
--@ spec: SPEC#relational-equality-and-containment-operators
--@ companion: helpers-native
-- Error [E0327]: Generic testing functions preserve equality eligibility.
--@ file: source.ril
use ril/test
fn action() {}
fn invalid() { Test::assert_eq(action, action) }
--@ end-file
--@ end-case

--@ case: reject-nested-callable
--@ mode: check-fail
--@ spec: SPEC#relational-equality-and-containment-operators
--@ companion: helpers-native
-- Error [E0327]: A nested callable cannot acquire equality through a generic alias.
--@ file: source.ril
use ril/test::{assert_ne as different}
fn action() {}
fn invalid() { let check = different; check([Some(action)], [Some(action)]) }
--@ end-file
--@ end-case

--@ case: reject-forwarded-callable
--@ mode: check-fail
--@ spec: SPEC#relational-equality-and-containment-operators
--@ companion: helpers-native
-- Error [E0327]: Generic forwarding rechecks the actual operand types.
--@ file: source.ril
fn equal<T>(left: T, right: T) -> bool { left == right }
fn forwarded<T>(left: T, right: T) -> bool { equal(left, right) }
fn action() {}
fn invalid() { let _ = forwarded(action, action) }
--@ end-file
--@ end-case

--@ case: reject-higher-order-callable
--@ mode: check-fail
--@ spec: SPEC#relational-equality-and-containment-operators
--@ companion: helpers-native
-- Error [E0327]: A callback invocation checks the generic body's equality condition.
--@ file: source.ril
fn equal<T>(left: T, right: T) -> bool { left == right }
type Action = fn() -> ()
fn invoke(compare: fn(fn() -> (), fn() -> ()) -> bool) {
    let action = \-> ()
    let _ = compare(action, action)
}
fn invalid() { invoke(equal<Action>) }
--@ end-file
--@ end-case

--@ case: reject-recursive-callable
--@ mode: check-fail
--@ spec: SPEC#relational-equality-and-containment-operators
--@ companion: helpers-native
-- Error [E0327]: A recursive instance cannot bypass the equality condition.
--@ file: source.ril
fn action() {}
fn rotated<T, U>(count: int, left: T, other: U) -> bool {
    if count > 0 { rotated(count - 1, other, left) } else { left == left }
}
fn invalid() { let _ = rotated(3, 1, action) }
--@ end-file
--@ end-case

--@ case: reject-nested-resource
