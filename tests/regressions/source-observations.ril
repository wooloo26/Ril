--@ case: callable-product-open-row
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ file: source.ril no-final-newline
var calls=0
fn step(value:int)->int &{mut calls}{calls+=1;value}
fn invoke(value:{step:fn(int)->int &{mut calls}})&{mut calls}{assert(value.step(1)==1)}
fn example()&{mut calls}{invoke(.{step:step})}
--@ end-file
--@ end-case

--@ case: generated-indexed-iterator
