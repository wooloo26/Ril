--@ end-case

--@ case: generated-map-filter-take
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ file: source.ril no-final-newline
fn example(){let source=Iter::map(Iter::indexed([1,2]),\n->n*2);let filtered=Iter::filter(source,\n:int->n>1);let limited=Iter::take(filtered,1);let mut cursor=Iter::cursor((0,0));assert(Iter::pull(mut cursor,limited)==Some(2))}
--@ end-file
--@ end-case

