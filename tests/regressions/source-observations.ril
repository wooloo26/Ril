--@ case: reject-optional-projection-hidden-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: optional-projection-paths-pointer32
-- Error [E0301]: Unwrapping a base before a field keeps the hidden inner dimension.
--@ file: source.ril
fn exact(values: [0][2]int) -> int { len(values) }
fn example() {
    let values: [0][3]int = []
    let packet: ?{items: [0][3]int} = Some(.{ items: values })
    if packet != None {
        let field = packet.items
        let invalid = exact(field)
    }
}
--@ end-file
--@ end-case
