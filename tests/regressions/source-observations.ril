--@ end-case

--@ case: closure-captured-step
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ file: source.ril no-final-newline
fn apply(callback:fn(int)->int,x:int)->int{callback(x)}
fn example(){let step=\n:int->n+1;let callback=\n->apply(step,n);assert(callback(1)==2)}
--@ end-file
--@ end-case

--@ case: closure-generic-return
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ file: source.ril no-final-newline
fn make<T>(value:T)->fn(T)->T{\argument:T->argument}
fn consume<T>(value:T){let action=make(1);assert(action(2)==2)}
--@ end-file
--@ end-case

--@ case: generic-immutable-empty-local
