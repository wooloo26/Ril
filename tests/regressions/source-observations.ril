--@ case: call-result-complete-roots
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ file: source.ril no-final-newline
fn leaf(value:int)->int{value}
fn example(){let first=leaf(1);let second=leaf(first);assert(second==1)}
--@ end-file
--@ end-case

--@ case: call-result-never-root
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
