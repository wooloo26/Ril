--@ case: generic-operation-view-native
--@ mode: run-pass
--@ spec: SPEC#effect-handlers
--@ companion: generic-operation-view
--@ entry: test_native
--@ use-source: generic-operation-view
--@ end-case

--@ case: reject-operation-hidden-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: fixed-operation-view
-- Error [E0301]: An ignored handler parameter does not erase the incoming hidden dimension.
--@ file: source.ril
eff Accept { apply([0][2]int) -> () }
fn example(){
    with Accept::apply(_) -> resume ()
    let wrong:[0][3]int=[]
    Accept::apply(wrong)
}
--@ end-file
--@ end-case

--@ case: reject-resumption-hidden-dimension
--@ mode: check-fail
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: fixed-operation-view
-- Error [E0301]: A resume operand retains its declared hidden inner dimension.
--@ file: source.ril
eff Read { get() -> [0][2]int }
fn example(){
    let wrong:[0][3]int=[]
    with Read::get() -> resume wrong
    let result=Read::get()
}
--@ end-file
--@ end-case

--@ source: generic-callback-interface
--@ file: source.ril
eff Echo<T> { apply(T) -> T }
type Callback = fn(value: int) -> int
fn number(original: int = 7) -> int { original }
pub fn test_native() {
    with Echo<Callback>::apply(action) -> resume action
    let action = Echo<Callback>::apply(number)
    assert(action(value: 9) == 9 && action(value: 12) == 12)
}
--@ end-file
--@ end-source

