-- [source: generic-operation-view]
-- file: source.ril
eff Echo<T> { apply(T) -> T }
pub fn test_native(){
    with Echo<[2]int>::apply(values) -> resume values
    let input:[2]int=[7,9]
    let output:[2]int=Echo<[2]int>::apply(input)
    assert(output[0]==7 && output[1]==9)
}

