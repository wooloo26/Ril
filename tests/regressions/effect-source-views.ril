-- [source: fixed-operation-view]
-- file: source.ril
eff Echo { apply([2]int) -> [2]int }
pub fn test_native(){
    with Echo::apply(values) -> resume values
    let input:[2]int=[7,9]
    let output:[2]int=Echo::apply(input)
    assert(output[0]==7 && output[1]==9)
}

