-- [case: reject-generic-resumption-hidden-dimension, check-fail]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: generic-operation-view
-- Error [E0301]: Generic operation results retain every selected array dimension.
-- file: source.ril
eff Read<T> { get() -> T }
fn example() {
    let wrong: [0][3]int = []
    with Read<[0][2]int>::get() -> resume wrong
    let result = Read<[0][2]int>::get()
}

-- [case: reject-generic-callback-default-recovery, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: generic-callback-interface-pointer64
-- Error [E0314]: Passing through an effect cannot recover a hidden default.
-- file: source.ril
eff Echo<T> { apply(T) -> T }
type Callback = fn(value: int) -> int
fn number(original: int = 7) -> int { original }
fn example() {
    with Echo<Callback>::apply(action) -> resume action
    let action = Echo<Callback>::apply(number)
    let missing = action()
}
