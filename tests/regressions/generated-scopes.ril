--@ case: scope-token
--@ mode: run-pass
--@ spec: STD#structured-concurrency-and-panic-containment
--@ entry: test_native
--@ file: source.ril
use ril/concurrent::{scope, TaskFault}

pub fn test_native() @Concurrent {
    let first = scope \mut s -> {
        let view alias = s
        let task = s.fork(\-> 7)
        task.join()
    }
    assert(first is Ok(7))
    let second = scope \mut s -> {
        let task = s.fork(\-> 9)
        task.join()
    }
    assert(second is Ok(9))
}
--@ end-file
--@ end-case

--@ case: scope-fault-declarations
--@ mode: run-pass
--@ spec: STD#structured-concurrency-and-panic-containment
--@ companion: scope-token
--@ entry: test_native
--@ file: source.ril
use ril/concurrent::{TaskFault, UnwindCause}

pub fn test_native() {
    let primary = UnwindCause::Panicked(.{ message: "body", index: Some(2) })
    let failure = TaskFault::DoubleFaultFatal(.{
        primary: primary,
        cleanup: .{ message: "cleanup", index: None }
    })
    match failure {
        TaskFault::DoubleFaultFatal(info) -> {
            assert(info.cleanup.message == "cleanup")
            match info.primary {
                UnwindCause::Panicked(info) -> assert(info.index is Some(2)),
                _ -> panic("wrong primary fault")
            }
        },
        _ -> panic("wrong task fault")
    }
    assert(TaskFault::Cancelled is TaskFault::Cancelled)
}
--@ end-file
--@ end-case

--@ case: reject-shadowed-catalog-pattern-namespace
--@ mode: check-fail
--@ spec: SPEC#pattern-matching
--@ spec: STD#structured-concurrency-and-panic-containment
--@ companion: scope-fault-declarations
-- Error [E0204]: A local type cannot supply the canonical catalog constructor namespace.
--@ file: source.ril
use ril/concurrent::{TaskFault}

fn inspect(value: TaskFault)
where
    type Concurrent = int
{
    match value {
        Concurrent::TaskFault::DoubleFaultFatal(info) -> (),
        _ -> (),
    }
}
--@ end-file
--@ end-case

--@ case: repeated-scope-token
--@ mode: run-pass
--@ spec: STD#structured-concurrency-and-panic-containment
--@ companion: scope-token
--@ entry: test_native
--@ file: source.ril
use ril/concurrent::{scope, TaskFault}

fn run(value: int) -> Result<int, TaskFault> @Concurrent {
    scope \mut s -> {
        let task = s.fork(\-> value)
        task.join()
    }
}
pub fn test_native() @Concurrent {
    assert(run(7) is Ok(7))
    assert(run(9) is Ok(9))
}
--@ end-file
--@ end-case

--@ case: scope-token-escape
--@ mode: check-fail
--@ spec: STD#structured-concurrency-and-panic-containment
--@ companion: scope-token
-- Error [E0606]: the generated scope token cannot escape its lifetime
--@ file: source.ril
use ril/concurrent::scope

fn escaped() @Concurrent {
    let result = scope \mut s -> {
        let task = s.fork(\-> ())
        assert(task.join() is Ok())
        Ok(s)
    }
    assert(result is Ok(_))
}
--@ end-file
--@ end-case
