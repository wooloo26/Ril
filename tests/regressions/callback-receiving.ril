--@ source: typed-inputs
--@ file: source.ril
use ril/parallel

fn cardinality(rows: [0][3]int) -> int { len(rows) }
fn recover(value: Result<int, [0][3]int>) -> int { value ?? \rows -> cardinality(rows) }
fn borrow_result(value: Result<int, Result<int, str>>) -> int { value ?? \nested -> 0 }
pub fn test_inputs() {
    let matrix: [0][3]int = []
    let pick = \pair -> {
        let (left, right) = pair
        assert(cardinality(left) == 0 && cardinality(right) == 0)
        left
    }
    let selected: [0][3]int = pick((matrix, matrix))
    let field = \record -> {
        let .{ items } = record
        assert(cardinality(items) == 0)
        items
    }
    let projected: [0][3]int = field(.{ items: matrix })
    assert(len(selected) == 0 && len(projected) == 0)
    let failure: Result<int, [0][3]int> = Err(matrix)
    assert(recover(failure) == 0)
    let success: Result<int, [0][3]int> = Ok(9)
    assert(recover(success) == 9)
    let value = 1
    assert(Parallel::map([1, 2], \number -> number + value) == [2, 3])
    let result: Result<int, str> = Err("missing")
    assert((result ?? \text -> len(text)) == 7)
    let inner: Result<int, str> = Err("later")
    let outer: Result<int, Result<int, str>> = Err(inner)
    assert(borrow_result(outer) == 0)
    assert(inner is Err("later"))
}
--@ end-file
--@ end-source

