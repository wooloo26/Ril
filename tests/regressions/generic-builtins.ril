--@ case: raw-dispatch
--@ mode: run-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ entry: test_native
--@ file: source.ril
pub fn invoke_append(append: fn(mut []f64, f64) -> () &mut, mut values: []f64) &mut {
    append(mut values, 2.5)
}
pub fn test_native() {
    let append = Array::push
    let mut numbers: []int = []
    let mut words: []str = []
    let mut fractions: []f64 = []
    append(mut numbers, 7)
    append(mut words, "value")
    append(mut fractions, 1.25)
    invoke_append(append, mut fractions)
    assert(numbers[0] == 7 && words[0] == "value")
    assert(fractions[0] == 1.25)
    assert(fractions[1] == 2.5)
}
--@ end-file
--@ end-case

