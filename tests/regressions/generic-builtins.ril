--@ case: distinct-source-instances
--@ mode: run-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ entry: test_native
--@ file: source.ril
pub fn test_native() {
    let raw = Array::push
    let two: fn(mut [][0][2]int, [0][2]int) -> () &mut = raw
    let three: fn(mut [][0][3]int, [0][3]int) -> () &mut = raw
    let mut left: [][0][2]int = []
    let mut right: [][0][3]int = []
    two(mut left, [])
    three(mut right, [])
    assert(len(left) == 1 && len(right) == 1)
}
--@ end-file
--@ end-case

--@ case: named-numeric
--@ mode: run-pass
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ file: source.ril
type Holder = { mut values: []f64 }
fn append_block(mut values: []f64) &mut { Array::push(value: { 5 }, mut items: values) }
fn append_field(mut holder: Holder) &mut { Array::push(value: { 6 }, mut items: holder.values) }
pub fn test_native() {
    let mut values: []f64 = []
    Array::push(value: 1, mut items: values)
    Array::push(value: { 4 }, mut items: values)
    Array::insert(value: 1 + 2, index: 0, mut items: values)
    assert(values[0] == 3.0 && values[1] == 1.0 && values[2] == 4.0)
    append_block(mut values)
    assert(values[3] == 5.0)
    let mut holder = Holder.{values: []}
    append_field(mut holder)
    assert(holder.values[0] == 6.0)
    Array::truncate(length: 1, mut items: values)
    assert(len(values) == 1)
}
--@ end-file
--@ end-case

--@ case: named-retention
--@ mode: run-pass
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ file: source.ril
type Cell = { mut count: int }
pub fn test_native() {
    let append = Array::push
    let mut values: []Cell = []
    let mut cell = Cell.{count: 1}
    append(^mut value: cell, mut items: values)
    values[0].count += 1
    cell.count += 1
    assert(cell.count == 3)
}
--@ end-file
--@ end-case

