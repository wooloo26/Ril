--@ case: pipeline-order
--@ mode: run-pass
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ file: source.ril
type Put = fn(mut items: []f64, value: f64) -> () &mut
fn index(mut order: []int) -> int &mut { order !> Array::push(1); 0 }
fn choose(mut order: []int) -> Put &mut { order !> Array::push(2); Array::push }
fn value(mut order: []int) -> f64 &mut { order !> Array::push(3); 1.0 }
pub fn test_native() {
    let mut values: [][]f64 = [[]]
    let mut order: []int = []
    values[index(mut order)] !> choose(mut order)(value: value(mut order))
    assert(len(order) == 3 && order[0] == 1 && order[1] == 2 && order[2] == 3)
    assert(values[0][0] == 1.0)
}
--@ end-file
--@ end-case

--@ case: map-order
--@ mode: run-pass
--@ spec: SPEC#default-parameters-and-named-arguments
--@ entry: test_native
--@ file: source.ril
fn key(mut order: []int) -> str &mut { order !> Array::push(2); "x" }
fn value(mut order: []int) -> f64 &mut { order !> Array::push(1); 2.5 }
pub fn test_native() {
    let mut values: [str:f64] = [:]
    let mut order: []int = []
    Map::set(value: value(mut order), key: key(mut order), mut items: values)
    assert(len(order) == 2 && order[0] == 1 && order[1] == 2)
    assert(Map::get(values, "x") == Some(2.5))
}
--@ end-file
--@ end-case

