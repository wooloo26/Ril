--@ case: reject-unselected-user-success-type
--@ mode: check-fail
--@ spec: SPEC#generic-parameters-defaults-and-value-sorts
--@ companion: explicit-user-error-type
-- Error [E0344]: Ordinary generic functions retain inference obligations across panic.
--@ file: source.ril
fn take<T, E>(value: Result<T, E>) -> T {
    match value { Ok(item) -> item, Err(_) -> panic("failed") }
}
fn invalid() { let _ = take(Err("failed")) }
