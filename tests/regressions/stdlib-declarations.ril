-- [source: generic-control-results]
-- file: source.ril
fn conditional<T>(flag: bool, left: T, right: T) -> T {
    if flag { left } else { right }
}
fn selected<T>(flag: bool, left: T, right: T) -> T {
    match flag { true -> left, false -> right }
}
fn required<T>(value: ?T) -> T {
    match value { Some(item) -> item, None -> panic("missing") }
}
pub fn test_control_results() {
    assert(conditional(true, 3, 4) == 3)
    assert(selected(false, 3, 4) == 4)
    assert(required(Some(7)) == 7)
    let left: [0][3]int = []
    let right: [0][3]int = []
    let matrix: [0][3]int = conditional(false, left, right)
    assert(len(matrix) == 0)
}

