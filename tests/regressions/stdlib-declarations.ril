--@ case: eager-fallback-order
--@ mode: run-pass
--@ entry: test_eager_order
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: eager-fallback-panic
--@ file: source.ril
fn mark(mut log: []int, value: int) -> int &mut {
    log !> Array::push(value)
    value
}
fn present(mut log: []int) -> ?int &mut { Some(mark(mut log, 1)) }
pub fn test_eager_order() {
    let mut log: []int = []
    assert(Options::unwrap_or(present(mut log), mark(mut log, 2)) == 1)
    assert(log == [1, 2])
    let mut reversed: []int = []
    assert(Options::unwrap_or(fallback: mark(mut reversed, 2), value: present(mut reversed)) == 1)
    assert(reversed == [2, 1])
}
--@ end-file
--@ end-case

