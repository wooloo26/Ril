--@ case: aliases-and-reexports
--@ mode: run-pass
--@ entry: test_aliases
--@ spec: SPEC#module-imports-and-visibility
--@ companion: ordinary-fallbacks-native
--@ file: root.ril
use facade::{choose, require, check_some, check_ok}
use ril/option as Optional
use ril/option::*
use ril/prelude as P
pub fn test_aliases() {
    assert(choose(None, 9) == 9)
    assert(require(Some(7), "missing") == 7)
    assert(check_some(Some(8)) == 8)
    let result: Result<int, str> = Ok(6)
    assert(check_ok(result) == 6)
    assert(Optional::unwrap_or(Some(5), 0) == 5)
    assert(unwrap_or(None, 4) == 4)
    assert(P::Options::expect(Some(3), "missing") == 3)
}
--@ end-file
--@ file: facade.ril
pub use ril/option::{unwrap_or as choose, expect as require}
pub use ril/test::{assert_some as check_some, assert_ok as check_ok}
--@ end-file
--@ end-case

--@ case: first-class-and-named
--@ mode: run-pass
--@ entry: test_first_class
--@ spec: SPEC#default-parameters-and-named-arguments
--@ companion: ordinary-fallbacks-native
--@ file: source.ril
pub fn test_first_class() {
    let choose = Options::unwrap_or
    assert(choose(Some(3), 4) == 3)
    assert(choose(None, 5) == 5)
    assert(Options::unwrap_or(fallback: 8, value: None) == 8)
    let require = Options::expect
    assert(require(Some(6), "missing") == 6)
    assert(Options::expect<int>(Some(6), "missing") == 6)
    assert(Test::assert_some(message: "missing", value: Some(7)) == 7)
}
--@ end-file
--@ end-case

--@ case: composite-payloads
--@ mode: run-pass
--@ entry: test_composites
--@ spec: STD#optional-and-fallible-values
--@ companion: reject-stored-payload-dimension
--@ file: source.ril
fn increment(value: int) -> int { value + 1 }
pub fn test_composites() {
    let matrix: [0][3]int = []
    let selected = Options::unwrap_or(Some(matrix), matrix)
    let required: [0][3]int = Options::expect(Some(matrix), "missing")
    assert(len(selected) == 0 && len(required) == 0)
    let result: Result<[0][3]int, str> = Ok(matrix)
    let checked: [0][3]int = Test::assert_ok(result)
    assert(len(checked) == 0)
    let callback = Options::unwrap_or(Some(increment), increment)
    assert(callback(4) == 5)
    let nested: Result<int, str> = Ok(9)
    let restored = Options::expect(Some(nested), "missing")
    match restored { Ok(value) -> assert(value == 9), Err(_) -> assert(false) }
}
--@ end-file
--@ end-case

