-- [source: result-inference]
-- file: source.ril
pub fn test_result_inference() {
    let value: Result<int, str> = Ok(9)
    assert(Results::expect(value, "missing") == 9)
    assert(Test::assert_ok(value) == 9)
    assert(Results::expect<int, str>(Ok(7), "missing") == 7)
    assert(Test::assert_ok<int, str>(Ok(8)) == 8)
    let require = Results::expect
    assert(require(value, "missing") == 9)
    let check = Test::assert_ok
    assert(check(value) == 9)
    assert(Results::expect(message: "missing", value: value) == 9)
    assert(Test::assert_ok(message: "missing", value: value) == 9)
    let inner: Result<int, str> = Err("inner")
    let outer: Result<Result<int, str>, str> = Ok(inner)
    let restored = Test::assert_ok(outer)
    assert(restored is Err("inner"))
}

