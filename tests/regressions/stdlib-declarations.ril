--@ case: typed-testing-helpers
--@ mode: run-pass
--@ entry: test_library
--@ spec: STD#testing
--@ companion: reject-uninspected-nested-result-via-ok
--@ file: source.ril
use ril/test
pub fn test_library() {
    Test::assert_eq([1, 2], [1, 2], "equal")
    Test::assert_ne(b"a", b"b")
    assert(Test::assert_some(Some(7)) == 7)
    let value: Result<int, str> = Ok(9)
    assert(Test::assert_ok(value) == 9)
    let inner: Result<int, str> = Err("inner")
    let outer: Result<Result<int, str>, str> = Ok(inner)
    let nested = Test::assert_ok(outer)
    assert(nested is Err("inner"))
    assert(b"a" < b"b" && b"a" <= b"a" && b"b" >= b"a")
}
--@ end-file
--@ end-case

