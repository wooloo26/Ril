-- [source: ordinary-fallbacks]
-- file: source.ril
pub fn test_fallbacks() {
    assert(Options::unwrap_or(Some(7), 9) == 7)
    assert(Options::unwrap_or(None, 9) == 9)
    assert(Options::expect(Some(7), "missing") == 7)
    let result: Result<int, str> = Ok(7)
    assert(Results::expect(result, "missing") == 7)
    assert(Test::assert_some(Some(7)) == 7)
    let tested: Result<int, str> = Ok(7)
    assert(Test::assert_ok(tested) == 7)
}

