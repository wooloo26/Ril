-- [source: scalar-answers]
-- file: source.ril
eff Read { get() -> int }
fn incremented() -> int {
    with Read::get() -> (resume 4) + 1
    Read::get() * 2
}
fn negated() -> int {
    with Read::get() -> -(resume 4)
    Read::get() + 1
}
fn combined() -> int {
    with Read::get() -> ((resume 4) + 1) * 2
    Read::get() * 2
}
fn received() -> int {
    with Read::get() -> {
        let answer: int = (resume 4) + 2
        answer * 3
    }
    Read::get() + 1
}
fn truth() -> bool {
    with Read::get() -> (resume 4) && true
    Read::get() == 4
}
fn budgeted(limit: int) -> ?int {
    with Div::exhausted() -> None
    Some(Div::budget(limit, \-> {
        with Read::get() -> (resume 4) + 1
        Read::get()
    }))
}
pub fn test_scalar_answers() {
    assert(incremented() == 9)
    assert(negated() == -5)
    assert(combined() == 18)
    assert(received() == 21)
    assert(truth())
    assert(budgeted(2) == None && budgeted(3) == Some(5))
}

