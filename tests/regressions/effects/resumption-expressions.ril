-- [case: suffix-order, run-pass]
-- spec: SPEC#effect-handlers
-- companion: scalar-native
-- file: source.ril
type Guard = { mut on_close: fn() -> () }
eff Read { get() -> int }
pub fn test_suffix_order() {
    let mut events: []int = []
    let answer = {
        with Read::get() -> {
            let scoped mut guard = Guard.{ on_close: \-> events !> Array::push(5) }
            events !> Array::push(1)
            let answer = (resume 4) + after()
            events !> Array::push(4)
            answer
        }
        events !> Array::push(0)
        let number = Read::get()
        events !> Array::push(2)
        number
    }
    assert(answer == 5 && events == [0, 1, 2, 3, 4, 5])
where
    fn after() -> int &{closure, mut events} {
        events !> Array::push(3)
        1
    }
}

-- [source: derived-answer]
-- file: source.ril
type Matrix = { mut values: [0][3]int, mut count: int }
eff Read { get() -> int }
fn original() -> Immut<Matrix> @Read {
    let snapshot: Immut<Matrix> = clone(Matrix.{ values: [], count: Read::get() })
    snapshot
}
fn revise(mut draft: Matrix) &mut { draft.count += 1 }
pub fn test_derived_answer() {
    let revised = {
        with Read::get() -> (resume 7) |> derive revise
        original()
    }
    let values: [0][3]int = revised.values
    assert(revised.count == 8 && len(values) == 0)
}

