-- [case: reject-derived-dimension, check-fail]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: derived-native
-- Error [E0301]: The actual resumed and derived answer retains its inner extent.
-- file: source.ril
type Matrix = { mut values: [0][3]int }
eff Read { get() -> int }
fn invalid() {
    let revised = {
        with Read::get() -> (resume 7) |> derive \mut draft: Matrix -> { draft.values = [] }
        let _ = Read::get()
        let snapshot: Immut<Matrix> = clone(Matrix.{ values: [] })
        snapshot
    }
    let values: [0][2]int = revised.values
}

-- [case: reject-readonly-answer, check-fail]
-- spec: SPEC#declarations-and-bindings
-- spec: SPEC#effect-handlers
-- companion: derived-native
-- Error [E0520]: Receiving the actual answer in a let binding cannot grant writes.
-- file: source.ril
type Cell = { mut value: int }
eff Read { get() -> int }
fn invalid() {
    let result = {
        with Read::get() -> {
            let answer = resume 7
            answer.value += 1
            answer
        }
        Cell.{ value: Read::get() }
    }
}

-- [case: reject-ended-operation-loan, check-fail]
-- spec: SPEC#effect-handlers
-- companion: suffix-order
-- Error [E0540]: An expression after resume cannot use its ended operation loan.
-- file: source.ril
type Cell = { mut value: int }
eff Edit { apply(mut Cell) -> () &mut }
fn invalid(mut cell: Cell) -> int &mut {
    with Edit::apply(mut target) -> {
        target.value += 1
        (resume ()) + target.value
    }
    Edit::apply(mut cell)
    cell.value
}

-- [case: reject-terminated-answer, check-fail]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
-- spec: SPEC#effect-handlers
-- companion: scalar-native
-- Error [E0625]: A terminated resumption is followed by a real unit answer.
-- file: source.ril
eff Read { get() -> int }
fn invalid() -> int {
    with Read::get() -> { resume 7; }
    Read::get()
}

-- [case: reject-affine-resumption, check-fail]
-- spec: SPEC#affine-resumption-and-delimited-early-abort
-- companion: scalar-native
-- Error [E0610]: Receiving the first answer does not create a second resumption.
-- file: source.ril
eff Read { get() -> int }
fn invalid() -> int {
    with Read::get() -> {
        let answer = (resume 7) + 1
        let second = resume 8
        answer + second
    }
    Read::get()
}
