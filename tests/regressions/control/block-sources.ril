-- [case: empty-block-contexts, run-pass]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
-- entry: test_native
-- file: source.ril
fn classify(value: ?int) {
    if value is Some(1) {} else if value is Some(2) {} else {}
}

pub fn test_native() {
    classify(None)
    classify(Some(1))
    classify(Some(2))
    let unit: () = {}
    assert(unit == ())
    let empty = \-> {}
    empty()
}

