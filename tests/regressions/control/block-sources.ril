-- [case: reject-abort-hidden-dimension, check-fail]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: owned-boundary-arrays-pointer32
-- Error [E0301]: An abort answer retains its hidden inner array dimension.
-- file: source.ril
eff Interrupt { choose() -> int }
fn invalid() -> [0][2]int {
    let early: [0][3]int = []
    with Interrupt::choose() -> early
    let _ = Interrupt::choose()
    let normal: [0][2]int = []
    normal
}

-- [case: reject-resume-answer-hidden-dimension, check-fail]
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: owned-boundary-arrays-pointer64
-- Error [E0301]: A resumption binder receives the actual protected array type.
-- file: source.ril
eff Interrupt { choose() -> int }
fn invalid() -> [0][2]int {
    with Interrupt::choose() -> { let continued: [0][3]int = resume 7; continued }
    let _ = Interrupt::choose()
    let normal: [0][2]int = []
    normal
}
