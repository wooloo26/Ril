-- [source: owned-boundary-arrays]
-- file: source.ril
eff Interrupt { choose() -> int }
fn aborted() -> [0][2]int {
    let early: [0][2]int = []
    with Interrupt::choose() -> early
    let _ = Interrupt::choose()
    let normal: [0][2]int = []
    normal
}
fn resumed() -> [0][2]int {
    with Interrupt::choose() -> { let continued = resume 7; continued }
    let _ = Interrupt::choose()
    let normal: [0][2]int = []
    normal
}
pub fn test_native() {
    assert(len(aborted()) == 0 && len(resumed()) == 0)
}

