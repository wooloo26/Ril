-- [source: contextual-default-values]
-- file: source.ril
fn bytes(value: [0][2]u8 = []) -> [0][2]u8 { value }
fn optional(value: ?u8 = Some(255)) -> ?u8 { value }
fn identity(value: u8) -> u8 { value }
fn callback(action: fn(u8) -> u8 = identity) -> u8 { action(255u8) }
pub fn test_defaults() {
    assert(len(bytes()) == 0)
    assert(optional() == Some(255u8))
    assert(callback() == 255u8)
}

