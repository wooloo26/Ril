-- [case: abrupt-source-block, check-pass]
-- spec: SPEC#named-function-declarations-and-contrast-matrix
-- spec: SPEC#effect-handlers
-- file: source.ril
eff Mark<T> { touch() }
fn selected<T>(witness: T, stop: bool, value: int = if stop { panic("default") } else { 7 }) -> int @Mark<T> {
    Mark<T>::touch()
    value
}
fn call(stop: bool) -> int @Mark<int> { selected(0, stop) }
fn main() {
    with Mark<int>::touch() -> resume()
    assert(call(false) == 7)
    call(true)
}

-- [source: source-entry-budget-order]
