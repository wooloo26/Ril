-- [source: source-nested-and-budget]
-- file: source.ril
eff Read<T>{get()->T}
type Reader<T>=fn()->T &closure
fn make<T>(value:T)->Reader<T> &capture{
    with Read<T>::get()->resume value
    with Read<T>::get()->resume (Read<T>::get())
    \->Read<T>::get()
}
pub fn test_native(){
    let seven=make(7)
    let nine=make(9)
    let word=make("seven")
    assert(seven()==7 && nine()==9 && word()=="seven")
    let exhausted={with Div::exhausted()->None;Some(Div::budget(0,seven))}
    let first={with Div::exhausted()->None;Some(Div::budget(100,seven))}
    let second={with Div::exhausted()->None;Some(Div::budget(100,nine))}
    assert(exhausted==None && first==Some(7) && second==Some(9))
    assert(seven()==7 && word()=="seven")
}

