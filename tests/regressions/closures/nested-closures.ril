-- [source: nested-retained-handlers]
-- file: source.ril
eff Read<T> { get() -> T }
type Reader<T> = fn() -> T &closure
type Factory<T> = fn() -> Reader<T> &capture &closure
fn make<T>(value: T) -> Factory<T> &capture {
    with Read<T>::get() -> resume value
    \-> { \-> (\-> Read<T>::get())() }
}
pub fn test_native() {
    let first = make(7)
    let second = make(9)
    let text = make("saved")
    let seven = first()
    let nine = second()
    let word = text()
    with { Read<int>::get() -> resume 100, Read<str>::get() -> resume "ambient" }
    assert(seven() == 7 && nine() == 9 && word() == "saved")
    assert(first()() == 7 && second()() == 9 && seven() == 7)
}

