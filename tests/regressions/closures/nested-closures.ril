-- [source: nested-default-environments]
-- file: source.ril
type Reader = fn() -> int &closure
pub fn test_native() {
    let choose = \seed: int, offset: int, reader: Reader = {
        let saved = seed + offset
        \-> (\-> saved)()
    } -> reader
    let first = choose(40, 1)
    let second = choose(40, 2)
    let explicit = choose(100, 99, \-> 7)
    let wrapped = \-> (first, second)
    let readers = wrapped()
    assert(readers.0() == 41 && readers.1() == 42 && explicit() == 7)
    assert(second() == 42 && first() == 41)
}

