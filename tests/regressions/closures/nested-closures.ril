type Reader = fn() -> [0][2]int &closure
fn make() -> Reader &capture {
    let wrong: [0][3]int = []
    \-> (\-> wrong)()
}

-- [case: reject-nested-environment-through-closed-row, check-fail]
-- spec: SPEC#empty-rows-on-higher-order-signatures
-- companion: nested-default-environments-pointer64
-- Error [E0534]: A nested factory preserves its reader's captured environment.
-- file: source.ril
fn pure(action: fn() -> int) -> int &{} { action() }
fn example() {
    let saved = 7
    let factory = \-> { \-> saved }
    let value = pure(factory())
}

-- [source: generic-interface-shadow]
-- file: source.ril
fn make<T>(seed: T) -> fn(T) -> T { \value: T -> value }
fn consume<T>(outer: T) -> int {
    let action = make(1)
    action(2)
}
pub fn test_native() {
    assert(consume("outer") == 2 && consume(true) == 2)
    let numbers = make(3)
    let words = make("first")
    assert(numbers(4) == 4 && words("second") == "second")
}

