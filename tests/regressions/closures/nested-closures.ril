-- [source: shared-and-independent-cells]
-- file: source.ril
type Step = fn(int) -> int &closure
fn make(seed: int) -> (Step, Step) &capture &^mut {
    var total = seed
    let mut add = \amount: int -> { total += amount; total }
    let mut subtract = \amount: int -> { total -= amount; total }
    (^mut add, ^mut subtract)
}
pub fn test_native() {
    let mut shared = make(10)
    let mut independent = make(100)
    assert(shared.0(3) == 13 && shared.1(2) == 11)
    assert(independent.1(4) == 96 && shared.0(1) == 12)
    assert(independent.0(5) == 101 && shared.1(2) == 10)
}

