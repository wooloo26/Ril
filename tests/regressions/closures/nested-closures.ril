-- [source: nested-where-capture-layers]
-- file: source.ril
fn make(base: int) -> Reader &capture
where
    type Reader = fn() -> int &closure
{
    build()
where
    fn build() -> Reader &capture &{closure, base} {
        let offset = 2
        \-> sum()
    where
        fn sum() -> int &{closure, offset} &{closure make, base} {
            base + offset
        }
    }
}
pub fn test_native() {
    let first = make(5)
    let second = make(9)
    assert(first() == 7 && second() == 11 && first() == 7)
}

