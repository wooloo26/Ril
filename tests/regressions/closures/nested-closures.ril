-- spec: SPEC#state-groups-and-captured-layers
-- companion: nested-where-capture-layers-pointer32
-- Error [E0538]: A farther capture cannot be attributed to the intermediate function.
-- file: source.ril
fn make(base: int) -> Reader &capture
where
    type Reader = fn() -> int &closure
{
    build()
where
    fn build() -> Reader &capture &{closure, base} {
        let offset = 2
        \-> sum()
    where
        fn sum() -> int &{closure, offset} &{closure build, base} {
            base + offset
        }
    }
}

-- [case: reject-missing-outer-capture, check-fail]
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- companion: generic-three-stage-pointer32
-- Error [E0510]: Returning an environment through another factory still requires capture.
-- file: source.ril
type Reader = fn() -> int &closure
type Factory = fn() -> Reader &capture &closure
fn make(value: int) -> Factory { \-> { \-> value } }

-- [case: reject-readonly-nested-writer, check-fail]
-- spec: SPEC#closure-capabilities-and-handle-permissions
-- companion: shared-and-independent-cells-pointer32
-- Error [E0520]: Wrapping a writer in another closure cannot upgrade a readonly view.
-- file: source.ril
fn example() {
    var total = 0
    let mut writer = \-> { total += 1; total }
    let view observed = writer
    let mut nested = \-> (\-> observed())()
    let value = nested()
}

