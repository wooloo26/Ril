-- [source: generic-three-stage]
-- file: source.ril
type Leaf<T> = fn(T) -> (T, T, T) &closure
type Stage<T> = fn(T) -> Leaf<T> &capture &closure
fn make<T>(first: T) -> Stage<T> &capture {
    \second: T -> {
        \third: T -> {
            (\-> (first, second, third))()
        }
    }
}
pub fn test_native() {
    let first = make(1)
    let other = make(9)
    let left = first(2)
    let right = first(3)
    let independent = other(8)
    assert(left(4) == (1, 2, 4) && right(5) == (1, 3, 5))
    assert(independent(7) == (9, 8, 7) && left(6) == (1, 2, 6))
    let words = make("outer")("middle")
    assert(words("inner") == ("outer", "middle", "inner"))
}

