-- [case: two-written, run-pass]
-- spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
-- entry: test_native
-- file: source.ril
pub fn test_native() {
    let first = \-> 1
    let second = \-> 2
    assert(first() == 1 && second() == 2)
}

-- [case: repeated-default, run-pass]
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- entry: test_native
-- file: source.ril
type Action = fn() -> int
fn choose(action: Action = \-> 7) -> Action { action }
pub fn test_native() {
    let first = choose()
    let second = choose()
    assert(first() == 7 && second() == 7)
}

-- [case: factory-with-handlers, run-pass]
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- spec: SPEC#effect-handlers
-- entry: test_native
-- file: source.ril
eff Read { get() -> int }
type Reader = fn() -> int &closure
fn make(value: int) -> Reader &capture {
    with Read::get() -> resume value
    with Read::get() -> resume (Read::get())
    \-> Read::get()
}
pub fn test_native() {
    let seven = make(7)
    let nine = make(9)
    assert(seven() == 7 && nine() == 9)
}

-- [case: named-default-block, run-pass]
-- spec: SPEC#named-function-declarations-and-contrast-matrix
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- entry: test_native
-- file: source.ril
type Action = fn() -> int &closure
fn choose(action: Action = {
    \-> saved()
where
    fn saved() -> int { 7 }
}) -> Action { action }
pub fn test_native() {
    let first = choose()
    let second = choose()
    let explicit = choose(\-> 13)
    assert(first() == 7 && second() == 7 && explicit() == 13)
}

-- [case: default-capture, run-pass]
-- spec: SPEC#named-function-declarations-and-contrast-matrix
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- entry: test_native
-- file: source.ril
type Action = fn() -> int &closure
fn choose(value: int, action: Action = \-> value) -> Action { action }
pub fn test_native() {
    let seven = choose(7)
    let nine = choose(9)
    let explicit = choose(11, \-> 13)
    assert(seven() == 7 && nine() == 9 && explicit() == 13)
}

-- [case: default-capture-through-call, run-pass]
-- spec: SPEC#named-function-declarations-and-contrast-matrix
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- entry: test_native
-- file: source.ril
type Action = fn() -> int &closure
fn choose(value: int, action: Action = \-> (\number: int -> number)(value)) -> Action { action }
pub fn test_native() {
    let seven = choose(7)
    let nine = choose(9)
    let explicit = choose(11, \-> 13)
    assert(seven() == 7 && nine() == 9 && explicit() == 13)
}

-- [case: contextual-signature-preview, run-pass]
-- spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
-- entry: test_native
-- file: source.ril
pub fn test_native() {
    let increment: fn(int) -> int = \value -> value + 1
    assert(increment(41) == 42)
}

-- [case: contextual-signature-result-mismatch, check-fail]
-- spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
-- Error [E0301]: reject an uncalled contextual lambda with the wrong result
-- file: source.ril
fn example() {
    let callback: fn(int) -> int = \value -> true
}

-- [case: contextual-signature-closure-argument-mismatch, check-fail]
-- spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
-- Error [E0301]: a closure's written callback parameter checks its lambda result
-- file: source.ril
fn example() {
    let apply = \callback: fn(int) -> int -> callback(1)
    apply(\value -> true)
}
