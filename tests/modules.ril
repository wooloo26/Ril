-- @suite modules
-- @default_stage hir

-- @case imports_and_reexports compile-pass unit=bin
-- @file pkg/main.ril
use pkg/math/circle
use pkg/utility::answer
fn main() -> () {
    assert(Circle::is_round())
    assert(answer() == 42)
}
-- @file pkg/math/circle.ril
pub fn is_round() -> bool { true }
-- @file pkg/utility.ril
pub use pkg/values::answer
-- @file pkg/values.ril
pub fn answer() -> int { 42 }

-- @case sub_parent_qualified compile-pass unit=lib
pkg let outer = 1
pub sub UnitCircle {
    pub fn limit() -> int { Super::outer }
}

-- @case sub_isolated compile-fail E0204 unit=lib
pub let outer = 1
pub sub UnitCircle {
    pub fn limit() -> int { outer }
    -- ^ E0204
}

-- @case file_root_has_no_super compile-fail E0208 unit=lib
use Super::something
-- ^ E0208

-- @case package_private compile-fail E0201 unit=bin
-- @file pkg/main.ril
use dep/info
fn main() -> () {}
-- @file dep/info.ril
pkg let value = 1

-- @case package_item_visible_to_other_module_in_package compile-pass unit=lib
-- @file pkg/main.ril
use pkg/info::answer
fn read() -> int { answer }
-- @file pkg/info.ril
pkg let answer = 42

-- @case public_signature_cannot_expose_package_item compile-fail E0910 unit=lib
pkg type Secret = int
pub fn leak() -> Secret { 1 }
-- ^ E0910

-- @case private_selection compile-fail E0201 unit=bin
-- @file pkg/main.ril
use pkg/math::number
-- ^ E0201
fn main() -> () {}
-- @file pkg/math.ril
let number = 1

-- @case unavailable_module compile-fail E0208 unit=bin
use pkg/missing
-- ^ E0208
fn main() -> () {}

-- @case unavailable_member compile-fail E0209 unit=bin
-- @file pkg/main.ril
use pkg/math::missing
-- ^ E0209
fn main() -> () {}
-- @file pkg/math.ril
pub fn exists() -> bool { true }

-- @case bad_derived_name compile-fail E0102 unit=bin
-- @file pkg/main.ril
use pkg/a_b
-- ^ E0102
fn main() -> () {}
-- @file pkg/a_b.ril
pub fn exists() -> bool { true }

-- @case visibility_leak compile-fail E0910 unit=lib
type Hidden = .{ value: int }
pub fn leak() -> new Hidden { Hidden.{ value: 1 } }
-- ^ E0910

-- @case opaque_hides_representation compile-pass unit=lib
type Hidden = .{ value: int }
pub opaque type Wrapper(Hidden)

-- @case helper_capture_before_initialization compile-fail E0207 unit=lib
fn count() -> int {
    let early = outer()
    -- ^ E0207
    let base = 1
    early
where
    fn outer() -> int { inner_helper() }
    fn inner_helper() &up(base) -> int { base }
}

-- @case downward_from_signature_where compile-fail E0705 unit=lib
fn f() -> Top where
    type Top = Lower
    -- ^ E0705
{
    ()
where
    type Lower = ()
}

-- @case signature_cannot_see_block_where compile-fail E0706 unit=lib
fn f() -> Lower {
-- ^ E0706
    ()
where
    type Lower = ()
}

-- @case fallback_transfer_rejected_in_hir compile-fail E0710
fn test(x: ?int) -> int { x ?? return 0 }
-- ^ E0710

-- @case missing_main compile-fail E0903 unit=bin
fn helper() -> int { 1 }

-- @case invalid_main compile-fail E0904 unit=bin
fn main() -> int { 1 }
-- ^ E0904

-- @case executable_root_is_private compile-fail E0905 unit=bin
pub fn main() -> () {}
-- ^ E0905

-- @case no_top_level_var compile-fail E0906 unit=lib
var value = 1
-- ^ E0906

-- @case bodyless_normal_fn compile-fail E0902 unit=lib
fn bodyless() -> ()
-- ^ E0902

-- @case bodyless_array_contract_validates_exact_signature compile-fail E0909 unit=lib
-- @file pkg/main.ril
use ril/array
-- @file ril/array.ril
pub fn pop_front<T>(xs: []T) -> ?T
-- ^ E0909

-- @case builtin_body_requires_the_registered_module_identity compile-fail E0902 unit=lib
-- @file pkg/main.ril
use pkg/array
-- @file pkg/array.ril
pub fn pop_front<T>(mut xs: [via]T) -> new ?T
-- ^ E0902

-- @case registered_prelude_unwind_ctl_signature_must_match compile-fail E0909 unit=lib
-- @file pkg/main.ril
use ril/prelude
-- @file ril/prelude.ril
pub fn unwind_ctl(x: int) -> ()
-- ^ E0909

-- @case registered_prelude_primitive_can_be_bodyless compile-pass unit=lib
-- @file pkg/main.ril
use ril/prelude
-- @file ril/prelude.ril
pub fn panic(message: str) -> never

-- @case registered_prelude_primitive_signature_must_match compile-fail E0909 unit=lib
-- @file pkg/main.ril
use ril/prelude
-- @file ril/prelude.ril
pub fn panic(message: int) -> never
-- ^ E0909

-- @case module_cannot_import_itself compile-fail E0208 unit=lib
-- @file pkg/foo.ril
use pkg/foo
-- ^ E0208
pub fn value() -> int { 1 }

-- @case sub_cannot_import_itself compile-fail E0208 unit=lib
-- @file pkg/foo.ril
pub sub Inner {
    use Super::Inner
    -- ^ E0208
    pub fn value() -> int { 1 }
}

-- @case sub_cannot_import_enclosing_file_by_path compile-fail E0208 unit=lib
-- @file pkg/foo.ril
pub fn outer() -> int { 1 }
pub sub Inner {
    use pkg/foo
    -- ^ E0208
    pub fn value() -> int { 2 }
}

-- @case local_block_cannot_import_enclosing_module compile-fail E0208 unit=lib
-- @file pkg/foo.ril
pub fn helper() -> int { 1 }
pub fn work() -> int {
    use pkg/foo
    -- ^ E0208
    helper()
}

-- @case same_package_mutual_module_imports_allowed compile-pass unit=lib
-- @file pkg/main.ril
use pkg/even
pub fn check(n: int) -> bool { Even::is_even(n) }
-- @file pkg/even.ril
use pkg/odd
pub fn is_even(n: int) -> bool {
    if n == 0 { true } else { Odd::is_odd(n - 1) }
}
-- @file pkg/odd.ril
use pkg/even
pub fn is_odd(n: int) -> bool {
    if n == 0 { false } else { Even::is_even(n - 1) }
}

-- @case cyclic_package_dependency_rejected compile-fail E0208 unit=lib
-- @file pkg/main.ril
use dep/mid
pub fn root() -> int { Mid::step() }
-- @file dep/mid.ril
use pkg/leaf
-- ^ E0208
pub fn step() -> int { Leaf::value() }
-- @file pkg/leaf.ril
pub fn value() -> int { 42 }

-- @case stdlib_module_cannot_self_reference_via_prelude compile-fail E0204 unit=lib
-- @file pkg/main.ril
use ril/array
-- @file ril/array.ril
pub fn push<T>(mut xs: [via]T, via item: T) -> ()
pub fn bad() -> new []int {
    let mut out: []int = []
    Array::push(mut out, 1)
    -- ^ E0204
    out
}
