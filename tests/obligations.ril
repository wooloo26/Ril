-- @case exact_slice_length_conservation compile-pass
fn takes_len(xs: []int, n: int, s: []int |> Len<n>) -> int {
    len(xs) + len(s)
}

fn takes_diff_len(a: int, b: int, s: []int |> Len<b - a>) -> int {
    a + b + len(s)
}

fn takes_same(a: []int, b: []int |> SameLen<a>) -> int {
    len(a) + len(b)
}

fn slice_conservation(xs: []int, ys: []int |> SameLen<xs>, a: int, b: int) -> int {
    var total = 0
    if 0 <= a && a <= b && b <= len(xs) {
        let s1 = xs[a..b]
        let s2 = ys[a..b]
        total += takes_diff_len(a, b, s1)
        total += takes_same(s1, s2)
        let left = xs[..a]
        let right = xs[a..]
        let _ = takes_len(xs, a, left)
        if len(left) + len(right) == len(xs) {
            total += len(left) + len(right)
        }
    }
    if let Some(win) = xs?[a..b] {
        total += takes_diff_len(a, b, win)
    }
    total
}

-- @case immutable_type_invariants_full_workflow compile-pass
type ValidSpan = \s: .{ lo: int, hi: int } -> if s.lo <= s.hi { <()> } else { <never> }
type Ordered = \p: (int, int) -> if p.0 <= p.1 { <()> } else { <never> }

type Port(int) |> Between<1, 65535>
type Span(.{ lo: int, hi: int }) |> ValidSpan
type Pair(int, int) |> Ordered
type NonEmptyList<T>([]T) |> NonEmpty
opaque type NonZeroId(int) |> NonZero

fn make_nz(x: int) -> new ?NonZeroId {
    if x != 0 { Some(NonZeroId::(x)) } else { None }
}

fn use_invariants(p: Port, sp: Span, pr: Pair, xs: NonEmptyList<int>, nz: NonZeroId) -> int {
    let a = 1000 / inner(p)
    let b = 100 / inner(nz)
    let c = inner(xs)[0]
    let d = if sp.lo <= sp.hi { sp.hi - sp.lo }
    let e = if pr.0 <= pr.1 { pr.1 - pr.0 }
    let p_const = Port::(8080)
    let sp_const = Span::(.{ lo: 1, hi: 5 })
    let pr_const = Pair::(2, 9)
    a + b + c + d + e + inner(p_const) + sp_const.lo + pr_const.0
}

type Holder(.{ span: Span })
fn replace_whole_span_in_derive(h: Holder) -> Holder {
    derive(h, \mut d -> {
        let _ = d.span.lo
        d.span = Span::(.{ lo: 10, hi: 20 })
    })
}

