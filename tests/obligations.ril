-- @case defer_resource_can_be_observed_and_mutated_by_helpers compile-pass
opaque type Handle(.{ var id: int })
fn close(mut handle: Handle) -> () { handle.id = 0 }
fn observe(ref handle: Handle) -> int { handle.id }
fn update(mut handle: Handle) -> () { handle.id += 1 }
fn work() -> int {
    let mut handle = Handle::(.{ id: 41 })
    defer close(mut handle)
    update(mut handle)
    observe(ref handle)
}

-- @case defer_mutation_satisfies_mut_use compile-pass
opaque type Handle(.{ var id: int })
fn close(mut handle: Handle) -> () { handle.id = 0 }
fn work() -> () {
    let mut handle = Handle::(.{ id: 42 })
    defer close(mut handle)
}

