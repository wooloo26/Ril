-- @case proved_bounds_and_witnesses_compile_pass compile-pass
fn safe_work(xs: []int, d |> NonZero, k |> Nat) -> int {
    var total = 0
    for 0..len(xs) as i {
        total += xs[i]
    }
    let q = total / d
    let r = if len(xs) > 0 { total / len(xs) } else { 0 }
    (q + r) >> k
}

