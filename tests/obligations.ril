-- @case derive_applies_a_store_to_an_outer_mutable_field compile-fail E0535 no-prelude
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Out { Frozen(Shelf); Count(int) }
type Slot = .{ var action: fn(new Shelf) -> new Out }
fn count(new shelf: Shelf) -> new Out { Out::Count(shelf.item.count) }
fn freeze(new shelf: Shelf) -> new Out { Out::Frozen(shelf) }
fn run() -> int {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let mut slot = Slot.{ action: count }
    let next = derive([1]) \mut draft -> {
        Array::push(mut draft, 2)
        slot.action = freeze
    }
    let _ = slot.action(Shelf.{ item: ^mut live })
    -- ^ E0535
    len(next)
}

-- @case branching_between_draft_appends_and_literals_preserves_callable_alternatives compile-fail E0535 no-prelude
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Out { Frozen(Shelf); Count(int) }
fn freeze(new shelf: Shelf) -> new Out { Out::Frozen(shelf) }
fn count(new shelf: Shelf) -> new Out { Out::Count(shelf.item.count) }
fn run(flag: bool) -> int {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let base = [count]
    let next = if flag { derive(base) \mut draft -> { Array::push(mut draft, freeze) } }
        else { [count, count] }
    if len(next) > 1 {
        let _ = next[1](Shelf.{ item: ^mut live })
        -- ^ E0535
    }
    live.count += 8
    live.count
}

-- @case effect_handler_append_updates_its_captured_array compile-fail E0535 no-prelude
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Out { Frozen(Shelf); Count(int) }
eff Append { fn push() -> () }
fn freeze(new shelf: Shelf) -> new Out { Out::Frozen(shelf) }
fn count(new shelf: Shelf) -> new Out { Out::Count(shelf.item.count) }
fn run() -> int {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let mut actions = [count]
    with Append::push = \-> Array::push(mut actions, freeze)
    Append::push()
    if len(ref actions) > 1 {
        let _ = actions[1](Shelf.{ item: ^mut live })
        -- ^ E0535
    }
    live.count += 8
    live.count
}

-- @case defer_forbids_direct_panic compile-fail E0627
fn bad() -> () {
    defer panic("cannot panic in defer")
    -- ^ E0627
    ()
}

-- @case defer_forbids_transitive_panic compile-fail E0627
fn may_fail(x: int) -> () {
    if x < 0 { panic("negative") }
}
fn bad(x: int) -> () {
    defer may_fail(x)
    -- ^ E0627
    ()
}

-- @case unproved_divisor_rejected_e0361 compile-fail E0361
