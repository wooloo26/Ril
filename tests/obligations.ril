    var i = 0
    while i < len(ref xs) {
        apply(cb)
        let _ = xs[i]
        --      ^ E0362
        i += 1
    }
}

-- @case direct_effect_row_var_rejects_ctl_callback_is_e0616 compile-fail E0616
eff Yield { ctl step() -> () }
fn run_row<@E: fn>(cb: fn() @E -> ()) @E -> () {
    defer cb()
}
fn bad() @Yield -> () {
    run_row(\-> Yield::step())
    -- ^ E0616
}

-- @case unconstrained_effect_row_var_rejected_in_defer_is_e0616 compile-fail E0616
fn bad<@E>(cb: fn() @E -> ()) @E -> () {
    defer cb()
    --    ^ E0616
}

-- @case unused_effect_row_var_is_e0626 compile-fail E0626
fn bad<@E>(_cb: fn() @E -> ()) @E -> () {}
-- ^ E0626
