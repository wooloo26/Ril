where
    fn positive(n: int) -> new !<(), str> {
        if n > 0 { Ok() } else { Err("months must be positive") }
    }
{
    var sum = 0
    for xs as x { sum += x }
    Ok(sum / months)
}

-- @case static_proof_lower_bound_and_insert_sorted compile-pass
fn lower_bound(xs: []int, target: int) -> int |> Between<0, len(xs)> {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn insert_sorted(mut xs: []int, value: int) -> () {
    let idx = lower_bound(clone(ref xs), value)
    Array::insert(mut xs, idx, value)
}

-- @case static_proof_fallible_return_and_binary_search compile-pass
fn binary_search(xs: []int, target: int) -> new ?int |> InBounds<xs> {
    var lo = 0
    var hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] == target {
            return Some(mid)
        } else if xs[mid] < target {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    None
}

fn use_bs(xs: []int, target: int) -> int {
    if let Some(idx) = binary_search(xs, target) {
        xs[idx]
    } else {
        0
    }
}

