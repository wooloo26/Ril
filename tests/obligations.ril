fn work() -> () {
    with {
        ctl Yield::step = \k -> {
            defer unwind_ctl(k)
            -- ^ E0549
            unwind_ctl(k)
        }
        Yield::step()
    }
}

-- @case defer_lifo_order_rejects_use_after_linear_unwind compile-fail E0549
eff Yield { ctl step() -> () }
fn work() -> () {
    with {
        ctl Yield::step = \k -> {
            defer k()
            -- ^ E0549
            defer unwind_ctl(k)
        }
        Yield::step()
    }
}

