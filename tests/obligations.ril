-- @case reflects_implies_and_ensures_compile_pass compile-pass
fn is_valid_slice(lo: int, hi: int, xs: []int) -> bool
    |> Reflects<Between<lo, 0, hi> && AtMost<hi, len(xs)>>
{
    lo >= 0 && lo <= hi && hi <= len(xs)
}

fn is_pos_strict(x: int) -> bool |> Implies<Positive<x>> {
    x > 10
}

fn ensure_key(mut m: [str: int], k: str) -> () |> Ensures<In<k, m>> {
    if !Map::contains(ref m, k) {
        m[k] = 0
    }
}

fn use_combinators(xs: []int, a: int, b: int, x: int, mut m: [str: int], k: str) -> int {
    let part: []int = if is_valid_slice(a, b, xs) { xs[a..b] } else { [] }
    let q = if is_pos_strict(x) { 100 / x } else { 0 }
    ensure_key(mut m, k)
    m[k] += 1
    len(part) + q + m[k]
}

