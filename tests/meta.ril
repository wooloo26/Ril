-- @suite meta
-- @default_stage type

-- @case static_clone_requires_a_proven_root_in_an_unconstrained_generic compile-fail E0301
meta fn duplicate<T>(value: T) -> T {
    clone(value)
    -- ^ E0301
}

-- @case anonymous_meta_callable_cannot_decay_to_runtime_value compile-fail E0810
fn invalid() -> () {
    let callback = \meta value: int -> value + 1
    -- ^ E0810
}

-- @case static_slice_patterns_match_and_bind_the_middle compile-pass
meta fn slices() -> bool {
    let values = [0, 3, 7, 9]
    let [0, ..middle, 9] = values else { return false }
    let str["é", ..body, "終"] = "éλ終" else { return false }
    middle == [3, 7] && body == "λ"
}
meta let SLICES = assert(slices())

-- @case dual_phase_text_literals_and_labeled_join compile-pass
meta fn assemble(parts: []str) -> str { String::join(separator: "/", parts: parts) }
meta let JOIN_CHECK = assert(assemble(["a", "β"]) == "a/β")
meta let BYTE_CHECK = assert(String::inspect(bytes"A\xFF") == #"bytes"A\xff""#)
meta let TEXT_CHECK = assert(String::inspect("{{a}}\u{1}") == #""{{a}}\u{1}""#)

-- @case static_arbitrary_precision compile-pass
meta let BIG = 1 << 150
meta let _ = assert(BIG > 100000000000000000000000000000000)
meta let _ = assert(-7 / 3 == -2 && -7 % 3 == -1)
meta let _ = assert(~0 == -1 && (-8 >> 2) == -2)

-- @case static_named_call_and_defaults compile-pass
meta fn align(n: int, size: int = 16) -> int {
    assert(n >= 0)
    ((n + size - 1) / size) * size
}
meta let COUNT = align(22)
meta let _ = assert(COUNT == 32)
fn get() -> int { meta align(size: 8, n: 17) }
meta let _ = assert(<typeof get()> == <int>)

-- @case recursive_meta compile-pass budget=100
meta fn factorial(n: int) -> int {
    if n == 0 { 1 } else { n * factorial(n - 1) }
}
meta let _ = assert(factorial(6) == 720)

-- @case loop_budget compile-fail E0811 budget=8
meta fn spin() -> never { while true {} }
-- ^ E0811
meta let _ = spin()

-- @case recursive_budget compile-fail E0811 budget=8
meta fn spin(n: int) -> int { spin(n + 1) }
-- ^ E0811
meta let _ = spin(0)

-- @case failing_assert compile-fail E0830
meta let _ = assert(false)
-- ^ E0830

-- @case dynamic_negative_shift compile-fail E0831
meta fn bad(n: int) -> int { 1 << n }
-- ^ E0831
meta let _ = bad(-2)

-- @case phase_violation compile-fail E0810
fn runtime() -> int { 1 }
meta let BAD = runtime()
-- ^ E0810

-- @case meta_argument_must_be_static compile-fail E0814
meta fn twice(n: int) -> int { n * 2 }
fn bad(n: int) -> int { meta twice(n) }
-- ^ E0814

-- @case runtime_bare_meta_fn_call_requires_meta compile-fail E0810
meta fn twice(n: int) -> int { n * 2 }
fn bad() -> int { twice(3) }
-- ^ E0810

-- @case nested_meta_expr_inside_meta_fn_rejected compile-fail E0810
meta fn bad() -> int { meta (1 + 2) }
-- ^ E0810

-- @case typeof_is_unevaluated compile-pass
meta fn doomed() -> int { panic("never evaluated") }
type Output = typeof doomed()
meta let _ = assert(<Output> == <int>)

-- @case typeof_shadow_checks_discarded_result compile-fail E0720
fn receive() -> new !<int, str> { Ok(3) }
type Invalid = typeof { receive(); true }
-- ^ E0720

-- @case runtime_cannot_hold_type_values compile-fail E0816
fn bad(t: Type<int>) -> () {}
-- ^ E0816

-- @case meta_fn_cannot_return_type_value compile-fail E0812
meta fn bad() -> Type<int> { <int> }
-- ^ E0812

-- @case type_function_selects_one_result compile-pass
type Choose = \T -> match <T> {
    <int> -> <str>
    _ -> <bool>
}
type Output = Choose<int>
meta let _ = assert(<Output> == <str>)
meta let _ = assert(<Choose<f64>> == <bool>)

-- @case type_identity_uses_f64_bits compile-pass
type Fixed<n: f64>(int)
meta let _ = assert(<Fixed<-0.0>> != <Fixed<0.0>>)
meta let _ = assert(-0.0 == 0.0)

-- @case scalar_length compile-pass
meta let _ = assert(len("αβ") == 2 && len(bytes"\xFF\0") == 2)

-- @case static_value_checks_run_with_trailing_arguments compile-pass
type Positive = \n: int -> if n > 0 { <()> } else { <never> }
type AtLeast = \n: int, lo: int -> if n >= lo { <()> } else { <never> }
type Buffer<capacity: int |> Positive |> AtLeast<4> = 8> = .{ size: int }
type Explicit = Buffer<4>
type Default = Buffer<>

-- @case static_value_check_rejects_invalid_argument compile-fail E0323
type Positive = \n: int -> if n > 0 { <()> } else { <never> }
type Buffer<capacity: int |> Positive> = .{ size: int }
type Invalid = Buffer<0>
-- ^ E0323

-- @case static_value_check_rejects_wrong_result_type compile-fail E0306
type Wrong = \n: int -> <str>
type Checked<n: int |> Wrong> = int
type Invalid = Checked<1>
-- ^ E0306

-- @case static_type_check_requires_preserving_the_input compile-fail E0301
type Number = \T -> match <T> { <int> -> <T>; _ -> <never> }
type Checked<T |> Number> = .{ item: T }
type Invalid = Checked<bool>
-- ^ E0301

-- @case reflection_filters_type_field_and_variant_metadata compile-pass
type Role(str)
meta(Role::("admin"), "ignored", Role::("writer"))
type Request(.{ meta(Role::("private")) email: str })
type ApiError { meta(Role::("log")) Missing; Unused }
type NestedError { ..ApiError; Bad }
meta let ROLES = Reflect::attrs(<Request>, <Role>)
meta let FIELD_ROLES = Reflect::field_attrs(<Request>, "email", <Role>)
meta let VARIANT_ROLES = Reflect::variant_attrs(<NestedError>, "Missing", <Role>)
meta let _ = assert(ROLES == [Role::("admin"), Role::("writer")])
meta let _ = assert(FIELD_ROLES == [Role::("private")])
meta let _ = assert(VARIANT_ROLES == [Role::("log")])

-- @case metadata_cannot_contain_a_runtime_callable compile-fail E0816
type Role(str)
meta((\x: int -> x, 1))
type Request(.{ email: str })

-- @case field_metadata_requires_a_valid_key compile-fail E0323
type Request(.{ email: str })
meta let INVALID = Reflect::field_attrs(<Request>, "unknown", <str>)
-- ^ E0323

-- @case static_map_updates_use_structural_keys_and_ordered_operands compile-pass
meta fn evaluate() -> int {
    var order = 0
    let mut values = [(1, "key"): 10]
    values[{ order = order * 10 + 1; (1, "key") }] = { order = order * 10 + 2; 30 }
    assert(values?[(1, "key")] == Some(30))
    assert(len(values) == 1)
    order
}
meta let _ = assert(evaluate() == 12)

-- @case meta_key_specializes_projection_and_rejects_unknown_coordinate compile-fail E0323
fn read<T: .{ .. }>(via item: T, meta key: str |> KeyOf<T>) -> infer T.(key) {
    item.(key)
}
fn bad() -> int { read(.{ size: 2 }, "missing") }
-- ^ E0323

-- @case projection_meta_argument_must_be_static compile-fail E0814
fn read<T: .{ .. }>(via item: T, meta key: str |> KeyOf<T>) -> infer T.(key) {
    item.(key)
}
fn bad(key: str) -> int { read(.{ size: 2 }, key) }
-- ^ E0814

-- @case mapped_record_reads_static_locals_and_preserves_member_modes compile-pass
type Select = \T: .{ .. }, keys: []str -> {
    let chosen = Reflect::fields(<T>) |> Array::filter(\(_, k) -> Array::contains(keys, k))
    <.{ m [chosen as (m, k)]: T.(k) }>
}
type Model = .{ id: int, var title: str, mut rows: []int }
type Patch = Select<Model, ["title", "rows"]>
meta let _ = assert(<Patch> == <.{ var title: str, mut rows: []int }>)

-- @case invalid_mapped_record_field_label compile-fail E0815
type Invalid = .{ [["where"] as key]: int }
-- ^ E0815

-- @case duplicate_mapped_record_field_label compile-fail E0210
type Invalid = .{ [["key", "key"] as key]: int }
-- ^ E0210

-- @case static_inspection_obeys_opaque_boundaries_in_nested_values compile-pass unit=lib
-- @file pkg/secret.ril
pub opaque type Token(int)
pub meta fn token(value: int) -> Token { value }
pub meta fn inside() -> str { String::inspect(token(42)) }
-- @file pkg/main.ril
use pkg/secret
meta fn describe<T>(value: []?T) -> str { String::inspect(value) }
meta let CHECK = assert(Secret::inside() == "42" &&
    String::inspect(Secret::token(17)) == "<Token>" &&
    describe([Some(Secret::token(17)), None]) == "[Some(<Token>), None]")

-- @case derive_updates_static_values_by_path compile-pass
type Cell = .{ count: int }
meta fn check_paths() -> bool {
    let cell = Cell.{ count: 7 }
    let row = [cell]
    let base = (row, row)
    let updated = derive(base) \mut draft -> {
        Array::push(mut draft.0, cell)
        draft.0[0].count = 8
    }
    base == ([Cell.{ count: 7 }], [Cell.{ count: 7 }]) &&
        updated == ([Cell.{ count: 8 }, Cell.{ count: 7 }], [Cell.{ count: 7 }])
}
meta let CHECK = assert(check_paths())

-- @case static_derive_preserves_unit_payloads compile-pass
type Kind { Present(); Empty }
meta fn check_payloads() -> bool {
    let some = derive(Some()) \mut _ -> ()
    let tagged = derive(Kind::Present()) \mut _ -> ()
    some == Some(()) && tagged == Kind::Present(())
}
meta let CHECK = assert(check_payloads())

-- @case forwarded_static_guard_fails_at_type_checking compile-fail E0323
type Positive = \n: int -> if n > 0 { <()> } else { <never> }
fn positive(meta n: int |> Positive) -> int { n }
fn relay(meta n: int) -> int {
    positive(n - 1)
    -- ^ E0323
}
fn use_relay() -> int { relay(1) }

-- @case forwarded_static_fault_fails_at_type_checking compile-fail E0830
meta fn positive(n: int) -> int {
    assert(n > 0)
    -- ^ E0830
    n
}
fn relay(meta n: int) -> int { meta positive(n - 1) }
fn use_relay() -> int { relay(1) }

-- @case changing_static_recursion_exhausts_compilation_budget compile-fail E0811 budget=12
fn spin(meta n: int) -> int {
    spin(n + 1)
    -- ^ E0811
}
fn start() -> int { spin(0) }

-- @case inferred_type_values_keep_opaque_declaration_identity compile-fail E0301
opaque type Weight(int)
fn read(meta kind: Type<Weight>) -> int { if kind == <Weight> { 42 } else { 0 } }
fn invalid() -> int { read(<int>) }
-- ^ E0301

-- @case static_draft_match_updates_active_variant_path compile-pass stage=access
type Cell = .{ count: int }
type Item { Present(Cell); Missing }
meta fn edit(base: Item) -> Item {
    derive(base) \mut draft -> {
        match draft {
            Item::Present(mut cell) -> { cell.count += 1 }
            Item::Missing -> ()
        }
    }
}
meta let CHECK = assert(edit(Item::Present(Cell.{ count: 41 })) == Item::Present(Cell.{ count: 42 }))

-- @case static_draft_alternative_binding_updates_only_selected_tuple_path compile-pass stage=access
type Cell = .{ count: int }
meta fn edit(base: (bool, Cell, Cell)) -> (bool, Cell, Cell) {
    derive(base) \mut draft -> {
        let (true, mut cell, _) | (false, _, mut cell) = draft
        cell.count += 10
    }
}
meta let LEFT = assert(edit((true, Cell.{ count: 1 }, Cell.{ count: 2 })) ==
    (true, Cell.{ count: 11 }, Cell.{ count: 2 }))
meta let RIGHT = assert(edit((false, Cell.{ count: 1 }, Cell.{ count: 2 })) ==
    (false, Cell.{ count: 1 }, Cell.{ count: 12 }))

-- @case static_draft_if_let_applies_change_to_nested_array_element compile-pass stage=access
type Cell = .{ count: int }
type State = .{ items: []?Cell }
meta fn edit(base: State, index: int) -> State {
    var evaluations = 0
    let updated = derive(base) \mut draft -> {
        if let Some(mut cell) = draft.items[{ evaluations += 1; index }] { cell.count += 1 }
    }
    assert(evaluations == 1)
    updated
}
meta let CHECK = assert(edit(State.{ items: [None, Some(Cell.{ count: 41 })] }, 1) ==
    State.{ items: [None, Some(Cell.{ count: 42 })] })

-- @case static_draft_inner_updates_nominal_array_payload compile-pass stage=access
type Bag([]int)
meta fn append(base: Bag) -> Bag {
    derive(base) \mut draft -> {
        inner(mut draft) |> mut Array::push(42)
    }
}
meta let CHECK = assert(inner(append(Bag::([1]))) == [1, 42])

-- @case static_draft_later_pattern_reads_writes_from_failed_guard compile-pass
type Cell = .{ count: int }
type Item { Present(Cell); Missing }
meta fn edit(base: Item) -> Item {
    derive(base) \mut draft -> {
        match draft {
            Item::Present(mut cell) if { cell.count = 7; false } -> ()
            Item::Present(.{ count: 7 }) -> ()
            Item::Present(mut cell) -> { cell.count = 9 }
            Item::Missing -> ()
        }
    }
}
meta let CHECK = assert(edit(Item::Present(Cell.{ count: 41 })) == Item::Present(Cell.{ count: 7 }))

-- @case static_draft_inner_writes_nominal_tuple_coordinates compile-pass stage=access
type Pair(int, int)
meta fn edit(base: Pair) -> Pair {
    derive(base) \mut draft -> {
        inner(mut draft).0 = 41
        (draft |> mut inner).1 += 1
    }
}
meta let CHECK = assert(inner(edit(Pair::(1, 2))) == (41, 3))

-- @case meta_if_in_meta_fn_is_rejected compile-fail E0810
meta fn bad(flag: bool) -> int {
    meta if flag { 1 } else { 2 }
    -- ^ E0810
}

-- @case meta_match_in_type_function_is_rejected compile-fail E0810
type Bad = \T -> meta match <T> {
    -- ^ E0810
    <int> -> <int>
    _ -> <str>
}

-- @case meta_if_requires_static_condition compile-fail E0814
fn bad(flag: bool) -> int {
    meta if flag { 1 } else { 2 }
    -- ^ E0814
}

-- @case meta_match_requires_static_scrutinee compile-fail E0814
fn bad(n: int) -> int {
    meta match n {
    -- ^ E0814
        0 -> 1
        _ -> 2
    }
}

-- @case meta_match_guard_must_be_static compile-fail E0814
meta let VAL = 5
fn bad(flag: bool) -> int {
    meta match VAL {
        x if flag -> x
        -- ^ E0814
        _ -> 0
    }
}

-- @case plain_runtime_match_on_type_value_is_rejected compile-fail E0816
fn bad<T>(x: T) -> int {
    match <T> {
    -- ^ E0816
        <int> -> x
        _ -> 0
    }
}

-- @case opaque_value_wrapper_and_aliased_variant_ctfe compile-pass
opaque type Weight(int)
type Shape { Circle(int); Square(int) }
meta fn make_a() -> Weight { 1 }
meta fn make_b() -> Weight { Weight::(1) }
meta fn check_all() -> bool {
    let a = make_a()
    let b = make_b()
    let Weight::(n) = a
    use Shape::Circle as C
    let s = C(5)
    let matched = match s {
        C(r) -> r
        Shape::Square(w) -> w
    }
    a == b && b + 1 == 2 && inner(a) == 1 && n == 1 && matched == 5
}
meta let OK = check_all()
fn main() -> () { assert(OK) }
