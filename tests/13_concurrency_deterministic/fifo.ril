-- @suite concurrency_deterministic
-- @default_stage run

-- @case plain_task_join_is_memoized_and_rooted run-pass backend=both
-- @expect-stdout once
-- @expect-stdout 42
use ril/fiber
fn main() @io @fiber -> () {
    Fiber::scope \mut s -> {
        let task = Fiber::spawn(mut s) \-> {
            println("once")
            [20, 22]
        }
        assert(Fiber::join(mut s, task)[0] == 20)
        let other = [1, 2, 3]
        assert(len(other) == 3)
        let again = Fiber::join(mut s, task)
        println("{again[0] + again[1]}")
    }
}

-- @case owned_task_join_preserves_fresh_payload run-pass backend=both
use ril/fiber
fn main() @fiber -> () {
    Fiber::scope \mut s -> {
        let mut task = Fiber::spawn(mut s) \-> [1]
        let mut output = Fiber::join(mut s, new task)
        Array::push(mut output, 2)
        assert(output == [1, 2])
    }
}

-- @case bodyless_fiber_module_uses_registered_runtime run-pass backend=both
-- @expect-stdout 42
-- @file pkg/main.ril
use ril/fiber
fn main() @io -> () {
    let value = Fiber::run \-> { Fiber::yield_now(); 42 }
    println("{value}")
}
-- @file ril/fiber.ril
pub fn run<Output |> Sendable>(via action: fn() @& -> infer Output) -> infer Output
pub fn yield_now() @fiber -> ()

-- @case executable_fiber_effect_drives_the_scheduler run-pass backend=both
-- @expect-stdout parent
-- @expect-stdout child
-- @expect-stdout 42
use ril/fiber
fn main() @io @fiber -> () {
    let answer = Fiber::scope \mut s -> {
        let child = Fiber::spawn(mut s) \-> {
            println("child")
            Fiber::run \-> { Fiber::yield_now(); 40 }
        }
        println("parent")
        Fiber::yield_now()
        Fiber::join(mut s, child) + 2
    }
    println("{answer}")
}

-- @case fifo_yield_order run-pass backend=both
-- @expect-stdout a1
-- @expect-stdout b1
-- @expect-stdout a2
-- @expect-stdout b2
-- @expect-stdout 30
use ril/fiber
fn main() @io -> () {
    let answer = Fiber::run \-> Fiber::scope \mut s -> {
        let a = Fiber::spawn(mut s) \-> {
            println("a1")
            Fiber::yield_now()
            println("a2")
            10
        }
        let b = Fiber::spawn(mut s) \-> {
            println("b1")
            Fiber::yield_now()
            println("b2")
            20
        }
        Fiber::join(mut s, a) + Fiber::join(mut s, b)
    }
    println("{answer}")
}

-- @case channel_pipeline_backpressure run-pass backend=both
-- @expect-stdout 30
use ril/fiber
use ril/channel
fn pipeline() @fiber -> int {
    Fiber::scope \mut s -> {
        let Channel::ChannelPair.{ mut tx, mut rx } = Channel::bounded(1)
        let task = Fiber::spawn(mut s) \-> {
            use mut sender = new tx
            for 1..=4 as i {
                match Channel::send(mut sender, i * i) {
                    Ok() -> ()
                    Err(_) -> break
                }
            }
        }
        var sum = 0
        while let Some(value) = Channel::recv(mut rx) { sum += value }
        Fiber::join(mut s, task)
        sum
    }
}
fn main() @io -> () { println("{Fiber::run(\-> pipeline())}") }

-- @case early_scope_cancel_drains_cleanup run-pass backend=both
-- @expect-stdout cleanup
-- @expect-stdout done
use ril/fiber
opaque type Resource use(close) = .{ id: int }
fn close(new resource: Resource) @io -> () { println("cleanup") }
fn main() @io -> () {
    Fiber::run \-> Fiber::scope \mut s -> {
        let mut child = Fiber::spawn(mut s) \-> {
            use resource = Resource.{ id: 1 }
            Fiber::yield_now()
            println("unexpected")
        }
        Fiber::yield_now()
        let _ = Fiber::cancel(mut s, new child)
    }
    println("done")
}

-- @case zip_race_and_map run-pass backend=both
-- @expect-stdout 42:8:9
use ril/fiber
fn main() @io -> () {
    Fiber::run \-> {
        let both = Fiber::zip(\-> 18, \-> 24)
        let winner = Fiber::race(\-> { Fiber::yield_now(); 7 }, \-> 8)
        let results = Fiber::map([1, 2, 3], \x -> x * x)
        println("{both.first + both.second}:{winner}:{results[2]}")
    }
}

-- @case supervise_absorbs_child_panic run-pass backend=both
-- @expect-stdout recovered
use ril/fiber
fn main() @io -> () {
    Fiber::run \-> {
        let outcome = Fiber::supervise \-> {
            Fiber::yield_now()
            panic("child")
        }
        match outcome { Ok(_) -> (); Err(_) -> println("recovered") }
    }
}

-- @case zero_capacity_send_waits_for_receiver run-pass backend=both
-- @expect-stdout sending
-- @expect-stdout receiving
-- @expect-stdout sent
use ril/fiber
use ril/channel
fn main() @io -> () {
    Fiber::run \-> Fiber::scope \mut scope -> {
        let Channel::ChannelPair.{ mut tx, mut rx } = Channel::bounded(0)
        match Channel::try_send(mut tx, 41) {
            Err(Channel::TrySendError::Full(41)) -> ()
            _ -> panic("zero-capacity send must wait for receiver")
        }
        let sender = Fiber::spawn(mut scope) \-> {
            use mut outlet = new tx
            println("sending")
            match Channel::send(mut outlet, 42) {
                Ok() -> println("sent")
                Err(_) -> panic("channel closed early")
            }
        }
        Fiber::yield_now()
        println("receiving")
        assert(Channel::recv(mut rx) == Some(42))
        Fiber::join(mut scope, sender)
    }
}
