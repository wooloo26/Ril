fn promote_twice() -> int {
    let mut moved = {
        let mut initial = make()
        Array::push(mut initial.items, 3)
        initial
    }
    Array::push(mut moved.items, 4)
    len(ref moved.items)
}

-- @case promoted_composite_keeps_independent_shared_source compile-pass no-prelude
type Cell = .{ var value: int }
type Holder = .{ mut cells: [^mut]Cell }
fn hold(^mut cell: Cell) &^mut &return(^mut cell) -> new Holder {
    Holder.{ cells: [^mut cell] }
}
fn edit() -> int {
    let mut cell = Cell.{ value: 2 }
    let mut moved = {
        let mut original = hold(^mut cell)
        if len(ref original.cells) > 0 { original.cells[0].value += 1 }
        original
    }
    if len(ref moved.cells) > 0 { moved.cells[0].value += 1 }
    cell.value
}

