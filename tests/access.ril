-- @case linear_scoped_access_file_and_typestate_pool compile-pass
sub Fs {
    pub opaque linear type File(.{ path: str, var written: int })
    pub fn open(path: str) -> new !<File, str> {
        Ok(File::(.{ path, written: 0 }))
    }
    pub fn path(ref f: File) -> str { inner(ref f).path }
    pub fn write(mut f: File, n: int) -> () {
        inner(mut f).written = inner(ref f).written + n
    }
    pub fn close(f: File) -> int {
        let File::(.{ written, .. }) = f
        written
    }
}

sub Net {
    pub type Disconnected
    pub type Connected
    pub opaque linear type Conn<S>(.{ id: int, var sent: int })
    pub fn create(id: int) -> Conn<Disconnected> {
        Conn::(.{ id, sent: 0 })
    }
    pub fn connect(c: Conn<Disconnected>) -> Conn<Connected> {
        let Conn::(.{ id, sent }) = c
        Conn::(.{ id, sent })
    }
    pub fn id(ref c: Conn<Connected>) -> int { inner(ref c).id }
    pub fn send(mut c: Conn<Connected>, n: int) -> () {
        inner(mut c).sent = inner(ref c).sent + n
    }
    pub fn close_connected(c: Conn<Connected>) -> int {
        let Conn::(.{ sent, .. }) = c
        sent
    }
}

fn use_file() -> new !<str, str> {
    let mut f = Fs::open("a.txt")?
    defer { let _ = Fs::close(f) }
    Fs::write(mut f, 10)
    Ok(Fs::path(ref f))
}

fn use_pool() -> int {
    let mut pool: [str: Net::Conn<Net::Connected>] = [:]
    defer {
        while let Some((_, c)) = Map::pop_entry(mut pool) {
            let _ = Net::close_connected(c)
        }
    }
    let raw = Net::create(1)
    let mut c = Net::connect(raw)
    Net::send(mut c, 5)
    if let Some(old) = Map::replace(mut pool, "primary", c) {
        let _ = Net::close_connected(old)
    }
    let _ = Map::contains(ref pool, "primary")
    let _ = Map::keys(ref pool)
    var total = 0
    for mut pool as (_, conn) {
        Net::send(mut conn, 2)
    }
    for ref pool as (_, conn) {
        total = total + Net::id(ref conn)
    }
    total
}

