-- @suite via_compat
-- @default_stage access

-- @prelude
pub type Cell = .{ var count: int }

-- @case domain_tightened compat-fail E0552
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count += 1; c.count }
-- ^ E0552

-- @case equivalent_via_revision compat-pass
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count + 0 }

-- @case signature_format compile-pass no-prelude
-- @expect-sig square "fn square(x: int) -> int"
fn square(x: int) -> int { x * x }

-- @case infer_requires_its_own_via compile-fail E0412
fn invalid(x: Cell) -> infer Cell { x }
-- ^ E0412

-- @case concrete_value_has_no_mode_family compile-fail E0550
fn invalid(via x: int) -> int { x }
-- ^ E0550

-- @case via_local_preserves_template compile-pass
pub fn relay(via source: Cell) -> infer Cell {
    let via local = source
    local
}

-- @case call_must_fit_inferred_domain compile-fail E0520
fn update(via c: Cell) -> () { c.count += 1 }
fn run() -> () {
    let snap = Cell.{ count: 1 }
    update(snap)
    -- ^ E0520
}

-- @case via_binding_must_be_dependent compile-fail E0550
fn invalid(via c: Cell) -> infer Cell {
    let via local = Cell.{ count: 0 }
    -- ^ E0550
    local
}

-- @case narrower_inferred_root_relation_is_compatible compat-pass
-- @baseline
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell {
    if first { a } else { b }
}
-- @revision
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell { a }

-- @case additional_inferred_root_breaks_compatibility compat-fail E0552
-- @baseline
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell { a }
-- @revision
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell {
-- ^ E0552
    if first { a } else { b }
}

-- @case changed_call_entry_projection_breaks_compatibility compat-fail E0552
-- @baseline
pub type Pair = .{ ref left: Cell, ref right: Cell }
pub fn project(ref pair: Pair) -> ref(pair) Cell { pair.left }
-- @revision
pub type Pair = .{ ref left: Cell, ref right: Cell }
pub fn project(ref pair: Pair) -> ref(pair) Cell { pair.right }
-- ^ E0552

-- @case changed_contained_projection_breaks_compatibility compat-fail E0552
-- @baseline
pub fn pack(input: Cell) &return(input) -> new []Cell { [input, Cell.{ count: 0 }] }
-- @revision
pub fn pack(input: Cell) &return(input) -> new []Cell { [Cell.{ count: 0 }, input] }
-- ^ E0552

-- @case multi_input_inference_preserves_selected_sources compile-pass
fn choose(condition: bool, via left: Cell, via right: Cell) -> infer Cell {
    if condition { left } else { right }
}
fn use_both(condition: bool) -> int {
    let mut left = Cell.{ count: 2 }
    let mut right = Cell.{ count: 3 }
    let ref view = choose(condition, ref left, ref right)
    left.count += 1
    right.count += 1
    view.count
}

-- @case inferred_new_result_is_independent_of_via_input compile-pass
fn copied(via source: Cell) -> infer Cell { Cell.{ count: source.count } }
fn use_copy() -> int {
    let mut copy = copied(Cell.{ count: 1 })
    copy.count += 1
    copy.count
}
