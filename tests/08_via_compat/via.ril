-- @suite via_compat
-- @default_stage access

-- @prelude
pub type Cell = .{ var count: int }

-- @case domain_tightened compat-fail E0552
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count += 1; c.count }
-- ^ E0552

-- @case equivalent_via_revision compat-pass
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count + 0 }

-- @case signature_format compile-pass no-prelude
-- @expect-sig square "fn square(x: int) -> int"
fn square(x: int) -> int { x * x }

-- @case infer_requires_its_own_via compile-fail E0412
fn invalid(x: Cell) -> infer Cell { x }
-- ^ E0412

-- @case concrete_value_has_no_mode_family compile-fail E0550
fn invalid(via x: int) -> int { x }
-- ^ E0550

-- @case higher_order_infer_requires_a_lexical_via_input compile-fail E0412
fn invalid(callback: fn(Cell) -> infer Cell) -> () {}
-- ^ E0412

-- @case standalone_via_field_cannot_supply_a_callable_input_mode compile-fail E0412
type Invalid = .{ via callback: fn() -> infer Cell }
-- ^ E0412

-- @case higher_order_infer_accepts_its_own_mode_input compile-pass
type Transform = fn(via Cell) @& -> infer Cell
fn accept(callback: Transform) -> () {}

-- @case higher_order_mode_family_rejects_a_fixed_writer compile-fail E0407
fn use_snapshot(via action: fn(via Cell) @& -> ()) -> () {
    let snapshot = Cell.{ count: 41 }
    action(snapshot)
}
fn change(mut cell: Cell) &mut -> () { cell.count += 1 }
fn invalid() -> () {
    use_snapshot(change)
    -- ^ E0407
}

-- @case higher_order_callback_requires_a_writable_forwarded_argument compile-fail E0520
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn invalid() -> int {
    let snapshot = Cell.{ count: 41 }
    apply(change, snapshot)
    -- ^ E0520
}

-- @case higher_order_writable_and_plain_instantiations_are_independent compile-pass
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
fn relay(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { apply(action, cell) }
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn read(via cell: Cell) -> int { cell.count }
fn run() -> int {
    let snapshot = Cell.{ count: 12 }
    let mut live = Cell.{ count: 29 }
    relay(read, snapshot) + relay(change, mut live)
}

-- @case higher_order_argument_demands_survive_recursion_and_named_values compile-fail E0520
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell, recur: bool) -> int {
    if recur { apply(action, cell, false) } else { action(cell) }
}
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn invalid() -> int {
    let snapshot = Cell.{ count: 41 }
    let action = change
    apply(action, snapshot, true)
    -- ^ E0520
}

-- @case higher_order_inferred_return_cannot_freeze_a_borrowed_argument compile-fail E0535
fn through(via cell: Cell) -> infer Cell { cell }
fn apply(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell {
    let via value = action(cell)
    through(value)
}
fn identity(via cell: Cell) -> infer Cell { cell }
fn invalid(ref cell: Cell) -> int {
    let value = apply(identity, ref cell)
    -- ^ E0535
    value.count
}

-- @case higher_order_inferred_return_keeps_the_original_handoff_dependency compile-fail E0549
fn apply(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell { action(cell) }
fn relay(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell { apply(action, cell) }
fn invalid() -> int {
    let mut cell = Cell.{ count: 41 }
    let relay_identity = \via value: Cell -> value
    let ref view = relay(relay_identity, ref cell)
    let moved = new cell
    moved.count + view.count
    -- ^ E0549
}

-- @case higher_order_return_distinguishes_reference_snapshot_and_new_arguments compile-pass
fn apply(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell { action(cell) }
fn identity(via cell: Cell) -> infer Cell { cell }
fn run() -> int {
    let plain = Cell.{ count: 1 }
    let snapshot = apply(identity, plain)
    let mut cell = Cell.{ count: 40 }
    let ref view = apply(identity, ref cell)
    let count = view.count
    let mut moved = apply(identity, new cell)
    moved.count += 1
    snapshot.count + count + moved.count
}

-- @case higher_order_return_cannot_recover_ownership_after_attenuation compile-fail E0520
fn observe(via action: fn() @& -> infer Cell) -> infer Cell { ref action() }
fn invalid() -> int {
    let mut view = observe(\-> Cell.{ count: 41 })
    -- ^ E0520
    view.count += 1
    view.count
}

-- @case adding_a_higher_order_mode_requirement_breaks_compatibility compat-fail E0552
-- @baseline
pub fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { cell.count }
-- @revision
pub fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
-- ^ E0552

-- @case forwarding_preserves_higher_order_mode_requirements compat-pass
-- @baseline
pub fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
-- @revision
fn relay(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
pub fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { relay(action, cell) }

-- @case higher_order_infer_can_use_an_enclosing_mode_input compile-pass
fn accept(via callback: fn() @& -> infer Cell) -> () {}

-- @case higher_order_mode_template_rejects_a_value_type_input compile-fail E0550
type Invalid = fn(via int) -> infer int
-- ^ E0550

-- @case anonymous_callable_binds_its_own_via_input compile-pass
fn run() -> int {
    let relay = \via cell: Cell -> { let via local = cell; local }
    relay(Cell.{ count: 42 }).count
}

-- @case anonymous_callable_binds_its_own_via_member compile-pass
fn run(ref holder: .{ child: Cell }) -> int {
    let read = \ref item: .{ via child: Cell } -> { let via local = item.child; local.count }
    read(ref holder)
}

-- @case local_via_closure_rejects_read_only_input compile-fail E0520
fn invalid() -> () {
    let change = \via cell: Cell -> { let via local = cell; local.count += 1 }
    let cell = Cell.{ count: 42 }
    change(cell)
    -- ^ E0520
}

-- @case local_composite_via_closure_rejects_read_only_input compile-fail E0520
fn invalid() -> () {
    let change = \mut holder: .{ via child: Cell } -> { holder.child.count += 1 }
    let mut holder = .{ child: Cell.{ count: 42 } }
    change(mut holder)
    -- ^ E0520
}

-- @case local_composite_via_closure_receives_and_uses_writable_member compile-pass
fn run() -> int {
    let change = \mut holder: .{ via child: Cell } -> { holder.child.count += 1 }
    let mut holder = .{ mut child: Cell.{ count: 41 } }
    change(mut holder)
    holder.child.count
}

-- @case local_via_closure_return_preserves_the_handoff_dependency compile-fail E0549
fn invalid() -> int {
    let relay = \via cell: Cell -> { let via alias = cell; alias }
    let mut cell = Cell.{ count: 41 }
    let ref view = relay(ref cell)
    let moved = new cell
    moved.count + view.count
    -- ^ E0549
}

-- @case via_local_preserves_template compile-pass
pub fn relay(via source: Cell) -> infer Cell {
    let via local = source
    local
}

-- @case call_must_fit_inferred_domain compile-fail E0520
fn update(via c: Cell) -> () { c.count += 1 }
fn run() -> () {
    let snap = Cell.{ count: 1 }
    update(snap)
    -- ^ E0520
}

-- @case via_binding_must_be_dependent compile-fail E0550
fn invalid(via c: Cell) -> infer Cell {
    let via local = Cell.{ count: 0 }
    -- ^ E0550
    local
}

-- @case narrower_inferred_root_relation_is_compatible compat-pass
-- @baseline
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell {
    if first { a } else { b }
}
-- @revision
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell { a }

-- @case additional_inferred_root_breaks_compatibility compat-fail E0552
-- @baseline
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell { a }
-- @revision
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell {
-- ^ E0552
    if first { a } else { b }
}

-- @case changed_call_entry_projection_breaks_compatibility compat-fail E0552
-- @baseline
pub type Pair = .{ ref left: Cell, ref right: Cell }
pub fn project(ref pair: Pair) -> ref(pair) Cell { pair.left }
-- @revision
pub type Pair = .{ ref left: Cell, ref right: Cell }
pub fn project(ref pair: Pair) -> ref(pair) Cell { pair.right }
-- ^ E0552

-- @case changed_contained_projection_breaks_compatibility compat-fail E0552
-- @baseline
pub fn pack(input: Cell) &return(input) -> new []Cell { [input, Cell.{ count: 0 }] }
-- @revision
pub fn pack(input: Cell) &return(input) -> new []Cell { [Cell.{ count: 0 }, input] }
-- ^ E0552

-- @case changed_exported_member_mode_breaks_compatibility compat-fail E0552 no-prelude
-- @baseline
pub nominal type Endpoint = .{ port: int }
-- @revision
pub nominal type Endpoint = .{ var port: int }
-- ^ E0552

-- @case narrower_generic_domain_breaks_compatibility compat-fail E0552 no-prelude
-- @baseline
pub fn constant<T: int | f64>(_value: T) -> int { 1 }
-- @revision
pub fn constant<T: int>(_value: T) -> int { 1 }
-- ^ E0552

-- @case runtime_definition_cannot_replace_meta_definition compat-fail E0552 no-prelude
-- @baseline
pub meta fn double(value: int) -> int { 2 * value }
-- @revision
pub fn double(value: int) -> int { 2 * value }
-- ^ E0552

-- @case removing_argument_default_breaks_compatibility compat-fail E0552 no-prelude
-- @baseline
pub fn choose(value: int = 42) -> int { value }
-- @revision
pub fn choose(value: int) -> int { value }
-- ^ E0552

-- @case effect_operation_exports_preserve_their_owner compat-fail E0552 no-prelude
-- @baseline
pub eff First { fn lookup() -> int }
pub eff Second { fn lookup() -> int }
-- @revision
pub eff First { fn lookup() -> bool }
-- ^ E0552
pub eff Second { fn lookup() -> int }

-- @case multi_input_inference_preserves_selected_sources compile-pass
fn choose(condition: bool, via left: Cell, via right: Cell) -> infer Cell {
    if condition { left } else { right }
}
fn use_both(condition: bool) -> int {
    let mut left = Cell.{ count: 2 }
    let mut right = Cell.{ count: 3 }
    let ref view = choose(condition, ref left, ref right)
    left.count += 1
    right.count += 1
    view.count
}

-- @case inferred_new_result_is_independent_of_via_input compile-pass
fn copied(via source: Cell) -> infer Cell { Cell.{ count: source.count } }
fn use_copy() -> int {
    let mut copy = copied(Cell.{ count: 1 })
    copy.count += 1
    copy.count
}

-- @case forwarding_to_writer_restricts_published_via_domain compat-fail E0552
-- @baseline
pub fn relay(via cell: Cell) -> int { cell.count }
-- @revision
fn bump(via cell: Cell) -> int { cell.count += 1; cell.count }
pub fn relay(via cell: Cell) -> int { bump(cell) }
-- ^ E0552

-- @case replacing_inline_via_body_with_forwarding_is_compatible compat-pass
-- @baseline
pub fn relay(via cell: Cell) -> infer Cell { cell }
-- @revision
fn identity(via cell: Cell) -> infer Cell { cell }
pub fn relay(via cell: Cell) -> infer Cell {
    let via local = cell
    identity(local)
}

-- @case forwarded_writer_rejects_read_only_instantiation compile-fail E0520
fn bump(via cell: Cell) -> int { cell.count += 1; cell.count }
fn relay(via cell: Cell) -> int { bump(cell) }
fn run() -> int {
    let mut cell = Cell.{ count: 41 }
    let value = relay(ref cell)
    -- ^ E0520
    cell.count += 1
    value
}

-- @case forwarded_via_handoff_requires_new_qualification compile-fail E0548
fn take(via cell: Cell) -> infer Cell { new cell }
fn relay(via cell: Cell) -> infer Cell { take(cell) }
fn read(ref cell: Cell) -> int {
    let selected = relay(ref cell)
    -- ^ E0548
    selected.count
}

-- @case via_handoff_revokes_path_after_nested_forwarding compile-fail E0549
fn take(via cell: Cell) -> infer Cell { new cell }
fn relay(via cell: Cell) -> infer Cell { take(cell) }
fn invalid(via cell: Cell) -> int {
    let ref observer = ref cell
    let selected = relay(cell)
    selected.count + observer.count
    -- ^ E0549
}

-- @case consuming_via_revision_restricts_published_domain compat-fail E0552
-- @baseline
pub fn relay(via cell: Cell) -> infer Cell { cell }
-- @revision
fn take(via cell: Cell) -> infer Cell { new cell }
pub fn relay(via cell: Cell) -> infer Cell { take(cell) }
-- ^ E0552

-- @case explicitly_read_only_via_result_cannot_recover_new_authority compile-fail E0520
fn observe(via cell: Cell) -> infer Cell { ref cell }
fn relay(via cell: Cell) -> infer Cell { observe(cell) }
fn invalid() -> int {
    let mut original = Cell.{ count: 41 }
    let mut view = relay(new original)
    -- ^ E0520
    view.count += 1
    view.count
}

-- @case attenuating_a_published_via_return_breaks_compatibility compat-fail E0552
-- @baseline
pub fn relay(via cell: Cell) -> infer Cell { cell }
-- @revision
fn observe(via cell: Cell) -> infer Cell { ref cell }
pub fn relay(via cell: Cell) -> infer Cell { observe(cell) }
-- ^ E0552

-- @case forwarded_via_retention_requires_a_shared_writer compile-fail E0520
type Shelf = .{ var ^mut item: Cell }
fn store(via item: Cell, mut shelf: Shelf) &mut -> () { shelf.item = ^mut item }
fn relay(via item: Cell, mut shelf: Shelf) &mut -> () { store(item, mut shelf) }
fn invalid(ref item: Cell, mut shelf: Shelf) &mut -> () {
    relay(ref item, mut shelf)
    -- ^ E0520
}

-- @case record_member_via_can_be_bound_and_forwarded compile-pass
fn select(ref holder: .{ via child: Cell }) -> infer Cell {
    let via child = holder.child
    child
}
pub fn select_again(ref holder: .{ via child: Cell }) -> infer Cell {
    let via child = select(ref holder)
    child
}
fn inspect() -> int {
    let holder = .{ child: Cell.{ count: 42 } }
    let selected = select_again(ref holder)
    selected.count
}

-- @case composite_via_infers_the_existing_member_access compile-fail E0520
fn select(ref holder: .{ via child: Cell }) -> infer Cell {
    let via child = holder.child
    child
}
fn invalid(ref holder: .{ ref child: Cell }) -> int {
    let mut selected = select(ref holder)
    -- ^ E0520
    selected.count += 1
    selected.count
}

-- @case record_member_via_write_rejects_immutable_schema compile-fail E0520
fn change(mut holder: .{ via child: Cell }) &mut -> () { holder.child.count += 1 }
fn invalid() -> () {
    let mut holder = .{ child: Cell.{ count: 42 } }
    change(mut holder)
    -- ^ E0520
}

-- @case different_member_via_axes_have_independent_modes compile-pass
fn change(mut holder: .{ via left: Cell, via right: Cell }) &mut -> () {
    holder.right.count += holder.left.count
}
fn run() -> int {
    let mut holder = .{ left: Cell.{ count: 1 }, mut right: Cell.{ count: 41 } }
    change(mut holder)
    holder.right.count
}

-- @case forwarding_records_propagates_member_write_requirements compile-fail E0520
fn change(mut holder: .{ via child: Cell }) &mut -> () { holder.child.count += 1 }
fn forward(mut holder: .{ via child: Cell }) &mut -> () { change(mut holder) }
fn invalid() -> () {
    let mut holder = .{ child: Cell.{ count: 42 } }
    forward(mut holder)
    -- ^ E0520
}

-- @case forwarding_arrays_propagates_element_write_requirements compile-fail E0520
fn change(mut items: [via]Cell) &mut -> () { items[0].count += 1 }
fn forward(mut items: [via]Cell) &mut -> () { change(mut items) }
fn invalid() -> () {
    let mut items = [Cell.{ count: 42 }]
    forward(mut items)
    -- ^ E0520
}

-- @case forwarding_a_member_to_a_root_via_writer_restricts_its_schema compile-fail E0520
fn change(via child: Cell) -> () { child.count += 1 }
fn forward(mut holder: .{ via child: Cell }) &mut -> () { change(holder.child) }
fn invalid() -> () {
    let mut holder = .{ child: Cell.{ count: 42 } }
    forward(mut holder)
    -- ^ E0520
}

-- @case explicit_mut_reception_restricts_the_member_schema compile-fail E0520
fn change(mut child: Cell) &mut -> () { child.count += 1 }
fn forward(mut holder: .{ via child: Cell }) &mut -> () { change(mut holder.child) }
fn invalid() -> () {
    let mut holder = .{ child: Cell.{ count: 42 } }
    forward(mut holder)
    -- ^ E0520
}

-- @case inline_record_argument_uses_its_written_member_mode compile-pass
fn change(new holder: .{ via child: Cell }) &mut -> int {
    holder.child.count += 1
    holder.child.count
}
fn run() -> int { change(new .{ mut child: Cell.{ count: 41 } }) }

-- @case nested_inline_record_keeps_each_received_schema compile-pass
fn change(new holder: .{ mut nested: .{ via child: Cell } }) &mut -> int {
    holder.nested.child.count += 1
    holder.nested.child.count
}
fn run() -> int {
    change(new .{ mut nested: .{ mut child: Cell.{ count: 41 } } })
}

-- @case tightening_member_via_domain_breaks_compatibility compat-fail E0552
-- @baseline
pub fn change(mut holder: .{ var marker: int, via child: Cell }) &mut -> int {
    holder.marker += 1
    holder.child.count
}
-- @revision
pub fn change(mut holder: .{ var marker: int, via child: Cell }) &mut -> int {
-- ^ E0552
    holder.marker += 1
    holder.child.count += 1
    holder.child.count
}
