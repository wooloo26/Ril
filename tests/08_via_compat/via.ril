-- @suite via_compat
-- @default_stage access

-- @prelude
pub type Cell = .{ var count: int }

-- @case domain_tightened compat-fail E0552
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count += 1; c.count }
-- ^ E0552

-- @case equivalent_via_revision compat-pass
-- @baseline
pub fn read(via c: Cell) -> int { c.count }
-- @revision
pub fn read(via c: Cell) -> int { c.count + 0 }

-- @case signature_format compile-pass no-prelude
-- @expect-sig square "fn square(x: int) -> int"
fn square(x: int) -> int { x * x }

-- @case infer_requires_its_own_via compile-fail E0412
fn invalid(x: Cell) -> infer Cell { x }
-- ^ E0412

-- @case concrete_value_has_no_mode_family compile-fail E0550
fn invalid(via x: int) -> int { x }
-- ^ E0550

-- @case via_local_preserves_template compile-pass
pub fn relay(via source: Cell) -> infer Cell {
    let via local = source
    local
}

-- @case call_must_fit_inferred_domain compile-fail E0520
fn update(via c: Cell) -> () { c.count += 1 }
fn run() -> () {
    let snap = Cell.{ count: 1 }
    update(snap)
    -- ^ E0520
}

-- @case via_binding_must_be_dependent compile-fail E0550
fn invalid(via c: Cell) -> infer Cell {
    let via local = Cell.{ count: 0 }
    -- ^ E0550
    local
}

-- @case narrower_inferred_root_relation_is_compatible compat-pass
-- @baseline
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell {
    if first { a } else { b }
}
-- @revision
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell { a }

-- @case additional_inferred_root_breaks_compatibility compat-fail E0552
-- @baseline
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell { a }
-- @revision
pub fn choose(first: bool, via a: Cell, via b: Cell) -> infer Cell {
-- ^ E0552
    if first { a } else { b }
}

-- @case changed_call_entry_projection_breaks_compatibility compat-fail E0552
-- @baseline
pub type Pair = .{ ref left: Cell, ref right: Cell }
pub fn project(ref pair: Pair) -> ref(pair) Cell { pair.left }
-- @revision
pub type Pair = .{ ref left: Cell, ref right: Cell }
pub fn project(ref pair: Pair) -> ref(pair) Cell { pair.right }
-- ^ E0552

-- @case changed_contained_projection_breaks_compatibility compat-fail E0552
-- @baseline
pub fn pack(input: Cell) &return(input) -> new []Cell { [input, Cell.{ count: 0 }] }
-- @revision
pub fn pack(input: Cell) &return(input) -> new []Cell { [Cell.{ count: 0 }, input] }
-- ^ E0552

-- @case changed_exported_member_mode_breaks_compatibility compat-fail E0552 no-prelude
-- @baseline
pub nominal type Endpoint = .{ port: int }
-- @revision
pub nominal type Endpoint = .{ var port: int }
-- ^ E0552

-- @case narrower_generic_domain_breaks_compatibility compat-fail E0552 no-prelude
-- @baseline
pub fn constant<T: int | f64>(_value: T) -> int { 1 }
-- @revision
pub fn constant<T: int>(_value: T) -> int { 1 }
-- ^ E0552

-- @case runtime_definition_cannot_replace_meta_definition compat-fail E0552 no-prelude
-- @baseline
pub meta fn double(value: int) -> int { 2 * value }
-- @revision
pub fn double(value: int) -> int { 2 * value }
-- ^ E0552

-- @case removing_argument_default_breaks_compatibility compat-fail E0552 no-prelude
-- @baseline
pub fn choose(value: int = 42) -> int { value }
-- @revision
pub fn choose(value: int) -> int { value }
-- ^ E0552

-- @case effect_operation_exports_preserve_their_owner compat-fail E0552 no-prelude
-- @baseline
pub eff First { fn lookup() -> int }
pub eff Second { fn lookup() -> int }
-- @revision
pub eff First { fn lookup() -> bool }
-- ^ E0552
pub eff Second { fn lookup() -> int }

-- @case multi_input_inference_preserves_selected_sources compile-pass
fn choose(condition: bool, via left: Cell, via right: Cell) -> infer Cell {
    if condition { left } else { right }
}
fn use_both(condition: bool) -> int {
    let mut left = Cell.{ count: 2 }
    let mut right = Cell.{ count: 3 }
    let ref view = choose(condition, ref left, ref right)
    left.count += 1
    right.count += 1
    view.count
}

-- @case inferred_new_result_is_independent_of_via_input compile-pass
fn copied(via source: Cell) -> infer Cell { Cell.{ count: source.count } }
fn use_copy() -> int {
    let mut copy = copied(Cell.{ count: 1 })
    copy.count += 1
    copy.count
}

-- @case forwarding_to_writer_restricts_published_via_domain compat-fail E0552
-- @baseline
pub fn relay(via cell: Cell) -> int { cell.count }
-- @revision
fn bump(via cell: Cell) -> int { cell.count += 1; cell.count }
pub fn relay(via cell: Cell) -> int { bump(cell) }
-- ^ E0552

-- @case replacing_inline_via_body_with_forwarding_is_compatible compat-pass
-- @baseline
pub fn relay(via cell: Cell) -> infer Cell { cell }
-- @revision
fn identity(via cell: Cell) -> infer Cell { cell }
pub fn relay(via cell: Cell) -> infer Cell {
    let via local = cell
    identity(local)
}

-- @case forwarded_writer_rejects_read_only_instantiation compile-fail E0520
fn bump(via cell: Cell) -> int { cell.count += 1; cell.count }
fn relay(via cell: Cell) -> int { bump(cell) }
fn run() -> int {
    let mut cell = Cell.{ count: 41 }
    let value = relay(ref cell)
    -- ^ E0520
    cell.count += 1
    value
}

-- @case forwarded_via_handoff_requires_new_qualification compile-fail E0548
fn take(via cell: Cell) -> infer Cell { new cell }
fn relay(via cell: Cell) -> infer Cell { take(cell) }
fn read(ref cell: Cell) -> int {
    let selected = relay(ref cell)
    -- ^ E0548
    selected.count
}

-- @case via_handoff_revokes_path_after_nested_forwarding compile-fail E0549
fn take(via cell: Cell) -> infer Cell { new cell }
fn relay(via cell: Cell) -> infer Cell { take(cell) }
fn invalid(via cell: Cell) -> int {
    let ref observer = ref cell
    let selected = relay(cell)
    selected.count + observer.count
    -- ^ E0549
}

-- @case consuming_via_revision_restricts_published_domain compat-fail E0552
-- @baseline
pub fn relay(via cell: Cell) -> infer Cell { cell }
-- @revision
fn take(via cell: Cell) -> infer Cell { new cell }
pub fn relay(via cell: Cell) -> infer Cell { take(cell) }
-- ^ E0552

-- @case explicitly_read_only_via_result_cannot_recover_new_authority compile-fail E0520
fn observe(via cell: Cell) -> infer Cell { ref cell }
fn relay(via cell: Cell) -> infer Cell { observe(cell) }
fn invalid() -> int {
    let mut original = Cell.{ count: 41 }
    let mut view = relay(new original)
    -- ^ E0520
    view.count += 1
    view.count
}

-- @case attenuating_a_published_via_return_breaks_compatibility compat-fail E0552
-- @baseline
pub fn relay(via cell: Cell) -> infer Cell { cell }
-- @revision
fn observe(via cell: Cell) -> infer Cell { ref cell }
pub fn relay(via cell: Cell) -> infer Cell { observe(cell) }
-- ^ E0552

-- @case forwarded_via_retention_requires_a_shared_writer compile-fail E0520
type Shelf = .{ var ^mut item: Cell }
fn store(via item: Cell, mut shelf: Shelf) &mut -> () { shelf.item = ^mut item }
fn relay(via item: Cell, mut shelf: Shelf) &mut -> () { store(item, mut shelf) }
fn invalid(ref item: Cell, mut shelf: Shelf) &mut -> () {
    relay(ref item, mut shelf)
    -- ^ E0520
}
