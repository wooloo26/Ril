--@ case: map-growth
--@ mode: run-pass
--@ spec: STD#map
--@ entry: test_map_growth
--@ file: map-growth.ril
pub fn test_map_growth() {
    let mut values: [int: int] = [:]
    for 0..10000 as n { values !> Map::set(n, n * 2) }
    for 0..10000 as n { assert(Map::get(values, n) == Some(n * 2)) }
    assert(len(values) == 10000)
}
--@ end-file
--@ end-case
