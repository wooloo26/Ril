fn main() -> () {
    let frozen = Cell.{ count: 7 }
    let selected = relay(frozen)
    let mut live = Cell.{ count: 40 }
    let ref observer = relay(ref live)
    live.count += 1
    assert(selected.count == 7 && observer.count == 41)
    let mut moved = relay(new live)
    moved.count += 1
    assert(moved.count == 42)
}

-- @case via_handoff_returns_live_new_qualified_path_after_nested_forwarding run-pass backend=both
type Cell = .{ var count: int }
fn identity(via cell: Cell) -> infer Cell { cell }
fn relay(via cell: Cell) -> infer Cell { identity(cell) }
fn adjust(via cell: Cell) -> infer Cell {
    cell.count += 1
    relay(cell)
}
fn main() -> () {
    let mut original = Cell.{ count: 41 }
    let updated = adjust(new original)
    assert(updated.count == 42)
}

-- @case via_forwarding_propagates_shared_retention_to_the_caller run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ var ^mut item: Cell }
fn store(^mut value: Cell, mut shelf: Shelf) &mut &^mut -> () {
    shelf.item = ^mut value
}
fn relay(^mut value: Cell, mut shelf: Shelf) &mut &^mut -> () {
    store(^mut value, mut shelf)
}
fn main() -> () {
    let mut previous = Cell.{ count: 0 }
    previous.count += 1
    let mut shelf = Shelf.{ item: ^mut previous }
    let mut selected = Cell.{ count: 41 }
    relay(^mut selected, mut shelf)
    selected.count += 1
    shelf.item.count += 1
    assert(selected.count == 43 && previous.count == 1)
}

-- @case freezing_the_selected_entry_graph_preserves_unrelated_aliases run-pass backend=both no-prelude
type Cell = .{ var count: int }
type Branch = .{ mut owned: Cell, ^mut external: Cell }
type Holder = .{ var ^mut item: Cell }

fn freeze_cell(new input: Cell) -> Cell {
    let snapshot = new input
    snapshot
}

fn select(new root: Branch) -> Cell {
    let mut current = new root
    freeze_cell(new current.owned)
}

fn replace(new input: Holder) -> Holder {
    let mut held = new input
    held.item = ^mut Cell.{ count: 14 }
    let snapshot = new held
    snapshot
}

fn freeze(new input: Holder) -> Holder {
    let snapshot = new input
    snapshot
}

fn relay(new input: Holder) -> Holder {
    freeze(new input)
}

fn main() -> () {
    let mut live = Cell.{ count: 12 }
    let mut branch = Branch.{ owned: Cell.{ count: 23 }, external: ^mut live }
    branch.owned.count += 1
    let selected = select(new branch)
    let mut holder = Holder.{ item: ^mut live }
    holder.item.count += 1
    let replaced = replace(new holder)
    let fresh = relay(new Holder.{ item: ^mut Cell.{ count: 36 } })
    live.count += 2
    assert(selected.count == 24 && replaced.item.count == 14 && fresh.item.count == 36 && live.count == 15)
}

-- @case recursively_wrapping_a_complete_new_graph_preserves_snapshot_reception run-pass backend=both no-prelude
type Cell = .{ var count: int }
type Node(.{ ^mut value: Cell, mut next: ?Node })
fn freeze(new source: Node) -> int { let snapshot = new source; snapshot.value.count }
fn visit(action: fn(new Node) -> int, new input: Node, depth: int) -> int {
    if depth == 0 { action(new input) }
    else {
        let outer = Cell.{ count: 5 }
        visit(action, new Node::(.{ value: ^mut Cell.{ count: outer.count }, next: Some(new input) }), depth - 1)
    }
}
fn main() -> () {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let observed = visit(freeze, new Node::(.{ value: ^mut Cell.{ count: 2 }, next: None }), 1)
    live.count += 8
    assert(observed == 5)
}

-- @case returned_snapshot_callbacks_call_their_runtime_targets run-pass backend=both no-prelude
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count }
fn keep(action: Action) -> Action { action }
fn make() -> Action { keep(freeze) }
fn select(make_action: fn() -> Action, new shelf: Shelf) -> int {
    let action = make_action()
    action(new shelf)
}
fn main() -> () {
    let actions = .{ table: [make] }
    assert(select(actions.table[0], new Shelf.{ item: ^mut Cell.{ count: 42 } }) == 42)
}

-- @case unified_nominal_parenthesized_syntax_and_destructuring run-pass backend=both
type Marker
type UserId(int)
type Point(int, int)
type User(.{ id: int, name: str = "anon" })
type AliasRec = .{ tag: str, count: int }
opaque type Token(.{ code: int })
fn drop_token(new _t: Token) -> () {}
fn main() -> () {
    let u1 = User::(.{ id: 1 })
    let raw = .{ id: 2, name: "ada" }
    let u2 = User::(raw)
    let mapped = [.{ id: 3, name: "bob" }, .{ id: 4, name: "cat" }] |> Array::map(\r -> User::(r))
    let User::(.{ id: id1, name: name1 }) = u1
    let User::(.{ id: id2, name: name2 }) = u2
    let p1 = Point::(3, 4)
    let p2 = Point::((3, 4))
    let Point::(px, py) = p1
    let uid = UserId::(7)
    let UserId::(raw_id) = uid
    let alias = AliasRec.{ tag: "ok", count: 5 }
    let .{ tag, count } = alias
    let mut tok = Token::(.{ code: 9 })
    defer drop_token(new tok)
    let matched = match u2 {
        User::(.{ id: 2, name }) -> name
        _ -> ""
    }
    assert(inner(Marker) == () && id1 == 1 && name1 == "anon" && id2 == 2 && name2 == "ada")
    assert(mapped[0].id == 3 && mapped[1].name == "cat")
    assert(p1 == p2 && px == 3 && py == 4 && raw_id == 7)
    assert(tag == "ok" && count == 5 && tok.code == 9 && matched == "ada")
}

-- @case meta_if_and_else_meta_if_skip_untaken_branches run-pass backend=both
meta let MODE = 2
fn pick() -> int {
    meta if MODE == 1 {
        "wrong_type_skipped" + 1
    } else meta if MODE == 2 {
        42
    } else {
        1 + "also_skipped"
    }
}
fn main() -> () {
    assert(pick() == 42)
}

-- @case zero_cost_nominal_opaque_and_qualified_variants_runtime run-pass backend=both
type UserId(int)
type Point(int, int)
type Bag([]int)
opaque type Weight(int)
type Shape { Circle(int); Square(int) }
fn next_id(id: UserId) -> UserId { UserId::(inner(id) + 1) }
fn weight_a() -> Weight { 1 }
fn weight_b() -> Weight { Weight::(1) }
fn main() -> () {
    let id = next_id(UserId::(41))
    let UserId::(n) = id
    assert(n == 42 && String::inspect(id) == "42")

    let a = weight_a()
    let b = weight_b()
    let Weight::(wn) = a
    assert(a == b && b + 1 == 2 && inner(a) == 1 && wn == 1)

    let p = Point::(1, 2)
    assert(inner(p) == (1, 2))
    let p_updated = derive(p) \mut d -> { inner(mut d).0 = 9 }
    assert(inner(p_updated) == (9, 2))
    let mut bag = Bag::([1])
    Array::push(mut inner(mut bag), 3)
    assert(inner(ref bag) == [1, 3])

    let opt = 42 |> Some
    let circ = 5 |> Shape::Circle
    assert(opt == Some(42) && circ == Shape::Circle(5))

    use Shape::Circle as C
    let c2 = 7 |> C
    let r = match c2 {
        C(radius) -> radius
        Shape::Square(w) -> w
    }
    assert(r == 7 && c2 == Shape::Circle(7))

    let s = Set::from_array([3, 1, 3])
    assert(len(s) == 2 && Set::contains(s, 3))
}
