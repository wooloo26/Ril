type Read = fn() -> int
fn count() -> int { 42 }
fn main() -> () {
    let captured = Counter.{ count: count() }
    let holder = .{ item: captured, read: \-> captured.count }
    let mut copied: .{ mut item: Counter, read: Read } = clone(holder)
    copied.item.count += 1
    assert(copied.item.count == 43)
    assert(copied.read() == 42 && holder.read() == 42 && holder.item.count == 42)
}

