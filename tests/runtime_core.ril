-- @case signature_checks_entry_and_successful_exit run-pass backend=both
-- @expect-stdout 5
type Span = .{ low: int, high: int }
type Problem { OutOfOrder; Empty }

fn create(low |> ordered(high), high: int) -> new !<Span, Problem> |> non_empty
where
    fn ordered(low: int, high: int) -> new !<(), Problem> {
        if low <= high { Ok() } else { Err(Problem::OutOfOrder) }
    }
    fn non_empty(x: Span) -> new !<(), Problem> {
        if x.low < x.high { Ok() } else { Err(Problem::Empty) }
    }
{
    Ok(Span.{ low, high })
}

fn main() @io -> () {
    assert(create(2, 1) == Err(Problem::OutOfOrder))
    assert(create(3, 3) == Err(Problem::Empty))
    match create(2, 5) { Ok(value) -> println("{value.high}"); Err(_) -> panic("entry unexpectedly failed") }
}

