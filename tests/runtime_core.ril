-- @suite runtime_core
-- @default_stage run

-- @case appended_callbacks_keep_their_positions_in_arrays_and_drafts run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn main() -> () {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let mut actions = [count]
    Array::push(mut actions, freeze)
    assert(actions[0](new Shelf.{ item: ^mut live }) == 2)
    assert(actions[1](new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    let base = new actions
    let next = derive(base) \mut draft -> { Array::push(mut draft, count) }
    assert(len(base) == 2 && len(next) == 3)
    assert(next[2](new Shelf.{ item: ^mut Cell.{ count: 4 } }) == 4)
    live.count += 8
    assert(live.count == 10)
}

-- @case slice_and_rest_index_the_selected_callable run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let actions = [freeze, count, freeze]
    let section = actions[1..2]
    let [_, ..middle, _] = actions else { panic("missing middle") }
    assert(section[0](new Shelf.{ item: ^mut live }) == 42)
    assert(middle[0](new Shelf.{ item: ^mut live }) == 42)
    match actions?[1..=1] {
        Some(selected) -> assert(selected[0](new Shelf.{ item: ^mut live }) == 42)
        None -> panic("missing section")
    }
    live.count += 1
    assert(live.count == 43)
}

-- @case closure_appends_to_the_current_captured_array_and_reads_the_current_callable run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    var mut actions = [freeze]
    var action = freeze
    let ^mut append = \-> Array::push(mut actions, action)
    actions = [count, freeze]
    action = count
    append()
    assert(len(ref actions) == 3)
    assert(actions[0](new Shelf.{ item: ^mut live }) == 42)
    assert(actions[2](new Shelf.{ item: ^mut live }) == 42)
    live.count += 1
    assert(live.count == 43)
}

-- @case returned_closures_share_the_same_captured_slot run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Slot = .{ var action: Action }
type Writer = fn() &up -> ()
type Controls = .{ ^mut select: Writer, ^mut store: Writer }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn controls(^mut slot: Slot, initial: Action) &capture &^mut &return(^mut slot, initial) -> new Controls {
    var action: Action = count
    action = initial
    Controls.{ select: \-> { action = count }, store: \-> { slot.action = action } }
}
fn main() -> () {
    let mut slot = Slot.{ action: freeze }
    let mut writer = controls(^mut slot, freeze)
    writer.select()
    writer.store()
    let mut live = Cell.{ count: 41 }
    live.count += 1
    assert(slot.action(new Shelf.{ item: ^mut live }) == 42)
    live.count += 1
    assert(live.count == 43)
}

-- @case a_direct_store_overwrites_the_previous_callback_store run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Slot = .{ var action: Action }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn install(mut slot: Slot) &mut -> () { slot.action = freeze }
fn reset(mut slot: Slot, write: fn(mut Slot) &mut -> ()) &mut -> () {
    write(mut slot)
    slot.action = count
}
fn main() -> () {
    let mut slot = Slot.{ action: count }
    reset(mut slot, install)
    let mut live = Cell.{ count: 41 }
    live.count += 1
    assert(slot.action(new Shelf.{ item: ^mut live }) == 42)
    live.count += 1
    assert(live.count == 43)
}

-- @case callback_reads_capture_the_value_at_the_read run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Slot = .{ var action: Action }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn install(mut slot: Slot) &mut -> () { slot.action = freeze }
fn clear(mut slot: Slot) &mut -> () { slot.action = count }
fn read_before(mut slot: Slot, write: fn(mut Slot) &mut -> ()) &mut -> Action {
    let saved = slot.action
    write(mut slot)
    saved
}
fn read_between(mut slot: Slot, write: fn(mut Slot) &mut -> ()) &mut -> Action {
    write(mut slot)
    let saved = slot.action
    slot.action = count
    saved
}
fn invoke_after(mut slot: Slot, write: fn(mut Slot) &mut -> (), new shelf: Shelf) &mut -> int {
    write(mut slot)
    slot.action(new shelf)
}
fn main() -> () {
    let mut slot = Slot.{ action: count }
    let before = read_before(mut slot, install)
    let mut live = Cell.{ count: 41 }
    live.count += 1
    assert(before(new Shelf.{ item: ^mut live }) == 42)
    let during = read_between(mut slot, install)
    assert(during(new Shelf.{ item: ^mut Cell.{ count: 2 } }) == 102)
    assert(invoke_after(mut slot, install, new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    assert(invoke_after(mut slot, clear, new Shelf.{ item: ^mut live }) == 42)
}

-- @case callback_writes_follow_the_object_selected_at_each_read run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Slot = .{ var action: fn(new Shelf) -> int }
type Holder = .{ var ^mut slot: Slot }
type Swap = fn(mut Holder) &mut -> ()
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn swap(mut holder: Holder) &mut -> () { holder.slot = Slot.{ action: count } }
fn write_after(mut holder: Holder, replace: Swap) &mut -> () {
    replace(mut holder)
    holder.slot.action = freeze
}
fn write_saved(mut holder: Holder, replace: Swap) &mut -> () {
    let ^mut saved = holder.slot
    replace(mut holder)
    saved.action = freeze
}
fn write_between(mut holder: Holder, replace: Swap) &mut -> () {
    replace(mut holder)
    let ^mut saved = holder.slot
    replace(mut holder)
    saved.action = freeze
}
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let mut original = Slot.{ action: count }
    let mut holder = Holder.{ slot: ^mut original }
    write_after(mut holder, swap)
    assert(original.action(new Shelf.{ item: ^mut live }) == 42)
    assert(holder.slot.action(new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    holder.slot = ^mut original
    write_saved(mut holder, swap)
    assert(original.action(new Shelf.{ item: ^mut Cell.{ count: 4 } }) == 104)
    assert(holder.slot.action(new Shelf.{ item: ^mut live }) == 42)
    write_between(mut holder, swap)
    assert(holder.slot.action(new Shelf.{ item: ^mut live }) == 42)
}

-- @case forwarded_drafts_sample_the_committed_graph run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Update = fn(mut Derived<[]Action>) &mut -> ()
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn append_count(mut draft: Derived<[]Action>) &mut -> () { Array::push(mut draft, count) }
fn append_freeze(mut draft: Derived<[]Action>) &mut -> () { Array::push(mut draft, freeze) }
fn forward(base: []Action, edit: Update) -> []Action { derive(base, edit) }
fn inspect(base: []Action, edit: Update, new input: Shelf) -> int {
    forward(base, edit)[1](new input)
}
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let base = [count]
    let first = forward(base, append_count)
    let second = forward(first, append_freeze)
    assert(len(base) == 1 && len(first) == 2 && len(second) == 3)
    assert(second[0](new Shelf.{ item: ^mut live }) == 42)
    assert(second[1](new Shelf.{ item: ^mut live }) == 42)
    assert(second[2](new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    assert(inspect(base, append_count, new Shelf.{ item: ^mut live }) == 42)
}

-- @case derive_updates_captured_fields_and_bindings run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Slot = .{ var action: Action }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let mut slot = Slot.{ action: freeze }
    var action: Action = freeze
    let saved = slot.action
    let base = [1]
    let next = derive(base) \mut draft -> {
        Array::push(mut draft, 2)
        slot.action = count
        action = count
    }
    assert(base == [1] && next == [1, 2])
    assert(saved(new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    assert(slot.action(new Shelf.{ item: ^mut live }) == 42)
    assert(action(new Shelf.{ item: ^mut live }) == 42)
}

-- @case draft_appends_follow_the_current_path_and_preserve_other_occurrences run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Pair = .{ left: []Action, right: []Action }
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let shared = [count]
    let seed = [count, count]
    let base = Pair.{ left: shared, right: shared }
    let first = derive(base) \mut draft -> {
        Array::push(mut draft.left, freeze)
        draft.left = seed
        Array::push(mut draft.left, count)
        Array::push(mut draft.left, freeze)
    }
    let second = derive(first) \mut draft -> { Array::push(mut draft.left, count) }
    assert(len(base.left) == 1 && len(base.right) == 1 && len(seed) == 2)
    assert(len(first.left) == 4 && len(second.left) == 5 && len(second.right) == 1)
    assert(second.right[0](new Shelf.{ item: ^mut live }) == 42)
    assert(second.left[1](new Shelf.{ item: ^mut live }) == 42)
    assert(second.left[2](new Shelf.{ item: ^mut live }) == 42)
    assert(second.left[3](new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    assert(second.left[4](new Shelf.{ item: ^mut live }) == 42)
}

-- @case calls_and_captured_writers_keep_append_order run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn extend(mut items: []Action) &mut -> () {
    for 0..2 as _ { Array::push(mut items, count) }
    Array::push(mut items, freeze)
}
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let mut direct = [count]
    extend(mut direct)
    assert(len(ref direct) == 4)
    assert(direct[1](new Shelf.{ item: ^mut live }) == 42)
    assert(direct[2](new Shelf.{ item: ^mut live }) == 42)
    assert(direct[3](new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    var mut captured = [freeze]
    let ^mut append = \-> { Array::push(mut captured, count); Array::push(mut captured, freeze) }
    captured = [count, count]
    append()
    assert(len(ref captured) == 4)
    assert(captured[2](new Shelf.{ item: ^mut live }) == 42)
    assert(captured[3](new Shelf.{ item: ^mut Cell.{ count: 4 } }) == 104)
}

-- @case consecutive_appends_follow_the_length_of_the_replacement_array run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ ^mut item: Cell }
type Action = fn(new Shelf) -> int
type Batch = .{ var ^mut items: []Action }
type Replace = fn(mut Batch) &mut -> ()
fn count(new shelf: Shelf) -> int { shelf.item.count }
fn freeze(new shelf: Shelf) -> int { let fixed = new shelf; fixed.item.count + 100 }
fn one() -> new []Action { [count] }
fn replace_one(mut batch: Batch) &mut -> () { batch.items = one() }
fn replace_two(mut batch: Batch) &mut -> () { batch.items = [count, count] }
fn append_twice(mut batch: Batch, replace: Replace) &mut -> () {
    replace(mut batch)
    Array::push(mut batch.items, count)
    Array::push(mut batch.items, freeze)
}
fn main() -> () {
    let mut live = Cell.{ count: 41 }
    live.count += 1
    let mut batch = Batch.{ items: [freeze, freeze, freeze] }
    append_twice(mut batch, replace_one)
    assert(len(ref batch.items) == 3)
    assert(batch.items[0](new Shelf.{ item: ^mut live }) == 42)
    assert(batch.items[1](new Shelf.{ item: ^mut live }) == 42)
    assert(batch.items[2](new Shelf.{ item: ^mut Cell.{ count: 3 } }) == 103)
    append_twice(mut batch, replace_two)
    assert(len(ref batch.items) == 4)
    assert(batch.items[2](new Shelf.{ item: ^mut live }) == 42)
    assert(batch.items[3](new Shelf.{ item: ^mut Cell.{ count: 4 } }) == 104)
}

-- @case aliased_shared_formals_preserve_identity_through_a_nested_mut_call run-pass backend=both
type Cell = .{ var count: int }
type Pair = .{ ^mut left: Cell, ^mut right: Cell }
fn edit(mut cell: Cell) &mut -> () { cell.count += 1 }
fn retain(^mut left: Cell, ^mut right: Cell) &mut &^mut &return(^mut left, ^mut right) -> new Pair {
    edit(mut left)
    Pair.{ left: ^mut left, right: ^mut right }
}
fn main() -> () {
    let mut cell = Cell.{ count: 40 }
    let mut pair = retain(^mut cell, ^mut cell)
    pair.right.count += 1
    assert(pair.left.count == 42 && cell.count == 42)
}

-- @case exhausting_a_variable_batch_inspects_every_result run-pass backend=both
fn batch(flag: bool) -> new []!<int, str> {
    if flag { [Ok(2), Err("skip"), Ok(3)] } else { [] }
}
fn total(flag: bool) -> int {
    var sum = 0
    for batch(flag) as item {
        match item { Ok(n) -> { sum += n }; Err(_) -> continue }
    }
    sum
}
fn main() -> () {
    assert(total(true) == 5 && total(false) == 0)
}

-- @case nominal_inner_preserves_record_payloads run-pass backend=both
type Packet<T>(.{ payload: T })
type Parcel<T>(T)
fn get() -> new !<int, str> { Ok(42) }
fn packet() -> new Packet<!<int, str>> { Packet::(.{ payload: get() }) }
fn parcel() -> new Parcel<!<int, str>> { Parcel::(get()) }
fn main() -> () {
    assert(inner(packet()).payload == Ok(42))
    assert(inner(parcel()) == Ok(42))
}

-- @case loop_allocations_are_fresh_and_bindings_can_be_handed_off_each_iteration run-pass backend=both
type Cell = .{ var count: int }
fn copy(mut target: Cell, ref reader: Cell) &mut -> () { target.count = reader.count }
fn main() -> () {
    let mut initial = Cell.{ count: 0 }
    initial.count += 1
    var ^mut previous = initial
    for 0..4 as i {
        let mut fresh = Cell.{ count: i }
        let mut moved = new fresh
        copy(mut moved, ref previous)
        previous = ^mut moved
        previous.count += 1
    }
    assert(previous.count == 5 && initial.count == 1)
}

-- @case loops_can_grow_recursive_immutable_data run-pass backend=both
type Tree { Leaf(int); Fork(Tree, Tree) }
fn grow(count: int) -> Tree {
    var tree = Tree::Leaf(1)
    for 0..count as _ { tree = Tree::Fork(tree, tree) }
    tree
}
fn main() -> () {
    match grow(80) {
        Tree::Fork(left, right) -> assert(left == right)
        Tree::Leaf(_) -> panic("growth did not occur")
    }
}

-- @case loops_can_grow_shared_recursive_data run-pass backend=both
type Node(.{ var value: int, var ^mut next: ?Node })
fn copy(mut target: Node, ref reader: Node) &mut -> () { target.value = reader.value }
fn read(count: int) -> int {
    let mut tail = Node::(.{ value: 4, next: None })
    tail.value += 1
    let mut initial = Node::(.{ value: 7, next: Some(^mut tail) })
    initial.value += 1
    var ^mut head = initial
    for 0..count as i {
        let mut node = Node::(.{ value: i, next: Some(^mut head) })
        node.value += 1
        head = ^mut node
    }
    head.value += 1
    let mut spare = Node::(.{ value: 0, next: None })
    match ref head.next {
        Some(first) -> match ref first.next {
            Some(second) -> copy(mut spare, ref second)
            None -> panic("missing second link")
        }
        None -> panic("missing first link")
    }
    spare.value
}
fn main() -> () { assert(read(80) == 78) }

-- @case callback_forwarded_chain_keeps_the_callers_tail run-pass backend=both
type Link(.{ var value: int, var ^mut next: ?Link })
fn build(^mut tail: Link, count: int) &mut &^mut &return(^mut tail) -> new Link {
    var ^mut head = tail
    for 0..count as i {
        let mut node = Link::(.{ value: i, next: Some(^mut head) })
        node.value += 1
        head = ^mut node
    }
    head.value += 1
    Link::(.{ value: 0, next: Some(^mut head) })
}
fn forward(via action: fn(via Link) @& -> infer Link, ^mut tail: Link, count: int) &mut &^mut -> infer Link {
    let mut chain = build(^mut tail, count)
    action(new chain)
}
fn identity(via chain: Link) -> infer Link { chain }
fn read(ref head: Link, depth: int) -> int {
    if depth == 0 { head.value } else {
        match ref head.next {
            Some(next) -> read(ref next, depth - 1)
            None -> panic("short chain")
        }
    }
}
fn main() -> () {
    let mut tail = Link::(.{ value: 41, next: None })
    let mut head = forward(identity, ^mut tail, 8)
    head.value += 1
    tail.value += 1
    assert(read(ref head, 9) == 42)
}

-- @case a_cyclic_graph_can_be_cloned_compared_and_inspected run-pass backend=both
type Node(.{ var value: int, var ^mut next: ?Node })
fn main() -> () {
    let mut first = Node::(.{ value: 20, next: None })
    let mut second = Node::(.{ value: 22, next: None })
    first.next = ^mut Some(^mut second)
    second.next = ^mut Some(^mut first)
    let snapshot = clone(ref first)
    let another = clone(ref first)
    assert(snapshot == another)
    assert(String::inspect(snapshot) == #".{ next: Some(.{ next: Some(...), value: 22 }), value: 20 }"#)
    first.value += 1
    let changed = clone(ref first)
    assert(snapshot != changed)
}

-- @case cloning_preserves_repeated_paths_to_one_object run-pass backend=both
type Cell = .{ var count: int }
type Pair = .{ ^mut first: Cell, ^mut second: Cell }
fn main() -> () {
    let mut state = Cell.{ count: 40 }
    state.count += 1
    let mut pair = Pair.{ first: ^mut state, second: ^mut state }
    pair.first.count += 1
    let mut copied = clone(ref pair)
    copied.first.count += 1
    assert(copied.second.count == 43)
    assert(state.count == 42)
}

-- @case via_record_schema_changes_the_selected_live_member run-pass backend=both
type Cell = .{ var count: int }
fn identity(via value: Cell) -> infer Cell { value }
fn select(ref holder: .{ via child: Cell }) -> infer Cell {
    let via child = identity(holder.child)
    child
}
fn change(mut holder: .{ via child: Cell }) &mut -> () { holder.child.count += 1 }
fn main() -> () {
    let mut holder = .{ mut child: Cell.{ count: 41 } }
    let ref selected = select(ref holder)
    change(mut holder)
    assert(selected.count == 42)
    assert(holder.child.count == 42)
}

-- @case local_callable_specializes_via_reference_and_new_qualified_results run-pass backend=both
type Cell = .{ var count: int }
fn main() -> () {
    let relay = \via cell: Cell -> { let via alias = cell; alias }
    let mut cell = Cell.{ count: 40 }
    let ref view = relay(ref cell)
    cell.count += 1
    assert(view.count == 41)
    let mut moved = relay(new cell)
    moved.count += 1
    assert(moved.count == 42)
}

-- @case higher_order_via_callbacks_accept_different_modes_at_each_call run-pass backend=both
type Cell = .{ var count: int }
fn apply(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { action(cell) }
fn relay(via action: fn(via Cell) @& -> int, via cell: Cell) -> int { apply(action, cell) }
fn change(via cell: Cell) -> int { cell.count += 1; cell.count }
fn read(via cell: Cell) -> int { cell.count }
fn main() -> () {
    let snapshot = Cell.{ count: 4 }
    assert(relay(read, snapshot) == 4)
    let mut live = Cell.{ count: 41 }
    assert(relay(change, mut live) == 42)
    assert(live.count == 42 && snapshot.count == 4)
}

-- @case higher_order_inferred_results_preserve_live_and_new_qualified_values run-pass backend=both
type Cell = .{ var count: int }
fn apply(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell { action(cell) }
fn relay(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell { apply(action, cell) }
fn make(via action: fn() @& -> infer Cell) -> infer Cell { action() }
fn main() -> () {
    let identity = \via value: Cell -> value
    let mut original = make(\-> Cell.{ count: 40 })
    let ref view = relay(identity, ref original)
    original.count += 1
    assert(view.count == 41)
    let mut owned = relay(identity, new original)
    owned.count += 1
    assert(owned.count == 42)
}

-- @case higher_order_callbacks_keep_the_returned_handoff_path_live run-pass backend=both
type Cell = .{ var count: int }
fn apply(via action: fn(via Cell) @& -> infer Cell, via cell: Cell) -> infer Cell {
    let via result = action(cell)
    assert(result.count == 41)
    result
}
fn bump(via cell: Cell) -> infer Cell { cell.count += 1; cell }
fn read(via cell: Cell) -> infer Cell { cell }
fn main() -> () {
    let mut original = Cell.{ count: 41 }
    let ref observer = apply(read, ref original)
    original.count += 1
    assert(observer.count == 42)
    let mut owned = apply(bump, Cell.{ count: 40 })
    owned.count += 1
    assert(owned.count == 42)
}

-- @case returned_storage_preserves_the_final_shared_member run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ var ^mut item: Cell }
fn make(^mut source: Cell) &^mut &return(^mut source) -> new Shelf {
    let mut shelf = Shelf.{ item: ^mut Cell.{ count: 0 } }
    shelf.item = ^mut source
    new shelf
}
fn main() -> () {
    let mut source = Cell.{ count: 40 }
    source.count += 1
    let mut shelf = make(^mut source)
    shelf.item.count += 1
    assert(source.count == 42)
}

-- @case callee_store_keeps_prepared_return_source_and_updates_the_caller run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ var ^mut item: Cell }
fn replace(mut shelf: Shelf, ^mut next: Cell) &mut &^mut -> ref(shelf) Cell {
    let ref previous = ref shelf.item
    shelf.item = ^mut next
    previous
}
fn main() -> () {
    let mut old = Cell.{ count: 0 }
    old.count += 1
    let mut next = Cell.{ count: 40 }
    next.count += 1
    let mut shelf = Shelf.{ item: ^mut old }
    let ref previous = replace(mut shelf, ^mut next)
    shelf.item.count += 1
    assert(previous.count == 1 && next.count == 42)
}

-- @case local_callee_rebinds_the_captured_slot_and_preserves_the_old_view run-pass backend=both
type Cell = .{ var count: int }
fn main() -> () {
    let mut old = Cell.{ count: 0 }
    old.count += 1
    let mut next = Cell.{ count: 41 }
    var ^mut saved = ^mut old
    saved.count += 1
    let ref previous = ref old
    publish(^mut next)
    saved.count += 1
    assert(previous.count == 2 && next.count == 42)
    where
        fn publish(^mut source: Cell) &up(var ^mut saved) &^mut -> () { saved = ^mut source }
}

-- @case recursive_store_preserves_the_call_entry_view run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ var ^mut item: Cell }
fn replace(mut shelf: Shelf, ^mut next: Cell, depth: int) &mut &^mut -> ref(shelf) Cell {
    if depth > 0 { replace(mut shelf, ^mut next, depth - 1) }
    else {
        let ref previous = ref shelf.item
        shelf.item = ^mut next
        previous
    }
}
fn main() -> () {
    let mut old = Cell.{ count: 0 }
    old.count += 1
    let mut next = Cell.{ count: 40 }
    next.count += 1
    let mut shelf = Shelf.{ item: ^mut old }
    let ref previous = replace(mut shelf, ^mut next, 3)
    shelf.item.count += 1
    assert(previous.count == 1 && next.count == 42)
}

-- @case local_closure_replaces_the_caller_member run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ var ^mut item: Cell }
fn main() -> () {
    let store = \mut dst: Shelf, ^mut value: Cell -> { dst.item = ^mut value }
    let mut old = Cell.{ count: 0 }
    old.count += 1
    let mut next = Cell.{ count: 40 }
    next.count += 1
    let mut shelf = Shelf.{ item: ^mut old }
    store(mut shelf, ^mut next)
    shelf.item.count += 1
    assert(old.count == 1 && next.count == 42)
}

-- @case named_callable_alias_keeps_the_entry_view_and_writes_the_caller_slot run-pass backend=both
type Cell = .{ var count: int }
type Shelf = .{ var ^mut item: Cell }
fn replace(mut shelf: Shelf, ^mut next: Cell) &mut &^mut -> ref(shelf) Cell {
    let ref previous = ref shelf.item
    shelf.item = ^mut next
    previous
}
fn main() -> () {
    let write = replace
    let mut old = Cell.{ count: 0 }
    old.count += 1
    let mut next = Cell.{ count: 40 }
    next.count += 1
    let mut shelf = Shelf.{ item: ^mut old }
    let ref previous = write(mut shelf, ^mut next)
    shelf.item.count += 1
    assert(previous.count == 1 && next.count == 42)
}

