-- @case generic_clone_copies_a_specialized_shared_object run-pass backend=both
type Counter = .{ count: int }
fn duplicate<T: Counter | []int>(value: T) -> new T { clone(value) }
fn count<T: Counter | int>(value: T) -> int {
    meta match <T> {
        <Counter> -> { let copied = clone(value); copied.count }
        _ -> value
    }
}
fn main() -> () {
