-- [case: byte-decoder-seeds, run-pass]
-- spec: STD#unicode-and-stringbuilder
use ril/unicode

pub fn test_byte_decoder_seeds() {
    for [b"", b"Ril", b"\x00", b"\xC0\xAF", b"\xED\xA0\x80", b"\xF4\x90\x80\x80"] as data {
        match Unicode::decode_utf8(data) {
            Ok(text) -> assert(String::utf8(text) == data),
            Err(error) -> assert(error.offset >= 0 && error.offset < len(data)),
        }
    }
}
