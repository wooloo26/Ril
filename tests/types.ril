-- @suite types
-- @default_stage type

-- @case structural_equality_and_aliases compile-pass
type A = .{ x: int, y: str }
type B = .{ y: str, x: int }
fn equal(a: A, b: B) -> bool { a == b }
fn build() -> new A { .{ y: "text", x: 1 } }

-- @case local_unification_and_generic_domains compile-pass
fn square<T: int | f64>(n: T) -> T { n * n }
fn run() -> () {
    assert(square(3) == 9)
    assert(square(2.0) == 4.0)
    let xs = [1, 2, 3]
    assert(xs[0] == 1)
}

-- @case float_arithmetic compile-pass
fn compare(x: f64) -> bool { 2.0 * x > 1.0 + x }

-- @case mismatched_arithmetic compile-fail E0301
let x = 3 + 2.0
-- ^ E0301

-- @case no_string_addition compile-fail E0327
let x = "a" + "b"
-- ^ E0327

-- @case unsupported_generic_operation compile-fail E0327
fn invalid<T>(n: T) -> T { n * n }
-- ^ E0327

-- @case literal_division_by_zero compile-fail E0361
fn invalid(x: int) -> int { x / 0 }
-- ^ E0361

-- @case literal_negative_shift compile-fail E0361
fn invalid(x: int) -> int { x >> -1 }
-- ^ E0361

-- @case infinite_literal compile-fail E0326
let x = 1.0e999999
-- ^ E0326

-- @case nominal_wrappers_are_distinct compile-fail E0305
type Left(int)
type Right(int)
fn invalid() -> Left { Right::(1) }
-- ^ E0305

-- @case opaque_converts_inside_scope compile-pass
opaque type Weight(int)
fn wrap(n: int) -> Weight { n }
fn unwrap(w: Weight) -> int { w }

-- @case opaque_member_outside_scope compile-fail E0308 unit=bin
-- @file pkg/main.ril
use pkg/vault
fn read(item: Vault::Token) -> int { item.code }
-- ^ E0308
-- @forbid E0301, E0336
fn main() -> () {}
-- @file pkg/vault.ril
pub opaque type Token(.{ code: int })

-- @case cyclic_transparent_aliases compile-fail E0313
type First = Second
type Second = First

-- @case numeric_key_rejects_f64 compile-fail E0328
type Invalid = [f64: str]
-- ^ E0328

-- @case field_diagnostic_precedence compile-fail E0336
fn bad(x: .{ known: int }) -> int { x.unknown }
-- ^ E0336
-- @forbid E0301

-- @case default_arguments compile-pass
fn add(a: int, b: int = a + 1) -> int { a + b }
let a = add(1)
let b = add(b: 1, a: 2)
let c = add(1, b: 2)

-- @case duplicate_argument compile-fail E0325
fn add(a: int, b: int = 1) -> int { a + b }
let a = add(1, a: 1)
-- ^ E0325

-- @case unknown_argument compile-fail E0339
fn add(a: int, b: int = 1) -> int { a + b }
let a = add(1, c: 1)
-- ^ E0339

-- @case expression_not_callable compile-fail E0338
let number = 2
let invalid = number()
-- ^ E0338
-- @forbid E0301

-- @case tuple_index compile-fail E0312
let number = (1, "s").2
-- ^ E0312

-- @case conditional_never_joins compile-pass
fn choose(x: bool) -> int { if x { return 1 } else { 2 } }
fn forever() -> never { while true {} }

-- @case locally_generalized_closure compile-pass
fn check() -> () {
    let identity = \item -> item
    let one: int = identity(1)
    let truth: bool = identity(true)
    assert(one == 1 && truth)
}

-- @case generic_domain_is_checked_at_application compile-fail E0306
fn number<T: int | f64>(x: T) -> T { x + x }
let wrong = number(true)
-- ^ E0306

-- @case sequential_and_nested_narrowing compile-pass
fn unwrap(value: ??int) -> int {
    if value == None { return 0 }
    if value == None { return 1 }
    value + 1
}

-- @case concrete_write_invalidates_narrowing compile-fail E0310
fn broken() -> int {
    var current: ?int = Some(1)
    if current == None { return 0 }
    current = None
    current + 1
    -- ^ E0310
}
-- @forbid E0301, E0327

-- @case open_state_call_invalidates_live_fact compile-fail E0533
type Box = .{ var item: ?int }
fn broken(mut box: Box, hook: fn() & -> ()) -> int {
    if box.item == None { return 0 }
    hook()
    box.item + 1
    -- ^ E0533
}

-- @case required_generic_after_default compile-fail E0316
type Invalid<T = int, U> = (T, U)
-- ^ E0316

-- @case forward_generic_default compile-fail E0320
type Invalid<T = U, U = int> = (T, U)
-- ^ E0320

-- @case function_generic_default compile-fail E0317
fn invalid<T = int>(x: T) -> T { x }
-- ^ E0317

-- @case structural_tail_has_no_duplicate_fields compile-fail E0212
type WithId<R: .{ .. }> = .{ id: int, ..R }
type Repeated = WithId<.{ id: int }>

-- @case structural_field_default_is_prohibited compile-fail E0359
type Structural = .{ field: int = 4 }
-- ^ E0359

-- @case field_default_cannot_read_later_field compile-fail E0408
type Backward(.{ first: int = last, last: int = 4 })
-- ^ E0408

-- @case defaults_are_pure compile-fail E0409
use ril/io
fn invalid(x: int = { Io::println("effect"); 1 }) -> int { x }
-- ^ E0409

-- @case defaults_cannot_read_later_parameter compile-fail E0408
fn invalid(x: int = y, y: int = 2) -> int { x + y }
-- ^ E0408

-- @case inferred_propagation_joins_error_sums compile-pass
type Basic { First }
type Extended { ..Basic; Second }
fn first() -> !<int, Basic> { Ok(2) }
fn second() -> !<int, Extended> { Ok(3) }
fn combine(condition: bool) -> !<int, Extended> {
    let sum = \-> {
        let a = if condition { first()? } else { 0 }
        let b = second()?
        Ok(a + b)
    }
    sum()
}

-- @case incomparable_propagation_sums compile-fail E0344
type Left { LeftError }
type Right { RightError }
fn first() -> !<int, Left> { Ok(2) }
fn second() -> !<int, Right> { Ok(3) }
fn combine() -> () {
    let sum = \-> {
    -- ^ E0344
        let a = first()?
        Ok(a + second()?)
    }
    let _ = sum
}
-- @forbid E0713

-- @case contextual_error_sum_handles_incomparable_sources compile-pass
type Left { LeftError }
type Right { RightError }
type Both { ..Left; ..Right }
fn first() -> !<int, Left> { Ok(2) }
fn second() -> !<int, Right> { Ok(3) }
fn combine() -> !<int, Both> {
    let sum: fn() -> !<int, Both> = \-> {
        let a = first()?
        Ok(a + second()?)
    }
    sum()
}

-- @case local_sum_can_be_used_in_hoisted_function compile-pass
fn total() -> int {
    use Tree::(Leaf, Pair)
    count(Pair(Leaf(3), Leaf(4)))
where
    type Tree { Leaf(int); Pair(Tree, Tree) }
    fn count(tree: Tree) -> int {
        match tree { Tree::Leaf(n) -> n; Tree::Pair(a, b) -> count(a) + count(b) }
    }
}

-- @case local_nominal_cannot_escape_callable_signature compile-fail E0315
fn escaped() -> Hidden
-- ^ E0315
where
    type Hidden(int)
{
    Hidden::(1)
}

-- @case local_nominal_cannot_escape_through_early_return compile-fail E0315
fn escaped() -> int {
    return Hidden::(1)
    -- ^ E0315
where
    type Hidden(int)
}

-- @case public_signature_can_desugar_a_local_alias compile-pass unit=lib
pub fn next(value: Counter) -> Counter
where
    type Counter = int
{
    value + 1
}

-- @case same_tags_without_spread_do_not_imply_inclusion compile-fail E0301
type Small { SharedTag }
type Large { SharedTag; DistinctTag }
fn widen(value: Small) -> Large { value as Large }

-- @case grouping_ends_optional_navigation compile-fail E0337
type Route = .{ pair: (str, int) }
fn port(route: ?Route) -> int { (route?.pair).1 }

-- @case unchecked_map_read_is_rejected compile-fail E0352
fn read(values: [str: int]) -> int { values["key"] }

-- @case map_compound_assignment_is_rejected compile-fail E0352
fn update(mut values: [str: int]) &mut -> () { values["key"] += 1 }

-- @case clone_rejects_a_callable_root compile-fail E0301
fn count() -> int { 42 }
fn copied() -> new fn() -> int {
    clone(count)
    -- ^ E0301
}

-- @case clone_rejects_ctl_through_nested_generic_payloads compile-fail E0301
type Box<T>(.{ mut item: T })
type Message { Empty; Full(Box<Box<ctl() -> ()>>) }
fn duplicate(ref value: Message) -> new Message {
    clone(ref value)
    -- ^ E0301
}

-- @case clone_rejects_a_graph_containing_a_draft compile-fail E0301
type Packet = .{ slot: Derived<[]int> }
fn duplicate(packet: Packet) -> new Packet {
    clone(packet)
    -- ^ E0301
}

-- @case clone_accepts_nested_ordinary_payloads compile-pass
type Box<T>(.{ item: T })
type Message { Empty; Full(Box<Box<int>>) }
fn duplicate(value: Message) -> new Message { clone(value) }

-- @case clone_requires_a_proven_root_in_an_unconstrained_generic compile-fail E0301
fn duplicate<T>(value: T) -> new T {
    clone(value)
    -- ^ E0301
}

-- @case clone_requires_proof_for_every_member_of_a_generic_domain compile-fail E0301
type Parcel<T>(.{ mut item: T })
fn duplicate<T: int | ctl() -> ()>(ref value: Parcel<T>) -> new Parcel<T> {
    clone(ref value)
    -- ^ E0301
}

-- @case clone_requires_a_proven_member_type_in_a_generic_graph compile-fail E0301
type Parcel<T>(.{ item: T })
fn duplicate<T>(value: Parcel<T>) -> new Parcel<T> {
    clone(value)
    -- ^ E0301
}

-- @case inferred_clone_cannot_generalize_an_unconstrained_operand compile-fail E0301
fn count() -> int { 42 }
fn invalid() -> () {
    let duplicate = \value -> {
        clone(value)
        -- ^ E0301
    }
    let _ = duplicate(count)
}

