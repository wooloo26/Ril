-- @case derive_rejects_live_shared_field_replacement compile-fail E0535
type Cell = .{ var count: int }
type Root = .{ ^mut item: Cell }
fn invalid() -> Root {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let base = Root.{ item: ^mut Cell.{ count: 3 } }
    derive(base) \mut draft -> {
        draft.item = ^mut live
        -- ^ E0535
    }
}

-- @case derive_rejects_live_shared_array_insertion compile-fail E0535
type Cell = .{ var count: int }
fn invalid() -> [^mut]Cell {
    let mut live = Cell.{ count: 1 }
    live.count += 1
    let base: [^mut]Cell = [^mut Cell.{ count: 3 }]
    derive(base) \mut draft -> {
        Array::push(mut draft, ^mut live)
        -- ^ E0535
    }
}

