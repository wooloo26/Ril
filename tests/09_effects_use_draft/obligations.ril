-- @suite obligations
-- @default_stage access

-- @case exact_io_asserted compile-pass
fn emit() @io -> () { println("message") }

-- @case a_named_function_cannot_declare_an_unused_effect compile-fail E0612
fn silent() @io -> () { () }
-- ^ E0612

-- @case missing_io compile-fail E0612
fn emit() -> () { println("message") }
-- ^ E0612

-- @case top_level_effect compile-fail E0202 unit=lib
let boot = println("message")
-- ^ E0202

-- @case handler_contains_effect compile-pass
eff Clock { fn now() -> int }
fn read() -> int {
    with Clock::now = \-> 42
    Clock::now()
}

-- @case handler_installation_charges_outward_effects compile-pass
eff Notify { fn log() -> () }
fn install() @io -> () {
    with Notify::log = \-> println("registered")
}

-- @case active_handler_cannot_lose_captured_authority compile-fail E0535
eff Grow { fn push() -> () }
fn blocked() -> () {
    let mut values = [1, 2]
    with Grow::push = \-> Array::push(mut values, 3)
    let snapshot = new values
    -- ^ E0535
}

-- @case effect_handler_must_not_write_collection_being_iterated compile-fail E0526
eff Grow { fn push() -> () }
fn forward() @Grow -> () { Grow::push() }
fn invalid() -> () {
    let mut values = [1, 2]
    with Grow::push = \-> Array::push(mut values, 3)
    for ref values as n {
        forward()
        -- ^ E0526
    }
}

-- @case effect_without_handler compile-fail E0612
eff Clock { fn now() -> int }
fn read() -> int { Clock::now() }
-- ^ E0612

-- @case duplicate_handler_operation compile-fail E0622
eff Clock { fn now() -> int }
fn read() -> int {
    with {
        Clock::now = \-> 2
        Clock::now = \-> 4
        -- ^ E0622
    }
    Clock::now()
}

-- @case resource_needs_cleanup compile-fail E0541
fn use_number() -> () { use number = 0 }
-- ^ E0541

-- @case synchronous_cleanup compile-pass
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) @io -> () { println("closed") }
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn scoped() @io -> int {
    use handle = acquire()
    handle.id
}

-- @case synchronous_cleanup_may_diverge compile-pass
opaque type Handle use(close) = .{ id: int }
fn close(new _resource: Handle) -> () { while true {} }
fn scoped() -> () {
    use handle = Handle.{ id: 1 }
}

-- @case a_cleanup_handler_write_requires_a_caller_state_clause compile-fail E0510
type Cell = .{ var count: int }
eff Finalize { fn record(id: int) -> () }
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) @Finalize -> () { Finalize::record(resource.id) }
fn scoped(mut target: Cell) -> () {
-- ^ E0510
    with Finalize::record = \id: int -> { target.count += id }
    use handle = Handle.{ id: 1 }
}

-- @case resource_does_not_escape compile-fail E0604
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) -> () {}
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn scoped() -> new Handle {
    use handle = acquire()
    new handle
    -- ^ E0604
}

-- @case cleanup_cannot_suspend compile-fail E0616
use ril/fiber
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) @fiber -> () { Fiber::yield() }
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn scoped() @fiber -> int {
    use handle = acquire()
    -- ^ E0616
    handle.id
}

-- @case one_handler_cannot_cover_a_different_operation compile-fail E0612
eff Clock { fn read() -> int; fn reset() -> () }
fn invalid() -> () {
    with Clock::read = \-> 1
    Clock::reset()
}

-- @case local_effect_must_be_handled_in_declaring_block compile-fail E0618
fn invalid() -> () {
    Notice::emit()
    -- ^ E0618
where
    eff Notice { fn emit() -> () }
}
-- @forbid E0612, E0204

-- @case handler_must_implement_operation_signature compile-fail E0534 stage=type
eff Convert { fn digit(input: int) -> int }
fn invalid() -> () {
    with Convert::digit = \input -> "wrong result"
    -- ^ E0534
}

-- @case named_calls_only_need_handlers_for_reachable_operations compile-pass
eff Log { fn open() -> (); fn close() -> () }
fn first(n: int) @Log -> () {
    if n == 0 { Log::open() } else { second(n - 1) }
}
fn second(n: int) @Log -> () { first(n) }
fn run() -> () {
    with Log::open = \-> ()
    second(0)
}

-- @case inspected_result_stays_inspected_at_loop_join compile-pass
fn value(ok: bool) -> new !<int, str> {
    if ok { Ok(1) } else { Err("failure") }
}
fn total(ok: bool) -> new !<int, str> {
    var total = 0
    for 0..3 as i {
        total += value(ok)?
    }
    Ok(total)
}

-- @case spread_effect_operation_identity_is_shared compile-fail E0622
eff Base { fn operation() -> int }
eff Larger { ..Base; fn extra() -> bool }
fn invalid() -> int {
    with {
        Base::operation = \-> 1
        Larger::operation = \-> 2
        -- ^ E0622
    }
    Larger::operation()
}

-- @case effect_spreads_cannot_cycle compile-fail E0313 stage=hir
eff Left { ..Right }
eff Right { ..Left }

-- @case spread_requires_an_effect compile-fail E0620 stage=hir
type Alias = int
eff Invalid { ..Alias }

-- @case spread_with_conflicting_operation compile-fail E0622 stage=hir
eff Base { fn operation() -> int }
eff Larger { ..Base; fn operation() -> bool }

-- @case spread_effect_subsumes_source_callable compile-pass
eff Base { fn operation() -> int }
eff Larger { ..Base; fn other() -> bool }
fn accept(handler: fn() @Larger -> int) @Larger -> int { handler() }
fn callback() @Base -> int { Base::operation() }
fn call() @Larger -> int { accept(callback) }

-- @case generic_effect_handler_applies_to_one_instance compile-fail E0612
eff State<T> { fn read() -> T }
fn bad() -> str {
    with State<int>::read = \-> 1
    State<str>::read()
}

-- @case generic_effect_specializes_handler_signature compile-fail E0534
eff State<T> { fn read() -> T }
fn bad() -> () {
    with State<str>::read = \-> 4
    -- ^ E0534
}

-- @case generic_effect_annotation_can_cover_monomorphic_callee compile-pass
eff State<T> { fn read() -> T }
fn read() @State<int> -> int { State<int>::read() }
fn run() -> int {
    with State<int>::read = \-> 4
    read()
}

-- @case incompatible_instances_cannot_share_a_spliced_operation compile-fail E0622
eff State<T> { fn read() -> T }
eff Both { ..State<int>; ..State<str> }
fn invalid() @Both -> int { Both::read() }

-- @case installed_handler_does_not_cover_its_own_arm compile-fail E0612
eff Clock { fn now() -> int }
fn read() -> int {
    with Clock::now = \-> Clock::now() + 1
    Clock::now()
}

-- @case outer_handler_covers_inner_arm compile-pass
eff Clock { fn now() -> int }
fn read() -> int {
    with Clock::now = \-> 41
    {
        with Clock::now = \-> Clock::now() + 1
        Clock::now()
    }
}

-- @case cleanup_uses_evidence_at_resource_binding compile-fail E0612
eff Notify { fn stop() -> () }
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) @Notify -> () { Notify::stop() }
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn read() -> int {
    use handle = acquire()
    with Notify::stop = \-> ()
    handle.id
}

-- @case derive_cannot_open_a_sealed_root compile-fail E0308
-- @file pkg/secret.ril
pub opaque type Secret = .{ value: int }
pub let hidden: Secret = Secret.{ value: 42 }
-- @file pkg/main.ril
use pkg/secret
fn update() -> Secret::Secret {
    derive(Secret::hidden) \mut _ -> ()
    -- ^ E0308
}

-- @case derive_rejects_an_opaque_value_representation compile-fail E0536
opaque type Scalar = int
fn update(value: Scalar) -> Scalar {
    derive(value) \mut _ -> ()
    -- ^ E0536
}

-- @case derive_rejects_unit_as_a_root compile-fail E0536
fn update() -> () {
    derive(()) \mut _ -> ()
    -- ^ E0536
}

-- @case derive_rejects_a_live_via_argument_after_forwarding compile-fail E0520
type Cell = .{ var count: int }
fn update(via base: Cell) -> Cell {
    derive(base) \mut draft -> { draft.count += 1 }
}
fn relay(via base: Cell) -> Cell { update(base) }
fn read() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    relay(ref cell).count
    -- ^ E0520
}

-- @case derive_rejects_joint_live_root_and_member_modes compile-fail E0520
type Cell = .{ count: int }
fn update(via box: .{ via item: Cell, var stamp: int }) -> Cell {
    derive(box.item) \mut draft -> { draft.count += 1 }
}
fn read() -> int {
    let mut writer = .{ mut item: Cell.{ count: 1 }, var stamp: 0 }
    writer.stamp += 1
    update(mut writer).count
    -- ^ E0520
}

-- @case derive_rejects_a_via_parameter_required_to_write compile-fail E0536
type Cell = .{ var count: int }
fn update(via base: Cell) -> Cell {
    base.count += 1
    derive(base) \mut draft -> { draft.count += 1 }
    -- ^ E0536
}

-- @case derive_requires_a_plain_input_to_a_forwarded_callback compile-fail E0520
type Cell = .{ var count: int }
fn update(via base: Cell) -> Cell {
    let apply = \ -> derive(base) \mut draft -> { draft.count += 1 }
    apply()
}
fn forward(action: fn(via Cell) -> Cell, via base: Cell) -> Cell { action(base) }
fn read() -> int {
    let mut cell = Cell.{ count: 1 }
    cell.count += 1
    forward(update, ref cell).count
    -- ^ E0520
}

