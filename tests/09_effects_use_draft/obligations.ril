-- @suite obligations
-- @default_stage access

-- @case exact_io_asserted compile-pass
fn emit() @io -> () { println("message") }

-- @case missing_io compile-fail E0612
fn emit() -> () { println("message") }
-- ^ E0612

-- @case top_level_effect compile-fail E0202 unit=lib
let boot = println("message")
-- ^ E0202

-- @case handler_contains_effect compile-pass
eff Clock { fn now() -> int }
fn read() -> int {
    with Clock::now = \-> 42
    Clock::now()
}

-- @case effect_without_handler compile-fail E0612
eff Clock { fn now() -> int }
fn read() -> int { Clock::now() }
-- ^ E0612

-- @case duplicate_handler_operation compile-fail E0622
eff Clock { fn now() -> int }
fn read() -> int {
    with {
        Clock::now = \-> 2
        Clock::now = \-> 4
        -- ^ E0622
    }
    Clock::now()
}

-- @case resource_needs_cleanup compile-fail E0541
fn use_number() -> () { use number = 0 }
-- ^ E0541

-- @case synchronous_cleanup compile-pass
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) @io -> () { println("closed") }
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn scoped() @io -> int {
    use handle = acquire()
    handle.id
}

-- @case resource_does_not_escape compile-fail E0604
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) -> () {}
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn scoped() -> new Handle {
    use handle = acquire()
    new handle
    -- ^ E0604
}

-- @case cleanup_cannot_suspend compile-fail E0616
use ril/fiber
opaque type Handle use(close) = .{ id: int }
fn close(new resource: Handle) @fiber -> () { Fiber::yield() }
fn acquire() -> new Handle { Handle.{ id: 42 } }
fn scoped() @fiber -> int {
    use handle = acquire()
    -- ^ E0616
    handle.id
}

-- @case one_handler_cannot_cover_a_different_operation compile-fail E0612
eff Clock { fn read() -> int; fn reset() -> () }
fn invalid() -> () {
    with Clock::read = \-> 1
    Clock::reset()
}

-- @case local_effect_must_be_handled_in_declaring_block compile-fail E0618
fn invalid() -> () {
    Notice::emit()
    -- ^ E0618
where
    eff Notice { fn emit() -> () }
}
-- @forbid E0612, E0204

-- @case handler_must_implement_operation_signature compile-fail E0534 stage=type
eff Convert { fn digit(input: int) -> int }
fn invalid() -> () {
    with Convert::digit = \input -> "wrong result"
    -- ^ E0534
}

-- @case named_calls_only_need_handlers_for_reachable_operations compile-pass
eff Log { fn open() -> (); fn close() -> () }
fn first(n: int) @Log -> () {
    if n == 0 { Log::open() } else { second(n - 1) }
}
fn second(n: int) @Log -> () { first(n) }
fn run() -> () {
    with Log::open = \-> ()
    second(0)
}

-- @case inspected_result_stays_inspected_at_loop_join compile-pass
fn value(ok: bool) -> new !<int, str> {
    if ok { Ok(1) } else { Err("failure") }
}
fn total(ok: bool) -> new !<int, str> {
    var total = 0
    for 0..3 as i {
        total += value(ok)?
    }
    Ok(total)
}

-- @case spread_effect_operation_identity_is_shared compile-fail E0622
eff Base { fn operation() -> int }
eff Larger { ..Base; fn extra() -> bool }
fn invalid() -> int {
    with {
        Base::operation = \-> 1
        Larger::operation = \-> 2
        -- ^ E0622
    }
    Larger::operation()
}

-- @case effect_spreads_cannot_cycle compile-fail E0313 stage=hir
eff Left { ..Right }
eff Right { ..Left }

-- @case spread_requires_an_effect compile-fail E0620 stage=hir
type Alias = int
eff Invalid { ..Alias }

-- @case spread_with_conflicting_operation compile-fail E0622 stage=hir
eff Base { fn operation() -> int }
eff Larger { ..Base; fn operation() -> bool }

-- @case spread_effect_subsumes_source_callable compile-pass
eff Base { fn operation() -> int }
eff Larger { ..Base; fn other() -> bool }
fn accept(handler: fn() @Larger -> int) @Larger -> int { handler() }
fn callback() @Base -> int { Base::operation() }
fn call() @Larger -> int { accept(callback) }
