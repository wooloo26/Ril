fn update() -> []int {
    let base = [1]
    derive(base) \mut draft -> {
        Array::push(mut draft, "text")
        -- ^ E0301
    }
}

-- @case scoped_resource_can_be_observed_and_mutated_by_helpers compile-pass
opaque type Handle use(close) = .{ var id: int }
fn close(new _handle: Handle) -> () {}
fn observe(ref handle: Handle) -> int { handle.id }
fn update(mut handle: Handle) &mut -> () { handle.id += 1 }
fn work() -> int {
    use mut handle = Handle.{ id: 41 }
    update(mut handle)
    observe(ref handle)
}

