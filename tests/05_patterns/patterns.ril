-- @suite patterns
-- @default_stage type

-- @case alternative_patterns_require_consistent_binding_types compile-fail E0301
type Value { Number(int); Text(str) }
fn bad(input: Value) -> () {
    match input { Number(item) | Text(item) -> () }
    -- ^ E0301
}

-- @case string_slice_fragment_cannot_be_empty compile-fail E0349
fn f(value: str) -> bool { match value { str["", ..] -> true; _ -> false } }
-- ^ E0349

-- @case array_slice_cannot_have_multiple_rests compile-fail E0349
fn f(value: []int) -> bool { match value { [..left, ..right] -> true; _ -> false } }
-- ^ E0349

-- @case extensible_sum_closes_inside_package compile-pass unit=lib
-- @file pkg/main.ril
use pkg/domain::Color
fn color(value: Color) -> int { match value { Color::Amber -> 0; Color::Green -> 1 } }
-- @file pkg/domain.ril
pub type Color { Amber; Green; .. }

-- @case extensible_sum_redundant_wildcard_inside_package compile-fail E0304 unit=lib
-- @file pkg/main.ril
use pkg/domain::Color
fn color(value: Color) -> int {
    match value {
        Color::Amber -> 0
        Color::Green -> 1
        _ -> 2
        -- ^ E0304
    }
}
-- @file pkg/domain.ril
pub type Color { Amber; Green; .. }

-- @case extensible_sum_needs_wildcard_across_packages compile-fail E0303 unit=lib
-- @file pkg/main.ril
use dep/domain::Color
fn color(value: Color) -> int { match value { Color::Amber -> 0; Color::Green -> 1 } }
-- ^ E0303
-- @file dep/domain.ril
pub type Color { Amber; Green; .. }

-- @case extensible_sum_wildcard_covers_other_packages compile-pass unit=lib
-- @file pkg/main.ril
use dep/domain::Color
fn color(value: Color) -> int {
    match value { Color::Amber -> 0; Color::Green -> 1; _ -> 2 }
}
-- @file dep/domain.d.ril
pub type Color { Amber; Green; .. }

-- @case option_pattern compile-pass
fn describe(value: ?str) -> str {
    match value {
        Some(text) -> text
        None -> ""
    }
}

-- @case distinct_sum_variants compile-pass
type Message { Number(int); Reset }
fn value(message: Message) -> int {
    match message {
        Number(n) -> n
        Reset -> 0
    }
}

-- @case boolean_coverage compile-fail E0303
fn decode(flag: bool) -> int { match flag { true -> 1 } }
-- ^ E0303

-- @case unreachable_after_wildcard compile-fail E0304
fn decode(flag: bool) -> int {
    match flag {
        _ -> 0
        false -> 1
        -- ^ E0304
    }
}

-- @case guarded_arm_does_not_cover compile-fail E0303
fn description(x: ?int) -> int {
    match x {
        Some(value) if value > 0 -> value
        None -> 0
    }
}

-- @case tuple_destructures compile-pass
fn total(x: (int, int)) -> int { let (a, b) = x; a + b }

-- @case alternatives_bind_same_names compile-fail E0346
fn read(val: (bool, int)) -> int {
    match val {
        (true, a) | (false, b) -> 1
        -- ^ E0346
        _ -> 0
    }
}

-- @case invalid_range compile-fail E0348
fn hit(n: int) -> bool {
    match n { 4 .. 3 -> true; _ -> false }
    -- ^ E0348
}

-- @case let_else_must_exit compile-fail E0321
fn receive(n: ?int) -> int { let Some(x) = n else {}; x }
-- ^ E0321

-- @case generic_type_facts compile-pass
fn describe<T>(x: T) -> str {
    match <T> {
        <int> -> "int:{x}"
        _ -> String::inspect(x)
    }
}

-- @case nested_constructor_product_coverage compile-pass
fn decode(x: ?(bool, bool)) -> int {
    match x {
        Some((true, _)) -> 1
        Some((false, true)) -> 2
        Some((false, false)) -> 3
        None -> 0
    }
}

-- @case nested_arm_already_covered compile-fail E0304
fn decode(x: ?bool) -> int {
    match x {
        Some(_) -> 1
        Some(true) -> 2
        -- ^ E0304
        None -> 0
    }
}

-- @case refutable_binding_requires_else compile-fail E0345
fn get(val: ?int) -> int {
    let Some(n) = val
    -- ^ E0345
    n
}

-- @case included_sum_patterns_cover_all_variants compile-pass
type Network { Offline; Timeout(int) }
type Account { Invalid }
type Failure { ..Network; ..Account; Other }
fn status(value: Failure) -> int {
    match value {
        Network as net -> match net { Offline -> 1; Timeout(status) -> status }
        ..Account -> 2
        Other -> 3
    }
}

-- @case sum_spread_rejects_conflicting_payload compile-fail E0213
type Before { Read }
type After { ..Before; Read() }
-- ^ E0213

-- @case sum_spread_resolves_without_recursive_expansion compile-fail E0313
type First { ..Second }
type Second { ..First }
