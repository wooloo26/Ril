--@ case: accept-conflicting-spreads
--@ mode: check-pass
--@ spec: SPEC#record-construction-and-functional-update
--@ companion: reject-conflicting-spreads
--@ file: accept-conflicting-spreads.ril
fn example(left: { id: int }, right: { id: int }) {
    let value = .{ ..left, ..right, id: 3 }
}
--@ end-file
--@ end-case

--@ case: reject-conflicting-spreads
--@ mode: check-fail
--@ spec: SPEC#record-construction-and-functional-update
--@ companion: accept-conflicting-spreads
-- Error [E0211]: reject conflicting spreads
--@ file: reject-conflicting-spreads.ril
fn example(left: { id: int }, right: { id: int }) {
    let value = .{ ..left, ..right }
}
--@ end-file
--@ end-case

