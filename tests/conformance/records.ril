--@ case: row-preservation
--@ mode: run-pass
--@ spec: SPEC#record-types-and-row-polymorphism
--@ entry: test_row_preservation
--@ file: row-preservation.ril
fn with_stamp<R>(item: { ..R }) -> { stamp: int, ..R } { .{ stamp: 7, ..item } }

pub fn test_row_preservation() {
    let item = with_stamp(.{ id: 1, name: "Ada" })
    assert(item.id == 1 && item.name == "Ada" && item.stamp == 7)
    let .{ id, ..rest } = item
    assert(id == 1 && rest.stamp == 7)
}
--@ end-file
--@ end-case

--@ case: spread-override-position
--@ mode: run-pass
--@ spec: SPEC#record-construction-and-functional-update
--@ entry: test_spread_override_position
--@ file: spread-override-position.ril
pub fn test_spread_override_position() {
    let base = .{ id: 1, name: "a" }
    assert((.{ id: 2, ..base }).id == 2)
    assert((.{ ..base, id: 2 }).id == 2)
    assert(base.id == 1)
}
--@ end-file
--@ end-case
