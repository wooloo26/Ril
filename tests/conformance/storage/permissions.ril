-- [pair: same-write-origin]
-- spec: SPEC#law-of-exclusivity-and-cross-argument-disjointness

-- accept
type Cell = { mut count: int }
fn swap(mut a: Cell, mut b: Cell) &mut { let saved = a.count; a.count = b.count; b.count = saved }

fn example() {
    let mut values = [Cell.{ count: 1 }, Cell.{ count: 2 }]
    swap(mut values[0], mut values[1])
}

-- reject
-- Error [E0523]: reject same write origin
type Cell = { mut count: int }
fn swap(mut a: Cell, mut b: Cell) &mut { let saved = a.count; a.count = b.count; b.count = saved }

fn example() {
    let mut values = [Cell.{ count: 1 }, Cell.{ count: 2 }]
    swap(mut values[0], mut values[0])
}

