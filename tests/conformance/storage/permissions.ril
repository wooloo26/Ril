-- [pair: derive-draft-escape]
-- spec: SPEC#functional-updates-via-derive

-- accept
type Cell = { mut count: int }

fn example() {
    var saved = Cell.{ count: 0 }
    let base = Cell.{ count: 1 }
    let result = base |> derive \mut draft -> {
        draft.count += 1
        let snapshot = clone(draft)
        saved = snapshot
    }
}

-- reject
-- Error [E0607]: reject derive draft escape
type Cell = { mut count: int }

fn example() {
    var saved = Cell.{ count: 0 }
    let base = Cell.{ count: 1 }
    let result = base |> derive \mut draft -> { draft.count += 1; saved = draft }
}

