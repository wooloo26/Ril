-- [pair: clone-internal-sharing-marker]
-- spec: SPEC#retained-mutable-sharing

-- accept
type Cell = { mut count: int }

fn example() {
    let item = Cell.{ count: 0 }
    let mut copied = ^mut clone((item, item))
    copied.0.count += 1
}

-- reject
-- Error [E0510]: reject clone internal sharing marker
type Cell = { mut count: int }

fn example() {
    let item = Cell.{ count: 0 }
    let mut copied = clone((item, item))
    copied.0.count += 1
}

