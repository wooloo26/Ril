-- [pair: read-write-origin]
-- spec: SPEC#law-of-exclusivity-and-cross-argument-disjointness

-- accept
type Cell = { mut count: int }
fn copy_count(source: Cell, mut target: Cell) &mut { target.count = source.count }

fn example() {
    let source = Cell.{ count: 1 }
    let mut value = Cell.{ count: 0 }
    copy_count(source, mut value)
}

-- reject
-- Error [E0524]: reject read write origin
type Cell = { mut count: int }
fn copy_count(source: Cell, mut target: Cell) &mut { target.count = source.count }

fn example() {
    let mut value = Cell.{ count: 0 }
    copy_count(value, mut value)
}

