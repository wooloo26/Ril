    let item = Cell.{ count: 0 }
    let copied = clone(item)
    let mut values: []Cell = []
    values !> Array::push(copied)
    values[0].count += 1
}

-- [pair: dead-write]
-- spec: SPEC#binding-permissions-and-storage-matrix

