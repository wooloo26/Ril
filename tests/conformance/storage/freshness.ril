-- [case: nested-immutable-field, run-pass]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#deep-immutability
-- companion: reject-nested-immutable-field-upgrade
type Cell = { mut count: int }
type Holder = { mut count: int, child: Immut<Cell> }

pub fn test_nested_immutable_field() {
    let snapshot: Immut<Cell> = clone(Cell.{ count: 7 })
    let holder = Holder.{ count: 0, child: snapshot }
    let mut values: []Holder = []
    values !> Array::push(clone(holder))
    values[0].count += 1
    let child: Immut<Cell> = values[0].child
    assert(values[0].count == 1 && child.count == 7 && holder.count == 0)
}

-- [case: reject-nested-immutable-field-upgrade, check-fail]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#deep-immutability
-- companion: nested-immutable-field
-- Error [E0520]: Receiving a fresh outer clone cannot upgrade its nested Immut field
type Cell = { mut count: int }
type Holder = { mut count: int, child: Immut<Cell> }

fn example() {
    let snapshot: Immut<Cell> = clone(Cell.{ count: 7 })
    let holder = Holder.{ count: 0, child: snapshot }
    let mut values: []Holder = []
    values !> Array::push(clone(holder))
    let mut child = ^mut values[0].child
    child.count += 1
}

-- [case: reject-shallow-construction-child-upgrade, check-fail]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: nested-immutable-field
-- Error [E0520]: A fresh outer construction does not make an existing immutable child writable
type Cell = { mut count: int }
type Holder = { child: Cell }

fn example() {
    let item = Cell.{ count: 7 }
    let mut values: []Holder = []
    values !> Array::push(Holder.{ child: item })
    let mut child = ^mut values[0].child
    child.count += 1
}

-- [case: fresh-values-map, run-pass]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: STD#map
-- companion: reject-immutable-map-value
type Cell = { mut count: int }

pub fn test_fresh_values_map() {
    let item = Cell.{ count: 1 }
    let mut values: [str: Cell] = [:]
    values !> Map::set("a", clone(item))
    values !> Map::set("b", Cell.{ count: 2 })
    {
        let mut first = ^mut (values["a"] ?? panic("missing a"))
        first.count += 1
        let mut second = ^mut (values["b"] ?? panic("missing b"))
        second.count += 1
        assert(first.count == 2 && second.count == 3 && item.count == 1)
    }
    values !> Map::set("a", clone(item))
    let mut replacement = ^mut (values["a"] ?? panic("missing replacement"))
    replacement.count += 4
    assert(replacement.count == 5 && item.count == 1)
    assert(Map::keys(values) == ["a", "b"])
}

