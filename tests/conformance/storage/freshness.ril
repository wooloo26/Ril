-- [case: marked-internal-sharing, run-pass]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#retained-mutable-sharing
-- companion: reject-unmarked-internal-sharing
type Cell = { mut count: int }

pub fn test_marked_internal_sharing() {
    let item = Cell.{ count: 1 }
    let repeated = (item, item)
    let mut values: [](Cell, Cell) = []
    values !> Array::push((^mut clone(repeated)))
    values[0].0.count += 1
    assert(values[0].1.count == 2 && item.count == 1)
}

-- [case: reject-unmarked-internal-sharing, check-fail]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#retained-mutable-sharing
-- companion: marked-internal-sharing
-- Error [E0510]: Fresh storage reception does not waive the clone's internal-sharing marker
type Cell = { mut count: int }

fn example() {
    let item = Cell.{ count: 1 }
    let mut values: [](Cell, Cell) = []
    values !> Array::push(clone((item, item)))
    values[0].0.count += 1
}

-- [case: reject-overlapping-internal-sharing, check-fail]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#law-of-exclusivity-and-cross-argument-disjointness
-- companion: marked-internal-sharing
-- Error [E0523]: The two stored paths still reach the same copied writable origin
type Cell = { mut count: int }
fn swap(mut a: Cell, mut b: Cell) &mut { let saved = a.count; a.count = b.count; b.count = saved }

fn example() {
    let item = Cell.{ count: 1 }
    let mut values: [](Cell, Cell) = []
    values !> Array::push((^mut clone((item, item))))
    swap(mut values[0].0, mut values[0].1)
}

