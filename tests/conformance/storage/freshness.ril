-- [case: reject-mixed-factory-result, check-fail]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: fresh-factory-results
-- Error [E0522]: A run-time alternative returning a read-only parameter prevents initial write authority
type Cell = { mut count: int }
fn choose(flag: bool, cell: Cell) -> Cell { if flag { clone(cell) } else { cell } }

fn example(flag: bool) {
    let item = Cell.{ count: 1 }
    let mut values: []Cell = []
    values !> Array::push(choose(flag, item))
    values[0].count += 1
}

