-- [case: fresh-values-array, run-pass]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: STD#array
-- companion: reject-readonly-storage-wrapper
type Cell = { mut count: int }

pub fn test_fresh_values_array() {
    let item = Cell.{ count: 1 }
    let mut values: []Cell = []
    values !> Array::push(clone(item))
    values !> Array::insert(0, Cell.{ count: 2 })
    values[0].count += 1
    values[1].count += 1
    assert(item.count == 1 && values[0].count == 3 && values[1].count == 2)
    let mut shared = Cell.{ count: 10 }
    values !> Array::push(^mut shared)
    values[2].count += 1
    shared.count += 1
    assert(values[2].count == 12)
}

-- [case: fresh-factory-results, run-pass]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#complete-provenance-and-optional-annotations
-- companion: reject-mixed-factory-result
type Cell = { mut count: int }
fn make(value: int) -> Cell { Cell.{ count: value } }
fn copy_cell(cell: Cell) -> Cell { clone(cell) }
fn build() -> Cell { let mut cell = Cell.{ count: 4 }; cell.count += 1; cell }
fn choose(flag: bool) -> Cell { if flag { make(1) } else { make(2) } }
fn append_copy(mut values: []Cell, source: Cell) &mut { values !> Array::push(copy_cell(source)) }

pub fn test_fresh_factory_results() {
    let item = Cell.{ count: 7 }
    let mut values: []Cell = []
    let factory: fn(int) -> Cell = make
    let append: fn(mut []Cell, Cell) -> () &mut = Array::push
    append(mut values, factory(3))
    values !> Array::push(build())
    append_copy(mut values, item)
    values !> Array::push({ Cell.{ count: 9 } })
    values[0].count += 1
    values[1].count += 1
    values[2].count += 1
    values[3].count += 1
    assert(values[0].count == 4 && values[1].count == 6)
    assert(values[2].count == 8 && values[3].count == 10 && item.count == 7)
    for [false, true] as flag {
        let mut selected: []Cell = []
        selected !> Array::push(choose(flag))
        selected[0].count += 1
        assert(selected[0].count == (if flag { 2 } else { 3 }))
    }
}

-- [case: imported-factory-result, run-pass]
-- spec: SPEC#fresh-values-in-storage-calls
-- spec: SPEC#module-imports-and-visibility
-- companion: reject-foreign-result
-- file: root.ril
use factory
use ril/array::{push as append}

pub fn test_imported_factory_result() {
    let mut values: []Factory::Cell = []
    append(mut values, Factory::make())
    values[0].count += 1
    assert(values[0].count == 2)
}

-- file: factory.ril
pub type Cell = { mut count: int }
