-- [case: reject-readonly-var-insertion, check-fail]
-- spec: SPEC#fresh-values-in-storage-calls
-- companion: fresh-values-array
-- Error [E0522]: Plain var has already selected read-only interior access
type Cell = { mut count: int }

fn example() {
    var copied = clone(Cell.{ count: 1 })
    let mut values: []Cell = []
    values !> Array::push(copied)
    copied = Cell.{ count: 2 }
    values[0].count += 1
}

