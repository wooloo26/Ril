-- Error [E0318]: reject literal type
type Method = "GET"

-- [case: accept-missing-inference, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: reject-missing-inference
fn empty<T>() -> []T { [] }

fn example() {
    let values: []int = empty()
}

-- [case: reject-missing-inference, check-fail]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: accept-missing-inference
-- Error [E0344]: reject missing inference
fn empty<T>() -> []T { [] }

fn example() {
    let values = empty()
}

