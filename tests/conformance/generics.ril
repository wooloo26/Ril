-- [case: accept-runtime-const, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: reject-runtime-const
type Token<size: int>(int)

fn example(size: int) {
    let value: Token<1> = Token(1)
}

-- [case: reject-runtime-const, check-fail]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: accept-runtime-const
-- Error [E0814]: reject runtime const
type Token<size: int>(int)

fn example(size: int) {
    let value: Token<size> = Token(1)
}

-- [case: static-argument-identity, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
type Token<value: f64>(int)
type Point<value: { x: int, y: int }>(int)
type Order<value: [str: int]>(int)
meta let _ = assert(type<Token<0.0>> != type<Token<-0.0>>)
meta let _ = assert(type<Token<0.0 / 0.0>> == type<Token<0.0 / 0.0>>)
meta let _ = assert(type<Point<.{ x: 1, y: 2 }>> == type<Point<.{ y: 2, x: 1 }>>)
meta let _ = assert(type<Order<["a": 1, "b": 2]>> != type<Order<["b": 2, "a": 1]>>)
