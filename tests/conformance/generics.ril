-- [case: accept-const-sort, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: reject-const-sort
type Token<size: int>(int)

fn example() {
    let value: Token<1> = Token(1)
}

-- [case: reject-const-sort, check-fail]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: accept-const-sort
-- Error [E0323]: reject const sort
type Token<size: int>(int)

fn example() {
    let value: Token<"1"> = Token(1)
}

-- [case: accept-forward-default, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: reject-forward-default
type Pair<T = int, U = T> = (T, U)

-- [case: reject-forward-default, check-fail]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: accept-forward-default
-- Error [E0320]: reject forward default
type Pair<T = U, U = int> = (T, U)

-- [case: accept-function-default, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: reject-function-default
fn echo<T>(value: T) -> T { value }

-- [case: reject-function-default, check-fail]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: accept-function-default
-- Error [E0317]: reject function default
fn echo<T = int>(value: T) -> T { value }

-- [case: accept-generic-arity, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: reject-generic-arity
type Item = Option<int>

-- [case: reject-generic-arity, check-fail]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
-- companion: accept-generic-arity
-- Error [E0340]: reject generic arity
type Item = Option<int, str>

-- [case: accept-literal-type, check-pass]
