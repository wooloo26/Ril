-- [case: accept-alias-no-inspection, check-pass]
-- spec: SPEC#mandatory-inspection-of-fallible-results
-- companion: reject-alias-no-inspection
fn example() {
    let result: Result<int, str> = Err("bad")
    let alias = result
    assert(alias is Err(_))
}

-- [case: reject-alias-no-inspection, check-fail]
-- spec: SPEC#mandatory-inspection-of-fallible-results
-- companion: accept-alias-no-inspection
-- Error [E0720]: reject alias no inspection
fn example() {
    let result: Result<int, str> = Err("bad")
    let alias = result
}

-- [case: accept-copy-no-inspection, check-pass]
-- spec: SPEC#mandatory-inspection-of-fallible-results
-- companion: reject-copy-no-inspection
fn example() {
    let result: Result<int, str> = Err("bad")
    let copied = clone(result)
    assert(result is Err(_))
    assert(copied is Err(_))
}

-- [case: reject-copy-no-inspection, check-fail]
