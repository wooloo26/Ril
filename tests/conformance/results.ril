--@ file: reject-task-result-uninspected.ril
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

fn example() @Concurrent {
    let result = scope \mut s -> { s.fork(\-> { let value: Result<int, str> = Err("bad"); value }); Ok() }
    assert(result is Ok())
}
--@ end-file
--@ end-case

