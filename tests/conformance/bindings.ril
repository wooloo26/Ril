-- [case: accept-assignment-target, check-pass]
-- spec: SPEC#assignments-and-compound-assignments
-- companion: reject-assignment-target
fn example() {
    var value = 1
    value = 3
}

-- [case: reject-assignment-target, check-fail]
-- spec: SPEC#assignments-and-compound-assignments
-- companion: accept-assignment-target
-- Error [E0503]: reject assignment target
fn example() {
    (1 + 2) = 3
}

-- [case: accept-chained-assignment, check-pass]
-- spec: SPEC#assignments-and-compound-assignments
-- companion: reject-chained-assignment
fn example() {
    var first = 0
    var second = 0
    second = 1
    first = second
}

-- [case: reject-chained-assignment, check-fail]
-- spec: SPEC#assignments-and-compound-assignments
-- companion: accept-chained-assignment
-- Error [E0701]: reject chained assignment
fn example() {
    var first = 0
    var second = 0
    first = second = 1
}

-- [case: accept-immutable-reassignment, check-pass]
-- spec: SPEC#immutable-bindings
-- companion: reject-immutable-reassignment
fn example() {
    var value = 1
    value = 2
}

-- [case: reject-immutable-reassignment, check-fail]
-- spec: SPEC#immutable-bindings
-- companion: accept-immutable-reassignment
-- Error [E0501]: reject immutable reassignment
fn example() {
    let value = 1
    value = 2
}

-- [case: compound-assignment, run-pass]
-- spec: SPEC#assignments-and-compound-assignments
pub fn test_compound_assignment() {
    var value = 10
    value += 5; value -= 2; value *= 2; value /= 2; value %= 5
    assert(value == 3)
    var byte_value = 250u8
    byte_value +%= 10u8; byte_value -%= 10u8; byte_value *%= 2u8
    assert(byte_value == 244u8)
    var flags = 3
    flags |= 12; flags &= 10; flags ^= 3; flags <<= 1; flags >>= 2
    assert(flags == 4)
}

-- [case: reassignable-and-interior, run-pass]
-- spec: SPEC#reassignable-mutable-variables
pub fn test_reassignable_and_interior() {
    var mut values = [1]
    values !> Array::push(2)
    values = [3]
    assert(values == [3])
}
