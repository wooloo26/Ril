--@ source: annotation-context-before-name-resolution
--@ file: source.ril
var capture = 0
var closure = 10
type Reader = fn() -> int &closure
fn bump() &{mut capture, mut closure} { capture += 1; closure += 2 }
fn read_capture() -> int &{capture} { capture }
fn read_closure() -> int &{closure} { closure }
fn make(capture: int) -> Reader &capture { \-> capture }
fn make_other(closure: int) -> Reader &capture { \-> closure }
pub fn test_native() &{mut capture, mut closure} {
    bump()
    let first = make(7)
    let second = make_other(9)
    assert(first() == 7 && second() == 9)
    assert(read_capture() == 1 && read_closure() == 12)
}
--@ end-file
--@ end-source

