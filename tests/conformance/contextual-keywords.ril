--@ case: reject-unrelated-global-callable-bound
--@ mode: check-fail
--@ spec: SPEC#state-groups-and-captured-layers
--@ companion: global-closure-callable-bound-pointer32
-- Error [E0534]: The global closure bound cannot authorize a different module binding.
--@ file: source.ril
var closure = 1
var other = 2
type Reader = fn() -> int &{closure}
fn read_other() -> int &{other} { other }
fn invoke(action: Reader) -> int &{closure} { action() }
fn example() &{other} { let value = invoke(read_other) }
--@ end-file
--@ end-case
