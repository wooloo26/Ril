--@ source: single-global-closure-group
--@ file: source.ril
var closure = 1
fn advance() &{mut closure} { closure += 1 }
fn read() -> int &{closure} { closure }
pub fn test_native() &{mut closure} {
    advance()
    assert(read() == 2)
}
