--@ source: contextual-parameter-and-pattern
--@ file: source.ril
type Config = { capture: int, closure: int }
fn read(capture: Config) -> int {
    let .{ capture: value, closure } = capture
    value + closure
}
pub fn test_native() {
    let config = Config.{ capture: 3, closure: 5 }
    let .{ capture, .. } = config
    let closure = \capture: int -> capture * 2
    assert(read(config) == 8 && closure(capture) == 6)
}
--@ end-file
--@ end-source

