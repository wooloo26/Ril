--@ case: reject-global-as-capture-group
--@ mode: check-fail
--@ spec: SPEC#state-groups-and-captured-layers
--@ companion: single-global-closure-group-pointer32
-- Error [E0538]: A comma fixes closure as a capture-group header before name resolution.
--@ file: source.ril
var closure = 1
var value = 2
fn example() -> int &{closure, value} { value }
--@ end-file
--@ end-case

--@ case: reject-empty-contextual-capture-group
--@ mode: check-fail
--@ spec: SPEC#state-groups-and-captured-layers
--@ companion: single-global-closure-group-pointer64
-- Error [E0538]: The contextual capture-group header requires an actual source item.
--@ file: source.ril
fn example() -> int &{closure,} { 7 }
--@ end-file
--@ end-case

--@ source: global-closure-callable-bound
--@ file: source.ril
var closure = 7
type Reader = fn() -> int &{closure}
fn read() -> int &{closure} { closure }
fn inherited() -> int &read { read() }
fn invoke(action: Reader) -> int &{closure} { action() }
pub fn test_native() &{mut closure} {
    closure = 9
    assert(invoke(read) == 9 && inherited() == 9)
    let action: Reader = read
    assert(action() == 9)
}
--@ end-file
--@ end-source

