--@ source: ordinary-capture-and-closure
--@ file: source.ril
type Config = { capture: bool, closure: int }
fn capture(value: int) -> int { value + 1 }
pub fn test_native() {
    assert(capture(2) == 3)
    let config = Config.{ capture: true, closure: 7 }
    let capture = config.capture
    let closure = config.closure
    assert(capture && closure == 7)
    {
        let capture = \value: int -> value * 2
        assert(capture(3) == 6)
    }
    assert(capture && closure == 7)
}
--@ end-file
--@ end-source

