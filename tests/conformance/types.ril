-- [pair: closed-record-width]
-- spec: SPEC#type-identity-and-subtyping

-- accept
fn make() -> { name: str, extra: int } { .{ name: "a", extra: 1 } }

fn example() {
    let getter: fn() -> { name: str, extra: int } = make
}

-- reject
-- Error [E0301]: reject closed record width
fn make() -> { name: str, extra: int } { .{ name: "a", extra: 1 } }

fn example() {
    let getter: fn() -> { name: str } = make
}

-- [pair: incompatible-binding]
-- spec: SPEC#diagnostic-classification

-- accept
fn example() {
    let value: str = "one"
}

-- reject
-- Error [E0301]: reject incompatible binding
fn example() {
    let value: str = 1
}

-- [pair: nominal-identity]
-- spec: SPEC#nominal-type-wrappers

-- accept
type UserId(int)
type AccountId(int)

fn example() {
    let same = UserId(1) == UserId(1)
}

-- reject
-- Error [E0305]: reject nominal identity
type UserId(int)
type AccountId(int)

fn example() {
    let same = UserId(1) == AccountId(1)
}

-- [pair: pinned-scalar]
-- spec: SPEC#value-types

-- accept
fn example() {
    var value = 1
    value += 1
}

-- reject
-- Error [E0402]: reject pinned scalar
fn example() {
    let mut value = 1
}

-- [pair: sum-argument-invariance]
-- spec: SPEC#type-identity-and-subtyping

-- accept
fn example() {
    let value: ?int = Some(1)
}

-- reject
-- Error [E0301]: reject sum argument invariance
fn example() {
    let value: ?int = Some("a")
}

-- [pair: value-borrow]
-- spec: SPEC#value-types

-- accept
fn example(value: int) {}

-- reject
-- Error [E0401]: reject value borrow
fn example(mut value: int) {}

-- [case: boolean-unit, run-pass]
-- spec: SPEC#boolean-and-unit-literals
pub fn test_boolean_unit() {
    let yes: bool = true
    let no: bool = false
    let unit: () = ()
    assert(yes != no && unit == ())
}

-- [case: copy-by-value, run-pass]
-- spec: SPEC#value-types
pub fn test_copy_by_value() {
    let original = 42
    var changed = original
    changed += 1
    assert(original == 42 && changed == 43)
}

-- [case: nominal-unwrapping, run-pass]
-- spec: SPEC#nominal-type-wrappers
type UserId(int)
type Coord(int, int)
type Marker

pub fn test_nominal_unwrapping() {
    assert(inner(UserId(7)) == 7)
    let Coord(x, y) = Coord(1, 2)
    assert(x == 1 && y == 2)
    assert(inner(Marker) == ())
}

-- [case: reference-identity, run-pass]
-- spec: SPEC#reference-types
type Cell = { mut count: int }

pub fn test_reference_identity() {
    let mut value = Cell.{ count: 1 }
    let view alias = value
    value.count = 2
    assert(alias.count == 2)
}
