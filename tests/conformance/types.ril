--@ case: accept-closed-record-width
--@ mode: check-pass
--@ spec: SPEC#type-identity-and-subtyping
--@ companion: reject-closed-record-width
--@ file: accept-closed-record-width.ril
fn make() -> { name: str, extra: int } { .{ name: "a", extra: 1 } }

fn example() {
    let getter: fn() -> { name: str, extra: int } = make
}
--@ end-file
--@ end-case

