--@ case: boolean-unit
--@ mode: run-pass
--@ spec: SPEC#boolean-and-unit-literals
--@ entry: test_boolean_unit
--@ file: boolean-unit.ril
pub fn test_boolean_unit() {
    let yes: bool = true
    let no: bool = false
    let unit: () = ()
    assert(yes != no && unit == ())
}
--@ end-file
--@ end-case

--@ case: copy-by-value
--@ mode: run-pass
--@ spec: SPEC#value-types
--@ entry: test_copy_by_value
--@ file: copy-by-value.ril
pub fn test_copy_by_value() {
    let original = 42
    var changed = original
    changed += 1
    assert(original == 42 && changed == 43)
}
--@ end-file
--@ end-case

--@ case: nominal-unwrapping
--@ mode: run-pass
--@ spec: SPEC#nominal-type-wrappers
--@ entry: test_nominal_unwrapping
--@ file: nominal-unwrapping.ril
type UserId(int)
type Coord(int, int)
type Marker

pub fn test_nominal_unwrapping() {
    assert(inner(UserId(7)) == 7)
    let Coord(x, y) = Coord(1, 2)
    assert(x == 1 && y == 2)
    assert(inner(Marker) == ())
}
--@ end-file
--@ end-case

--@ case: reference-identity
--@ mode: run-pass
--@ spec: SPEC#reference-types
--@ entry: test_reference_identity
--@ file: reference-identity.ril
type Cell = { mut count: int }

pub fn test_reference_identity() {
    let mut value = Cell.{ count: 1 }
    let view alias = value
    value.count = 2
    assert(alias.count == 2)
}
--@ end-file
--@ end-case
