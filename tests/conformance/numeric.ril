--@ case: i16-boundaries
--@ mode: run-pass
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ entry: test_i16_boundaries
--@ file: i16-boundaries.ril
pub fn test_i16_boundaries() {
    assert(32767i16 +% 1i16 == -32768i16)
    assert(-32768i16 -% 1i16 == 32767i16)
    assert(32767i16 / 1i16 == 32767i16)
}
--@ end-file
--@ end-case

--@ case: static-floating-receipts
--@ mode: run-pass
--@ spec: SPEC#numeric-literals
--@ spec: SPEC#generic-parameters-defaults-and-value-sorts
--@ companion: static-floating-widening
--@ entry: test_static_floating_receipts
--@ file: static-floating-receipts.ril
meta let ROUNDED: f32 = 16777217
meta let NEGATIVE_ZERO: f32 = -0.0f32
meta let NEGATIVE: f64 = -1.5f64
meta let NOT_A_NUMBER: f64 = 0.0f64 / 0.0f64
fn fixed<value: f32>(number: f32 = value) -> f32 { number }
fn fixed_wide<value: f64>(number: f64 = value) -> f64 { number }
pub fn test_static_floating_receipts() &{ROUNDED, NEGATIVE_ZERO, NEGATIVE, NOT_A_NUMBER} {
    assert(ROUNDED == 16777216.0f32)
    assert(1.0f32 / NEGATIVE_ZERO < 0.0f32)
    assert(1.0f32 / (-NEGATIVE_ZERO) > 0.0f32)
    assert(NEGATIVE == -1.5f64)
    assert(NOT_A_NUMBER != NOT_A_NUMBER)
    assert(fixed<16777217>() == 16777216.0f32)
    let zero = fixed<-0.0f32>()
    assert(1.0f32 / zero < 0.0f32)
    assert(1.0f32 / (-fixed<-0.0f32>()) > 0.0f32)
    assert(fixed_wide<-1.5f64>() == -1.5f64)
    let nan = fixed_wide<(0.0f64 / 0.0f64)>()
    assert(nan != nan)
}
--@ end-file
--@ end-case

--@ case: external-const-floating-defaults
--@ mode: check-pass
--@ spec: SPEC#numeric-literals
--@ spec: SPEC#generic-parameters-defaults-and-value-sorts
--@ file: main.ril
use api
fn example() {
    let rounded: f32 = Api::fixed<16777217.0f32>()
    let negative_zero: f32 = Api::fixed<-0.0f32>()
    let negative: f64 = Api::wide<-1.5f64>()
    let nan: f64 = Api::wide<(0.0f64 / 0.0f64)>()
    let negated_nan: f32 = Api::negated<(0.0f32 / 0.0f32)>()
    let negated_wide_nan: f64 = Api::negated_wide<(0.0f64 / 0.0f64)>()
    let flipped: f32 = -negative_zero
}
--@ end-file
--@ file: api.d.ril
pub fn fixed<value: f32>(number: f32 = value) -> f32
pub fn wide<value: f64>(number: f64 = value) -> f64
pub fn negated<value: f32>(number: f32 = -value) -> f32
pub fn negated_wide<value: f64>(number: f64 = -value) -> f64
--@ end-file
--@ end-case

