--@ case: i16-boundaries
--@ mode: run-pass
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ entry: test_i16_boundaries
--@ file: i16-boundaries.ril
pub fn test_i16_boundaries() {
    assert(32767i16 +% 1i16 == -32768i16)
    assert(-32768i16 -% 1i16 == 32767i16)
    assert(32767i16 / 1i16 == 32767i16)
}
--@ end-file
--@ end-case

--@ case: i16-overflow-safe
--@ mode: run-pass
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ companion: i16-overflow
--@ entry: test_i16_overflow_safe
--@ file: i16-overflow-safe.ril
pub fn test_i16_overflow_safe() {
    assert(32766i16 + 1i16 == 32767i16)
}
--@ end-file
--@ end-case

--@ case: i16-overflow
--@ mode: run-panic
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ companion: i16-overflow-safe
--@ entry: test_i16_overflow
-- Panics: i16 overflow
--@ file: i16-overflow.ril
pub fn test_i16_overflow() {
    let _ = 32767i16 + 1i16
}
--@ end-file
--@ end-case

