-- [case: deferred-arithmetic-safe, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: deferred-arithmetic-overflow
fn identity<T>(value: T) -> T { value }
fn choose<T>(left: T, right: T) -> T { left }
pub fn test_deferred_arithmetic_safe() {
    let operations = .{get: \value -> value}
    let result = choose(126 + 1, operations.get(3i8))
    assert(result == 127i8)
}

-- [case: deferred-arithmetic-overflow, run-panic]
-- spec: SPEC#numeric-literals
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: deferred-arithmetic-safe
-- Panics: arithmetic selected as i8 still overflows before choose enters.
fn identity<T>(value: T) -> T { value }
fn choose<T>(left: T, right: T) -> T { left }
pub fn test_deferred_arithmetic_overflow() {
    let operations = .{get: \value -> value}
    let _ = choose(127 + 1, operations.get(3i8))
}

-- [case: sibling-literal-occurrences, run-pass]
-- spec: SPEC#numeric-literals
pub fn test_sibling_literal_occurrences() {
    let pair: (f32, f32) = (16777217, 16777217)
    assert(pair.0 == 16777216.0f32)
    assert(pair.1 == 16777216.0f32)
}

-- [case: default-literal-occurrences, run-pass]
-- spec: SPEC#numeric-literals
fn rounded(value: f32 = 16777217) -> f32 { value }
fn nested() -> f32 { rounded() }
pub fn test_default_literal_occurrences() {
    assert(rounded() == 16777216.0f32)
    assert(nested() == 16777216.0f32)
}

-- [case: pattern-literal-occurrences, run-pass]
-- spec: SPEC#numeric-literals
fn classify(value: i8) -> int {
    match value { 7 -> 1, 8 -> 2, _ -> 3 }
}
pub fn test_pattern_literal_occurrences() {
    assert(classify(7i8) == 1)
    assert(classify(8i8) == 2)
    assert(classify(-128i8) == 3)
}

-- [case: lexical-numeric-shadow, run-pass]
-- spec: SPEC#numeric-literals
pub fn test_lexical_numeric_shadow() {
    let number = 1
    let before = number
    let nested = {
        let number = number + 1
        number
    }
    assert(before == 1)
    assert(nested == 2)
    assert(number == 1)
}

-- [case: hoisted-numeric-capture, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
pub fn test_hoisted_numeric_capture() {
    let number = 3
    assert(read_number() == 3)
where
    fn read_number() -> int &{closure, number} { number }
}

-- [case: floating-alias-patterns, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
type Rounded = f32
fn matches_rounded(value: Rounded) -> bool {
    match value { 16777217 -> true, _ -> false }
}
pub fn test_floating_alias_patterns() {
    assert(matches_rounded(16777216.0f32))
    assert(!matches_rounded(16777218.0f32))
}

-- [case: nested-alias-patterns, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
type Narrow = i8
type Frozen = Immut<Narrow>
fn classify_nested(value: (Frozen, Narrow)) -> int {
    match value { (127, _) -> 1, (_, 7) -> 2, _ -> 3 }
}
pub fn test_nested_alias_patterns() {
    assert(classify_nested((127i8, 7i8)) == 1)
    assert(classify_nested((0i8, 7i8)) == 2)
    assert(classify_nested((0i8, 8i8)) == 3)
}

-- [case: alias-pattern-range-safe, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
-- companion: alias-pattern-range-overflow
type Narrow = i8
fn matches_narrow(value: Narrow) -> bool {
    match value { 127 -> true, _ -> false }
}
pub fn test_alias_pattern_range_safe() {
    assert(matches_narrow(127i8))
    assert(!matches_narrow(0i8))
}

-- [case: alias-pattern-range-overflow, check-fail]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
-- companion: alias-pattern-range-safe
-- Error [E0326]: 128 is outside the numeric pattern's actual i8 view.
type Narrow = i8
fn matches_narrow(value: Narrow) -> bool {
    match value { 128 -> true, _ -> false }
}

-- [case: shadowed-alias-pattern-safe, run-pass]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
-- companion: shadowed-alias-pattern-overflow
type Narrow = i64
fn matches_local(value: Narrow) -> bool
where
    type Narrow = i8
{
    match value { 127 -> true, _ -> false }
}
pub fn test_shadowed_alias_pattern_safe() {
    assert(matches_local(127i8))
    assert(!matches_local(0i8))
}

-- [case: shadowed-alias-pattern-overflow, check-fail]
-- spec: SPEC#numeric-literals
-- spec: SPEC#pattern-matching
-- companion: shadowed-alias-pattern-safe
-- Error [E0326]: the inner i8 alias cannot borrow the outer i64 range.
type Narrow = i64
fn matches_local(value: Narrow) -> bool
where
    type Narrow = i8
{
    match value { 128 -> true, _ -> false }
}
