-- [pair: branch-type]
-- spec: SPEC#conditional-expressions

-- accept
fn example(choose: bool) {
    let value = if choose { 1 } else { 2 }
}

-- reject
-- Error [E0351]: reject branch type
fn example(choose: bool) {
    let value = if choose { 1 } else { "a" }
}

-- [pair: last-outside-loop]
-- spec: SPEC#control-transfers

-- accept
fn example() {
    loop { last }
}

-- reject
-- Error [E0707]: reject last outside loop
fn example() {
    last
}

-- [pair: next-outside-loop]
-- spec: SPEC#control-transfers

-- accept
fn example() {
    loop { last }
}

-- reject
-- Error [E0707]: reject next outside loop
fn example() {
    next
}

-- [pair: nonboolean-condition]
-- spec: SPEC#conditional-expressions

-- accept
fn example() {
    if true {}
}

-- reject
-- Error [E0350]: reject nonboolean condition
fn example() {
    if 1 {}
}

-- [pair: nonboolean-logical]
-- spec: SPEC#logical-operators

-- accept
fn example() {
    let value = true && false
}

-- reject
-- Error [E0350]: reject nonboolean logical
fn example() {
    let value = true && 1
}

-- [pair: noniterable-string]
-- spec: SPEC#loop-expressions

-- accept
fn example() {
    for String::scalars("abc") as value {}
}

-- reject
-- Error [E0355]: reject noniterable string
fn example() {
    for "abc" as value {}
}

-- [case: loop-last-next, run-pass]
-- spec: SPEC#control-transfers
pub fn test_loop_last_next() {
    var sum = 0
    for 1..=10 as value { if value > 6 { last }; if value % 2 == 0 { next }; sum += value }
    assert(sum == 9)
    var count = 0
    let result = loop { count += 1; if count == 3 { last count * 2 } }
    assert(result == 6)
}

-- [case: short-circuit, run-pass]
-- spec: SPEC#logical-operators
pub fn test_short_circuit() {
    assert(!(false && panic("rhs must not execute")))
    assert(true || panic("rhs must not execute"))
    assert(!false && !(!true))
}
