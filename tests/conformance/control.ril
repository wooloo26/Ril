--@ case: accept-branch-type
--@ mode: check-pass
--@ spec: SPEC#conditional-expressions
--@ companion: reject-branch-type
--@ file: accept-branch-type.ril
fn example(choose: bool) {
    let value = if choose { 1 } else { 2 }
}
--@ end-file
--@ end-case

--@ case: reject-branch-type
--@ mode: check-fail
--@ spec: SPEC#conditional-expressions
--@ companion: accept-branch-type
-- Error [E0351]: reject branch type
--@ file: reject-branch-type.ril
fn example(choose: bool) {
    let value = if choose { 1 } else { "a" }
}
--@ end-file
--@ end-case

