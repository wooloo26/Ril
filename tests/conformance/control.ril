-- [case: accept-branch-type, check-pass]
-- spec: SPEC#conditional-expressions
-- companion: reject-branch-type
fn example(choose: bool) {
    let value = if choose { 1 } else { 2 }
}

-- [case: reject-branch-type, check-fail]
-- spec: SPEC#conditional-expressions
-- companion: accept-branch-type
-- Error [E0351]: reject branch type
fn example(choose: bool) {
    let value = if choose { 1 } else { "a" }
}

-- [case: accept-last-outside-loop, check-pass]
-- spec: SPEC#control-transfers
-- companion: reject-last-outside-loop
fn example() {
    loop { last }
}

-- [case: reject-last-outside-loop, check-fail]
-- spec: SPEC#control-transfers
-- companion: accept-last-outside-loop
-- Error [E0707]: reject last outside loop
fn example() {
    last
}

-- [case: accept-next-outside-loop, check-pass]
-- spec: SPEC#control-transfers
-- companion: reject-next-outside-loop
fn example() {
    loop { last }
}

-- [case: reject-next-outside-loop, check-fail]
-- spec: SPEC#control-transfers
-- companion: accept-next-outside-loop
-- Error [E0707]: reject next outside loop
fn example() {
    next
}

-- [case: accept-nonboolean-condition, check-pass]
-- spec: SPEC#conditional-expressions
-- companion: reject-nonboolean-condition
fn example() {
    if true {}
}

-- [case: reject-nonboolean-condition, check-fail]
-- spec: SPEC#conditional-expressions
-- companion: accept-nonboolean-condition
-- Error [E0350]: reject nonboolean condition
fn example() {
    if 1 {}
}

-- [case: accept-nonboolean-logical, check-pass]
-- spec: SPEC#logical-operators
-- companion: reject-nonboolean-logical
fn example() {
    let value = true && false
}

-- [case: reject-nonboolean-logical, check-fail]
-- spec: SPEC#logical-operators
-- companion: accept-nonboolean-logical
-- Error [E0350]: reject nonboolean logical
fn example() {
    let value = true && 1
}

-- [case: accept-noniterable-string, check-pass]
-- spec: SPEC#loop-expressions
-- companion: reject-noniterable-string
fn example() {
    for String::scalars("abc") as value {}
}

-- [case: reject-noniterable-string, check-fail]
-- spec: SPEC#loop-expressions
-- companion: accept-noniterable-string
-- Error [E0355]: reject noniterable string
fn example() {
    for "abc" as value {}
}

-- [case: loop-last-next, run-pass]
-- spec: SPEC#control-transfers
pub fn test_loop_last_next() {
    var sum = 0
    for 1..=10 as value { if value > 6 { last }; if value % 2 == 0 { next }; sum += value }
    assert(sum == 9)
    var count = 0
    let result = loop { count += 1; if count == 3 { last count * 2 } }
    assert(result == 6)
}

-- [case: short-circuit, run-pass]
-- spec: SPEC#logical-operators
pub fn test_short_circuit() {
    assert(!(false && panic("rhs must not execute")))
    assert(true || panic("rhs must not execute"))
    assert(!false && !(!true))
}
