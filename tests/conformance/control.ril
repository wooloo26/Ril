--@ case: loop-last-next
--@ mode: run-pass
--@ spec: SPEC#control-transfers
--@ entry: test_loop_last_next
--@ file: loop-last-next.ril
pub fn test_loop_last_next() {
    var sum = 0
    for 1..=10 as value { if value > 6 { last }; if value % 2 == 0 { next }; sum += value }
    assert(sum == 9)
    var count = 0
    let result = loop { count += 1; if count == 3 { last count * 2 } }
    assert(result == 6)
}
--@ end-file
--@ end-case

--@ case: short-circuit
--@ mode: run-pass
--@ spec: SPEC#logical-operators
--@ entry: test_short_circuit
--@ file: short-circuit.ril
pub fn test_short_circuit() {
    assert(!(false && panic("rhs must not execute")))
    assert(true || panic("rhs must not execute"))
    assert(!false && !(!true))
}
--@ end-file
--@ end-case
