-- [pair: alternative-binders]
-- spec: SPEC#pattern-matching

-- accept
type Choice { Left(int), Right(int) }

fn example(item: Choice) {
    match item { Left(x) | Right(x) -> () }
}

-- reject
-- Error [E0346]: reject alternative binders
type Choice { Left(int), Right(int) }

fn example(item: Choice) {
    match item { Left(x) | Right(y) -> () }
}

-- [pair: computed-pattern]
-- spec: SPEC#pattern-matching

-- accept
fn example(item: int) {
    match item { 3 -> (), _ -> () }
}

-- reject
-- Error [E0349]: reject computed pattern
fn example(item: int) {
    match item { (1 + 2) -> (), _ -> () }
}

-- [pair: duplicate-binder]
-- spec: SPEC#pattern-matching

-- accept
fn example() {
    let (first, second) = (1, 2)
}

-- reject
-- Error [E0347]: reject duplicate binder
fn example() {
    let (same, same) = (1, 2)
}

-- [pair: guard-not-exhaustive]
-- spec: SPEC#pattern-syntax-or-patterns-and-exhaustiveness

-- accept
fn example(item: int) {
    match item { value if value >= 0 -> (), _ -> () }
}

-- reject
-- Error [E0303]: reject guard not exhaustive
fn example(item: int) {
    match item { value if value >= 0 -> (), value if value < 0 -> () }
}

-- [pair: match-branch-type]
-- spec: SPEC#pattern-matching

-- accept
fn example(item: bool) {
    let value = match item { true -> 1, false -> 2 }
}

-- reject
-- Error [E0351]: reject match branch type
fn example(item: bool) {
    let value = match item { true -> 1, false -> "a" }
}

-- [pair: nondivergent-else]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant

-- accept
fn example(item: ?int) {
    let Some(value) = item else { return }
}

-- reject
-- Error [E0321]: reject nondivergent else
fn example(item: ?int) {
    let Some(value) = item else { () }
}

-- [pair: nonexhaustive-match]
-- spec: SPEC#pattern-matching

-- accept
fn example(item: ?int) {
    match item { Some(value) -> (), None -> () }
}

-- reject
-- Error [E0303]: reject nonexhaustive match
fn example(item: ?int) {
    match item { Some(value) -> () }
}

-- [pair: refutable-binding]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant

-- accept
fn example(item: ?int) {
    let Some(value) = item else { return }
}

-- reject
-- Error [E0345]: reject refutable binding
fn example(item: ?int) {
    let Some(value) = item
}

-- [pair: refutable-for-pattern]
-- spec: SPEC#pattern-matching

-- accept
fn example(items: []?int) {
    for items as value {}
}

-- reject
-- Error [E0345]: reject refutable for pattern
fn example(items: []?int) {
    for items as Some(value) {}
}

-- [pair: reversed-range]
-- spec: SPEC#pattern-matching

-- accept
fn example(item: int) {
    match item { 1..=5 -> (), _ -> () }
}

-- reject
-- Error [E0348]: reject reversed range
fn example(item: int) {
    match item { 5..=1 -> (), _ -> () }
}

-- [pair: unreachable-arm]
-- spec: SPEC#pattern-matching

-- accept
fn example(item: ?int) {
    match item { Some(value) -> (), None -> () }
}

-- reject
-- Error [E0304]: reject unreachable arm
fn example(item: ?int) {
    match item { _ -> (), Some(value) -> () }
}

-- [pair: vacuous-guarded-discard]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant

-- accept
fn example(item: int) {
    let value = item
}

-- reject
-- Error [E0309]: reject vacuous guarded discard
fn example(item: int) {
    let _ = item else { return }
}

-- [pair: vacuous-unit]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant

-- accept
fn example() {
    let _ = ()
}

-- reject
-- Error [E0309]: reject vacuous unit
fn example() {
    let () = ()
}

-- [case: guarded-binding, run-pass]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
fn read(item: ?int) -> int { let Some(value) = item else { return 0 }; value }

pub fn test_guarded_binding() {
    assert(read(Some(7)) == 7 && read(None) == 0)
}

-- [case: guarded-binding-shadowed-receivers, run-pass]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
fn read_shadowed(item: ?int, first: bool) -> int {
    let value = 100
    match Some(1) { Some(value) -> assert(value == 1), None -> () }
    for [1] as value { assert(value == 1) }
    let result = if first {
        let Some(value) = item else { return 1 }
        value
    } else {
        let Some(value) = item else { return 2 }
        let nested = {
            let Some(value) = Some(value + 1) else { return 3 }
            value
        }
        nested
    }
    assert(value == 100)
    result
}

pub fn test_guarded_binding_shadowed_receivers() {
    assert(read_shadowed(Some(7), true) == 7)
    assert(read_shadowed(Some(7), false) == 8)
    assert(read_shadowed(None, true) == 1)
    assert(read_shadowed(None, false) == 2)
}

-- [case: guarded-binding-alternative-receivers, run-pass]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
type GuardedChoice { Left(int), Right(int), Empty }

fn read_alternative(item: GuardedChoice) -> int {
    let Left(value) | Right(value) = item else { return 0 }
    value
}

pub fn test_guarded_binding_alternative_receivers() {
    assert(read_alternative(Left(7)) == 7)
    assert(read_alternative(Right(9)) == 9)
    assert(read_alternative(Empty) == 0)
}
