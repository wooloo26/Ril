-- [case: expected-expressions, run-pass]
-- spec: SPEC#value-tests-with-is
-- companion: reject-unresolved-expected-name
fn expected() -> int { 40 + 2 }
fn guarded(result: Result<int, str>) -> bool {
    match result { Ok(value) if value == expected() -> true, _ -> false }
}

pub fn test_expected_expressions() {
    let result: Result<int, str> = Ok(42)
    let wanted = 42
    assert(result is Ok && result is Ok(_))
    assert(result is Ok(expected()) && result is Ok(wanted))
    assert(result is Ok(40 + 2))
    assert(!(result is Ok(wanted + 1)))
    assert(wanted == 42)
    assert(42 is expected())
    assert(guarded(Ok(42)) && !guarded(Err("failed")))
}

-- [case: nested-and-product-tests, run-pass]
-- spec: SPEC#value-tests-with-is
type UserId(int)
type Pair { Item(int, int) }

pub fn test_nested_and_product_tests() {
    let id = 7
    let nested: Result<?UserId, str> = Ok(Some(UserId(7)))
    assert(nested is Ok(Some(UserId(id))))
    let pair = Pair::Item(7, 7)
    assert(pair is Item(id, id))
    assert(pair is Item((id, id)))
    let expected_pair = (7, 7)
    assert(pair is Item(expected_pair))
    assert((7, 8) is (id, id + 1))
    assert((7, 8) is (_, id + 1))
    let record: Result<{ id: int, name: str }, str> = Ok(.{ id: 7, name: "Ada" })
    assert(record is Ok(.{ id }))
    assert(record is Ok(.{ name: String::concat("A", "da"), id: id }))
    assert(!(record is Ok(.{ id: id + 1 })))
}

-- [case: collection-expressions, run-pass]
-- spec: SPEC#value-tests-with-is
-- companion: reject-array-wildcard
pub fn test_collection_expressions() {
    let array: Result<[]int, str> = Ok([1, 2])
    assert(array is Ok([1, 1 + 1]))
    assert(array is Ok(Array::reverse([2, 1])))
    assert(!(array is Ok([1])))
    let mapping: Result<[str: int], str> = Ok(["a": 1, "b": 2])
    assert(mapping is Ok(["b": 1 + 1, "a": 1]))
    let empty: Result<[]int, str> = Ok([])
    assert(empty is Ok([]))
}

-- [case: subject-once-and-component-short-circuit, run-pass]
-- spec: SPEC#value-tests-with-is
pub fn test_subject_once_and_component_short_circuit() {
    let mut trace: []int = []
    let mut subject = \-> {
        trace !> Array::push(0)
        let result: Result<(int, int), str> = Ok(1, 2)
        result
    }
    let mut mark = \n -> { trace !> Array::push(n); n }
    assert(subject() is Ok(mark(1), mark(2)))
    assert(trace == [0, 1, 2])
    trace !> Array::truncate(0)
    assert(!(subject() is Ok(mark(9), mark(2))))
    assert(trace == [0, 9])
}

-- [case: array-expression-is-eager, run-pass]
-- spec: SPEC#value-tests-with-is
pub fn test_array_expression_is_eager() {
    let mut trace: []int = []
    let mut mark = \n -> { trace !> Array::push(n); n }
    let result: Result<[]int, str> = Ok([1])
    assert(!(result is Ok([mark(1), mark(2)])))
    assert(trace == [1, 2])
}

-- [case: tag-mismatch-skips-expressions, run-pass]
-- spec: SPEC#value-tests-with-is
-- companion: reached-expression-panic
pub fn test_tag_mismatch_skips_expressions() {
    let failed: Result<int, str> = Err("failed")
    assert(!(failed is Ok(panic("unreached expected value"))))
    let nested: Result<?int, str> = Ok(None)
    assert(!(nested is Ok(Some(panic("unreached nested value")))))
}

-- [case: alternative-short-circuit, run-pass]
-- spec: SPEC#value-tests-with-is
pub fn test_alternative_short_circuit() {
    let mut trace: []int = []
    let mut mark = \n -> { trace !> Array::push(n); n }
    let result: Result<int, str> = Ok(1)
    assert(result is Ok(mark(0)) | Ok(mark(1)) | Ok(mark(2)))
    assert(trace == [0, 1])
}

-- [case: precedence-and-literal-ranges, run-pass]
-- spec: SPEC#value-tests-with-is
pub fn test_precedence_and_literal_ranges() {
    assert(3 is 1 + 2)
    assert(3 is 1 | 3)
    assert(3 is (1 | 2))
    assert(3 is 3 && 3 > 0)
    assert(!(3 is 3 && false))
    assert(3 is 4 || true)
    assert(3 is 1..=3)
    assert(!(3 is 1..3))
    assert(Some(true) is Some(1 < 2))
}

-- [case: wildcard-skips-payload-equality, run-pass]
-- spec: SPEC#value-tests-with-is
-- companion: reject-callable-equality
fn action() -> int { 1 }

pub fn test_wildcard_skips_payload_equality() {
    let result: Result<fn() -> int, str> = Ok(action)
    assert(result is Ok && result is Ok(_))
}

-- [case: payload-test-narrowing, run-pass]
-- spec: SPEC#value-tests-with-is
-- spec: SPEC#flow-sensitive-type-narrowing
-- companion: reject-trailing-guard
fn inspect(result: Result<int, str>, wanted: int) -> int {
    if result is Ok(wanted + 1) {
        result.0
    } else {
        result ?? \_error -> -1
    }
}

pub fn test_payload_test_narrowing() {
    assert(inspect(Ok(2), 1) == 2)
    assert(inspect(Ok(5), 1) == 5)
    assert(inspect(Err("failed"), 1) == -1)
    let result: Result<int, str> = Ok(7)
    assert(result is Ok && result.0 > 5)
}

-- [case: expected-expression-effects, run-pass]
-- spec: SPEC#value-tests-with-is
-- companion: reject-unhandled-expected-effect
eff Read { get() -> int }
fn check(result: Result<int, str>) -> bool @Read { result is Ok(Read::get()) }

pub fn test_expected_expression_effects() {
    var calls = 0
    with Read::get() -> { calls += 1; resume 42 }
    assert(check(Ok(42)))
    assert(!check(Err("failed")))
    assert(calls == 1)
}

-- [case: subject-captured-before-expected-write, run-pass]
-- spec: SPEC#value-tests-with-is
-- spec: SPEC#flow-sensitive-type-narrowing
-- companion: reject-refinement-after-expected-write
pub fn test_subject_captured_before_expected_write() {
    var value: ?int = Some(1)
    let mut expected = \-> { value = None; 1 }
    let matched = value is Some(expected())
    assert(matched && value == None)
}

-- [case: static-expected-expressions, check-pass]
-- spec: SPEC#value-tests-with-is
-- spec: SPEC#disjoint-call-families-evaluation-budgets-and-branch-pruning
meta fn expected() -> int { 2 }
meta let _ = assert(Some(2) is Some(expected()))
meta let _ = assert(3 is 1 + 2)
meta let _ = assert([1, 2] is Array::reverse([2, 1]))

-- [case: reached-expression-panic, run-panic]
-- spec: SPEC#value-tests-with-is
-- companion: tag-mismatch-skips-expressions
-- Panics: The matching tag reaches the expected-value expression
pub fn test_reached_expression_panic() {
    let result: Result<int, str> = Ok(1)
    let matched = result is Ok(panic("expected value reached"))
}

