-- [case: reject-refinement-after-expected-write, check-fail]
-- spec: SPEC#value-tests-with-is
-- spec: SPEC#flow-sensitive-type-narrowing
-- companion: subject-captured-before-expected-write
-- Error [E0310]: Completing is does not restore a refinement invalidated by expected-value evaluation
fn example() {
    var value: ?int = Some(1)
    let mut expected = \-> { value = None; 1 }
    if value is Some(expected()) {
        let after = value.0
    }
}
