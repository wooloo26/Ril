-- [pair: contradictory-refinement]
-- spec: SPEC#flow-sensitive-type-narrowing

-- accept
type Shape { Circle(int), Point }

fn example(shape: Shape) {
    if shape is Circle {} else if shape is Point {}
}

-- reject
-- Error [E0311]: reject contradictory refinement
type Shape { Circle(int), Point }

fn example(shape: Shape) {
    if shape is Circle { if shape is Point {} }
}

-- [pair: reassigned-refinement]
-- spec: SPEC#flow-sensitive-type-narrowing

-- accept
fn example() {
    var item: ?int = Some(1)
    if item != None { let value = item + 1; item = None }
}

-- reject
-- Error [E0310]: reject reassigned refinement
fn example() {
    var item: ?int = Some(1)
    if item != None { item = None; let value = item + 1 }
}

-- [pair: unknown-callback-independence]
-- spec: SPEC#flow-sensitive-type-narrowing

-- accept
type Cell = { mut value: ?int }
fn example(mut cell: Cell, action: fn() -> ()) &mut {
    let snapshot = clone_immut(cell)
    if snapshot.value != None {
        action()
        let _ = snapshot.value + 1
    }
    cell.value = None
}

-- reject
-- Error [E0533]: Unknown callback writes cannot establish independence for a live refinement; snapshot remains stable
type Cell = { mut value: ?int }
fn example(mut cell: Cell, action: fn() -> ()) &mut {
    if cell.value != None {
        action()
        let _ = cell.value + 1
    }
    cell.value = None
}

-- [case: guard-clause, run-pass]
-- spec: SPEC#flow-sensitive-type-narrowing
fn read(item: ?{ id: int }) -> int { if item == None { return -1 }; item.id }

pub fn test_guard_clause() {
    assert(read(Some(.{ id: 7 })) == 7 && read(None) == -1)
}

-- [pair: known-write-refinement]
-- spec: SPEC#flow-sensitive-type-narrowing

-- accept
type Cell = { mut value: ?int }
fn clear(mut cell: Cell) &mut { cell.value = None }

fn example(mut cell: Cell) &mut {
    if cell.value != None {
        let before = cell.value + 1
        clear(mut cell)
    }
}

-- reject
-- Error [E0310]: A known callee write invalidates the previously narrowed field
type Cell = { mut value: ?int }
fn clear(mut cell: Cell) &mut { cell.value = None }

fn example(mut cell: Cell) &mut {
    if cell.value != None {
        clear(mut cell)
        let after = cell.value + 1
    }
}

-- [case: known-write-and-renarrowing, run-pass]
-- spec: SPEC#flow-sensitive-type-narrowing
type Cell = { mut value: ?int }
fn clear(mut cell: Cell) &mut { cell.value = None }

pub fn test_known_write_and_renarrowing() {
    let mut cell = Cell.{ value: Some(7) }
    if cell.value != None {
        assert(cell.value + 1 == 8)
        clear(mut cell)
        if cell.value != None { panic("clear did not invalidate the value") }
    }
    assert(cell.value == None)
}
