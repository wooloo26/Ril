--@ source: nested-array-closures
--@ file: source.ril
type Reader = fn() -> int &closure
fn make(values: []int) -> Reader &capture {
    match values {
        [first, ..middle, final] -> {
            let count = len(middle)
            \-> (\-> first + final + count)()
        },
        _ -> \-> -1,
    }
}
pub fn test_native() {
    let first = make([1, 2, 3, 4])
    let second = make([10, 20])
    let absent = make([7])
    assert(first() == 7 && second() == 30 && absent() == -1)
    assert(second() == 30 && first() == 7)
}
--@ end-file
--@ end-source

