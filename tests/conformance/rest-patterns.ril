--@ source: array-rest-lengths
--@ file: source.ril
fn classify(values: []int) -> int {
    match values {
        [] -> 0,
        [single] -> single,
        [front, ..middle, back] -> front + back + len(middle) * 10,
    }
}
fn tail_length(values: []int) -> int {
    match values { [head, ..tail] -> head + len(tail), [] -> 0 }
}
pub fn test_native() {
    let fixed: [3]int = [10, 20, 30]
    let [x, y, z] = fixed
    assert(x == 10 && y == 20 && z == 30)
    assert(classify([]) == 0 && classify([7]) == 7)
    assert(classify([2, 8]) == 10 && classify([1, 2, 3, 4]) == 25)
    assert(tail_length([]) == 0 && tail_length([9]) == 9)
    assert(tail_length([9, 8, 7]) == 11)
}
--@ end-file
--@ end-source

