--@ source: array-rest-window
--@ file: source.ril
pub fn test_native() {
    let mut values: []int = [1, 2, 3, 4]
    let view [_, ..tail] = values
    values[1] = 9
    assert(tail[0] == 9 && len(tail) == 3)
    Array::push(mut values, 5)
    assert(len(values) == 5)
}
