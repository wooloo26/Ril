--@ source: conditional-array-rests
--@ file: source.ril
pub fn test_native() {
    let mut values = [1, 2, 3, 4]
    var total = 0
    while let [front, .., back] = values {
        total += front + back
        let _ = Array::pop(mut values)
    }
    assert(total == 12 && values == [1])
    let remaining = if let [head, ..tail] = values { head + len(tail) } else { 0 }
    assert(remaining == 1)
}
--@ end-file
--@ end-source

