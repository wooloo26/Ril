--@ source: nested-rest-layers
--@ file: source.ril
fn two(values: [2]int) -> int { values[0] + values[1] }
fn three(values: [3]int) -> int { values[0] + values[1] + values[2] }
fn zero(values: [0]int) -> int { len(values) }
pub fn test_native() {
    let left: [3]int = [1, 2, 3]
    let right: [4]int = [4, 5, 6, 7]
    let ([a, ..xs], [b, ..ys]) = (left, right)
    assert(a == 1 && b == 4 && two(xs) == 5 && three(ys) == 18)
    let ((head, ..), (.., last)) = ((10, 20), (30, 40))
    assert(head == 10 && last == 40)
    let (.{ id, ..first }, .{ id: other, ..second }) =
        (.{ id: 7, saved: 8 }, .{ id: 9, saved: 10 })
    assert(id == 7 && other == 9 && first.saved == 8 && second.saved == 10)
    let singleton: [1]int = [11]
    let [only, ..empty] = singleton
    assert(only == 11 && zero(empty) == 0)
}
--@ end-file
--@ end-source

