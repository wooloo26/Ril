--@ source: tuple-rest-positions
--@ file: source.ril
pub fn test_native() {
    let values = (10, "discarded", false, 50)
    let (first, .., final) = values
    let (head, ..) = (9,)
    let (.., suffix) = (true, 2)
    let (left, .., right) = (3, 4)
    assert(first == 10 && final == 50 && head == 9 && suffix == 2)
    assert(left == 3 && right == 4)
    let nested = (Some((6, "middle", 8)), 99)
    let (Some((start, .., end)), tag) = nested else { panic("missing tuple") }
    assert(start == 6 && end == 8 && tag == 99)
    assert((match () { (..) -> 7 }) == 7)
}
--@ end-file
--@ end-source

