--@ source: repeated-record-rest-views
--@ file: source.ril
fn pick(value: int) -> int {
    let items: [0][2]int = []
    let packet = .{ id: value, items }
    let .{ id, ..rest } = packet
    let alias = rest
    id + len(alias.items)
}
pub fn test_native() { assert(pick(7) == 7 && pick(9) == 9 && pick(7) == 7) }
--@ end-file
--@ end-source

