--@ source: record-rest-schema
--@ file: source.ril
type Packet = { id: int, items: [0][2]int, tag: str }
fn exact(items: [0][2]int) -> int { len(items) }
pub fn test_native() {
    let items: [0][2]int = []
    let packet = Packet.{ id: 7, items, tag: "saved" }
    let .{ id, ..rest } = packet
    let .{ tag, .. } = packet
    assert(id == 7 && rest.tag == "saved" && tag == "saved")
    assert(exact(rest.items) == 0)
}
--@ end-file
--@ end-source

