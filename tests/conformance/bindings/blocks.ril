-- [pair: local-effect-escape]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations

-- accept
fn example() -> int { with Local::read() -> resume 1
    Local::read()
where
    eff Local { read() -> int }
}

-- reject
-- Error [E0618]: reject local effect escape
fn example() -> int @Local { Local::read()
where
    eff Local { read() -> int }
}

-- [pair: local-nominal-escape]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations

-- accept
fn example() -> Token
where
    type Token = int
{ 1 }

-- reject
-- Error [E0315]: reject local nominal escape
fn example() -> Token
where
    type Token(int)
{ Token(1) }

-- [pair: sequential-function]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations

-- accept
fn example() { helper()
where
    fn helper() {}
}

-- reject
-- Error [E0703]: reject sequential function
fn example() { fn helper() {} }

-- [pair: sequential-type]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations

-- accept
fn example() { ()
where
    type Item = int
}

-- reject
-- Error [E0703]: reject sequential type
fn example() { type Item = int }

-- [pair: uninitialized-capture]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations

-- accept
fn example() -> int { let value = 1
    read()
where
    fn read() -> int &{closure, value} { value }
}

-- reject
-- Error [E0207]: reject uninitialized capture
fn example() -> int { read()
    let value = 1
    read()
where
    fn read() -> int &{closure, value} { value }
}

-- [pair: where-binding]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations

-- accept
fn example() { let value = 1
}

-- reject
-- Error [E0702]: reject where binding
fn example() { ()
where
    let value = 1
}
