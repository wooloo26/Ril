--@ case: separate-anonymous-capture-layers
--@ mode: run-pass
--@ spec: SPEC#state-groups-and-captured-layers
--@ companion: reject-merged-anonymous-capture-layers
--@ entry: test_separate_anonymous_capture_layers
--@ file: separate-anonymous-capture-layers.ril
pub fn test_separate_anonymous_capture_layers() {
    let run = \-> {
        var x = 0
        let mut nested = \-> {
            var y = 0
            leaf()
            where
                fn leaf() -> int &{closure, mut x} &{closure, mut y} {
                    x += 1
                    y += 1
                    x + y
                }
        }
        nested()
    }
    assert(run() == 2)
}
--@ end-file
--@ end-case

--@ case: reject-merged-anonymous-capture-layers
--@ mode: check-fail
--@ spec: SPEC#state-groups-and-captured-layers
--@ companion: separate-anonymous-capture-layers
-- Error [E0538]: Different anonymous callable layers cannot share one capture group
--@ file: reject-merged-anonymous-capture-layers.ril
fn example() {
    let run = \-> {
        var x = 0
        let mut nested = \-> {
            var y = 0
            leaf()
            where
                fn leaf() -> int &{closure, mut x, mut y} {
                    x += 1
                    y += 1
                    x + y
                }
        }
        nested()
    }
    assert(run() == 2)
}
--@ end-file
--@ end-case
