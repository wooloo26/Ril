-- [pair: callable-type-contract-reference]
-- spec: SPEC#named-function-state-contract-references

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
type Action = fn() -> () &{mut count}

-- reject
-- Error [E0539]: reject callable type contract reference
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
type Action = fn() -> () &advance

-- [pair: closed-row-hazard]
-- spec: SPEC#callable-contracts

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example(action: fn() -> ()) &{mut count} { advance(); action() }

-- reject
-- Error [E0534]: reject closed row hazard
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example(action: fn() -> ()) &{} { advance(); action() }

-- [pair: empty-capture-group]
-- spec: SPEC#state-groups-and-captured-layers

-- accept
fn example() {}

-- reject
-- Error [E0538]: reject empty capture group
fn example() &{closure,} {}

-- [pair: empty-provider-reference]
-- spec: SPEC#named-function-state-contract-references

-- accept
fn nothing() {}
fn example() { nothing() }

-- reject
-- Error [E0529]: reject empty provider reference
fn nothing() {}
fn example() &nothing { nothing() }

-- [pair: excess-capability]
-- spec: SPEC#retained-mutable-sharing

-- accept
fn example() {}

-- reject
-- Error [E0529]: reject excess capability
fn example() &mut {}

-- [pair: first-order-empty-both]
-- spec: SPEC#empty-rows-on-higher-order-signatures

-- accept
fn example(action: fn() -> ()) @{} &{} { action() }

-- reject
-- Error [E0542]: reject first order empty both
fn example() @{} &{} {}

-- [pair: first-order-empty-effect]
-- spec: SPEC#empty-rows-on-higher-order-signatures

-- accept
fn example(action: fn() -> ()) @{} { action() }

-- reject
-- Error [E0542]: reject first order empty effect
fn example() @{} {}

-- [pair: first-order-empty-state]
-- spec: SPEC#empty-rows-on-higher-order-signatures

-- accept
fn example(action: fn() -> ()) &{} { action() }

-- reject
-- Error [E0542]: reject first order empty state
fn example() &{} {}

-- [pair: missing-alias]
-- spec: SPEC#external-state-tracking

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() &{mut count} { let action = advance; action() }

-- reject
-- Error [E0510]: reject missing alias
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() { let action = advance; action() }

-- [pair: missing-callback]
-- spec: SPEC#external-state-tracking

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() &{mut count} { invoke(advance) }

-- reject
-- Error [E0510]: reject missing callback
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() { invoke(advance) }

-- [pair: missing-callee]
-- spec: SPEC#external-state-tracking

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() &{mut count} { advance() }

-- reject
-- Error [E0510]: reject missing callee
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() { advance() }

-- [pair: missing-direct]
-- spec: SPEC#external-state-tracking

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() &{mut count} { count += 1 }

-- reject
-- Error [E0510]: reject missing direct
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() { count += 1 }

-- [pair: value-contract-provider]
-- spec: SPEC#named-function-state-contract-references

-- accept
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
fn example() &advance { advance() }

-- reject
-- Error [E0539]: reject value contract provider
var count = 0
fn advance() &{mut count} { count += 1 }
fn invoke(action: fn() -> ()) { action() }
let ACTION = advance
fn example() &ACTION { advance() }

-- [pair: wrong-capture-group]
-- spec: SPEC#state-groups-and-captured-layers

-- accept
fn outer() { var count = 0; inner()
where
    fn inner() &{closure, mut count} { count += 1 }
}

-- reject
-- Error [E0538]: reject wrong capture group
fn outer() { var count = 0; inner()
where
    fn inner() &{mut count} { count += 1 }
}

-- [case: farther-named-capture-owner, run-pass]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: reject-missing-farther-capture-owner
fn outer_layer() -> int {
    var count = 0
    middle()
where
    fn middle() -> int &{closure, mut count} {
        inner()
    where
        fn inner() -> int &{closure outer_layer, mut count} {
            count += 1
            count
        }
    }
}

pub fn test_farther_named_capture_owner() {
    assert(outer_layer() == 1)
}

-- [case: reject-missing-farther-capture-owner, check-fail]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: farther-named-capture-owner
-- Error [E0538]: A capture from a farther named callable must name its owner
fn outer_layer() -> int {
    var count = 0
    middle()
where
    fn middle() -> int &{closure, mut count} {
        inner()
    where
        fn inner() -> int &{closure, mut count} {
            count += 1
            count
        }
    }
}

-- [case: reject-wrong-farther-capture-owner, check-fail]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: farther-named-capture-owner
-- Error [E0538]: An explicit owner must match the resolved binding's declaring layer
fn outer_layer() -> int {
    var count = 0
    middle()
where
    fn middle() -> int &{closure, mut count} {
        inner()
    where
        fn inner() -> int &{closure middle, mut count} {
            count += 1
            count
        }
    }
}

-- [case: separate-anonymous-capture-layers, run-pass]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: reject-merged-anonymous-capture-layers
pub fn test_separate_anonymous_capture_layers() {
    let run = \-> {
        var x = 0
        let mut nested = \-> {
            var y = 0
            leaf()
        where
            fn leaf() -> int &{closure, mut x} &{closure, mut y} {
                x += 1
                y += 1
                x + y
            }
        }
        nested()
    }
    assert(run() == 2)
}

-- [case: reject-merged-anonymous-capture-layers, check-fail]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: separate-anonymous-capture-layers
-- Error [E0538]: Different anonymous callable layers cannot share one capture group
fn example() {
    let run = \-> {
        var x = 0
        let mut nested = \-> {
            var y = 0
            leaf()
        where
            fn leaf() -> int &{closure, mut x, mut y} {
                x += 1
                y += 1
                x + y
            }
        }
        nested()
    }
    assert(run() == 2)
}
