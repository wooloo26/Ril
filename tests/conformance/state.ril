-- [case: accept-wrong-capture-group, check-pass]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: reject-wrong-capture-group
fn outer() { var count = 0; inner()
where
    fn inner() &{closure, mut count} { count += 1 }
}

-- [case: reject-wrong-capture-group, check-fail]
-- spec: SPEC#state-groups-and-captured-layers
-- companion: accept-wrong-capture-group
