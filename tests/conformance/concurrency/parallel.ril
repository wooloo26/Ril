-- [pair: outside-write]
-- spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives

-- accept
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let value = 1
    let _ = Parallel::map([1], \n -> n + value)
}

-- reject
-- Error [E0605]: reject outside write
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let mut cell = Cell.{ count: 0 }
    let _ = Parallel::map([1], \n -> { cell.count += n; n })
}

-- [pair: overlapping-writes]
-- spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives

-- accept
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let mut copy = (Cell.{ count: 0 }, Cell.{ count: 0 })
    let _ = Parallel::join(\-> { copy.0.count += 1 }, \-> { copy.1.count += 1 })
}

-- reject
-- Error [E0619]: reject overlapping writes
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let original = Cell.{ count: 0 }
    let mut copy = ^mut clone((original, original))
    let _ = Parallel::join(\-> { copy.0.count += 1 }, \-> { copy.1.count += 1 })
}

-- [pair: pseudo-effect]
-- spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives

-- accept
fn example() {}

-- reject
-- Error [E0620]: reject pseudo effect
fn example() @Parallel {}

-- [case: square-all-immutable-input, run-pass]
-- spec: STD#deterministic-data-parallelism-and-divide-and-conquer-primitives
-- spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives
-- companion: square-all-live-read-input
-- entry: test_native
-- file: source.ril
use ril/parallel
halt fn square_all(numbers:Immut<[]f64>)->[]f64{
    numbers |> Parallel::map(\x->x*x)
}
pub fn test_native(){
    let numbers: Immut<[]f64> = clone([1.5, 2.0])
    assert(square_all(numbers) == [2.25, 4.0])
}

-- [case: square-all-live-read-input, check-fail]
-- spec: STD#deterministic-data-parallelism-and-divide-and-conquer-primitives
-- companion: square-all-immutable-input
-- Error [E0605]: a read-only formal can still denote live input.
-- file: source.ril
use ril/parallel
halt fn square_all(numbers:[]f64)->[]f64{
    numbers |> Parallel::map(\x->x*x)
}

-- [case: square-all-unbounded-callback, check-fail]
-- spec: STD#deterministic-data-parallelism-and-divide-and-conquer-primitives
-- companion: square-all-immutable-input
-- Error [E0820]: a pipeline retains its actual callback's termination obligation.
-- file: source.ril
use ril/parallel
fn spin(value:f64)->f64{loop{}}
halt fn square_all(numbers:Immut<[]f64>)->[]f64{
    numbers |> Parallel::map(spin)
}
