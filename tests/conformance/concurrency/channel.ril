-- [pair: live-payload]
-- spec: SPEC#structured-concurrency-channels

-- accept
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel
type Cell = { mut count: int }

fn example() @Async {
    let result = scope \mut s -> {
        let task = s.fork(\-> ())
        let (mut tx, mut rx) = Channel::bounded<Cell>(1)
        let mut cell = Cell.{ count: 0 }
        let snapshot = clone(cell)
        assert((tx !> Channel::send(snapshot)) is Ok())
        assert((rx !> Channel::recv()) is Ok(_))
        cell.count += 1
        task.join()?
        Ok()
    }
    assert(result is Ok())
}

-- reject
-- Error [E0602]: reject live payload
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel
type Cell = { mut count: int }

fn example() @Async {
    let result = scope \mut s -> {
        let task = s.fork(\-> ())
        let (mut tx, mut rx) = Channel::bounded<Cell>(1)
        let mut cell = Cell.{ count: 0 }
        assert((tx !> Channel::send(cell)) is Ok())
        assert((rx !> Channel::recv()) is Ok(_))
        cell.count += 1
        task.join()?
        Ok()
    }
    assert(result is Ok())
}

-- [pair: use-after-detach]
-- spec: SPEC#structured-concurrency-channels

-- accept
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

fn example() @Async {
    let result = scope \mut s -> {
        let task = s.fork(\-> ())
        let (tx, mut rx) = Channel::bounded<int>(1)
        let ticket = Channel::detach(mut rx)
        let local = Channel::attach(ticket)
        Channel::close(local)
        Channel::close(tx)
        task.join()?; Ok()
    }
    assert(result is Ok())
}

-- reject
-- Error [E0603]: reject use after detach
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

fn example() @Async {
    let result = scope \mut s -> {
        let task = s.fork(\-> ())
        let (tx, mut rx) = Channel::bounded<int>(1)
        let ticket = Channel::detach(mut rx)
        Channel::close(rx)
        let local = Channel::attach(ticket)
        Channel::close(local)
        Channel::close(tx)
        task.join()?; Ok()
    }
    assert(result is Ok())
}
