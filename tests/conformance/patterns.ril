-- [case: accept-alternative-binders, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-alternative-binders
type Choice { Left(int), Right(int) }

fn example(item: Choice) {
    match item { Left(x) | Right(x) -> () }
}

-- [case: reject-alternative-binders, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-alternative-binders
-- Error [E0346]: reject alternative binders
type Choice { Left(int), Right(int) }

fn example(item: Choice) {
    match item { Left(x) | Right(y) -> () }
}

-- [case: accept-computed-pattern, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-computed-pattern
fn example(item: int) {
    match item { 3 -> (), _ -> () }
}

-- [case: reject-computed-pattern, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-computed-pattern
-- Error [E0349]: reject computed pattern
fn example(item: int) {
    match item { (1 + 2) -> (), _ -> () }
}

-- [case: accept-duplicate-binder, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-duplicate-binder
fn example() {
    let (first, second) = (1, 2)
}

-- [case: reject-duplicate-binder, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-duplicate-binder
-- Error [E0347]: reject duplicate binder
fn example() {
    let (same, same) = (1, 2)
}

-- [case: accept-guard-not-exhaustive, check-pass]
-- spec: SPEC#pattern-syntax-or-patterns-and-exhaustiveness
-- companion: reject-guard-not-exhaustive
fn example(item: int) {
    match item { value if value >= 0 -> (), _ -> () }
}

-- [case: reject-guard-not-exhaustive, check-fail]
-- spec: SPEC#pattern-syntax-or-patterns-and-exhaustiveness
-- companion: accept-guard-not-exhaustive
-- Error [E0303]: reject guard not exhaustive
fn example(item: int) {
    match item { value if value >= 0 -> (), value if value < 0 -> () }
}

-- [case: accept-match-branch-type, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-match-branch-type
fn example(item: bool) {
    let value = match item { true -> 1, false -> 2 }
}

-- [case: reject-match-branch-type, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-match-branch-type
-- Error [E0351]: reject match branch type
fn example(item: bool) {
    let value = match item { true -> 1, false -> "a" }
}

-- [case: accept-nondivergent-else, check-pass]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
-- companion: reject-nondivergent-else
fn example(item: ?int) {
    let Some(value) = item else { return }
}

-- [case: reject-nondivergent-else, check-fail]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
-- companion: accept-nondivergent-else
-- Error [E0321]: reject nondivergent else
fn example(item: ?int) {
    let Some(value) = item else { () }
}

-- [case: accept-nonexhaustive-match, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-nonexhaustive-match
fn example(item: ?int) {
    match item { Some(value) -> (), None -> () }
}

-- [case: reject-nonexhaustive-match, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-nonexhaustive-match
-- Error [E0303]: reject nonexhaustive match
fn example(item: ?int) {
    match item { Some(value) -> () }
}

