-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
-- companion: accept-refutable-binding
-- Error [E0345]: reject refutable binding
fn example(item: ?int) {
    let Some(value) = item
}

-- [case: accept-refutable-for-pattern, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-refutable-for-pattern
fn example(items: []?int) {
    for items as value {}
}

-- [case: reject-refutable-for-pattern, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-refutable-for-pattern
-- Error [E0345]: reject refutable for pattern
fn example(items: []?int) {
    for items as Some(value) {}
}

-- [case: accept-reversed-range, check-pass]
-- spec: SPEC#pattern-matching
-- companion: reject-reversed-range
fn example(item: int) {
    match item { 1..=5 -> (), _ -> () }
}

-- [case: reject-reversed-range, check-fail]
-- spec: SPEC#pattern-matching
-- companion: accept-reversed-range
-- Error [E0348]: reject reversed range
fn example(item: int) {
    match item { 5..=1 -> (), _ -> () }
