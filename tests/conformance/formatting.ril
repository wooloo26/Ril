-- [case: reject-wrapper-format, check-fail]
-- spec: SPEC#text-and-byte-literals
-- companion: accept-wrapper-format
-- Error [E0329]: reject wrapper format
type Token(int)

fn example() {
    let value = "{Token(1)}"
}

-- [case: numeric-and-layout, run-pass]
-- spec: SPEC#text-and-byte-literals
pub fn test_numeric_and_layout() {
    assert("{-42:05}" == "-0042")
    assert("{1.25:.1f}" == "1.2")
    assert("{12.5:.2e}" == "1.25e1")
    assert("{1.0:.0f}" == "1")
    assert("{-0.0}" == "-0.0")
    assert("{true}" == "true")
    let text = "é🙂x"
    assert("{text:.2s}" == "é🙂")
    let one = "x"
    assert("{one:^4}" == " x  ")
    assert("{42:X}" == "2A" && "{42:b}" == "101010" && "{42:o}" == "52")
}
