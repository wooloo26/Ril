-- [case: accept-boolean-precision, check-pass]
-- spec: SPEC#text-and-byte-literals
-- companion: reject-boolean-precision
type Token(int)

fn example() {
    let value = "{1}"
}

-- [case: reject-boolean-precision, check-fail]
-- spec: SPEC#text-and-byte-literals
-- companion: accept-boolean-precision
-- Error [E0329]: reject boolean precision
type Token(int)

fn example() {
    let value = "{true:.2}"
}

