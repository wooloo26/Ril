-- [case: accept-bare-effect, check-pass]
-- spec: SPEC#type-definition-boundaries
-- companion: reject-bare-effect
eff Io { read() -> int }
type Reader = fn() -> int @Io

-- [case: reject-bare-effect, check-fail]
-- spec: SPEC#type-definition-boundaries
-- companion: accept-bare-effect
-- Error [E0330]: reject bare effect
eff Io { read() -> int }
type Invalid = @Io

