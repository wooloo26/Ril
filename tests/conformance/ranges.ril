--@ case: accept-live-window-structural-change
--@ mode: check-pass
--@ spec: SPEC#range-and-slicing-expressions
--@ companion: reject-live-window-structural-change
--@ file: accept-live-window-structural-change.ril
fn example() {
    let mut items = [1, 2]
    let view window = items[..]
    assert(len(window) == 2)
    items !> Array::push(3)
}
--@ end-file
--@ end-case

--@ case: reject-live-window-structural-change
--@ mode: check-fail
--@ spec: SPEC#range-and-slicing-expressions
--@ companion: accept-live-window-structural-change
-- Error [E0537]: reject live window structural change
--@ file: reject-live-window-structural-change.ril
fn example() {
    let mut items = [1, 2]
    let view window = items[..]
    items !> Array::push(3)
    assert(len(window) == 2)
}
--@ end-file
--@ end-case

