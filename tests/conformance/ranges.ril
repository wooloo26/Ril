-- [case: accept-live-window-structural-change, check-pass]
-- spec: SPEC#range-and-slicing-expressions
-- companion: reject-live-window-structural-change
fn example() {
    let mut items = [1, 2]
    let view window = items[..]
    assert(len(window) == 2)
    items !> Array::push(3)
}

-- [case: reject-live-window-element-write, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- companion: window-observes-replacement
-- Error [E0520]: A slice window grants no element writer even when its backing has one.
fn invalid() {
    let mut items = [1, 2, 3]
    items[0] = 7
    let view window = items[1..]
    window[0] = 9
}

-- [case: reject-live-window-structural-change, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- companion: accept-live-window-structural-change
-- Error [E0537]: reject live window structural change
fn example() {
    let mut items = [1, 2]
    let view window = items[..]
    items !> Array::push(3)
    assert(len(window) == 2)
}

