-- [case: range-boundaries, run-pass]
-- spec: SPEC#range-and-slicing-expressions
pub fn test_range_boundaries() {
    var count = 0
    for 254u8..=255u8 as value { assert(value >= 254u8); count += 1 }
    assert(count == 2)
    assert(!(3 in 5..1) && !(5 in 5..5) && 5 in 5..=5)
    assert((0..5) != (0..=5))
    let values = [10, 20, 30]
    assert(values[..2] == [10, 20])
    assert(values[1..] == [20, 30])
    assert(values[1..=] == [20, 30])
    assert(values[3..3] == [])
}

