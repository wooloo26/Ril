-- [case: window-observes-replacement, run-pass]
-- spec: SPEC#range-and-slicing-expressions
pub fn test_window_observes_replacement() {
    let mut items = [1, 2]
    let view window = items[..]
    items[0] = 9
    assert(window[0] == 9)
    items !> Array::push(3)
    assert(len(items) == 3)
}
