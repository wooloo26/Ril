--@ case: accept-function-auto-tuple
--@ mode: check-pass
--@ spec: SPEC#constructor-tuple-equivalence-invariant
--@ companion: reject-function-auto-tuple
--@ file: accept-function-auto-tuple.ril
fn add(a: int, b: int) -> int { a + b }

fn example() {
    let value = add(1, 2)
}
--@ end-file
--@ end-case

--@ case: reject-function-auto-tuple
--@ mode: check-fail
