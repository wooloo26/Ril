--@ companion: accept-function-auto-tuple
-- Error [E0314]: reject function auto tuple
--@ file: reject-function-auto-tuple.ril
fn add(a: int, b: int) -> int { a + b }

fn example() {
    let value = add((1, 2))
}
--@ end-file
--@ end-case

