-- [pair: function-auto-tuple]
-- spec: SPEC#constructor-tuple-equivalence-invariant

-- accept
fn add(a: int, b: int) -> int { a + b }

fn example() {
    let value = add(1, 2)
}

-- reject
-- Error [E0314]: reject function auto tuple
fn add(a: int, b: int) -> int { a + b }

fn example() {
    let value = add((1, 2))
}

-- [pair: hidden-existential]
-- spec: SPEC#sum-types-and-gadts

-- accept
type Packed<T> { Item<U>(U) -> Packed<U> }

-- reject
-- Error [E0354]: reject hidden existential
type Packed { Item<U>(U) }

-- [pair: impossible-gadt-arm]
-- spec: SPEC#sum-types-and-gadts

-- accept
type Expr<T> { LitInt(int) -> Expr<int>, LitBool(bool) -> Expr<bool> }
fn eval<T>(expr: Expr<T>) -> T {
    match expr { LitInt(n) -> n, LitBool(b) -> b }
}

fn example(expr: Expr<int>) {
    match expr { LitInt(n) -> () }
}

-- reject
-- Error [E0304]: reject impossible gadt arm
type Expr<T> { LitInt(int) -> Expr<int>, LitBool(bool) -> Expr<bool> }
fn eval<T>(expr: Expr<T>) -> T {
    match expr { LitInt(n) -> n, LitBool(b) -> b }
}

fn example(expr: Expr<int>) {
    match expr { LitInt(n) -> (), LitBool(b) -> () }
}

-- [pair: nested-constructor-flattening]
-- spec: SPEC#constructor-tuple-equivalence-invariant

-- accept
type Node { Branch((int, int), str) }

fn example() {
    let value = Branch((1, 2), "a")
}

-- reject
-- Error [E0314]: reject nested constructor flattening
type Node { Branch((int, int), str) }

fn example() {
    let value = Branch(1, 2, "a")
}

-- [pair: nullary-call]
-- spec: SPEC#constructor-tuple-equivalence-invariant

-- accept
fn example() {
    let value: ?int = None
}

-- reject
-- Error [E0353]: reject nullary call
fn example() {
    let value: ?int = None()
}

-- [pair: wrong-result-declaration]
-- spec: SPEC#sum-types-and-gadts

-- accept
type Packed<T> { Item(T) -> Packed<T> }

-- reject
-- Error [E0354]: reject wrong result declaration
type Packed<T> { Item(T) -> bool }

-- [case: constructor-canonical-callable, run-pass]
-- spec: SPEC#constructor-tuple-equivalence-invariant
type Pair { Item(int, str) }

pub fn test_constructor_canonical_callable() {
    let make: fn((int, str)) -> Pair = Pair::Item
    let expanded: fn(int, str) -> Pair = Pair::Item
    assert(make((1, "a")) == expanded(1, "a"))
    assert(Item(1, "a") == Item((1, "a")))
    let result: Result<(), str> = Ok()
    assert(result is Ok())
}

-- [case: gadt-refinement, run-pass]
-- spec: SPEC#sum-types-and-gadts
type Expr<T> { LitInt(int) -> Expr<int>, LitBool(bool) -> Expr<bool> }
fn eval<T>(expr: Expr<T>) -> T {
    match expr { LitInt(n) -> n, LitBool(b) -> b }
}

pub fn test_gadt_refinement() {
    assert(eval(LitInt(3)) == 3)
    assert(eval(LitBool(true)))
}
