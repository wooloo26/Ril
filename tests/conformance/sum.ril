-- [case: accept-function-auto-tuple, check-pass]
-- spec: SPEC#constructor-tuple-equivalence-invariant
-- companion: reject-function-auto-tuple
fn add(a: int, b: int) -> int { a + b }

fn example() {
    let value = add(1, 2)
}

-- [case: reject-function-auto-tuple, check-fail]
-- spec: SPEC#constructor-tuple-equivalence-invariant
-- companion: accept-function-auto-tuple
-- Error [E0314]: reject function auto tuple
fn add(a: int, b: int) -> int { a + b }

fn example() {
    let value = add((1, 2))
}

-- [case: accept-hidden-existential, check-pass]
-- spec: SPEC#sum-types-and-gadts
-- companion: reject-hidden-existential
type Packed<T> { Item<U>(U) -> Packed<U> }

-- [case: reject-hidden-existential, check-fail]
-- spec: SPEC#sum-types-and-gadts
-- companion: accept-hidden-existential
