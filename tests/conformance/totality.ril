--@ case: bounded-divergence
--@ mode: run-pass
--@ spec: SPEC#finite-evaluation-with-div
--@ entry: test_bounded_divergence
--@ file: bounded-divergence.ril
fn spin() -> int { loop {} }
halt fn attempt() -> ?int { with Div::exhausted() -> None; with Div::budget(100); Some(spin()) }

pub fn test_bounded_divergence() {
    assert(attempt() == None)
}
--@ end-file
--@ end-case

--@ case: mutual-descent
--@ mode: run-pass
--@ spec: SPEC#termination-and-halt-contracts
--@ entry: test_mutual_descent
--@ file: mutual-descent.ril
halt fn even(n: int) -> bool { if n <= 0 { true } else { odd(n - 1) } }
fn odd(n: int) -> bool { if n <= 0 { false } else { even(n - 1) } }

pub fn test_mutual_descent() {
    assert(even(8) && !even(9))
}
--@ end-file
--@ end-case

--@ case: negative-budget-safe
--@ mode: run-pass
--@ spec: SPEC#finite-evaluation-with-div
--@ companion: negative-budget
--@ entry: test_negative_budget_safe
--@ file: negative-budget-safe.ril
fn one() -> int { 1 }

pub fn test_negative_budget_safe() {
    with Div::exhausted() -> ()
    let _ = Div::budget(1, one)
}
--@ end-file
--@ end-case

--@ case: negative-budget
--@ mode: run-panic
--@ spec: SPEC#finite-evaluation-with-div
--@ companion: negative-budget-safe
--@ entry: test_negative_budget
-- Panics: negative budget
--@ file: negative-budget.ril
fn one() -> int { 1 }

pub fn test_negative_budget() {
    with Div::exhausted() -> ()
    let _ = Div::budget(-1, one)
}
--@ end-file
--@ end-case

--@ case: nested-budget-outer-wins
--@ mode: run-pass
--@ spec: SPEC#finite-evaluation-with-div
--@ entry: test_nested_budget_outer_wins
--@ file: nested-budget-outer-wins.ril
fn spin() -> int { loop {} }
halt fn attempt() -> ?int { with Div::exhausted() -> None; with Div::budget(2); with Div::exhausted() -> Some(99); with Div::budget(100); Some(spin()) }

pub fn test_nested_budget_outer_wins() {
    assert(attempt() == None)
}
--@ end-file
--@ end-case

--@ case: zero-one-budget
--@ mode: run-pass
--@ spec: SPEC#finite-evaluation-with-div
--@ entry: test_zero_one_budget
--@ file: zero-one-budget.ril
fn one() -> int { 1 }
fn attempt(limit: int) -> ?int { with Div::exhausted() -> None; Some(Div::budget(limit, one)) }

pub fn test_zero_one_budget() {
    assert(attempt(0) == None)
    assert(attempt(1) == Some(1))
}
--@ end-file
--@ end-case
