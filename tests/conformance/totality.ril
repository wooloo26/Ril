-- [case: accept-callback-divergence, check-pass]
-- spec: SPEC#termination-and-halt-contracts
-- companion: reject-callback-divergence
halt fn invoke(action: fn() -> ()) { action() }
fn spin() { loop {} }
fn done() {}

fn example() {
    invoke(done)
}

-- [case: reject-callback-divergence, check-fail]
-- spec: SPEC#termination-and-halt-contracts
-- companion: accept-callback-divergence
-- Error [E0534]: reject callback divergence
halt fn invoke(action: fn() -> ()) { action() }
fn spin() { loop {} }
fn done() {}

fn example() {
    invoke(spin)
}

-- [case: accept-excluded-yield, check-pass]
-- spec: SPEC#finite-evaluation-with-div
-- companion: reject-excluded-yield
fn example() {
    with Fiber::yield() -> resume ()
    Fiber::yield()
}

-- [case: reject-excluded-yield, check-fail]
-- spec: SPEC#finite-evaluation-with-div
-- companion: accept-excluded-yield
-- Error [E0822]: reject excluded yield
fn example() {
    with Div::exhausted() -> ()
    with Fiber::yield() -> resume ()
    with Div::budget(100)
    Fiber::yield()
}

-- [case: accept-outward-effect, check-pass]
-- spec: SPEC#termination-and-halt-contracts
-- companion: reject-outward-effect
fn example() @Fiber { Fiber::yield() }

-- [case: reject-outward-effect, check-fail]
-- spec: SPEC#termination-and-halt-contracts
-- companion: accept-outward-effect
-- Error [E0821]: reject outward effect
halt fn example() @Fiber { Fiber::yield() }

-- [case: accept-outward-state, check-pass]
-- spec: SPEC#termination-and-halt-contracts
-- companion: reject-outward-state
var count = 0
fn example() &{mut count} { count += 1 }

-- [case: reject-outward-state, check-fail]
-- spec: SPEC#termination-and-halt-contracts
-- companion: accept-outward-state
-- Error [E0821]: reject outward state
var count = 0
halt fn example() &{mut count} { count += 1 }

-- [case: accept-resume-exhaustion, check-pass]
-- spec: SPEC#finite-evaluation-with-div
-- companion: reject-resume-exhaustion
fn one() -> int { 1 }

fn example() {
    with Div::exhausted() -> ()
    let _ = Div::budget(0, one)
}

-- [case: reject-resume-exhaustion, check-fail]
-- spec: SPEC#finite-evaluation-with-div
-- companion: accept-resume-exhaustion
-- Error [E0822]: reject resume exhaustion
fn one() -> int { 1 }

fn example() {
    with Div::exhausted() -> resume ()
    let _ = Div::budget(0, one)
}

-- [case: accept-unbounded-loop, check-pass]
-- spec: SPEC#termination-and-halt-contracts
-- companion: reject-unbounded-loop
fn forever() { loop {} }

-- [case: reject-unbounded-loop, check-fail]
-- spec: SPEC#termination-and-halt-contracts
-- companion: accept-unbounded-loop
-- Error [E0820]: reject unbounded loop
halt fn forever() { loop {} }

-- [case: bounded-divergence, run-pass]
-- spec: SPEC#finite-evaluation-with-div
fn spin() -> int { loop {} }
halt fn attempt() -> ?int { with Div::exhausted() -> None; with Div::budget(100); Some(spin()) }

pub fn test_bounded_divergence() {
    assert(attempt() == None)
}

-- [case: mutual-descent, run-pass]
-- spec: SPEC#termination-and-halt-contracts
halt fn even(n: int) -> bool { if n <= 0 { true } else { odd(n - 1) } }
fn odd(n: int) -> bool { if n <= 0 { false } else { even(n - 1) } }

pub fn test_mutual_descent() {
    assert(even(8) && !even(9))
}

-- [case: negative-budget-safe, run-pass]
-- spec: SPEC#finite-evaluation-with-div
-- companion: negative-budget
fn one() -> int { 1 }

pub fn test_negative_budget_safe() {
    with Div::exhausted() -> ()
    let _ = Div::budget(1, one)
}

-- [case: negative-budget, run-panic]
-- spec: SPEC#finite-evaluation-with-div
-- companion: negative-budget-safe
-- Panics: negative budget
fn one() -> int { 1 }

pub fn test_negative_budget() {
    with Div::exhausted() -> ()
    let _ = Div::budget(-1, one)
}

-- [case: nested-budget-outer-wins, run-pass]
-- spec: SPEC#finite-evaluation-with-div
fn spin() -> int { loop {} }
halt fn attempt() -> ?int { with Div::exhausted() -> None; with Div::budget(2); with Div::exhausted() -> Some(99); with Div::budget(100); Some(spin()) }

pub fn test_nested_budget_outer_wins() {
    assert(attempt() == None)
}

-- [case: zero-one-budget, run-pass]
-- spec: SPEC#finite-evaluation-with-div
fn one() -> int { 1 }
fn attempt(limit: int) -> ?int { with Div::exhausted() -> None; Some(Div::budget(limit, one)) }

pub fn test_zero_one_budget() {
    assert(attempt(0) == None)
    assert(attempt(1) == Some(1))
}
