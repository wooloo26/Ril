--@ case: accept-callback-divergence
--@ mode: check-pass
--@ spec: SPEC#termination-and-halt-contracts
--@ companion: reject-callback-divergence
--@ file: accept-callback-divergence.ril
halt fn invoke(action: fn() -> ()) { action() }
fn spin() { loop {} }
fn done() {}

fn example() {
    invoke(done)
}
--@ end-file
--@ end-case

--@ case: reject-callback-divergence
--@ mode: check-fail
--@ spec: SPEC#termination-and-halt-contracts
--@ companion: accept-callback-divergence
-- Error [E0534]: reject callback divergence
--@ file: reject-callback-divergence.ril
halt fn invoke(action: fn() -> ()) { action() }
fn spin() { loop {} }
fn done() {}

fn example() {
    invoke(spin)
}
--@ end-file
--@ end-case

--@ case: accept-excluded-yield
--@ mode: check-pass
--@ spec: SPEC#finite-evaluation-with-div
--@ companion: reject-excluded-yield
--@ file: accept-excluded-yield.ril
fn example() {
    with Fiber::yield() -> resume ()
    Fiber::yield()
}
--@ end-file
--@ end-case

--@ case: reject-excluded-yield
--@ mode: check-fail
--@ spec: SPEC#finite-evaluation-with-div
--@ companion: accept-excluded-yield
-- Error [E0822]: reject excluded yield
--@ file: reject-excluded-yield.ril
fn example() {
    with Div::exhausted() -> ()
    with Fiber::yield() -> resume ()
    with Div::budget(100)
    Fiber::yield()
}
--@ end-file
--@ end-case

