-- [pair: const-sort]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
type Token<size: int>(int)

fn example() {
    let value: Token<1> = Token(1)
}

-- reject
-- Error [E0323]: reject const sort
type Token<size: int>(int)

fn example() {
    let value: Token<"1"> = Token(1)
}

-- [pair: forward-default]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
type Pair<T = int, U = T> = (T, U)

-- reject
-- Error [E0320]: reject forward default
type Pair<T = U, U = int> = (T, U)

-- [pair: function-default]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
fn echo<T>(value: T) -> T { value }

-- reject
-- Error [E0317]: reject function default
fn echo<T = int>(value: T) -> T { value }

-- [pair: generic-arity]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
type Item = Option<int>

-- reject
-- Error [E0340]: reject generic arity
type Item = Option<int, str>

-- [pair: literal-type]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
type Method { Get }

-- reject
-- Error [E0318]: reject literal type
type Method = "GET"

-- [pair: missing-inference]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
fn empty<T>() -> []T { [] }

fn example() {
    let values: []int = empty()
}

-- reject
-- Error [E0344]: reject missing inference
fn empty<T>() -> []T { [] }

fn example() {
    let values = empty()
}

-- [pair: nontrailing-default]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
type Pair<T = int, U = int> = (T, U)

-- reject
-- Error [E0316]: reject nontrailing default
type Pair<T = int, U> = (T, U)

-- [pair: runtime-const]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts

-- accept
type Token<size: int>(int)

fn example(size: int) {
    let value: Token<1> = Token(1)
}

-- reject
-- Error [E0814]: reject runtime const
type Token<size: int>(int)

fn example(size: int) {
    let value: Token<size> = Token(1)
}

-- [case: static-argument-identity, check-pass]
-- spec: SPEC#generic-parameters-defaults-and-value-sorts
type Token<value: f64>(int)
type Point<value: { x: int, y: int }>(int)
type Order<value: [str: int]>(int)
meta let _ = assert(type<Token<0.0>> != type<Token<-0.0>>)
meta let _ = assert(type<Token<0.0 / 0.0>> == type<Token<0.0 / 0.0>>)
meta let _ = assert(type<Point<.{ x: 1, y: 2 }>> == type<Point<.{ y: 2, x: 1 }>>)
meta let _ = assert(type<Order<["a": 1, "b": 2]>> != type<Order<["b": 2, "a": 1]>>)
