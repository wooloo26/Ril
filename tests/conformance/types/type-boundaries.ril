-- [pair: bare-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Reader = fn() -> int @Io

-- reject
-- Error [E0330]: reject bare effect
eff Io { read() -> int }
type Invalid = @Io

-- [pair: bare-mut]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Writer = fn(mut []int) -> () &mut

-- reject
-- Error [E0331]: reject bare mut
eff Io { read() -> int }
type Invalid = &mut

-- [pair: bare-sharing]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Writer = fn(^mut []int) -> () &^mut

-- reject
-- Error [E0331]: reject bare sharing
eff Io { read() -> int }
type Invalid = &^mut

-- [pair: field-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Item = { value: fn() -> int @Io }

-- reject
-- Error [E0333]: reject field effect
eff Io { read() -> int }
type Item = { value: int @Io }

-- [pair: generic-capability]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Item<T> = T

-- reject
-- Error [E0334]: reject generic capability
eff Io { read() -> int }
type Item<T: &mut> = T

-- [pair: generic-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Item<T> = T

-- reject
-- Error [E0334]: reject generic effect
eff Io { read() -> int }
type Item<T: @Io> = T

-- [pair: tuple-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Item = (fn() -> int @Io, int)

-- reject
-- Error [E0333]: reject tuple effect
eff Io { read() -> int }
type Item = (int @Io, int)

-- [pair: type-function-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Item = \T -> type<T>

-- reject
-- Error [E0335]: reject type function effect
eff Io { read() -> int }
type Item = \T -> type<T> @Io

-- [pair: type-function-state]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Item = \T -> type<T>

-- reject
-- Error [E0335]: reject type function state
eff Io { read() -> int }
type Item = \T -> type<T> &mut

-- [pair: value-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }

fn example() {
    let value: str = "text"
}

-- reject
-- Error [E0613]: reject value effect
eff Io { read() -> int }

fn example() {
    let value: str @Io = "text"
}

-- [pair: variant-capability]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Task { Running(fn(mut []int) -> () &mut) }

-- reject
-- Error [E0332]: reject variant capability
eff Io { read() -> int }
type Task { Running &mut }

-- [pair: variant-effect]
-- spec: SPEC#type-definition-boundaries

-- accept
eff Io { read() -> int }
type Task { Running(fn() -> int @Io) }

-- reject
-- Error [E0332]: reject variant effect
eff Io { read() -> int }
type Task { Running @Io }
