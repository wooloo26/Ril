-- [pair: alias-no-inspection]
-- spec: SPEC#mandatory-inspection-of-fallible-results

-- accept
fn example() {
    let result: Result<int, str> = Err("bad")
    let alias = result
    assert(alias is Err(_))
}

-- reject
-- Error [E0720]: reject alias no inspection
fn example() {
    let result: Result<int, str> = Err("bad")
    let alias = result
}

-- [pair: copy-no-inspection]
-- spec: SPEC#mandatory-inspection-of-fallible-results

-- accept
fn example() {
    let result: Result<int, str> = Err("bad")
    let copied = clone(result)
    assert(result is Err(_))
    assert(copied is Err(_))
}

-- reject
-- Error [E0720]: reject copy no inspection
fn example() {
    let result: Result<int, str> = Err("bad")
    let copied = clone(result)
}

-- [pair: invalid-fallback-family]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example() {
    let value = Some(42) ?? 0
}

-- reject
-- Error [E0714]: reject invalid fallback family
fn example() {
    let value = 42 ?? 0
}

-- [pair: nested-outer-only]
-- spec: SPEC#mandatory-inspection-of-fallible-results

-- accept
fn example() {
    let result: Result<Result<int, str>, str> = Ok(Err("bad"))
    match result { Ok(inner) -> assert(inner is Err(_)), Err(_) -> () }
}

-- reject
-- Error [E0720]: reject nested outer only
fn example() {
    let result: Result<Result<int, str>, str> = Ok(Err("bad"))
    assert(result is Ok(_))
}

-- [pair: nonoptional-safe-field]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example() {
    let item: ?{ name: str } = Some(.{ name: "Ada" })
    let name = item?.name
}

-- reject
-- Error [E0715]: reject nonoptional safe field
fn example() {
    let name = (.{ name: "Ada" })?.name
}

-- [pair: outward-fallback-return]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example(item: ?int) {
    let value = item ?? 0
}

-- reject
-- Error [E0710]: reject outward fallback return
fn example(item: ?int) {
    let value = item ?? return
}

-- [pair: overwritten-result]
-- spec: SPEC#mandatory-inspection-of-fallible-results

-- accept
fn example() {
    var result: Result<int, str> = Err("lost")
    assert(result is Err(_))
    result = Ok(1)
    assert(result is Ok(_))
}

-- reject
-- Error [E0720]: reject overwritten result
fn example() {
    var result: Result<int, str> = Err("lost")
    result = Ok(1)
    assert(result is Ok(_))
}

-- [pair: propagation-error-type]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example(value: Result<int, str>) -> Result<int, str> { Ok(value?) }

-- reject
-- Error [E0713]: reject propagation error type
fn example(value: Result<int, str>) -> Result<int, int> { Ok(value?) }

-- [pair: propagation-operand]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example() -> ?int { let value = Some(42)?; Some(value) }

-- reject
-- Error [E0712]: reject propagation operand
fn example() -> ?int { let value = 42?; Some(value) }

-- [pair: propagation-target]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example(value: ?int) -> ?int { Some(value?) }

-- reject
-- Error [E0713]: reject propagation target
fn example(value: ?int) -> int { value? }

-- [pair: raw-result-fallback]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn example(result: Result<int, str>) {
    let value = result ?? \_error -> 0
}

-- reject
-- Error [E0711]: reject raw result fallback
fn example(result: Result<int, str>) {
    let value = result ?? 0
}

-- [pair: task-result-uninspected]
-- spec: SPEC#mandatory-inspection-of-fallible-results

-- accept
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

fn example() @Concurrent {
    let result = scope \mut s -> { let task = s.fork(\-> { let value: Result<int, str> = Err("bad"); value }); let business = task.join()?; assert(business is Err("bad")); Ok() }
    assert(result is Ok())
}

-- reject
-- Error [E0720]: reject task result uninspected
use ril/concurrent::{scope, TaskFault}
use ril/concurrent/channel

fn example() @Concurrent {
    let result = scope \mut s -> { s.fork(\-> { let value: Result<int, str> = Err("bad"); value }); Ok() }
    assert(result is Ok())
}

-- [pair: top-level-propagation]
-- spec: SPEC#error-and-fallback-operators

-- accept
fn value() -> ?int { Some(1) }
fn read() -> ?int { Some(value()?) }

-- reject
-- Error [E0205]: reject top level propagation
fn value() -> ?int { Some(1) }
let VALUE = value()?

-- [pair: wildcard-discard]
-- spec: SPEC#mandatory-inspection-of-fallible-results

-- accept
fn example() {
    let result: Result<int, str> = Err("bad")
    assert(result is Err(_))
}

-- reject
-- Error [E0720]: reject wildcard discard
fn example() {
    let result: Result<int, str> = Err("bad")
    let _ = result
}

-- [case: ordinary-error-data, run-pass]
-- spec: SPEC#failure-model-and-error-categories
pub fn test_ordinary_error_data() {
    let value: Result<int, str> = Err("recoverable")
    assert(value is Err("recoverable"))
}

-- [case: propagation-and-fallback, run-pass]
-- spec: SPEC#error-and-fallback-operators
fn option_step(value: ?int) -> ?int { Some(value? + 1) }
fn result_step(value: Result<int, str>) -> Result<int, str> { Ok(value? + 1) }

pub fn test_propagation_and_fallback() {
    assert(option_step(Some(1)) == Some(2))
    assert(option_step(None) == None)
    assert(result_step(Ok(1)) is Ok(2))
    assert(result_step(Err("bad")) is Err("bad"))
    let result: Result<int, str> = Err("bad")
    assert((result ?? \error -> len(error)) == 3)
}

-- [case: safe-access-short-circuits, run-pass]
-- spec: SPEC#error-and-fallback-operators
pub fn test_safe_access_short_circuits() {
    let missing: ?[]int = None
    assert(missing?[panic("index must not execute")] == None)
    assert([1]?[1] == None && [1]?[-1] == None)
    let nested: ?{ value: ?int } = Some(.{ value: Some(3) })
    assert(nested?.value == Some(3))
    assert((Some(7) ?? panic("fallback must not execute")) == 7)
}
