-- [source: static-record-member-order]
-- file: source.ril
meta fn mark(digit: int) -> int { digit }
meta fn spread(digit: int) -> { id: int } {
    .{ id: mark(digit) }
}
meta fn order() -> { id: int, tail: int } {
    .{ id: mark(1), ..spread(2), tail: mark(3), ..spread(4) }
}
meta let RECORD = order()
meta let _ = assert(RECORD.id == 1 && RECORD.tail == 3)
pub fn test_static_order() &{RECORD} { assert(RECORD.id == 1 && RECORD.tail == 3) }

