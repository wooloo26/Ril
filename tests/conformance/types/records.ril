fn example(item: User, key: str) {
    let value: User = .{ id: 1, name: "Ada" }
}

-- reject
-- Error [E0302]: reject extra field
type User = { id: int, name: str }

fn example(item: User, key: str) {
    let value: User = .{ id: 1, name: "Ada", age: 3 }
}

