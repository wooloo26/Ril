-- [pair: conflicting-spreads]
-- spec: SPEC#record-construction-and-functional-update

-- accept
fn example(left: { id: int }, right: { id: int }) {
    let value = .{ ..left, ..right, id: 3 }
}

-- reject
-- Error [E0211]: reject conflicting spreads
fn example(left: { id: int }, right: { id: int }) {
    let value = .{ ..left, ..right }
}

-- [source: ordered-record-members]
-- file: source.ril
type Trace = { mut value: int }
eff Stop { now() -> never }
fn mark(mut trace: Trace, digit: int) -> int &mut {
    trace.value = trace.value * 10 + digit
    digit
}
fn spread(mut trace: Trace, digit: int) -> { id: int } &mut {
    .{ id: mark(mut trace, digit) }
}
pub fn test_order() {
    let mut trace = Trace.{ value: 0 }
    let before = .{ id: mark(mut trace, 1), ..spread(mut trace, 2), tail: mark(mut trace, 3), ..spread(mut trace, 4) }
    assert(trace.value == 1234 && before.id == 1 && before.tail == 3)
    trace.value = 0
    let after = .{ ..spread(mut trace, 5), ..spread(mut trace, 6), id: mark(mut trace, 7) }
    assert(trace.value == 567 && after.id == 7)
    let nested = .{ child: .{ ..before, id: 9 }, other: after }
    assert(nested.child.id == 9 && nested.child.tail == 3 && nested.other.id == 7)
}
pub fn test_abrupt() {
    let mut trace = Trace.{ value: 0 }
    let answer = {
        with Stop::now() -> 99
        let stopped = .{ first: mark(mut trace, 1), ..{ Stop::now(); .{ id: 2 } }, tail: mark(mut trace, 3) }
        7
    }
    assert(answer == 99 && trace.value == 1)
}

