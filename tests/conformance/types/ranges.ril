-- [case: live-view-observes-replacement, run-pass]
-- spec: SPEC#range-and-slicing-expressions
pub fn test_live_view_observes_replacement() {
    let mut items = [1, 2]
    let view observed = items
    items[0] = 9
    assert(observed[0] == 9)
    items !> Array::push(3)
    assert(len(items) == 3)
}

-- [case: reject-full-slice-view, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- companion: slice-container-is-independent
-- Error [E0543]: A full range still allocates a new array rather than a live view.
fn invalid() {
    let mut items = [1, 2]
    items[0] = 9
    let view observed = items[..]
}

-- [case: reject-partial-slice-view, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- companion: slice-container-is-independent
-- Error [E0543]: A partial range also allocates a new array.
fn invalid() {
    let mut items = [1, 2, 3]
    items[0] = 9
    let view observed = items[1..]
}

-- [case: slice-container-is-independent, run-pass]
-- spec: SPEC#range-and-slicing-expressions
pub fn test_slice_container_is_independent() {
    let mut items = [1, 2, 3]
    let selected = items[1..]
    items[1] = 9
    items !> Array::push(4)
    assert(selected == [2, 3] && items == [1, 9, 3, 4])
}

-- [case: reject-forwarded-slice-view, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- spec: SPEC#normative-rules-for-live-views
-- companion: slice-container-is-independent
-- Error [E0543]: A read-only call cannot relabel a new slice array as a live view.
fn identity(items: []int) -> []int { items }

fn invalid() {
    let mut items = [1, 2]
    items[0] = 9
    let view observed = identity(items[..])
}

-- [case: slice-preserves-reference-sharing, run-pass]
-- spec: SPEC#range-and-slicing-expressions
-- spec: SPEC#retained-mutable-sharing
type Cell = { mut count: int }

pub fn test_slice_preserves_reference_sharing() {
    let mut items: []Cell = [Cell.{ count: 1 }, Cell.{ count: 2 }]
    items[1].count += 1
    let mut selected = ^mut items[0..1]
    selected[0].count = 9
    selected !> Array::push(Cell.{ count: 4 })
    assert(items[0].count == 9 && items[1].count == 3)
    assert(len(items) == 2 && len(selected) == 2)
}

-- [case: pinned-slice-array-view, run-pass]
-- spec: SPEC#range-and-slicing-expressions
-- spec: SPEC#normative-rules-for-live-views
pub fn test_pinned_slice_array_view() {
    let mut items = [1, 2, 3]
    items[0] = 9
    let mut selected = items[1..]
    let view observed = selected
    selected[0] = 8
    assert(observed[0] == 8 && items[1] == 2)
}
