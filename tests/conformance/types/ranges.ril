-- [case: accept-live-view-structural-change, check-pass]
-- spec: SPEC#range-and-slicing-expressions
-- companion: reject-live-view-structural-change
fn example() {
    let mut items = [1, 2]
    let view observed = items
    assert(len(observed) == 2)
    items !> Array::push(3)
}

-- [case: reject-live-view-element-write, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- companion: live-view-observes-replacement
-- Error [E0520]: A live view grants no element writer even when its source has one.
fn invalid() {
    let mut items = [1, 2, 3]
    items[0] = 7
    let view observed = items
    observed[0] = 9
}

-- [case: reject-live-view-structural-change, check-fail]
-- spec: SPEC#range-and-slicing-expressions
-- companion: accept-live-view-structural-change
-- Error [E0537]: A later use of the live array view requires structural stability.
fn example() {
    let mut items = [1, 2]
    let view observed = items
    items !> Array::push(3)
    assert(len(observed) == 2)
}

-- [pair: mixed-range-type]
-- spec: SPEC#range-and-slicing-expressions

-- accept
fn example() {
    let values = 0u8..1u8
}

-- reject
-- Error [E0301]: reject mixed range type
fn example() {
    let values = 0u8..1u16
}

-- [pair: noninteger-range]
-- spec: SPEC#range-and-slicing-expressions

-- accept
fn example() {
    let values = 0..1
}

-- reject
-- Error [E0327]: reject noninteger range
fn example() {
    let values = 0.0..1.0
}

