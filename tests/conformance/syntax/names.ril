-- [pair: acronym-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
type HttpServer = int

-- reject
-- Error [E0102]: reject acronym casing
type HTTPServer = int

-- [pair: consecutive-underscores]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let user_name = "a"
}

-- reject
-- Error [E0102]: reject consecutive underscores
fn example() {
    let user__name = "a"
}

-- [pair: constant-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
let COUNT = 1

-- reject
-- Error [E0101]: reject constant casing
let count = 1

-- [pair: constructor-abbreviation]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
type First { Shared }
type Second { Shared }

fn example() {
    let item: First = First::Shared
}

-- reject
-- Error [E0206]: reject constructor abbreviation
type First { Shared }
type Second { Shared }

fn example() {
    let item: First = Shared
}

-- [pair: duplicate-local]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let value = 1
    { let value = 2 }
}

-- reject
-- Error [E0203]: reject duplicate local
fn example() {
    let value = 1
    let value = 2
}

-- [pair: function-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn compute() {}

-- reject
-- Error [E0101]: reject function casing
fn Compute() {}

-- [pair: global-var-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
var count = 1
fn advance() &{mut count} { count += 1 }

-- reject
-- Error [E0101]: reject global var casing
var COUNT = 1
fn advance() &{mut COUNT} { COUNT += 1 }

-- [pair: local-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let user_count = 1
}

-- reject
-- Error [E0101]: reject local casing
fn example() {
    let UserCount = 1
}

-- [pair: meta-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
meta let COUNT = 1

-- reject
-- Error [E0101]: reject meta casing
meta let count = 1

-- [pair: pattern-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let (user_id, name) = (1, "a")
}

-- reject
-- Error [E0103]: reject pattern casing
fn example() {
    let (USER_ID, name) = (1, "a")
}

-- [pair: trailing-underscore]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let user = 1
}

-- reject
-- Error [E0102]: reject trailing underscore
fn example() {
    let user_ = 1
}

-- [pair: type-casing]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
type Item = int

-- reject
-- Error [E0101]: reject type casing
type item = int

-- [pair: unresolved-local]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let missing = 1
    let value = missing
}

-- reject
-- Error [E0204]: reject unresolved local
fn example() {
    let value = missing
}

-- [pair: wildcard-expression]
-- spec: SPEC#identifiers-and-casing-invariants

-- accept
fn example() {
    let value = 1
    let _ = value
}

-- reject
-- Error [E0322]: reject wildcard expression
fn example() {
    let _ = 1
    let value = _
}
