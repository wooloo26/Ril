-- [pair: bad-byte-hex]
-- spec: SPEC#text-and-byte-literals

-- accept
-- file: input.ril hex
6c 65 74 20 56 41 4c 55 45 20 3d 20 62 22 5c 78 46 30 22

-- reject
-- Error [E0110]: reject bad byte hex
-- file: input.ril hex
6c 65 74 20 56 41 4c 55 45 20 3d 20 62 22 5c 78 47 30 22

