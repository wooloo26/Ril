-- [case: literal-values, run-pass]
-- spec: SPEC#numeric-literals
pub fn test_literal_values() {
    assert(0xFF == 255)
    assert(0o755 == 493)
    assert(0b1010_0110 == 166)
    assert(1_000 == 1000)
    assert(-128i8 < 127i8)
    let contextual: u8 = 255
    assert(contextual == 255u8)
    assert(1.25e-4 == 0.000125)
    assert(12345678901234567890bigint > 0bigint)
}

-- [case: text-and-byte-values, run-pass]
-- spec: SPEC#text-and-byte-literals
pub fn test_text_and_byte_values() {
    assert(len("aé😀") == 3)
    assert(len(b"\x00\xFF") == 2)
    assert("{{value}}" == `{value}`)
    assert("{42:04x}" == "002a")
    assert("\u{1F642}" == "🙂")
}
