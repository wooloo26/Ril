-- [case: newline-continuation, run-pass]
-- spec: SPEC#whitespace-and-layout-rules
pub fn test_newline_continuation() {
    let a = 1; let b = 2
    let sum = a +
        b
    let values = [1, 2]
        |> Array::map(\n -> n * 2)
    assert(sum == 3 && values == [2, 4])
    let value = {
        let first = 4
        first + 1
    }
    let discarded = { 5; }
    assert(value == 5 && discarded == ())
}
