-- [pair: opaque-unwrapping]
-- spec: SPEC#type-declarations-and-opaque-types

-- accept
-- file: root.ril
use token
fn example(value: Token::Value) { let _ = Token::reveal(value) }

-- file: token.ril
pub opaque type Value = int
pub fn reveal(value: Value) -> int { value }

-- reject
-- Error [E0308]: reject opaque unwrapping
-- file: root.ril
use token
fn example(value: Token::Value) { let _ = inner(value) }

-- file: token.ril
pub opaque type Value = int
pub fn reveal(value: Value) -> int { value }

