-- [pair: state-reference]
-- spec: SPEC#named-function-state-contract-references

-- accept
-- file: root.ril
use counter
fn example() &Counter::advance { Counter::advance() }

-- file: counter.ril
var count = 0
pub fn advance() &{mut count} { count += 1 }

-- reject
-- Error [E0510]: reject state reference
-- file: root.ril
