--@ case: accept-local-effect-escape
--@ mode: check-pass
--@ spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
--@ companion: reject-local-effect-escape
--@ file: accept-local-effect-escape.ril
fn example() -> int { with Local::read() -> resume 1
    Local::read()
where
    eff Local { read() -> int }
}
--@ end-file
--@ end-case

--@ case: reject-local-effect-escape
--@ mode: check-fail
--@ spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
--@ companion: accept-local-effect-escape
-- Error [E0618]: reject local effect escape
--@ file: reject-local-effect-escape.ril
fn example() -> int @Local { Local::read()
where
    eff Local { read() -> int }
}
--@ end-file
--@ end-case

--@ case: accept-local-nominal-escape
--@ mode: check-pass
--@ spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
--@ companion: reject-local-nominal-escape
--@ file: accept-local-nominal-escape.ril
fn example() -> Token
where
    type Token = int
{ 1 }
--@ end-file
--@ end-case

--@ case: reject-local-nominal-escape
--@ mode: check-fail
--@ spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
--@ companion: accept-local-nominal-escape
-- Error [E0315]: reject local nominal escape
--@ file: reject-local-nominal-escape.ril
fn example() -> Token
where
    type Token(int)
{ Token(1) }
--@ end-file
--@ end-case

