--@ case: accept-uninitialized-capture
--@ mode: check-pass
--@ spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
--@ companion: reject-uninitialized-capture
--@ file: accept-uninitialized-capture.ril
fn example() -> int { let value = 1
    read()
where
    fn read() -> int &{closure, value} { value }
}
--@ end-file
--@ end-case

--@ case: reject-uninitialized-capture
--@ mode: check-fail
--@ spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
--@ companion: accept-uninitialized-capture
-- Error [E0207]: reject uninitialized capture
--@ file: reject-uninitialized-capture.ril
fn example() -> int { read()
    let value = 1
    read()
where
    fn read() -> int &{closure, value} { value }
}
--@ end-file
--@ end-case

