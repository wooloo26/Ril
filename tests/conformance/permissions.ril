--@ case: clone-isolation
--@ mode: run-pass
--@ spec: SPEC#deep-immutability
--@ entry: test_clone_isolation
--@ file: clone-isolation.ril
type Cell = { mut count: int }

pub fn test_clone_isolation() {
    let mut source = Cell.{ count: 1 }
    let view seen = source
    let mut detached = clone(seen)
    let frozen = clone_immut(seen)
    source.count = 3
    detached.count = 2
    assert(seen.count == 3 && detached.count == 2 && frozen.count == 1)
}
--@ end-file
--@ end-case

--@ case: clone-preserves-aliases
--@ mode: run-pass
--@ spec: SPEC#deep-immutability
--@ entry: test_clone_preserves_aliases
--@ file: clone-preserves-aliases.ril
type Cell = { mut count: int }

pub fn test_clone_preserves_aliases() {
    let shared = Cell.{ count: 1 }
    let original = (shared, shared)
    let mut copied = ^mut clone(original)
    copied.0.count += 1
    assert(copied.1.count == 2 && original.0.count == 1)
}
--@ end-file
--@ end-case

--@ case: derive-preserves-input-and-aliases
--@ mode: run-pass
--@ spec: SPEC#functional-updates-via-derive
--@ entry: test_derive_preserves_input_and_aliases
--@ file: derive-preserves-input-and-aliases.ril
type Cell = { mut count: int }

pub fn test_derive_preserves_input_and_aliases() {
    let child = Cell.{ count: 1 }
    let base = .{ left: child, right: child }
    let revised = base |> derive \mut draft -> { draft.left.count += 1 }
    assert(base.left.count == 1 && child.count == 1)
    assert(revised.left.count == 2 && revised.right.count == 2)
}
--@ end-file
--@ end-case

--@ case: view-keeps-initial-child
--@ mode: run-pass
--@ spec: SPEC#live-view-bindings
--@ entry: test_view_keeps_initial_child
--@ file: view-keeps-initial-child.ril
type Cell = { mut count: int }
type Parent = { mut child: Cell }

pub fn test_view_keeps_initial_child() {
    let mut parent = Parent.{ child: Cell.{ count: 1 } }
    let view child = parent.child
    parent.child = Cell.{ count: 9 }
    assert(child.count == 1 && parent.child.count == 9)
}
--@ end-file
--@ end-case
