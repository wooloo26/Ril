-- [case: accept-ended-operation-loan, check-pass]
-- spec: SPEC#effect-handlers
-- companion: reject-ended-operation-loan
type Cell = { mut count: int }
eff Edit { apply(mut Cell) -> () &mut }

fn example() {
    with Edit::apply(mut item) -> { item.count += 1; resume () }
    let mut value = Cell.{ count: 0 }
    Edit::apply(mut value)
}

-- [case: reject-ended-operation-loan, check-fail]
-- spec: SPEC#effect-handlers
-- companion: accept-ended-operation-loan
-- Error [E0540]: reject ended operation loan
type Cell = { mut count: int }
eff Edit { apply(mut Cell) -> () &mut }

fn example() {
    with Edit::apply(mut item) -> { item.count += 1; resume (); item.count += 1 }
    let mut value = Cell.{ count: 0 }
    Edit::apply(mut value)
}

