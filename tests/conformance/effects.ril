-- [case: accept-duplicate-handler, check-pass]
-- spec: SPEC#effect-handlers
-- companion: reject-duplicate-handler
eff Read { get() -> int }

fn example() {
    with Read::get() -> resume 1
    let _ = Read::get()
}

-- [case: reject-duplicate-handler, check-fail]
-- spec: SPEC#effect-handlers
-- companion: accept-duplicate-handler
-- Error [E0622]: reject duplicate handler
eff Read { get() -> int }

fn example() {
    with { Read::get() -> resume 1, Read::get() -> resume 2 }
    let _ = Read::get()
}

