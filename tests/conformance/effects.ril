--@ end-case

--@ case: reject-unstable-handler-answer
--@ mode: check-fail
--@ spec: SPEC#effect-handlers
--@ companion: accept-unstable-handler-answer
-- Error [E0614]: reject unstable handler answer
--@ file: reject-unstable-handler-answer.ril
eff Read { get() -> int }
type Reader = fn() -> int &closure
fn make_reader() -> Reader &capture {
    with Read::get() -> { let ignored = resume 7; \-> 0 }
    \-> Read::get()
}
--@ end-file
--@ end-case

--@ case: deep-resumption
--@ mode: run-pass
--@ spec: SPEC#effect-handlers
--@ entry: test_deep_resumption
--@ file: deep-resumption.ril
eff Read { get() -> int }

pub fn test_deep_resumption() {
    var calls = 0
    with Read::get() -> { calls += 1; resume calls }
    let first = Read::get()
    let second = Read::get()
    assert(first == 1 && second == 2 && calls == 2)
}
--@ end-file
--@ end-case

--@ case: generic-instances
--@ mode: run-pass
--@ spec: SPEC#effect-declarations-and-operation-signatures
--@ entry: test_generic_instances
--@ file: generic-instances.ril
eff State<T> { get() -> T }

pub fn test_generic_instances() {
    with { State<int>::get() -> resume 7, State<str>::get() -> resume "seven" }
    assert(State<int>::get() == 7 && State<str>::get() == "seven")
}
--@ end-file
--@ end-case

--@ case: outer-handler-forwarding
--@ mode: run-pass
--@ spec: SPEC#effect-handlers
--@ entry: test_outer_handler_forwarding
--@ file: outer-handler-forwarding.ril
eff Read { get() -> int }

pub fn test_outer_handler_forwarding() {
    with Read::get() -> resume 7
    let result = {
        with Read::get() -> { let outer = Read::get(); resume (outer + 1) }
        Read::get()
    }
    assert(result == 8)
}
--@ end-file
--@ end-case

--@ case: parameterized-handler
--@ mode: run-pass
--@ spec: SPEC#parameterized-handler-applications
--@ entry: test_parameterized_handler
--@ file: parameterized-handler.ril
eff Read { get() -> int }
fn supply(value: int, action: fn() -> int) -> int { with Read::get() -> resume value; action() }
halt fn configured() -> int { with supply(7); Read::get() + 1 }
halt fn existing() -> int { with Read::get() -> resume 3; with supply(7); Read::get() }

pub fn test_parameterized_handler() {
    assert(configured() == 8)
    assert(existing() == 3)
}
--@ end-file
--@ end-case

--@ case: retained-handler-selection
--@ mode: run-pass
--@ spec: SPEC#effect-handlers
--@ entry: test_retained_handler_selection
--@ file: retained-handler-selection.ril
eff Read { get() -> int }
type Reader = fn() -> int &closure
fn make_reader() -> Reader &capture { with Read::get() -> resume 7; \-> Read::get() }

pub fn test_retained_handler_selection() {
    let reader = make_reader()
    with Read::get() -> resume 99
    assert(reader() == 7 && reader() == 7)
}
--@ end-file
--@ end-case

--@ case: system-yield-local-handling
--@ mode: run-pass
--@ spec: SPEC#built-in-system-effects
--@ spec: STD#execution-boundaries
--@ entry: test_system_yield_local_handling
--@ file: system-yield-local-handling.ril
pub fn test_system_yield_local_handling() {
    var yielded = 0
    with Fiber::yield() -> { yielded += 1; resume () }
    Fiber::yield()
    assert(yielded == 1)
}
--@ end-file
--@ end-case
