--@ source: if-let-result-tuples
--@ file: source.ril
fn sum(item: Result<(int, int), str>) -> int {
    if let Ok(left, right) = item { left + right } else { -1 }
}
pub fn test_native() {
    assert(sum(Ok(2, 3)) == 5 && sum(Err("missing")) == -1)
    let item: ?(int, ?int) = Some((4, Some(5)))
    let total = if let Some((left, Some(right))) = item { left + right } else { 0 }
    assert(total == 9)
}
