--@ source: if-let-branches
--@ file: source.ril
type Event { Pair(int, str), Again(int, str), Stop }
type Counter = { mut count: int }

fn observe(mut counter: Counter, item: ?int) -> ?int &mut {
    counter.count += 1
    item
}
fn code(event: Event) -> int {
    if let Pair(value, _) | Again(value, _) = event { value } else { 0 }
}
pub fn test_native() {
    let mut counter = Counter.{ count: 0 }
    let value = 90
    let found = if let Some(value) = observe(mut counter, Some(7)) {
        value + 1
    } else {
        panic("matching branch must run")
    }
    let absent = if let Some(value) = observe(mut counter, None) {
        panic("nonmatching branch must not run")
    } else if let Some(other) = Some(2) {
        value + other
    } else { 0 }
    assert(found == 8 && absent == 92 && value == 90 && counter.count == 2)
    assert(code(Pair(3, "a")) == 3 && code(Again(5, "b")) == 5 && code(Stop) == 0)
    if let Some(unit) = Some(()) { assert(unit == ()) }
}
--@ end-file
--@ end-source

