--@ source: while-let-control
--@ file: source.ril
type Counter = { mut count: int }
fn pull(mut values: []int, mut counter: Counter) -> ?int &mut {
    counter.count += 1
    Array::pop(mut values)
}
pub fn test_native() {
    let mut values = [1, 2, 3, 4, 5]
    let mut counter = Counter.{ count: 0 }
    var total = 0
    while let Some(item) = pull(mut values, mut counter) {
        if item == 4 { next }
        total += item
        if item == 2 { last }
    }
    assert(total == 10 && values == [1] && counter.count == 4)
    while let Some(item) = pull(mut values, mut counter) { total += item }
    assert(total == 11 && values == [] && counter.count == 6)
    while let Some(item) = pull(mut values, mut counter) {
        panic("empty subject must skip the body")
    }
    assert(counter.count == 7)
}
--@ end-file
--@ end-source

