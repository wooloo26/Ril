--@ source: while-let-capture-occurrences
--@ file: source.ril
type Reader = fn() -> int &closure
pub fn test_native() {
    let mut values = [1, 2, 3]
    let mut readers: []Reader = []
    while let Some(item) = Array::pop(mut values) {
        Array::push(mut readers, \-> (\-> item)())
    }
    assert(readers[0]() == 3 && readers[1]() == 2 && readers[2]() == 1)
    assert(readers[0]() == 3 && readers[2]() == 1)
}
--@ end-file
--@ end-source

