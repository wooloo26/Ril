--@ source: while-let-fallible-propagation
--@ file: source.ril
type Stream = { mut step: int, fail_at: int }

fn next_item(mut stream: Stream) -> Result<?int, str> &mut {
    stream.step += 1
    if stream.step == stream.fail_at {
        Err("stream error")
    } else if stream.step > 3 {
        Ok(None)
    } else {
        Ok(Some(stream.step * 10))
    }
}

fn drain(fail_at: int) -> Result<int, str> {
    let mut stream = Stream.{ step: 0, fail_at }
    var total = 0
    while let Some(item) = next_item(mut stream)? {
        total += item
    }
    Ok(total)
}

pub fn test_native() {
    assert(drain(99) is Ok(60))
    assert(drain(1) is Err("stream error"))
    assert(drain(3) is Err("stream error"))
}
--@ end-file
--@ end-source

