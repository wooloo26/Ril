--@ source: if-let-fallible-propagation
--@ file: source.ril
type Cache = { mut counter: int }

fn fetch(mut cache: Cache, id: int) -> Result<?str, str> &mut {
    cache.counter += 1
    if id < 0 {
        Err("negative id")
    } else if id == 0 {
        Ok(None)
    } else {
        Ok(Some("found"))
    }
}

fn query(mut cache: Cache, id: int) -> Result<str, str> &mut {
    let result = if let Some(text) = fetch(mut cache, id)? {
        text
    } else {
        "fallback"
    }
    Ok(result)
}

pub fn test_native() {
    let mut cache = Cache.{ counter: 0 }
    assert(query(mut cache, 42) is Ok("found"))
    assert(query(mut cache, 0) is Ok("fallback"))
    assert(query(mut cache, -1) is Err("negative id"))
    assert(cache.counter == 3)
}
--@ end-file
--@ end-source

