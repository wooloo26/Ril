--@ case: accept-outside-write
--@ mode: check-pass
--@ spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives
--@ companion: reject-outside-write
--@ file: accept-outside-write.ril
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let value = 1
    let _ = Parallel::map([1], \n -> n + value)
}
--@ end-file
--@ end-case

--@ case: reject-outside-write
--@ mode: check-fail
--@ spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives
--@ companion: accept-outside-write
-- Error [E0605]: reject outside write
--@ file: reject-outside-write.ril
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let mut cell = Cell.{ count: 0 }
    let _ = Parallel::map([1], \n -> { cell.count += n; n })
}
--@ end-file
--@ end-case

--@ case: accept-overlapping-writes
--@ mode: check-pass
--@ spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives
--@ companion: reject-overlapping-writes
--@ file: accept-overlapping-writes.ril
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let mut copy = (Cell.{ count: 0 }, Cell.{ count: 0 })
    let _ = Parallel::join(\-> { copy.0.count += 1 }, \-> { copy.1.count += 1 })
}
--@ end-file
--@ end-case

--@ case: reject-overlapping-writes
--@ mode: check-fail
--@ spec: SPEC#deterministic-data-parallelism-and-divide-and-conquer-primitives
--@ companion: accept-overlapping-writes
-- Error [E0619]: reject overlapping writes
--@ file: reject-overlapping-writes.ril
use ril/parallel
type Cell = { mut count: int }

fn example() {
    let original = Cell.{ count: 0 }
    let mut copy = ^mut clone((original, original))
    let _ = Parallel::join(\-> { copy.0.count += 1 }, \-> { copy.1.count += 1 })
}
--@ end-file
--@ end-case

