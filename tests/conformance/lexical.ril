-- [pair: above-unicode-limit]
-- spec: SPEC#character-set-and-encoding

-- accept
-- file: input.ril

-- reject
-- Error [E0104]: reject above unicode limit
-- file: input.ril hex
f4 90 80 80

-- [pair: illegal-character]
-- spec: SPEC#character-set-and-encoding

-- accept
fn example() {
    let value = "$"
}

-- reject
-- Error [E0105]: reject illegal character
fn example() {
    let value = $
}

