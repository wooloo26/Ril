-- [case: accept-acronym-casing, check-pass]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: reject-acronym-casing
type HttpServer = int

-- [case: reject-acronym-casing, check-fail]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: accept-acronym-casing
-- Error [E0102]: reject acronym casing
type HTTPServer = int

-- [case: accept-consecutive-underscores, check-pass]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: reject-consecutive-underscores
fn example() {
    let user_name = "a"
}

-- [case: reject-consecutive-underscores, check-fail]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: accept-consecutive-underscores
-- Error [E0102]: reject consecutive underscores
fn example() {
    let user__name = "a"
}

-- [case: accept-constant-casing, check-pass]
