let count = 1

-- [case: accept-constructor-abbreviation, check-pass]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: reject-constructor-abbreviation
type First { Shared }
type Second { Shared }

fn example() {
    let item: First = First::Shared
}

-- [case: reject-constructor-abbreviation, check-fail]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: accept-constructor-abbreviation
-- Error [E0206]: reject constructor abbreviation
type First { Shared }
type Second { Shared }

fn example() {
    let item: First = Shared
}

-- [case: accept-duplicate-local, check-pass]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: reject-duplicate-local
fn example() {
    let value = 1
    { let value = 2 }
}

-- [case: reject-duplicate-local, check-fail]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: accept-duplicate-local
-- Error [E0203]: reject duplicate local
fn example() {
    let value = 1
    let value = 2
}

-- [case: accept-function-casing, check-pass]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: reject-function-casing
fn compute() {}

-- [case: reject-function-casing, check-fail]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: accept-function-casing
-- Error [E0101]: reject function casing
fn Compute() {}

-- [case: accept-global-var-casing, check-pass]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: reject-global-var-casing
var count = 1
fn advance() &{mut count} { count += 1 }

-- [case: reject-global-var-casing, check-fail]
-- spec: SPEC#identifiers-and-casing-invariants
-- companion: accept-global-var-casing
-- Error [E0101]: reject global var casing
var COUNT = 1
fn advance() &{mut COUNT} { COUNT += 1 }

