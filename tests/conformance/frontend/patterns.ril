-- [case: value-tests-read-constants-and-match-constructors, front-pass]
-- spec: SPEC#value-tests-with-is
let WANTED = 42
fn expected() -> i64 { 42 }
fn check(value: Result<?i64, str>) -> bool {
    value is Ok(Some(WANTED)) | Ok(Some(expected()))
}

-- [case: constructor-tests-follow-imported-alias, front-pass]
-- spec: SPEC#value-tests-with-is
use Option::{Some as present}
fn check(value: ?i64) -> bool { value is present(_) }

-- [case: range-alternatives-in-value-test, front-pass]
-- spec: SPEC#value-tests-with-is
fn check(value: i64) -> bool { value is -3..=-1 | 1..=3 }

-- [case: range-alternatives-in-constructor-payload-test, front-pass]
-- spec: SPEC#value-tests-with-is
fn check(value: ?i64) -> bool { value is Some(-3..=-1 | 1..=3) }

-- [case: range-alternatives-in-tuple-test, front-pass]
-- spec: SPEC#value-tests-with-is
fn check(value: (i64, i64)) -> bool { value is (-3..=-1 | 1..=3, _) }

-- [case: is-value-names-do-not-bind, front-fail]
-- spec: SPEC#value-tests-with-is
-- Error [E0204]
fn check(value: ?i64) -> bool { value is Some(wanted) }

-- [case: is-rejects-record-member-modifier, front-fail]
-- spec: SPEC#value-tests-with-is
-- Error [E0120]
type Cell = { var value: i64 }
fn check(cell: Cell) -> bool { cell is .{ var value: 1 } }

-- [case: is-rejects-trailing-guard, front-fail]
-- spec: SPEC#value-tests-with-is
-- Error [E0120]
fn check(value: ?i64) -> bool { value is Some(_) if true }

-- [case: is-record-ranges-and-shorthand, front-pass]
-- spec: SPEC#value-tests-with-is
type Record = { code: i64, flag: bool }
fn check(value: Record, flag: bool) -> bool {
    value is .{ code: -3..=-1 | 1..=3, flag }
}

-- [case: typed-record-test-keeps-nested-alternatives, front-pass]
-- spec: SPEC#value-tests-with-is
type Record<T> = { code: T }
fn check(value: Record<i64>) -> bool {
    value is Record<i64>.{ code: -3..=-1 | 1..=3 }
}

-- [case: parenthesized-pipe-is-an-ordinary-value, front-pass]
-- spec: SPEC#value-tests-with-is
fn check(value: i64) -> bool { value is (1 | 2) }

-- [case: a-generic-comma-does-not-make-a-tuple-test, front-pass]
-- spec: SPEC#value-tests-with-is
fn select<T, U>(value: T, _other: U) -> T { value }
fn check(value: i64) -> bool { value is (select<i64, str>(1, "") | 2) }

-- [case: nominal-constructor-value-alias-is-a-test-head, front-pass]
-- spec: SPEC#value-tests-with-is
type UserId(i64)
fn check(value: UserId) -> bool {
    let make = UserId
    value is make(_)
}

-- [case: typed-record-pattern-preserves-generic-arguments, front-pass]
-- spec: SPEC#pattern-matching
type Cell<T> = { value: T }
fn extract(cell: Cell<i64>) -> i64 {
    match cell { Cell<i64>.{ value } -> value }
}

-- [case: negative-numeric-binding-pattern, front-pass]
-- spec: SPEC#pattern-matching
fn sign(value: i64) -> i64 {
    match value { -3..=-1 -> -1, -0 -> 0, _ -> 1 }
}

-- [case: computed-call-is-not-a-binding-pattern, front-fail]
-- spec: SPEC#value-tests-with-is
-- Error [E0349]
fn expected() -> i64 { 42 }
fn check(value: ?i64) -> bool {
    match value { Some(expected()) -> true, _ -> false }
}

-- [case: ordinary-lexical-constant-wins-over-tag-abbreviation, front-pass]
-- spec: SPEC#identifiers-and-casing-invariants
type Choice { A }
let A = 42
fn check(value: i64) -> bool { value is A }

-- [case: stored-nullary-value-remains-an-equality-test, front-pass]
-- spec: SPEC#value-tests-with-is
use Option::{None as empty}
let SAVED: ?i64 = None
fn check(value: ?i64) -> bool { value is SAVED | empty }

-- [case: binding-alternatives-have-one-shared-binder-set, front-pass]
-- spec: SPEC#pattern-matching
type Choice { Left(i64), Right(i64) }
fn extract(value: Choice) -> i64 {
    match value { Left(item) | Right(item) -> item }
}

-- [case: alternative-must-bind-the-same-names, front-fail]
-- spec: SPEC#pattern-matching
-- Error [E0346]
fn extract(value: ?i64) -> i64 {
    match value { Some(item) | None -> 0 }
}

-- [case: repeated-binding-in-nested-pattern, front-fail]
-- spec: SPEC#pattern-matching
-- Error [E0347]
fn extract(value: (i64, ?i64)) -> i64 {
    match value { (item, Some(item) | Some(item)) -> item, _ -> 0 }
}

-- [case: guarded-binding-must-bind-something, front-fail]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
-- Error [E0309]
fn example(value: i64) -> i64 {
    let _ = value else { return 0 }
    value
}

-- [case: nullary-pattern-is-not-a-local-declaration, front-fail]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
-- Error [E0309]
type Marker
fn example(value: Marker) -> () { let Marker = value }

-- [case: guarded-failure-must-be-a-block, front-fail]
-- spec: SPEC#guarded-bindings-and-non-vacuous-invariant
-- Error [E0124]
fn extract(value: ?i64) -> i64 {
    let Some(item) = value else return 0
    item
}

-- [case: record-reception-preserves-ref-mode, front-pass]
-- spec: SPEC#pattern-reception-and-decomposition
type Cell = { var count: i64 }
fn count(ref source: { ref item: Cell }) -> i64 {
    let .{ ref item } = source
    item.count
}
