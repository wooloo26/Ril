-- [case: independent-via-instances-and-ref-member-replacement, front-pass]
-- spec: SPEC#member-modes-and-implicit-schema-parameters
type Cell = { var count: i64 }
type Slot<T> = { var via item: T }

fn example() -> () {
    let mut source = Cell.{ count: 0 }
    let mut other = Cell.{ count: 10 }
    let mut slot = Slot.{ item: ref source }
    slot.item = ref other
    source.count += 1
    other.count += 1
    assert(slot.item.count == 11)

    let frozen = Cell.{ count: 1 }
    let mut snapshot = Slot.{ item: frozen }
    snapshot.item = Cell.{ count: 2 }
    assert(snapshot.item.count == 2)
}

-- [case: parenthesized-observation-keeps-its-expression-role, front-pass]
-- spec: SPEC#member-modes-and-implicit-schema-parameters
type Cell = { var count: i64 }
fn example(ref cell: Cell) -> () {
    let _ = (ref cell)
    let _ = .{ ref cell, selected: ref cell }
    let _ = (ref cell, cell)
}

-- [case: via-is-still-a-contextual-field-label, front-pass]
-- spec: SPEC#member-modes-and-implicit-schema-parameters
type Fields = { var via: i64, via item: { var count: i64 } }
fn example() -> () {
    let _ = Fields.{ var via: 1, item: .{ var count: 2 } }
}

-- [case: recursive-schema-and-callable-via-binders, front-pass]
-- spec: SPEC#member-modes-and-implicit-schema-parameters
type Node<T> { End, Link { var via value: T, ref following: Node<T> } }
type Alias<T> = Node<T>
fn apply<T>(input: { via value: T }, callback: fn(via T) -> infer T) -> infer T {
    callback(input.value)
}

-- [case: type-patterns-cannot-infer-a-declared-member-mode, front-fail]
-- spec: SPEC#structural-type-pattern-matching
-- Error [E0412]
type Select = \T -> match <T> {
    <{ var via item: let U }> -> <U>,
    _ -> <never>,
}

-- [case: type-tuple-patterns-cannot-infer-a-member-mode, front-fail]
-- spec: SPEC#structural-type-pattern-matching
-- Error [E0412]
type Select = \T -> match <T> {
    <(via let U, i64)> -> <U>,
    _ -> <never>,
}

-- [case: captured-tuple-member-mode-cannot-also-spell-a-mode, front-fail]
-- spec: SPEC#structural-type-pattern-matching
-- Error [E0120]
type Select = \T -> match <T> {
    <(let M mut let U, i64)> -> <U>,
    _ -> <never>,
}

-- [case: captured-record-member-mode-cannot-also-spell-a-mode, front-fail]
-- spec: SPEC#structural-type-pattern-matching
-- Error [E0120]
type Select = \T -> match <T> {
    <{ let M var ref item: let U }> -> <U>,
    _ -> <never>,
}

-- [case: via-field-label-in-a-type-pattern-is-not-mode-inference, front-pass]
-- spec: SPEC#structural-type-pattern-matching
type Select = \T -> match <T> {
    <{ via: let U }> -> <U>,
    _ -> <never>,
}

-- [case: inline-map-key-member-via-is-an-explicit-input-occurrence, front-pass]
-- spec: SPEC#access-mode-inference-with-via-and-infer
fn select<T>(items: [{ via item: T }: i64]) -> infer i64 { 0 }
