-- [case: lossless-source-layout, front-pass]
-- spec: SPEC#whitespace-and-layout-rules
{- outer {- nested -} comment -}
fn accumulate(value: i64)
    -> i64
{
    let result = value +
        10
    result
        |> twice
where
    fn twice(n: i64) -> i64 { n * 2 }
}
let TEXT = "formatted {accumulate(2):>8}"
let RAW = `literal { }`
let DATA = b"\x00\xFF"

-- [case: exact-source-encoding, front-fail]
-- spec: SPEC#character-set-and-encoding
-- Error [E0104]
-- file: root.ril hex
6c 65 74 20 54 45 58 54 20 3d 20 ff

-- [case: invalid-numeric-suffix, front-fail]
-- spec: SPEC#numeric-literals
-- Error [E0111]
let VALUE = 123int

-- [case: primitive-is-reserved, front-fail]
-- spec: SPEC#keywords
-- Error [E0113]
fn example() -> () {
    let i64 = 1
}

-- [case: contextual-keywords, front-pass]
-- spec: SPEC#keywords
type Config = { opaque: bool, scoped: bool, in: bool, via: bool, infer: bool }
fn sample(opaque: i64, scoped: i64, in: i64, via: i64) -> i64 {
    let infer = opaque + scoped + in + via
    infer
}

-- [case: delimiters-and-recovery, front-fail]
-- spec: SPEC#syntactic-diagnostic-conditions
fn recovery() -> () {
    let pair = (1, 2]
    --~ ERROR [E0123]
    let array = [1 2]
    --~ ERROR [E0124]
    let _ = 3
}

-- [case: nested-shapes-and-modes, front-pass]
-- spec: SPEC#array-map-and-tuple-types
type Cell = { var value: i64 }
type Table = [str: ^mut Cell]
type Pair = (var i64, ref Cell)
type Sequence = [via]Cell
type OptionalArray = ?[]i64
fn relay<T>(via value: T) -> infer T {
    let via item = value
    item
}
fn observe(ref cell: Cell) -> ref(cell) Cell { cell }

-- [case: infer-with-via-inputs, front-pass]
-- spec: SPEC#access-mode-inference-with-via-and-infer
type Forward<T> = fn(via T) -> infer T
type ReadField<T> = fn({ var via item: T }) -> infer T
type ReadMap<T> = fn([str: via T]) -> infer T
fn inspect<T>(ref values: [via]T) -> infer i64 { len(ref values) }
fn relay<T>(ref value: T, forward: fn(via T) -> infer T) -> infer T {
    forward(ref value)
}

-- [case: infer-requires-via-inputs, front-fail]
-- spec: SPEC#access-mode-inference-with-via-and-infer
type Cell = { var value: i64 }
type Packet<T> = { via item: T }
fn create() -> infer Cell { Cell.{ value: 0 } } --~ ERROR [E0412]
fn echo(via: Cell) -> infer Cell { via } --~ ERROR [E0412]
fn read<T>(packet: Packet<T>) -> infer i64 { 0 } --~ ERROR [E0412]
fn outer<T>(via value: T, inner: fn(ref T) -> infer T) -> T { value } --~ ERROR [E0412]
fn body_only<T>(value: T) -> infer T { let local = \via x: T -> x; local(value) } --~ ERROR [E0412]
type Factory<T> = fn() -> infer fn(via T) -> T --~ ERROR [E0412]
eff Read<T> { read(via value: T) -> infer T } --~ ERROR [E0412]

-- [case: block-binders, front-pass]
-- spec: SPEC#control-flow-and-pattern-matching
fn steps(items: []i64, maybe: ?i64) -> i64 {
    var total = 0
    for items as item { total += item }
    if let Some(number) = maybe { total += number }
    match maybe {
        Some(n) if n > 0 -> n + total,
        _ -> total,
    }
}

-- [case: qualified-generic-effect, front-pass]
-- spec: SPEC#effect-declarations-and-operation-signatures
eff State<S> {
    get() -> S,
    put(value: S) -> (),
}
fn run() -> i64 {
    with State<i64>::get() -> resume 7
    State<i64>::get()
}

-- [case: tuple-coordinate-chains, front-pass]
-- spec: SPEC#array-map-and-tuple-types
fn read(pair: ((i64, i64), i64)) -> i64 { pair.0.1 }
fn xor(value: i64, mutator: i64) -> i64 { value^mutator }

-- [case: named-reference-argument, front-pass]
-- spec: SPEC#default-parameters-and-named-arguments
type Cell = { var value: i64 }
fn inspect(ref cell: Cell) -> i64 { cell.value }
fn sample(ref source: Cell) -> i64 { inspect(cell: ref source) }

-- [case: mapped-schema-mode-projection, front-pass]
-- spec: SPEC#mapped-record-and-tuple-types
halt type Project = \T: { .. }, keys: []str ->
    <{ modeof T.(K) [keys as K]: T.(K) }>
type Shape = { var value: i64 }
type Projection = Project<Shape, ["value"]>
