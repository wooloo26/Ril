-- [case: nested-static-pattern-binder, front-pass]
-- spec: SPEC#structural-type-pattern-matching
type Choose = \T -> match (<T>, true) {
    (<let U>, true) | (<let U>, false) if <U> == <T> -> <U>,
    _ -> <never>,
}

-- [case: default-resolves-earlier-parameter, front-pass]
