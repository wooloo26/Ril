-- [case: visible-constructor-selects-application-sort, front-pass]
-- spec: SPEC#static-type-values-and-type-quotation
type Event<T> { Ready(T) }
fn sample() -> () {
    let _ = Ready<true && false>(1)
where
    type Event<flag: bool> { Ready(i64) }
}

-- [case: aliased-constructor-candidates-share-identity, front-pass]
