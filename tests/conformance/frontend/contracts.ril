-- [case: state-groups-preserve-named-and-module-sources, front-pass]
-- spec: SPEC#state-groups-and-captured-layers
var visits = 0
fn tick() &up(sub){mut visits} -> () { visits += 1 }
fn outer_layer() -> i64 {
    var count = 0
    middle()
where
    fn middle() &up{mut count} -> i64 {
        inner()
    where
        fn inner() &up(outer_layer){mut count} -> i64 {
            count += 1
            count
        }
    }
}

