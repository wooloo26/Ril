-- [case: explicit-set-import-retains-the-standard-type-under-shadowing, front-pass]
-- spec: SPEC#prelude-scope
use ril/set as Unique
type Set<T> = { item: T }
fn local() -> Set<i64> { Set.{ item: 1 } }
fn standard() -> Unique<i64> { Unique::from([1, 2, 1]) }
