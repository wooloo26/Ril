-- [case: numeric-namespace-is-ambient-and-explicitly-importable, front-pass]
-- spec: SPEC#explicit-numeric-conversions
use ril/numeric as Conversion
use ril/numeric::{convert as coerce}
fn convert_values() -> (?i64, ?i64, ?i64, u8, f32) {
    (
        Numeric::convert<i64>(255u8),
        Conversion::trunc<i64>(3.5),
        coerce<i64>(1u8),
        Numeric::wrap<u8>(257),
        Numeric::reinterpret<f32>(1u32),
    )
}

