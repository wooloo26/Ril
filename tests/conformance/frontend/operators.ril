-- [case: assignment-in-value-position, front-pass]
-- spec: SPEC#assignments-and-compound-assignments
fn consume(value: ()) -> () { value }
fn update() -> () {
    var total = 0
    let result = total += 1
    consume(total = 2)
    result
}

-- [case: ungrouped-chained-assignment, front-fail]
-- spec: SPEC#assignments-and-compound-assignments
fn update() -> () {
    var first = 0
    var second = 0
    first = second = 1
    --~ ERROR [E0701]
}

-- [case: chained-comparison, front-fail]
-- spec: SPEC#operator-precedence-and-associativity
fn compare(a: i64, b: i64, c: i64) -> bool {
    a < b < c
    --~ ERROR [E0120]
}

-- [case: chained-range, front-fail]
-- spec: SPEC#operator-precedence-and-associativity
fn invalid() -> () {
    let _ = 1..2..=3
    --~ ERROR [E0120]
}

-- [case: grouped-comparisons-and-separate-ranges, front-pass]
-- spec: SPEC#operator-precedence-and-associativity
fn compare() -> bool { (1 < 2) == (3 < 4) && 1..2 == 3..4 }

-- [case: leading-assignment-does-not-continue, front-fail]
-- spec: SPEC#whitespace-and-layout-rules
-- Error [E0124]
fn update() -> () {
    var total = 0
    total
        = 1
    --~ ERROR [E0120]
}
