-- [case: parameterized-handler-remainder-shadows-prefix, front-pass]
-- spec: SPEC#parameterized-handler-applications
fn pass<T>(action: fn() @& -> T) -> T { action() }
fn example() -> i64 {
    let value = 1
    with pass<i64>()
    let value = value + 1
    with pass()
    let value = value + 1
    return value
}

-- [case: enclosing-where-remains-hoisted-before-application, front-pass]
-- spec: SPEC#block-expressions-tail-values-and-hoisted-declarations
fn pass(action: fn() -> i64) -> i64 { action() }
fn example() -> i64 {
    let saved = helper()
    with pass()
    saved + helper()
where
    fn helper() -> i64 { 1 }
}

-- [case: with-application-requires-argument-list, front-fail]
-- spec: SPEC#parameterized-handler-applications
-- Error [E0124]
fn pass(action: fn() -> i64) -> i64 { action() }
fn example() -> i64 {
    with pass
    7
}

-- [case: loop-transfer-cannot-cross-implicit-callable, front-fail]
-- spec: SPEC#parameterized-handler-applications
fn pass(action: fn() -> ()) -> () { action() }
fn example() -> () {
    loop {
        with pass()
        next
        --~ ERROR [E0707]
    }
}

-- [case: loop-transfer-in-implicit-callable, front-pass]
-- spec: SPEC#parameterized-handler-applications
fn pass(action: fn() -> i64) -> i64 { action() }
fn example() -> i64 {
    with pass()
    loop { last 7 }
}

-- [case: generic-handler-head-and-resumption, front-pass]
-- spec: SPEC#effect-handlers
eff Read<T> { get() -> T, put(value: T) -> () }
fn example() -> i64 {
    with {
        Read<i64>::get() -> resume 7,
        Read<i64>::put(value) -> resume (),
    }
    Read<i64>::get()
}

-- [case: system-yield-is-a-resolved-operation, front-pass]
-- spec: SPEC#normative-rules-for-built-in-system-effects
fn example() -> () {
    with Fiber::yield() -> resume ()
    Fiber::yield()
}

-- [case: empty-handler-group, front-fail]
-- spec: SPEC#effect-handlers
fn example() -> () {
    with {}
    --~ ERROR [E0120]
}

-- [case: budget-is-a-generic-handler-application, front-pass]
-- spec: SPEC#finite-evaluation-with-div
halt fn example() -> i64 {
    with Div::exhausted() -> 0
    with Div::budget<i64>(10)
    42
}

-- [case: resume-outside-arm, front-fail]
-- spec: SPEC#affine-resumption-and-delimited-early-abort
fn example() -> i64 {
    resume 1
    --~ ERROR [E0623]
}

-- [case: module-propagation-has-no-callable, front-fail]
-- spec: SPEC#error-and-fallback-operators
let BAD = Some(1)?
--~ ERROR [E0205]

-- [case: fallback-cannot-transfer-outward, front-fail]
-- spec: SPEC#error-and-fallback-operators
fn example(value: ?i64) -> i64 {
    value ?? return 0
    --~ ERROR [E0710]
}

-- [case: fallback-permits-local-loop-exit, front-pass]
-- spec: SPEC#error-and-fallback-operators
fn example(value: ?i64) -> i64 {
    value ?? loop { last 0 }
}

-- [case: return-operand-layout-in-argument-list, front-pass]
-- spec: SPEC#whitespace-and-layout-rules
fn consume(value: i64) -> i64 { value }
fn example() -> i64 {
    consume(
        return
        7,
    )
}

-- [case: bare-return-before-block-where, front-pass]
-- spec: SPEC#control-transfers
fn example() -> () { return where type Value = i64 }
