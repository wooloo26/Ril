--@ case: evaluation-order
--@ mode: run-pass
--@ spec: SPEC#abstract-machine-and-memory-semantics
--@ entry: test_evaluation_order
--@ file: evaluation-order.ril
pub fn test_evaluation_order() {
    let mut trace: []int = []
    let mut log = \value -> { trace !> Array::push(value); value }
    let result = log(1) + log(2) * log(3)
    assert(result == 7 && trace == [1, 2, 3])
}
--@ end-file
--@ end-case

--@ case: ieee-comparison
--@ mode: run-pass
--@ spec: SPEC#relational-equality-and-containment-operators
--@ entry: test_ieee_comparison
--@ file: ieee-comparison.ril
pub fn test_ieee_comparison() {
    let nan = 0.0 / 0.0
    assert(nan != nan && !(nan == nan))
    assert(!(nan < 1.0) && !(nan <= 1.0) && !(nan > 1.0) && !(nan >= 1.0))
    assert(0.0 == -0.0)
    assert(1.0 / 0.0 > 1.0 && 1.0 / -0.0 < -1.0)
}
--@ end-file
--@ end-case

--@ case: integer-arithmetic
--@ mode: run-pass
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ entry: test_integer_arithmetic
--@ file: integer-arithmetic.ril
pub fn test_integer_arithmetic() {
    assert(-7 / 3 == -2 && -7 % 3 == -1)
    assert(7 / -3 == -2 && 7 % -3 == 1)
    assert(-128i8 % -1i8 == 0i8)
    assert(10 /? 0 == None && 10 %? 0 == None)
    assert(-128i8 /? -1i8 == None)
    assert(10 /? 2 == Some(5))
    assert(255u8 +% 1u8 == 0u8)
    assert(0u8 -% 1u8 == 255u8)
    assert(128u8 *% 2u8 == 0u8)
    assert(1bigint << 100 > 1bigint << 99)
}
--@ end-file
--@ end-case

