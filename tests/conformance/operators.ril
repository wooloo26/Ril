}

-- [case: negative-shift-safe, run-pass]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: negative-shift
pub fn test_negative_shift_safe() {
    assert(1u8 << 0 == 1u8)
}

-- [case: negative-shift, run-panic]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: negative-shift-safe
-- Panics: negative shift
pub fn test_negative_shift() {
    let _ = 1u8 << -1
}

-- [case: pipeline, run-pass]
-- spec: SPEC#pipeline-operators
pub fn test_pipeline() {
    let values = [1, 2, 3] |> Array::map(\value -> value * 2) |> Array::filter(\value -> value > 2)
    assert(values == [4, 6])
    let mut changed: []int = []
    changed !> Array::push(3)
    assert(changed == [3])
}

-- [case: precedence, run-pass]
-- spec: SPEC#operator-precedence-and-associativity
pub fn test_precedence() {
    assert(1 + 2 * 3 == 7)
    assert((1 + 2) * 3 == 9)
    assert(8 - 3 - 2 == 3)
    assert(16 / 2 / 2 == 4)
    assert(!false && true || false)
}

-- [case: remainder-zero-safe, run-pass]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: remainder-zero
pub fn test_remainder_zero_safe() {
    assert(1 % 1 == 0)
}

-- [case: remainder-zero, run-panic]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: remainder-zero-safe
-- Panics: remainder zero
pub fn test_remainder_zero() {
    let _ = 1 % 0
}

-- [case: structural-equality, run-pass]
-- spec: SPEC#relational-equality-and-containment-operators
pub fn test_structural_equality() {
    assert(.{ x: 1, y: 2 } == .{ y: 2, x: 1 })
    assert(["a": 1, "b": 2] == ["b": 2, "a": 1])
    assert(Set::from([1, 2]) == Set::from([2, 1]))
    let callback: ?fn() -> () = None
    assert(callback == None)
    assert(2 in [1, 2] && "a" in ["a": 1] && 2 in 1..=2)
}

