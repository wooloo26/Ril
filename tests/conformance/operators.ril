--@ case: bitwise-and-shift
--@ mode: run-pass
--@ spec: SPEC#bitwise-and-shift-operators
--@ entry: test_bitwise_and_shift
--@ file: bitwise-and-shift.ril
pub fn test_bitwise_and_shift() {
    assert((12 & 10) == 8 && (12 | 10) == 14 && (12 ^ 10) == 6)
    assert(~0u8 == 255u8)
    assert(-8i8 >> 2 == -2i8 && 128u8 >> 7 == 1u8)
    assert(128u8 << 1 == 0u8)
}
--@ end-file
--@ end-case

