-- [case: accept-bigint-wrap, check-pass]
-- spec: SPEC#bitwise-and-shift-operators
-- companion: reject-bigint-wrap
fn example() {
    let value = 1bigint + 2bigint
}

-- [case: reject-bigint-wrap, check-fail]
-- spec: SPEC#bitwise-and-shift-operators
-- companion: accept-bigint-wrap
-- Error [E0327]: reject bigint wrap
fn example() {
    let value = 1bigint +% 2bigint
}

-- [case: accept-callable-equality, check-pass]
-- spec: SPEC#relational-equality-and-containment-operators
-- companion: reject-callable-equality
fn action() -> int { 1 }

fn example() {
    let same = action() == action()
}

-- [case: reject-callable-equality, check-fail]
-- spec: SPEC#relational-equality-and-containment-operators
-- companion: accept-callable-equality
-- Error [E0327]: reject callable equality
fn action() -> int { 1 }

fn example() {
    let same = action == action
}

-- [case: accept-float-wrap, check-pass]
-- spec: SPEC#bitwise-and-shift-operators
-- companion: reject-float-wrap
fn example() {
    let value = 1.0 + 2.0
}

-- [case: reject-float-wrap, check-fail]
-- spec: SPEC#bitwise-and-shift-operators
-- companion: accept-float-wrap
-- Error [E0327]: reject float wrap
fn example() {
    let value = 1.0 +% 2.0
}

-- [case: accept-string-add, check-pass]
-- spec: SPEC#bitwise-and-shift-operators
-- companion: reject-string-add
fn example() {
    let value = String::concat("a", "b")
}

-- [case: reject-string-add, check-fail]
-- spec: SPEC#bitwise-and-shift-operators
-- companion: accept-string-add
-- Error [E0327]: reject string add
fn example() {
    let value = "a" + "b"
}

-- [case: bigint-negative-shift-safe, run-pass]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: bigint-negative-shift
pub fn test_bigint_negative_shift_safe() {
    assert(1bigint >> 0 == 1bigint)
}

-- [case: bigint-negative-shift, run-panic]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: bigint-negative-shift-safe
-- Panics: bigint negative shift
pub fn test_bigint_negative_shift() {
    let _ = 1bigint >> -1
}

-- [case: bitwise-and-shift, run-pass]
-- spec: SPEC#bitwise-and-shift-operators
pub fn test_bitwise_and_shift() {
    assert((12 & 10) == 8 && (12 | 10) == 14 && (12 ^ 10) == 6)
    assert(~0u8 == 255u8)
    assert(-8i8 >> 2 == -2i8 && 128u8 >> 7 == 1u8)
    assert(128u8 << 1 == 0u8)
}

-- [case: checked-add-safe, run-pass]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: checked-add
pub fn test_checked_add_safe() {
    assert(126i8 + 1i8 == 127i8)
}

-- [case: checked-add, run-panic]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: checked-add-safe
-- Panics: checked add
pub fn test_checked_add() {
    let _ = 127i8 + 1i8
}

