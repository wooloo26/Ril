--@ case: pipeline
--@ mode: run-pass
--@ spec: SPEC#pipeline-operators
--@ entry: test_pipeline
--@ file: pipeline.ril
pub fn test_pipeline() {
    let values = [1, 2, 3] |> Array::map(\value -> value * 2) |> Array::filter(\value -> value > 2)
    assert(values == [4, 6])
    let mut changed: []int = []
    changed !> Array::push(3)
    assert(changed == [3])
}
--@ end-file
--@ end-case

--@ case: precedence
--@ mode: run-pass
--@ spec: SPEC#operator-precedence-and-associativity
--@ entry: test_precedence
--@ file: precedence.ril
pub fn test_precedence() {
    assert(1 + 2 * 3 == 7)
    assert((1 + 2) * 3 == 9)
    assert(8 - 3 - 2 == 3)
    assert(16 / 2 / 2 == 4)
    assert(!false && true || false)
}
--@ end-file
--@ end-case

