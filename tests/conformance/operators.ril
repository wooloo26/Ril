--@ case: bigint-negative-shift-safe
--@ mode: run-pass
--@ spec: SPEC#arithmetic-and-wrapping-operators
--@ companion: bigint-negative-shift
--@ entry: test_bigint_negative_shift_safe
--@ file: bigint-negative-shift-safe.ril
