-- [case: checked-subtract-safe, run-pass]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: checked-subtract
pub fn test_checked_subtract_safe() {
    assert(1u8 - 1u8 == 0u8)
}

-- [case: checked-subtract, run-panic]
-- spec: SPEC#arithmetic-and-wrapping-operators
-- companion: checked-subtract-safe
