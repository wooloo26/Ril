--@ case: names-and-identity
--@ mode: run-pass
--@ spec: SPEC#prelude-scope
--@ spec: STD#prelude-and-module-index
--@ entry: test_names_and_identity
--@ file: names-and-identity.ril
pub fn test_names_and_identity() {
    let values: []int = [1, 2]
    let tags: Set<str> = Set::from(["a", "a"])
    let result: Result<int, str> = Ok(2)
    assert(Array::first(values) == Some(1))
    assert(len(tags) == 1 && result is Ok(2))
    let clone = \n: int -> n + 1
    assert(clone(1) == 2)
}
--@ end-file
--@ end-case
