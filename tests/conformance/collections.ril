-- [pair: collection-projection]
-- spec: SPEC#array-map-and-tuple-types

-- accept
use ril/array::{Elem}
type Item = Elem<[]int>

-- reject
-- Error [E0337]: reject collection projection
type Item = ([]int).elem

-- [pair: fixed-length]
-- spec: SPEC#array-map-and-tuple-types

-- accept
fn example() {
    let items: [2]int = [1, 2]
}

-- reject
-- Error [E0301]: reject fixed length
fn example() {
    let items: [2]int = [1]
}

-- [pair: float-key]
-- spec: SPEC#relational-equality-and-containment-operators

-- accept
fn example() {
    let values = [1: 1]
}

-- reject
-- Error [E0328]: reject float key
fn example() {
    let values = [1.0: 1]
}

-- [pair: float-set]
-- spec: SPEC#relational-equality-and-containment-operators

-- accept
fn example() {
    let values = Set::from([1])
}

-- reject
-- Error [E0328]: reject float set
fn example() {
    let values = Set::from([1.0])
}

-- [pair: invalid-index-target]
-- spec: SPEC#array-map-and-tuple-types

-- accept
fn example() {
    let item = [42][0]
}

-- reject
-- Error [E0352]: reject invalid index target
fn example() {
    let item = 42[0]
}

-- [pair: invalid-index-type]
-- spec: SPEC#array-map-and-tuple-types

-- accept
fn example() {
    let item = [42][0]
}

-- reject
-- Error [E0301]: reject invalid index type
fn example() {
    let item = [42]["0"]
}

-- [pair: length-sort]
-- spec: SPEC#array-map-and-tuple-types

-- accept
fn example() {
    let items: [0]int = []
}

-- reject
-- Error [E0323]: reject length sort
fn example() {
    let items: ["0"]int = []
}

-- [pair: negative-length]
-- spec: SPEC#array-map-and-tuple-types

-- accept
fn example() {
    let items: [0]int = []
}

-- reject
-- Error [E0815]: reject negative length
fn example() {
    let items: [-1]int = []
}

-- [pair: record-key]
-- spec: SPEC#relational-equality-and-containment-operators

-- accept
fn example() {
    let values = [1: 1]
}

-- reject
-- Error [E0328]: reject record key
fn example() {
    let values = [.{ id: 1 }: 1]
}

-- [pair: tuple-index]
-- spec: SPEC#array-map-and-tuple-types

-- accept
fn example() {
    let item = (1, "a").1
}

-- reject
-- Error [E0312]: reject tuple index
fn example() {
    let item = (1, "a").2
}

-- [case: literal-and-lookup, run-pass]
-- spec: SPEC#array-map-and-tuple-types
pub fn test_literal_and_lookup() {
    let fixed: [2]u8 = [1, 2]
    let dynamic: []int = [3, 4]
    let values: [str: int] = ["a": 1]
    let empty: [str: int] = [:]
    assert(fixed[1] == 2u8 && dynamic[0] == 3)
    assert(values["a"] == Some(1) && values["b"] == None)
    assert(len(empty) == 0 && (7, "a").0 == 7)
}
