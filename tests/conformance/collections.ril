-- [case: accept-collection-projection, check-pass]
-- spec: SPEC#array-map-and-tuple-types
-- companion: reject-collection-projection
use ril/array::{Elem}
type Item = Elem<[]int>

-- [case: reject-collection-projection, check-fail]
-- spec: SPEC#array-map-and-tuple-types
-- companion: accept-collection-projection
-- Error [E0337]: reject collection projection
type Item = ([]int).elem

-- [case: accept-fixed-length, check-pass]
-- spec: SPEC#array-map-and-tuple-types
-- companion: reject-fixed-length
fn example() {
    let items: [2]int = [1, 2]
}

-- [case: reject-fixed-length, check-fail]
-- spec: SPEC#array-map-and-tuple-types
-- companion: accept-fixed-length
-- Error [E0301]: reject fixed length
fn example() {
    let items: [2]int = [1]
}

-- [case: accept-float-key, check-pass]
-- spec: SPEC#relational-equality-and-containment-operators
-- companion: reject-float-key
