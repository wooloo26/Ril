    let values = [1: 1]
}

-- [case: reject-float-key, check-fail]
-- spec: SPEC#relational-equality-and-containment-operators
-- companion: accept-float-key
-- Error [E0328]: reject float key
fn example() {
    let values = [1.0: 1]
}

-- [case: accept-float-set, check-pass]
-- spec: SPEC#relational-equality-and-containment-operators
-- companion: reject-float-set
