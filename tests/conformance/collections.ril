--@ end-case

--@ case: reject-collection-projection
--@ mode: check-fail
--@ spec: SPEC#array-map-and-tuple-types
--@ companion: accept-collection-projection
-- Error [E0337]: reject collection projection
--@ file: reject-collection-projection.ril
type Item = ([]int).elem
--@ end-file
--@ end-case

