--@ case: literal-and-lookup
--@ mode: run-pass
--@ spec: SPEC#array-map-and-tuple-types
--@ entry: test_literal_and_lookup
--@ file: literal-and-lookup.ril
pub fn test_literal_and_lookup() {
    let fixed: [2]u8 = [1, 2]
    let dynamic: []int = [3, 4]
    let values: [str: int] = ["a": 1]
    let empty: [str: int] = [:]
    assert(fixed[1] == 2u8 && dynamic[0] == 3)
    assert(values["a"] == Some(1) && values["b"] == None)
    assert(len(empty) == 0 && (7, "a").0 == 7)
}
--@ end-file
--@ end-case
