--@ case: reject-parameter-option-record-dimension
--@ mode: check-fail
--@ spec: SPEC#pattern-matching
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ companion: parameter-record-option-sources-pointer32
-- Error [E0301]: Nested nominal Option payloads retain their declared array coordinates.
--@ file: source.ril
type Packet = { id: int, items: [0][3]int }
fn exact(values: [0][2]int) -> int { len(values) }
fn invalid(input: (Option<Packet>, bool)) -> int {
    match input {
        (wrapped, ..) -> match wrapped {
            Some(.{ id, ..rest }) -> id + exact(rest.items),
            None -> 0,
        },
    }
}
