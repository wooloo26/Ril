--@ source: parameter-sequence-sources
--@ file: source.ril
fn exact(values: [2]int) -> int { len(values) }
fn empty(values: [0][2]int) -> int { len(values) }
fn fixed(values: [3]int) -> int {
    match values { [head, ..tail] -> head + exact(tail) }
}
fn dynamic(values: []int) -> int { match values { [..all] -> len(all) } }
fn suffix(values: (str, bool, [0][2]int)) -> int { match values { (.., tail) -> empty(tail) } }
pub fn test_native() {
    assert(fixed([10, 20, 30]) == 12)
    assert(dynamic([1, 2, 3, 4]) == 4 && dynamic([]) == 0)
    let values: [0][2]int = []
    assert(suffix(("discarded", false, values)) == 0)
    let typed = \input: (int, str, [0][2]int) -> match input {
        (prefix, .., tail) -> prefix + empty(tail),
    }
    let inferred = \input -> match input { (prefix, .., tail) -> prefix + empty(tail) }
    assert(typed((7, "middle", values)) == 7)
    assert(inferred((9, "middle", values)) == 9)
}
--@ end-file
--@ end-source

