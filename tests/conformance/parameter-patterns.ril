--@ source: parameter-record-option-sources
--@ file: source.ril
type Packet = { id: int, items: [0][2]int, label: str }
eff Inspect { packet(value: Packet) -> int }
fn empty(values: [0][2]int) -> int { len(values) }
fn remainder(packet: Packet) -> int {
    match packet { .{ id, ..rest } -> id + empty(rest.items) }
}
fn nested(input: (Option<Packet>, bool, int)) -> int {
    match input {
        (wrapped, .., final) -> match wrapped {
            Some(.{ id, ..rest }) -> id + empty(rest.items) + final,
            None -> 0,
        },
    }
}
pub fn test_native() {
    let items: [0][2]int = []
    let packet = Packet.{ id: 5, items, label: "retained" }
    assert(remainder(packet) == 5)
    assert(nested((Some(packet), false, 7)) == 12)
    assert(nested((None, true, 20)) == 0)
    with Inspect::packet(.{ id, ..rest }) -> resume id + empty(rest.items)
    assert(Inspect::packet(packet) == 5)
}
--@ end-file
--@ end-source

