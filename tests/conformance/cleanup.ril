-- [case: abort-commits-writes, run-pass]
-- spec: SPEC#affine-resumption-and-delimited-early-abort
type Resource = { mut on_close: fn() -> () }
eff Abort { stop() -> int }

pub fn test_abort_commits_writes() {
    let mut events: []int = []
    let result = {
        with Abort::stop() -> 9
        let scoped mut first = Resource.{ on_close: \-> events !> Array::push(1) }
        let scoped mut second = Resource.{ on_close: \-> events !> Array::push(2) }
        events !> Array::push(0)
        Abort::stop()
    }
    assert(result == 9 && events == [0, 2, 1])
}

-- [pair: divergent-cleanup]
-- spec: SPEC#scoped-resource-bindings

-- accept
type Guard = { on_close: fn() -> () }

fn example() {
    let scoped item = Guard.{ on_close: \-> () }
}

-- reject
-- Error [E0617]: reject divergent cleanup
type Guard = { on_close: fn() -> () }

fn example() {
    let scoped item = Guard.{ on_close: \-> { loop {} } }
}

-- [pair: effectful-cleanup]
-- spec: SPEC#scoped-resource-bindings

-- accept
type Guard = { on_close: fn() -> () }

fn example() @Fiber {
    let scoped item = Guard.{ on_close: \-> () }
}

-- reject
-- Error [E0616]: reject effectful cleanup
type Guard = { on_close: fn() -> () }

fn example() @Fiber {
    let scoped item = Guard.{ on_close: \-> Fiber::yield() }
}

-- [pair: missing-contract]
-- spec: SPEC#scoped-resource-bindings

-- accept
type Guard = { on_close: fn() -> () }

fn example() {
    let scoped item = Guard.{ on_close: \-> () }
}

-- reject
-- Error [E0541]: reject missing contract
type Guard = { on_close: fn() -> () }

fn example() {
    let scoped item = 42
}

-- [pair: reassignable-scoped]
-- spec: SPEC#scoped-resource-bindings

-- accept
type Guard = { on_close: fn() -> () }

fn example() {
    let scoped item = Guard.{ on_close: \-> () }
}

-- reject
-- Error [E0532]: reject reassignable scoped
type Guard = { on_close: fn() -> () }

fn example() {
    var scoped item = Guard.{ on_close: \-> () }
}

-- [pair: resource-escape]
-- spec: SPEC#scoped-resource-bindings

-- accept
type Guard = { on_close: fn() -> () }
fn make() -> () { let scoped item = Guard.{ on_close: \-> () } }

-- reject
-- Error [E0604]: reject resource escape
type Guard = { on_close: fn() -> () }
fn make() -> Guard { let scoped item = Guard.{ on_close: \-> () }; item }

-- [case: loop-registration, run-pass]
-- spec: SPEC#scoped-resource-bindings
type Resource = { mut on_close: fn() -> () }

pub fn test_loop_registration() {
    let mut events: []int = []
    for 0..3 as index {
        let scoped mut resource = Resource.{ on_close: \-> events !> Array::push(index) }
        if index == 0 { next }
        if index == 2 { last }
    }
    assert(events == [0, 1, 2])
}

-- [case: normal-lifo, run-pass]
-- spec: SPEC#scoped-resource-bindings
type Resource = { mut on_close: fn() -> () }

pub fn test_normal_lifo() {
    let mut events: []int = []
    {
        let scoped mut first = Resource.{ on_close: \-> events !> Array::push(1) }
        let scoped mut second = Resource.{ on_close: \-> events !> Array::push(2) }
        events !> Array::push(0)
    }
    assert(events == [0, 2, 1])
}

-- [case: replacement-callback, run-pass]
-- spec: SPEC#scoped-resource-bindings
type Resource = { mut on_close: fn() -> () }

pub fn test_replacement_callback() {
    let mut events: []int = []
    {
        let scoped mut resource = Resource.{ on_close: \-> events !> Array::push(1) }
        resource.on_close = \-> events !> Array::push(2)
    }
    assert(events == [2])
}

-- [case: return-runs-cleanup, run-pass]
-- spec: SPEC#scoped-resource-bindings
type Resource = { mut on_close: fn() -> () }
fn finish(mut events: []int) &mut {
    let scoped mut resource = Resource.{ on_close: \-> events !> Array::push(1) }
    return
}

pub fn test_return_runs_cleanup() {
    let mut events: []int = []
    finish(mut events)
    assert(events == [1])
}
