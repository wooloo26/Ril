--@ case: loop-registration
--@ mode: run-pass
--@ spec: SPEC#scoped-resource-bindings
--@ entry: test_loop_registration
--@ file: loop-registration.ril
type Resource = { mut on_close: fn() -> () }

pub fn test_loop_registration() {
    let mut events: []int = []
    for 0..3 as index {
        let scoped mut resource = Resource.{ on_close: \-> events !> Array::push(index) }
        if index == 0 { next }
        if index == 2 { last }
    }
    assert(events == [0, 1, 2])
}
--@ end-file
--@ end-case

--@ case: normal-lifo
--@ mode: run-pass
--@ spec: SPEC#scoped-resource-bindings
--@ entry: test_normal_lifo
--@ file: normal-lifo.ril
type Resource = { mut on_close: fn() -> () }

pub fn test_normal_lifo() {
    let mut events: []int = []
    {
        let scoped mut first = Resource.{ on_close: \-> events !> Array::push(1) }
        let scoped mut second = Resource.{ on_close: \-> events !> Array::push(2) }
        events !> Array::push(0)
    }
    assert(events == [0, 2, 1])
}
--@ end-file
--@ end-case

--@ case: replacement-callback
--@ mode: run-pass
--@ spec: SPEC#scoped-resource-bindings
--@ entry: test_replacement_callback
--@ file: replacement-callback.ril
type Resource = { mut on_close: fn() -> () }

pub fn test_replacement_callback() {
    let mut events: []int = []
    {
        let scoped mut resource = Resource.{ on_close: \-> events !> Array::push(1) }
        resource.on_close = \-> events !> Array::push(2)
    }
    assert(events == [2])
}
--@ end-file
--@ end-case

--@ case: return-runs-cleanup
--@ mode: run-pass
--@ spec: SPEC#scoped-resource-bindings
--@ entry: test_return_runs_cleanup
--@ file: return-runs-cleanup.ril
type Resource = { mut on_close: fn() -> () }
fn finish(mut events: []int) &mut {
    let scoped mut resource = Resource.{ on_close: \-> events !> Array::push(1) }
    return
}

pub fn test_return_runs_cleanup() {
    let mut events: []int = []
    finish(mut events)
    assert(events == [1])
}
--@ end-file
--@ end-case
