-- [case: explicit-panic-safe, run-pass]
-- spec: SPEC#run-time-failure-conditions
-- companion: explicit-panic
pub fn test_explicit_panic_safe() {
    assert(true)
}

-- [case: explicit-panic, run-panic]
-- spec: SPEC#run-time-failure-conditions
-- companion: explicit-panic-safe
-- Panics: explicit panic
pub fn test_explicit_panic() {
    panic("defect")
}

-- [case: failed-assert-safe, run-pass]
-- spec: SPEC#run-time-failure-conditions
-- companion: failed-assert
pub fn test_failed_assert_safe() {
    assert(true)
}

-- [case: failed-assert, run-panic]
-- spec: SPEC#run-time-failure-conditions
-- companion: failed-assert-safe
-- Panics: failed assert
pub fn test_failed_assert() {
    assert(false)
}
