-- [case: accept-missing-capture, check-pass]
-- spec: SPEC#closures-factory-signatures-and-lexical-environments
-- companion: reject-missing-capture
type Adder = fn(int) -> int &closure
fn make(base: int) -> Adder &capture { \value -> base + value }

