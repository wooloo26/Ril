--@ case: projection-accessors
--@ mode: run-pass
--@ spec: SPEC#anonymous-functions-trailing-closures-and-projection-accessors
--@ entry: test_projection_accessors
--@ file: projection-accessors.ril
pub fn test_projection_accessors() {
    let values = [.{ id: 1, name: "a" }, .{ id: 2, name: "b" }]
    assert(Array::map(values, \.name) == ["a", "b"])
    assert(Array::map([(1, "a"), (2, "b")], \.0) == [1, 2])
    let optional: []?{ name: str } = [Some(.{ name: "a" }), None]
    assert(Array::map(optional, \?.name) == [Some("a"), None])
    let doubled = [1, 2] |> Array::map \n -> n * 2
    assert(doubled == [2, 4])
}
--@ end-file
--@ end-case

--@ case: shared-capture-origin
--@ mode: run-pass
--@ spec: SPEC#complete-provenance-and-optional-annotations
--@ spec: SPEC#closure-capabilities-and-handle-permissions
--@ entry: test_shared_capture_origin
--@ file: shared-capture-origin.ril
type Cell = { mut count: int }

pub fn test_shared_capture_origin() {
    let mut cell = Cell.{ count: 0 }
    let mut step = \-> { cell.count += 1; cell.count }
    assert(step() == 1)
    cell.count += 1
    assert(step() == 3)
}
--@ end-file
--@ end-case

--@ case: stateful-closure
--@ mode: run-pass
--@ spec: SPEC#closures-factory-signatures-and-lexical-environments
--@ entry: test_stateful_closure
--@ file: stateful-closure.ril
type Step = fn() -> int &closure
fn make_step() -> Step &capture { var count = 0; \-> { count += 1; count } }

pub fn test_stateful_closure() {
    let mut step = make_step()
    assert(step() == 1 && step() == 2)
}
--@ end-file
--@ end-case
