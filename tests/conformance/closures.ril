--@ case: accept-clone-environment
--@ mode: check-pass
--@ spec: SPEC#deep-immutability
--@ companion: reject-clone-environment
--@ file: accept-clone-environment.ril
type Step = fn() -> int &closure
fn make_step() -> Step &capture { var count = 0; \-> { count += 1; count } }

fn example() {
    let mut step = make_step()
    let value = step()
    let _ = clone(value)
}
--@ end-file
--@ end-case

--@ case: reject-clone-environment
--@ mode: check-fail
--@ spec: SPEC#deep-immutability
--@ companion: accept-clone-environment
-- Error [E0530]: reject clone environment
--@ file: reject-clone-environment.ril
type Step = fn() -> int &closure
fn make_step() -> Step &capture { var count = 0; \-> { count += 1; count } }

fn example() {
    let mut step = make_step()
    let _ = step()
    let _ = clone(step)
}
--@ end-file
--@ end-case

