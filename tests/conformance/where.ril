-- [pair: downward-type]
-- spec: SPEC#dual-tier-where-invariants

-- accept
fn example() -> Wrapper
where
    type Internal = int
    type Wrapper = { value: Internal }
{ .{ value: 1 } }

-- reject
-- Error [E0705]: reject downward type
fn example() -> Wrapper
where
    type Wrapper = { value: Internal }
{ .{ value: 1 }
where
    type Internal = int
}

-- [pair: signature-block-type]
-- spec: SPEC#dual-tier-where-invariants

-- accept
fn example(action: Action)
where
    type Action = fn() -> ()
{ action() }

-- reject
-- Error [E0706]: reject signature block type
fn example(action: Action) { action()
where
    type Action = fn() -> ()
}

-- [pair: signature-function]
-- spec: SPEC#dual-tier-where-invariants

-- accept
fn example() { helper()
where
    fn helper() {}
}

-- reject
-- Error [E0704]: reject signature function
fn example()
where
    fn helper() {}
{ helper() }
