where
    type Action = fn() -> ()
{ action() }

-- [case: reject-signature-block-type, check-fail]
-- spec: SPEC#dual-tier-where-invariants
-- companion: accept-signature-block-type
-- Error [E0706]: reject signature block type
fn example(action: Action) { action()
where
    type Action = fn() -> ()
}

