-- [case: accept-downward-type, check-pass]
-- spec: SPEC#dual-tier-where-invariants
-- companion: reject-downward-type
fn example() -> Wrapper
where
    type Internal = int
    type Wrapper = { value: Internal }
{ .{ value: 1 } }

-- [case: reject-downward-type, check-fail]
-- spec: SPEC#dual-tier-where-invariants
-- companion: accept-downward-type
-- Error [E0705]: reject downward type
fn example() -> Wrapper
where
    type Wrapper = { value: Internal }
{ .{ value: 1 }
where
    type Internal = int
}

-- [case: accept-signature-block-type, check-pass]
