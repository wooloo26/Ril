-- [pair: alias-cycle]
-- spec: SPEC#type-declarations-and-opaque-types

-- accept
type First = Second
type Second = int

-- reject
-- Error [E0313]: reject alias cycle
type First = Second
type Second = First

-- [pair: bare-type-value]
-- spec: SPEC#static-type-values-and-type-quotation

-- accept
type Identity = \T -> { let value = type<int>; type<T> }

-- reject
-- Error [E0319]: reject bare type value
type Identity = \T -> { let value = int; type<T> }

-- [pair: duplicate-mapped-key]
-- spec: SPEC#symmetrical-mapped-comprehensions

-- accept
type Item = { [K in ["a", "b"]]: int }

-- reject
-- Error [E0210]: reject duplicate mapped key
type Item = { [K in ["a", "a"]]: int }

-- [pair: evaluation-budget]
-- spec: SPEC#pure-type-functions-and-type-return-privilege

-- accept
type Identity = \T -> type<T>
type Value = Identity<int>

-- reject
-- Error [E0811]: reject evaluation budget
type Spin = \T -> Spin<T>
type Value = Spin<int>

-- [pair: failed-assertion]
-- spec: SPEC#pure-type-functions-and-type-return-privilege

-- accept
meta let _ = assert(true)

-- reject
-- Error [E0830]: reject failed assertion
meta let _ = assert(false)

-- [pair: higher-kinded-sort]
-- spec: SPEC#static-parameter-sorts-and-adaptation-rules

-- accept
type Wrapper = \M: Type -> Type, T -> type<M<T>>
type Valid = Wrapper<Option, int>

-- reject
-- Error [E0306]: reject higher kinded sort
type Wrapper = \M: Type -> Type, T -> type<M<T>>
type Invalid = Wrapper<int, int>

-- [pair: invalid-mapped-label]
-- spec: SPEC#symmetrical-mapped-comprehensions

-- accept
type Item = { [K in ["good_name"]]: int }

-- reject
-- Error [E0102]: reject invalid mapped label
type Item = { [K in ["bad__name"]]: int }

-- [pair: key-membership]
-- spec: SPEC#static-key-parameters-and-computed-value-projection

-- accept
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example() {
    let _ = get_field(.{ id: 1 }, "id")
}

-- reject
-- Error [E0323]: reject key membership
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example() {
    let _ = get_field(.{ id: 1 }, "missing")
}

-- [pair: key-runtime]
-- spec: SPEC#static-key-parameters-and-computed-value-projection

-- accept
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example(key: str) {
    let _ = get_field(.{ id: 1 }, "id")
}

-- reject
-- Error [E0814]: reject key runtime
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example(key: str) {
    let _ = get_field(.{ id: 1 }, key)
}

-- [pair: meta-effect]
-- spec: SPEC#pure-type-functions-and-type-return-privilege

-- accept
meta fn value() -> int { 1 }

-- reject
-- Error [E0813]: reject meta effect
meta fn value() -> int @Fiber { 1 }

-- [pair: meta-state]
-- spec: SPEC#pure-type-functions-and-type-return-privilege

-- accept
meta fn value() -> int { 1 }

-- reject
-- Error [E0813]: reject meta state
meta fn value() -> int &mut { 1 }

-- [pair: meta-type-return]
-- spec: SPEC#pure-type-functions-and-type-return-privilege

-- accept
meta fn inspect() -> int { byte_size(type<int>) }

-- reject
-- Error [E0812]: reject meta type return
meta fn generate() -> type<int> { type<int> }

-- [pair: nonrigid-type-pattern]
-- spec: SPEC#structural-type-pattern-matching

-- accept
type Inspect = \T -> match type<T> { type<Option<let U>> -> type<U>, _ -> type<never> }
type Value = Inspect<Option<int>>

-- reject
-- Error [E0306]: reject nonrigid type pattern
type Inspect = \T -> match type<T> { type<(let M)<let U>> -> type<U>, _ -> type<never> }
type Value = Inspect<Option<int>>

-- [pair: record-key-sort]
-- spec: SPEC#symmetrical-mapped-comprehensions

-- accept
type Item = { [K in ["a", "b"]]: int }

-- reject
-- Error [E0341]: reject record key sort
type Item = { [K in [0, 1]]: int }

-- [pair: runtime-call]
-- spec: SPEC#disjoint-call-families-evaluation-budgets-and-branch-pruning

-- accept
meta fn identity(value: int) -> int { value }
meta let VALUE = identity(1)

-- reject
-- Error [E0810]: reject runtime call
fn identity(value: int) -> int { value }
meta let VALUE = identity(1)

-- [pair: runtime-only-clock]
-- spec: STD#static-availability

-- accept
use ril/clock
fn example() @Fiber { let value = Clock::now(); let _ = value }

-- reject
-- Error [E0810]: reject runtime only clock
use ril/clock
meta let VALUE = Clock::now()

-- [pair: runtime-only-numeric-parser]
-- spec: STD#static-availability

-- accept
use ril/num
fn example() { let value = Num::parse_int("1"); assert(value is Ok(1)) }

-- reject
-- Error [E0810]: reject runtime only numeric parser
use ril/num
meta let VALUE = Num::parse_int("1")

-- [pair: runtime-only-set-construction]
-- spec: STD#static-availability

-- accept
fn example() { let value = Set::from([1]); let _ = value }

-- reject
-- Error [E0810]: reject runtime only set construction
meta let VALUE = Set::from([1])

-- [pair: runtime-size-query]
-- spec: SPEC#compile-time-execution-and-layout-cooperation

-- accept
fn example() {
    meta let VALUE = byte_size(type<u8>)
}

-- reject
-- Error [E0810]: reject runtime size query
fn example() {
    let value = byte_size(type<u8>)
}

-- [pair: single-tuple]
-- spec: SPEC#symmetrical-mapped-comprehensions

-- accept
type Item = ( [K in [0, 1]]: int )

-- reject
-- Error [E0343]: reject single tuple
type Item = ( [K in [0]]: int )

-- [pair: static-overflow]
-- spec: SPEC#pure-type-functions-and-type-return-privilege

-- accept
meta let VALUE = 126i8 + 1i8

-- reject
-- Error [E0831]: reject static overflow
meta let VALUE = 127i8 + 1i8

-- [pair: tuple-key-sort]
-- spec: SPEC#symmetrical-mapped-comprehensions

-- accept
type Item = ( [K in [0, 1]]: int )

-- reject
-- Error [E0342]: reject tuple key sort
type Item = ( [K in ["a", "b"]]: int )

-- [case: canonical-coordinates, check-pass]
-- spec: SPEC#universal-coordinate-indexing
type Record = { z: int, a: str }
type Choice { Zebra, Alpha(int) }
meta let _ = assert(keyof Record == ["a", "z"])
meta let _ = assert(keyof Choice == ["Alpha", "Zebra"])
meta let _ = assert(keyof (int, str) == [0, 1])
meta let _ = assert(type<Record.a> == type<str>)
meta let _ = assert(type<Choice.Alpha> == type<int>)
meta let _ = assert(type<Choice.Zebra> == type<()>)

-- [case: pointer-size-pointer32, check-pass]
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- target: pointer32
meta let _ = assert(byte_size(type<int>) == 4)
meta let _ = assert(byte_size(type<u8>) == 1)
meta let _ = assert(byte_size(type<i64>) == 8)

-- [case: pointer-size-pointer64, check-pass]
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- target: pointer64
meta let _ = assert(byte_size(type<int>) == 8)
meta let _ = assert(byte_size(type<u8>) == 1)
meta let _ = assert(byte_size(type<i64>) == 8)

-- [case: type-extractors, check-pass]
-- spec: STD#set
-- spec: SPEC#unified-tripartite-introspection
use ril/array::{Elem}
use ril/map::{Key, Value}
use ril/set as Sets
type A = Elem<[4]u8>
type K = Key<[str: int]>
type V = Value<[str: int]>
type S = Sets::Elem<Set<int>>
meta let _ = assert(type<A> == type<u8>)
meta let _ = assert(type<K> == type<str>)
meta let _ = assert(type<V> == type<int> && type<S> == type<int>)

-- [case: type-pattern-rest, check-pass]
-- spec: SPEC#structural-type-pattern-matching
halt type Tail = \T -> match type<T> {
    type<(let Head, ..let Rest)> -> type<Rest>,
    _ -> type<never>,
}
type Long = Tail<(int, str, bool)>
type Short = Tail<(int, str)>
meta let _ = assert(type<Long> == type<(str, bool)>)
meta let _ = assert(type<Short> == type<never>)

-- [case: runtime-meta-named-source, run-pass]
-- spec: SPEC#external-state-tracking
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- companion: runtime-meta-missing-source
-- entry: test_native
-- file: source.ril
meta let ANSWER=42
fn answer()->int &{ANSWER}{ANSWER}
pub fn test_native() &{ANSWER}{assert(answer()==42)}

-- [case: runtime-meta-missing-source, check-fail]
-- spec: SPEC#external-state-tracking
-- companion: runtime-meta-named-source
-- Error [E0510]: compile-time publication does not erase a runtime named source.
-- file: source.ril
meta let ANSWER=42
fn hidden_answer()->int{ANSWER}

-- [case: static-meta-source-exemption, check-pass]
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- file: source.ril
meta let ANSWER=42
meta let COPY=ANSWER
meta let _=assert(COPY==42)
fn empty(values:[ANSWER-42]int)->int{len(values)}
fn example(){assert(empty([])==0)}
