-- [case: accept-alias-cycle, check-pass]
-- spec: SPEC#type-declarations-and-opaque-types
-- companion: reject-alias-cycle
type First = Second
type Second = int

-- [case: reject-alias-cycle, check-fail]
-- spec: SPEC#type-declarations-and-opaque-types
-- companion: accept-alias-cycle
-- Error [E0313]: reject alias cycle
type First = Second
type Second = First

-- [case: accept-bare-type-value, check-pass]
