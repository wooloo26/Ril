-- [case: canonical-coordinates, check-pass]
-- spec: SPEC#universal-coordinate-indexing
type Record = { z: int, a: str }
type Choice { Zebra, Alpha(int) }
meta let _ = assert(keyof Record == ["a", "z"])
meta let _ = assert(keyof Choice == ["Alpha", "Zebra"])
meta let _ = assert(keyof (int, str) == [0, 1])
meta let _ = assert(type<Record.a> == type<str>)
meta let _ = assert(type<Choice.Alpha> == type<int>)
meta let _ = assert(type<Choice.Zebra> == type<()>)

-- [case: pointer-size-pointer32, check-pass]
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- target: pointer32
meta let _ = assert(byte_size(type<int>) == 4)
meta let _ = assert(byte_size(type<u8>) == 1)
meta let _ = assert(byte_size(type<i64>) == 8)

-- [case: pointer-size-pointer64, check-pass]
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- target: pointer64
meta let _ = assert(byte_size(type<int>) == 8)
meta let _ = assert(byte_size(type<u8>) == 1)
meta let _ = assert(byte_size(type<i64>) == 8)

-- [case: type-extractors, check-pass]
-- spec: STD#set
-- spec: SPEC#unified-tripartite-introspection
use ril/array::{Elem}
use ril/map::{Key, Value}
use ril/set as Sets
type A = Elem<[4]u8>
type K = Key<[str: int]>
type V = Value<[str: int]>
type S = Sets::Elem<Set<int>>
meta let _ = assert(type<A> == type<u8>)
meta let _ = assert(type<K> == type<str>)
meta let _ = assert(type<V> == type<int> && type<S> == type<int>)

-- [case: type-pattern-rest, check-pass]
-- spec: SPEC#structural-type-pattern-matching
halt type Tail = \T -> match type<T> {
    type<(let Head, ..let Rest)> -> type<Rest>,
    _ -> type<never>,
}
type Long = Tail<(int, str, bool)>
type Short = Tail<(int, str)>
meta let _ = assert(type<Long> == type<(str, bool)>)
meta let _ = assert(type<Short> == type<never>)

-- [case: runtime-meta-named-source, run-pass]
-- spec: SPEC#external-state-tracking
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- companion: runtime-meta-missing-source
-- entry: test_native
-- file: source.ril
meta let ANSWER=42
fn answer()->int &{ANSWER}{ANSWER}
pub fn test_native() &{ANSWER}{assert(answer()==42)}

-- [case: runtime-meta-missing-source, check-fail]
-- spec: SPEC#external-state-tracking
-- companion: runtime-meta-named-source
-- Error [E0510]: compile-time publication does not erase a runtime named source.
-- file: source.ril
meta let ANSWER=42
fn hidden_answer()->int{ANSWER}

-- [case: static-meta-source-exemption, check-pass]
-- spec: SPEC#compile-time-execution-and-layout-cooperation
-- file: source.ril
meta let ANSWER=42
meta let COPY=ANSWER
meta let _=assert(COPY==42)
fn empty(values:[ANSWER-42]int)->int{len(values)}
fn example(){assert(empty([])==0)}
