-- [case: accept-key-membership, check-pass]
-- spec: SPEC#static-key-parameters-and-computed-value-projection
-- companion: reject-key-membership
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example() {
    let _ = get_field(.{ id: 1 }, "id")
}

-- [case: reject-key-membership, check-fail]
-- spec: SPEC#static-key-parameters-and-computed-value-projection
-- companion: accept-key-membership
-- Error [E0323]: reject key membership
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example() {
    let _ = get_field(.{ id: 1 }, "missing")
}

-- [case: accept-key-runtime, check-pass]
-- spec: SPEC#static-key-parameters-and-computed-value-projection
-- companion: reject-key-runtime
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example(key: str) {
    let _ = get_field(.{ id: 1 }, "id")
}

-- [case: reject-key-runtime, check-fail]
-- spec: SPEC#static-key-parameters-and-computed-value-projection
-- companion: accept-key-runtime
-- Error [E0814]: reject key runtime
fn get_field<T: { ..R }, K: keyof T>(record: T, key: K) -> T.(K) { record.(key) }

fn example(key: str) {
    let _ = get_field(.{ id: 1 }, key)
}

