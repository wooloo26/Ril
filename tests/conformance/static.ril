--@ case: accept-alias-cycle
--@ mode: check-pass
--@ spec: SPEC#type-declarations-and-opaque-types
--@ companion: reject-alias-cycle
--@ file: accept-alias-cycle.ril
type First = Second
type Second = int
--@ end-file
--@ end-case

--@ case: reject-alias-cycle
--@ mode: check-fail
--@ spec: SPEC#type-declarations-and-opaque-types
--@ companion: accept-alias-cycle
-- Error [E0313]: reject alias cycle
--@ file: reject-alias-cycle.ril
type First = Second
type Second = First
--@ end-file
--@ end-case

