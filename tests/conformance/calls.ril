-- [case: default-binding-order, run-pass]
-- spec: SPEC#default-parameters-and-named-arguments
fn pair(a: int = 1, b: int = 2) -> (int, int) { (a, b) }

pub fn test_default_binding_order() {
    assert(pair(b: 20, 10) == (10, 20))
    assert(pair(a: 10, 20) == (10, 20))
    assert(pair() == (1, 2))
    let alias = pair
    assert(alias() == (1, 2))
}

-- [case: callable-ascription-labels-and-defaults, run-pass]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: reject-ascribed-source-label
fn identity(value: int = 1) -> int { value }

pub fn test_callable_ascription_labels_and_defaults() {
    let direct_alias = identity
    let renamed: fn(other: int) -> int = identity
    let unnamed: fn(int) -> int = identity
    assert(direct_alias() == 1 && direct_alias(value: 2) == 2)
    assert(renamed(other: 3) == 3 && renamed(4) == 4)
    assert(unnamed(5) == 5)
}

-- [case: reject-ascribed-source-label, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0339]: The destination callable signature replaces the source parameter label
fn identity(value: int = 1) -> int { value }

fn example() {
    let renamed: fn(other: int) -> int = identity
    let value = renamed(value: 2)
}

-- [case: reject-ascribed-default, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0314]: Callable-type ascription does not import the declaration's default
fn identity(value: int = 1) -> int { value }

fn example() {
    let renamed: fn(other: int) -> int = identity
    let value = renamed()
}

-- [case: reject-unnamed-callable-label, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0339]: An unnamed callable parameter permits only positional arguments
fn identity(value: int = 1) -> int { value }

fn example() {
    let unnamed: fn(int) -> int = identity
    let value = unnamed(value: 2)
}

-- [case: reject-unnamed-callable-default, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0314]: An unnamed callable type also discards the source default
fn identity(value: int = 1) -> int { value }

fn example() {
    let unnamed: fn(int) -> int = identity
    let value = unnamed()
}
