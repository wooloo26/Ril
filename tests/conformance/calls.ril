-- [case: accept-callback-parameter-mode, check-pass]
-- spec: SPEC#parameter-modes-caller-obligations-and-defaults
-- companion: reject-callback-parameter-mode
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let action: fn(mut Cell) -> () &mut = bump
}

