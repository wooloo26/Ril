-- [pair: callback-parameter-mode]
-- spec: SPEC#parameter-modes-caller-obligations-and-defaults

-- accept
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let action: fn(mut Cell) -> () &mut = bump
}

-- reject
-- Error [E0407]: reject callback parameter mode
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let action: fn(Cell) -> () &mut = bump
}

-- [pair: duplicate-argument]
-- spec: SPEC#default-parameters-and-named-arguments

-- accept
fn item(a: int = 0, b: int = 0) -> int { a + b }

fn example() {
    let value = item(b: 2, 1)
}

-- reject
-- Error [E0325]: reject duplicate argument
fn item(a: int = 0, b: int = 0) -> int { a + b }

fn example() {
    let value = item(1, a: 2)
}

-- [pair: effectful-default]
-- spec: SPEC#default-parameters-and-named-arguments

-- accept
eff Read { get() -> int }
fn value(a: int = 1) -> int { a }

-- reject
-- Error [E0409]: reject effectful default
eff Read { get() -> int }
fn value(a: int = Read::get()) -> int @Read { a }

-- [pair: forward-default]
-- spec: SPEC#default-parameters-and-named-arguments

-- accept
fn value(a: int = 1, b: int = a) -> int { a + b }

-- reject
-- Error [E0408]: reject forward default
fn value(a: int = b, b: int = 1) -> int { a + b }

-- [pair: missing-mut-marker]
-- spec: SPEC#parameter-modes-caller-obligations-and-defaults

-- accept
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let mut cell = Cell.{ count: 0 }
    bump(mut cell)
}

-- reject
-- Error [E0405]: reject missing mut marker
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let mut cell = Cell.{ count: 0 }
    bump(cell)
}

-- [pair: missing-parameter-capability]
-- spec: SPEC#parameter-mutation

-- accept
type Cell = { mut count: int }
fn change(mut cell: Cell) &mut { cell.count += 1 }

-- reject
-- Error [E0510]: reject missing parameter capability
type Cell = { mut count: int }
fn change(mut cell: Cell) { cell.count += 1 }

-- [pair: mutable-default]
-- spec: SPEC#default-parameters-and-named-arguments

-- accept
fn change(mut items: []int) &mut { items !> Array::push(1) }

-- reject
-- Error [E0404]: reject mutable default
fn change(mut items: []int = []) &mut { items !> Array::push(1) }

-- [pair: nonaddressable-mut]
-- spec: SPEC#parameter-modes-caller-obligations-and-defaults

-- accept
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let mut cell = Cell.{ count: 0 }
    bump(mut cell)
}

-- reject
-- Error [E0410]: reject nonaddressable mut
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    bump(mut Cell.{ count: 0 })
}

-- [pair: noncallable]
-- spec: SPEC#default-parameters-and-named-arguments

-- accept
fn example() {
    let action = \-> 42
    let value = action()
}

-- reject
-- Error [E0338]: reject noncallable
fn example() {
    let value = 42()
}

-- [pair: unknown-argument]
-- spec: SPEC#default-parameters-and-named-arguments

-- accept
fn item(value: int) -> int { value }

fn example() {
    let value = item(value: 1)
}

-- reject
-- Error [E0339]: reject unknown argument
fn item(value: int) -> int { value }

fn example() {
    let value = item(unknown: 1)
}

-- [pair: var-parameter]
-- spec: SPEC#parameter-modes-caller-obligations-and-defaults

-- accept
fn example(value: int) { var local = value; local += 1 }

-- reject
-- Error [E0403]: reject var parameter
fn example(var value: int) { value += 1 }

-- [pair: wrong-mut-mode]
-- spec: SPEC#parameter-modes-caller-obligations-and-defaults

-- accept
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let mut cell = Cell.{ count: 0 }
    bump(mut cell)
}

-- reject
-- Error [E0406]: reject wrong mut mode
type Cell = { mut count: int }
fn bump(mut cell: Cell) &mut { cell.count += 1 }

fn example() {
    let mut cell = Cell.{ count: 0 }
    bump(^mut cell)
}

-- [case: default-binding-order, run-pass]
-- spec: SPEC#default-parameters-and-named-arguments
fn pair(a: int = 1, b: int = 2) -> (int, int) { (a, b) }

pub fn test_default_binding_order() {
    assert(pair(b: 20, 10) == (10, 20))
    assert(pair(a: 10, 20) == (10, 20))
    assert(pair() == (1, 2))
    let alias = pair
    assert(alias() == (1, 2))
}

-- [case: callable-ascription-labels-and-defaults, run-pass]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: reject-ascribed-source-label
fn identity(value: int = 1) -> int { value }

pub fn test_callable_ascription_labels_and_defaults() {
    let direct_alias = identity
    let renamed: fn(other: int) -> int = identity
    let unnamed: fn(int) -> int = identity
    assert(direct_alias() == 1 && direct_alias(value: 2) == 2)
    assert(renamed(other: 3) == 3 && renamed(4) == 4)
    assert(unnamed(5) == 5)
}

-- [case: reject-ascribed-source-label, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0339]: The destination callable signature replaces the source parameter label
fn identity(value: int = 1) -> int { value }

fn example() {
    let renamed: fn(other: int) -> int = identity
    let value = renamed(value: 2)
}

-- [case: reject-ascribed-default, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0314]: Callable-type ascription does not import the declaration's default
fn identity(value: int = 1) -> int { value }

fn example() {
    let renamed: fn(other: int) -> int = identity
    let value = renamed()
}

-- [case: reject-unnamed-callable-label, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0339]: An unnamed callable parameter permits only positional arguments
fn identity(value: int = 1) -> int { value }

fn example() {
    let unnamed: fn(int) -> int = identity
    let value = unnamed(value: 2)
}

-- [case: reject-unnamed-callable-default, check-fail]
-- spec: SPEC#default-parameters-and-named-arguments
-- companion: callable-ascription-labels-and-defaults
-- Error [E0314]: An unnamed callable type also discards the source default
fn identity(value: int = 1) -> int { value }

fn example() {
    let unnamed: fn(int) -> int = identity
    let value = unnamed()
}
