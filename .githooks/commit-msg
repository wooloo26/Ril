#!/bin/sh
set -eu

# Git keeps comment lines in ordinary non-interactive commits.
if [ "${GIT_EDITOR-}" = : ]; then
    message=$(git stripspace < "$1")
else
    message=$(git stripspace --strip-comments < "$1")
fi

case "$message" in
    [ABCDEFGHIJKLMNOPQRSTUVWXYZ]*) ;;
    *)
        printf '%s\n' 'Start the commit message with an uppercase ASCII letter.' >&2
        exit 1
        ;;
esac

case "$message" in
    *:*)
        printf '%s\n' 'Remove colons (:) from the commit message.' >&2
        exit 1
        ;;
esac
